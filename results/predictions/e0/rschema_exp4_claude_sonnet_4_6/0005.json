  "question": "The business requirements for a service management system are described as follows: The system manages multiple services, each with a service ID, name, type, price and description. There are multiple users in the system, each with a user ID and name. Each service usage needs to record the operating user ID, service ID, usage time and duration. The system needs to support real-time monitoring and performance evaluation of service usage.",
  "ddl": "-- Schema for database: rschema_0005\nCREATE TABLE `service` (\n  `service_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `type` varchar(100) NOT NULL,\n  `price` decimal(10,2) NOT NULL,\n  `description` text DEFAULT NULL,\n  PRIMARY KEY (`service_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `user` (\n  `user_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  PRIMARY KEY (`user_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `service_usage` (\n  `usage_id` int(11) NOT NULL AUTO_INCREMENT,\n  `user_id` int(11) NOT NULL,\n  `service_id` int(11) NOT NULL,\n  `usage_time` datetime NOT NULL,\n  `duration` int(11) NOT NULL,\n  PRIMARY KEY (`usage_id`),\n  CONSTRAINT `service_usage_ibfk_1` FOREIGN KEY (`user_id`) REFERENCES `user` (`user_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `service_usage_ibfk_2` FOREIGN KEY (`service_id`) REFERENCES `service` (`service_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `service_monitoring` (\n  `monitoring_id` int(11) NOT NULL AUTO_INCREMENT,\n  `service_id` int(11) NOT NULL,\n  `monitor_time` datetime NOT NULL,\n  `status` varchar(50) NOT NULL,\n  `response_time` decimal(10,3) DEFAULT NULL,\n  `error_count` int(11) DEFAULT NULL,\n  PRIMARY KEY (`monitoring_id`),\n  CONSTRAINT `service_monitoring_ibfk_1` FOREIGN KEY (`service_id`) REFERENCES `service` (`service_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `performance_evaluation` (\n  `evaluation_id` int(11) NOT NULL AUTO_INCREMENT,\n  `service_id` int(11) NOT NULL,\n  `evaluation_time` datetime NOT NULL,\n  `availability` decimal(5,2) DEFAULT NULL,\n  `avg_response_time` decimal(10,3) DEFAULT NULL,\n  `total_usage_count` int(11) DEFAULT NULL,\n  `total_duration` int(11) DEFAULT NULL,\n  `score` decimal(5,2) DEFAULT NULL,\n  `remarks` text DEFAULT NULL,\n  PRIMARY KEY (`evaluation_id`),\n  CONSTRAINT `performance_evaluation_ibfk_1` FOREIGN KEY (`service_id`) REFERENCES `service` (`service_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
