  "question": "The software development company manages multiple projects, each with a Project ID, Name, Start Date, End Date, and Budget. The company employs multiple developers, and each developer can participate in multiple projects. Each project progress update must record the Update Time, Current Status, and the person who performed the update.",
  "ddl": "-- Schema for database: rschema_0006\n\nCREATE TABLE `project` (\n  `project_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `start_date` datetime NOT NULL,\n  `end_date` datetime DEFAULT NULL,\n  `budget` decimal(15,2) NOT NULL,\n  PRIMARY KEY (`project_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `developer` (\n  `developer_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `email` varchar(255) DEFAULT NULL,\n  `phone` varchar(50) DEFAULT NULL,\n  `hire_date` datetime DEFAULT NULL,\n  PRIMARY KEY (`developer_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `project_developer` (\n  `project_id` int(11) NOT NULL,\n  `developer_id` int(11) NOT NULL,\n  `role` varchar(100) DEFAULT NULL,\n  `joined_date` datetime DEFAULT NULL,\n  PRIMARY KEY (`project_id`, `developer_id`),\n  CONSTRAINT `project_developer_ibfk_1` FOREIGN KEY (`project_id`) REFERENCES `project` (`project_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `project_developer_ibfk_2` FOREIGN KEY (`developer_id`) REFERENCES `developer` (`developer_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `project_progress_update` (\n  `update_id` int(11) NOT NULL AUTO_INCREMENT,\n  `project_id` int(11) NOT NULL,\n  `update_time` datetime NOT NULL,\n  `current_status` varchar(255) NOT NULL,\n  `updated_by` int(11) NOT NULL,\n  PRIMARY KEY (`update_id`),\n  CONSTRAINT `project_progress_update_ibfk_1` FOREIGN KEY (`project_id`) REFERENCES `project` (`project_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `project_progress_update_ibfk_2` FOREIGN KEY (`updated_by`) REFERENCES `developer` (`developer_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
