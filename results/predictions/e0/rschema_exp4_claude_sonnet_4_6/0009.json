  "question": "A grassroots self-governance organization needs to manage the election process, including candidates, voters, and voting records. The candidates have candidate ID, name, gender, date of birth, and position; voters have voter ID, name, gender, date of birth, and contact information; voting records include voter ID, candidate ID, voting time, and voting location. The system also needs to be able to count the number of votes for each candidate.",
  "ddl": "-- Schema for database: rschema_0009\n\nCREATE TABLE `candidate` (\n  `candidate_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(100) NOT NULL,\n  `gender` char(1) NOT NULL,\n  `date_of_birth` date NOT NULL,\n  `position` varchar(100) NOT NULL,\n  PRIMARY KEY (`candidate_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `voter` (\n  `voter_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(100) NOT NULL,\n  `gender` char(1) NOT NULL,\n  `date_of_birth` date NOT NULL,\n  `contact_info` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`voter_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `voting_record` (\n  `record_id` int(11) NOT NULL AUTO_INCREMENT,\n  `voter_id` int(11) NOT NULL,\n  `candidate_id` int(11) NOT NULL,\n  `voting_time` datetime NOT NULL,\n  `voting_location` varchar(255) NOT NULL,\n  PRIMARY KEY (`record_id`),\n  CONSTRAINT `voting_record_ibfk_1` FOREIGN KEY (`voter_id`) REFERENCES `voter` (`voter_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `voting_record_ibfk_2` FOREIGN KEY (`candidate_id`) REFERENCES `candidate` (`candidate_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `vote_count` (\n  `candidate_id` int(11) NOT NULL,\n  `vote_count` int(11) NOT NULL DEFAULT 0,\n  PRIMARY KEY (`candidate_id`),\n  CONSTRAINT `vote_count_ibfk_1` FOREIGN KEY (`candidate_id`) REFERENCES `candidate` (`candidate_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
