  "question": "The Agricultural Meteorological Data Management System needs to record meteorological data from multiple weather stations. Each weather station can observe weather changes.\n- Each weather station has a Weather Station ID, name, location, person in charge, and contact information.\n- Each record includes Weather Station ID, recording date, temperature, humidity, precipitation, wind speed, and wind direction.\n- Each farm can subscribe to data from multiple weather stations, recording the subscription date and unsubscription date.",
  "ddl": "-- Schema for database: rschema_0013\n\nCREATE TABLE `weather_station` (\n  `station_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `location` varchar(255) NOT NULL,\n  `person_in_charge` varchar(255) NOT NULL,\n  `contact_info` varchar(255) NOT NULL,\n  PRIMARY KEY (`station_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `meteorological_record` (\n  `record_id` int(11) NOT NULL AUTO_INCREMENT,\n  `station_id` int(11) NOT NULL,\n  `recording_date` datetime NOT NULL,\n  `temperature` decimal(5,2) DEFAULT NULL,\n  `humidity` decimal(5,2) DEFAULT NULL,\n  `precipitation` decimal(6,2) DEFAULT NULL,\n  `wind_speed` decimal(5,2) DEFAULT NULL,\n  `wind_direction` varchar(50) DEFAULT NULL,\n  PRIMARY KEY (`record_id`),\n  CONSTRAINT `meteorological_record_ibfk_1` FOREIGN KEY (`station_id`) REFERENCES `weather_station` (`station_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `farm` (\n  `farm_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `location` varchar(255) DEFAULT NULL,\n  `owner` varchar(255) DEFAULT NULL,\n  `contact_info` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`farm_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `farm_station_subscription` (\n  `subscription_id` int(11) NOT NULL AUTO_INCREMENT,\n  `farm_id` int(11) NOT NULL,\n  `station_id` int(11) NOT NULL,\n  `subscription_date` datetime NOT NULL,\n  `unsubscription_date` datetime DEFAULT NULL,\n  PRIMARY KEY (`subscription_id`),\n  CONSTRAINT `farm_station_subscription_ibfk_1` FOREIGN KEY (`farm_id`) REFERENCES `farm` (`farm_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `farm_station_subscription_ibfk_2` FOREIGN KEY (`station_id`) REFERENCES `weather_station` (`station_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
