  "database": "rschema_0014",
  "question": "The Agricultural Irrigation Management System shall manage multiple irrigation systems, each capable of irrigating several plots. Each plot has a Plot ID, area, soil type, and current irrigation status (such as \"Irrigated\", \"Not Irrigated\"). Each irrigation system possesses a System ID, name, type (such as \"Drip\", \"Spray\"), installation date, and maintenance records. Each irrigation record includes System ID, Plot ID, irrigation date, irrigation duration, and irrigation amount.",
  "ddl": "-- Schema for database: rschema_0014\n\nCREATE TABLE `irrigation_system` (\n  `system_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `type` varchar(100) NOT NULL,\n  `installation_date` date NOT NULL,\n  `maintenance_records` text DEFAULT NULL,\n  PRIMARY KEY (`system_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `plot` (\n  `plot_id` int(11) NOT NULL AUTO_INCREMENT,\n  `system_id` int(11) NOT NULL,\n  `area` decimal(10,2) NOT NULL,\n  `soil_type` varchar(100) NOT NULL,\n  `irrigation_status` varchar(50) NOT NULL DEFAULT 'Not Irrigated',\n  PRIMARY KEY (`plot_id`),\n  CONSTRAINT `plot_ibfk_1` FOREIGN KEY (`system_id`) REFERENCES `irrigation_system` (`system_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `irrigation_record` (\n  `record_id` int(11) NOT NULL AUTO_INCREMENT,\n  `system_id` int(11) NOT NULL,\n  `plot_id` int(11) NOT NULL,\n  `irrigation_date` date NOT NULL,\n  `irrigation_duration` decimal(10,2) NOT NULL,\n  `irrigation_amount` decimal(10,2) NOT NULL,\n  PRIMARY KEY (`record_id`),\n  CONSTRAINT `irrigation_record_ibfk_1` FOREIGN KEY (`system_id`) REFERENCES `irrigation_system` (`system_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `irrigation_record_ibfk_2` FOREIGN KEY (`plot_id`) REFERENCES `plot` (`plot_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
