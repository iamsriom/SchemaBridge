  "question": "The agricultural planting plan management system needs to manage planting plans for multiple farms. Each farm has a farm ID, name, address, and contact information. Each planting plan includes a farm ID, plot ID, crop type, planting time, expected harvest time, planting quantity, and operator. Each plot has a plot ID, area, soil type, and current status (e.g., “idle,” “planting in progress,” etc.).",
  "ddl": "-- Schema for database: rschema_0016\n\nCREATE TABLE `farm` (\n  `farm_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `address` varchar(500) NOT NULL,\n  `contact_info` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`farm_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `plot` (\n  `plot_id` int(11) NOT NULL AUTO_INCREMENT,\n  `farm_id` int(11) NOT NULL,\n  `area` decimal(10,2) NOT NULL,\n  `soil_type` varchar(100) DEFAULT NULL,\n  `current_status` varchar(100) NOT NULL DEFAULT 'idle',\n  PRIMARY KEY (`plot_id`),\n  CONSTRAINT `plot_ibfk_1` FOREIGN KEY (`farm_id`) REFERENCES `farm` (`farm_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `planting_plan` (\n  `plan_id` int(11) NOT NULL AUTO_INCREMENT,\n  `farm_id` int(11) NOT NULL,\n  `plot_id` int(11) NOT NULL,\n  `crop_type` varchar(255) NOT NULL,\n  `planting_time` datetime NOT NULL,\n  `expected_harvest_time` datetime NOT NULL,\n  `planting_quantity` decimal(10,2) NOT NULL,\n  `operator` varchar(255) NOT NULL,\n  PRIMARY KEY (`plan_id`),\n  CONSTRAINT `planting_plan_ibfk_1` FOREIGN KEY (`farm_id`) REFERENCES `farm` (`farm_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `planting_plan_ibfk_2` FOREIGN KEY (`plot_id`) REFERENCES `plot` (`plot_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
