  "database": "rschema_0022",
  "question": "A national agency requires management of the document circulation process, including approval, archiving, and querying of documents.\nDocuments have a document ID, name, category, creation time, and status;\nApproval records include document ID, approver, approval time, and approval comments;\nArchiving records include document ID, archivist, archiving time, and archiving location;\nQuery records include document ID, query personnel, query time, and query results;\nThe approval and querying operations of documents can occur multiple times, whereas archiving occurs only once.\nDocument management personnel are responsible for approving, archiving, and querying documents; they have employee ID, name, gender, position, and contact information.",
  "ddl": "-- Schema for database: rschema_0022\n\nCREATE TABLE `personnel` (\n  `employee_id` varchar(50) NOT NULL,\n  `name` varchar(100) NOT NULL,\n  `gender` char(6) NOT NULL,\n  `position` varchar(100) NOT NULL,\n  `contact_info` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`employee_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `document` (\n  `document_id` varchar(50) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `category` varchar(100) NOT NULL,\n  `creation_time` datetime NOT NULL,\n  `status` varchar(50) NOT NULL,\n  PRIMARY KEY (`document_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `approval_record` (\n  `approval_id` int(11) NOT NULL AUTO_INCREMENT,\n  `document_id` varchar(50) NOT NULL,\n  `approver_id` varchar(50) NOT NULL,\n  `approval_time` datetime NOT NULL,\n  `approval_comments` text DEFAULT NULL,\n  PRIMARY KEY (`approval_id`),\n  CONSTRAINT `approval_record_ibfk_1` FOREIGN KEY (`document_id`) REFERENCES `document` (`document_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `approval_record_ibfk_2` FOREIGN KEY (`approver_id`) REFERENCES `personnel` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `archiving_record` (\n  `archiving_id` int(11) NOT NULL AUTO_INCREMENT,\n  `document_id` varchar(50) NOT NULL,\n  `archivist_id` varchar(50) NOT NULL,\n  `archiving_time` datetime NOT NULL,\n  `archiving_location` varchar(255) NOT NULL,\n  PRIMARY KEY (`archiving_id`),\n  UNIQUE KEY `document_id` (`document_id`),\n  CONSTRAINT `archiving_record_ibfk_1` FOREIGN KEY (`document_id`) REFERENCES `document` (`document_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `archiving_record_ibfk_2` FOREIGN KEY (`archivist_id`) REFERENCES `personnel` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `query_record` (\n  `query_id` int(11) NOT NULL AUTO_INCREMENT,\n  `document_id` varchar(50) NOT NULL,\n  `query_personnel_id` varchar(50) NOT NULL,\n  `query_time` datetime NOT NULL,\n  `query_result` text DEFAULT NULL,\n  PRIMARY KEY (`query_id`),\n  CONSTRAINT `query_record_ibfk_1` FOREIGN KEY (`document_id`) REFERENCES `document` (`document_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `query_record_ibfk_2` FOREIGN KEY (`query_personnel_id`) REFERENCES `personnel` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
