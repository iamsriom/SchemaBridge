  "question": "Business requirement description:\nThe real estate company manages the property management of multiple communities. Each community has a community number, name, location and property manager. The property manager can manage multiple communities, but each community has only one property manager, and the name, phone number and email address of the property manager need to be recorded. Each community has multiple residents, and each resident has a resident number, name, phone number, email address and building number. Every time the property is repaired, the maintenance order number, community number, resident number, maintenance date, maintenance content, maintenance cost and maintenance personnel information must be recorded. The maintenance personnel information includes the maintenance personnel number, name and phone number.",
  "ddl": "-- Schema for database: rschema_0041\n\nCREATE TABLE `property_manager` (\n  `manager_id` int(11) NOT NULL AUTO_INCREMENT,\n  `manager_name` varchar(255) NOT NULL,\n  `phone` varchar(50) NOT NULL,\n  `email` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`manager_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `community` (\n  `community_id` int(11) NOT NULL AUTO_INCREMENT,\n  `community_name` varchar(255) NOT NULL,\n  `location` varchar(255) NOT NULL,\n  `manager_id` int(11) NOT NULL,\n  PRIMARY KEY (`community_id`),\n  CONSTRAINT `community_ibfk_1` FOREIGN KEY (`manager_id`) REFERENCES `property_manager` (`manager_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `resident` (\n  `resident_id` int(11) NOT NULL AUTO_INCREMENT,\n  `resident_name` varchar(255) NOT NULL,\n  `phone` varchar(50) NOT NULL,\n  `email` varchar(255) DEFAULT NULL,\n  `building_number` varchar(100) NOT NULL,\n  `community_id` int(11) NOT NULL,\n  PRIMARY KEY (`resident_id`),\n  CONSTRAINT `resident_ibfk_1` FOREIGN KEY (`community_id`) REFERENCES `community` (`community_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `maintenance_worker` (\n  `worker_id` int(11) NOT NULL AUTO_INCREMENT,\n  `worker_name` varchar(255) NOT NULL,\n  `phone` varchar(50) NOT NULL,\n  PRIMARY KEY (`worker_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `maintenance_order` (\n  `order_id` int(11) NOT NULL AUTO_INCREMENT,\n  `community_id` int(11) NOT NULL,\n  `resident_id` int(11) NOT NULL,\n  `maintenance_date` datetime NOT NULL,\n  `maintenance_content` varchar(1000) NOT NULL,\n  `maintenance_cost` decimal(10,2) NOT NULL,\n  `worker_id` int(11) NOT NULL,\n  PRIMARY KEY (`order_id`),\n  CONSTRAINT `maintenance_order_ibfk_1` FOREIGN KEY (`community_id`) REFERENCES `community` (`community_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `maintenance_order_ibfk_2` FOREIGN KEY (`resident_id`) REFERENCES `resident` (`resident_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `maintenance_order_ibfk_3` FOREIGN KEY (`worker_id`) REFERENCES `maintenance_worker` (`worker_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
