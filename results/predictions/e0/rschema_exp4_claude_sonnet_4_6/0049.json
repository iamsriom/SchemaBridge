  "question": "The broadcasting station requires management of multiple programs, each with multiple hosts and time slots. The system needs to record the name, type, and broadcast time of each program, as well as the information of the hosts and the arrangement of the time slots.",
  "ddl": "-- Schema for database: rschema_0049\n\nCREATE TABLE `program` (\n  `program_id` int(11) NOT NULL AUTO_INCREMENT,\n  `program_name` varchar(255) NOT NULL,\n  `program_type` varchar(100) NOT NULL,\n  `broadcast_time` datetime NOT NULL,\n  `description` varchar(500) DEFAULT NULL,\n  PRIMARY KEY (`program_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `host` (\n  `host_id` int(11) NOT NULL AUTO_INCREMENT,\n  `host_name` varchar(255) NOT NULL,\n  `gender` varchar(10) DEFAULT NULL,\n  `birth_date` datetime DEFAULT NULL,\n  `contact_info` varchar(255) DEFAULT NULL,\n  `bio` varchar(500) DEFAULT NULL,\n  PRIMARY KEY (`host_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `program_host` (\n  `program_host_id` int(11) NOT NULL AUTO_INCREMENT,\n  `program_id` int(11) NOT NULL,\n  `host_id` int(11) NOT NULL,\n  `role` varchar(100) DEFAULT NULL,\n  PRIMARY KEY (`program_host_id`),\n  CONSTRAINT `program_host_ibfk_1` FOREIGN KEY (`program_id`) REFERENCES `program` (`program_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `program_host_ibfk_2` FOREIGN KEY (`host_id`) REFERENCES `host` (`host_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `time_slot` (\n  `slot_id` int(11) NOT NULL AUTO_INCREMENT,\n  `program_id` int(11) NOT NULL,\n  `start_time` datetime NOT NULL,\n  `end_time` datetime NOT NULL,\n  `day_of_week` varchar(20) DEFAULT NULL,\n  `frequency` varchar(50) DEFAULT NULL,\n  `channel` varchar(100) DEFAULT NULL,\n  PRIMARY KEY (`slot_id`),\n  CONSTRAINT `time_slot_ibfk_1` FOREIGN KEY (`program_id`) REFERENCES `program` (`program_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
