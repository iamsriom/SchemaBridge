  "question": "Equipment Repair Management\n\nA water treatment company needs to manage the maintenance of equipment as a sub-business. Each piece of equipment has an ID, name, model, installation location, and installation date. Each maintenance record includes the maintenance date, maintenance content, maintainer ID, and equipment ID. Each maintainer has an ID, name, department, and contact information.",
  "ddl": "-- Schema for database: rschema_0057\n\nCREATE TABLE `maintainer` (\n  `maintainer_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `department` varchar(255) NOT NULL,\n  `contact_info` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`maintainer_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `equipment` (\n  `equipment_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `model` varchar(255) DEFAULT NULL,\n  `installation_location` varchar(255) DEFAULT NULL,\n  `installation_date` datetime DEFAULT NULL,\n  PRIMARY KEY (`equipment_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `maintenance_record` (\n  `record_id` int(11) NOT NULL AUTO_INCREMENT,\n  `maintenance_date` datetime NOT NULL,\n  `maintenance_content` text DEFAULT NULL,\n  `maintainer_id` int(11) NOT NULL,\n  `equipment_id` int(11) NOT NULL,\n  PRIMARY KEY (`record_id`),\n  CONSTRAINT `maintenance_record_ibfk_1` FOREIGN KEY (`maintainer_id`) REFERENCES `maintainer` (`maintainer_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `maintenance_record_ibfk_2` FOREIGN KEY (`equipment_id`) REFERENCES `equipment` (`equipment_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
