  "question": "The heating company needs to manage fault occurrences during the heat supply process. Each fault has a description, occurrence date, resolution date, and handler ID. The handler has an ID, name, department, and contact information. Each fault record must be associated with the affected user ID. The user needs to record a name, address, and contact information.",
  "ddl": "-- Schema for database: rschema_0059\nCREATE TABLE `handler` (\n  `handler_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `department` varchar(255) NOT NULL,\n  `contact_info` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`handler_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `user` (\n  `user_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `address` varchar(255) DEFAULT NULL,\n  `contact_info` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`user_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `fault` (\n  `fault_id` int(11) NOT NULL AUTO_INCREMENT,\n  `description` text DEFAULT NULL,\n  `occurrence_date` datetime NOT NULL,\n  `resolution_date` datetime DEFAULT NULL,\n  `handler_id` int(11) NOT NULL,\n  `user_id` int(11) NOT NULL,\n  PRIMARY KEY (`fault_id`),\n  CONSTRAINT `fault_ibfk_1` FOREIGN KEY (`handler_id`) REFERENCES `handler` (`handler_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `fault_ibfk_2` FOREIGN KEY (`user_id`) REFERENCES `user` (`user_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
