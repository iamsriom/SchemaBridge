  "question": "Research institutions conduct multiple scientific projects, each involving multiple researchers, with each researcher participating in only one project.\n  Each project has a project ID, name, start date, end date, project leader, and budget. Researchers have an employee number, name, date of birth, gender, phone number, and position.\n  Each project's research results must be recorded with a result ID, name, publication date, and researcher (1 person).\n  The usage of project funds needs to be recorded with a fund ID, project ID, purpose, amount, and usage date.",
  "ddl": "-- Schema for database: rschema_0060\n\nCREATE TABLE `project` (\n  `project_id` int(11) NOT NULL AUTO_INCREMENT,\n  `project_name` varchar(255) NOT NULL,\n  `start_date` datetime NOT NULL,\n  `end_date` datetime DEFAULT NULL,\n  `project_leader` int(11) NOT NULL,\n  `budget` decimal(15,2) NOT NULL,\n  PRIMARY KEY (`project_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `researcher` (\n  `employee_number` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `date_of_birth` datetime NOT NULL,\n  `gender` char(1) NOT NULL,\n  `phone_number` varchar(20) DEFAULT NULL,\n  `position` varchar(100) NOT NULL,\n  `project_id` int(11) NOT NULL,\n  PRIMARY KEY (`employee_number`),\n  CONSTRAINT `researcher_ibfk_1` FOREIGN KEY (`project_id`) REFERENCES `project` (`project_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nALTER TABLE `project` ADD CONSTRAINT `project_ibfk_1` FOREIGN KEY (`project_leader`) REFERENCES `researcher` (`employee_number`) ON DELETE CASCADE ON UPDATE CASCADE;\n\nCREATE TABLE `research_result` (\n  `result_id` int(11) NOT NULL AUTO_INCREMENT,\n  `result_name` varchar(255) NOT NULL,\n  `publication_date` datetime NOT NULL,\n  `researcher_id` int(11) NOT NULL,\n  `project_id` int(11) NOT NULL,\n  PRIMARY KEY (`result_id`),\n  CONSTRAINT `research_result_ibfk_1` FOREIGN KEY (`researcher_id`) REFERENCES `researcher` (`employee_number`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `research_result_ibfk_2` FOREIGN KEY (`project_id`) REFERENCES `project` (`project_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `fund_usage` (\n  `fund_id` int(11) NOT NULL AUTO_INCREMENT,\n  `project_id` int(11) NOT NULL,\n  `purpose` varchar(255) NOT NULL,\n  `amount` decimal(15,2) NOT NULL,\n  `usage_date` datetime NOT NULL,\n  PRIMARY KEY (`fund_id`),\n  CONSTRAINT `fund_usage_ibfk_1` FOREIGN KEY (`project_id`) REFERENCES `project` (`project_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
