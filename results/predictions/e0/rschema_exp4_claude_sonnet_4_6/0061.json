  "question": "The patent management department manages multiple patents, and each patent is applied for by multiple inventors. A patent has a patent number, name, application date, and status. An inventor has a work number, name, date of birth, gender, telephone number, and position. Patent application records need to record application number, patent number, inventor, and application date.",
  "ddl": "-- Schema for database: rschema_0061\nCREATE TABLE `patent` (\n  `patent_number` varchar(50) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `application_date` datetime NOT NULL,\n  `status` varchar(50) NOT NULL,\n  PRIMARY KEY (`patent_number`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `inventor` (\n  `work_number` varchar(50) NOT NULL,\n  `name` varchar(100) NOT NULL,\n  `date_of_birth` datetime NOT NULL,\n  `gender` char(6) NOT NULL,\n  `telephone_number` varchar(20) NOT NULL,\n  `position` varchar(100) NOT NULL,\n  PRIMARY KEY (`work_number`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `patent_application` (\n  `application_number` varchar(50) NOT NULL,\n  `patent_number` varchar(50) NOT NULL,\n  `work_number` varchar(50) NOT NULL,\n  `application_date` datetime NOT NULL,\n  PRIMARY KEY (`application_number`),\n  CONSTRAINT `patent_application_ibfk_1` FOREIGN KEY (`patent_number`) REFERENCES `patent` (`patent_number`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `patent_application_ibfk_2` FOREIGN KEY (`work_number`) REFERENCES `inventor` (`work_number`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
