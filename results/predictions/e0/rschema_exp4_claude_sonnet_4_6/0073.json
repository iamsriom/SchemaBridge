  "question": "The insurance company has multiple insurance agents, each with a unique Agent ID, Name, Hire Date, and Contact Phone Number. An agent can handle insurance business for multiple customers. Each customer has a Customer ID, Name, ID Card Number, and Contact Phone Number. Each insurance policy has a unique Policy Number, Insurance Type (Life, Health, Property), Insured Amount, Insurance Term, and Premium. Each premium payment requires recording the Payment Amount, Payment Time, and Payment Method. In addition, the insurance company needs to keep track of each customer's Claim Records.",
  "ddl": "-- Schema for database: rschema_0073\n\nCREATE TABLE `agents` (\n  `agent_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `hire_date` datetime NOT NULL,\n  `contact_phone` varchar(20) NOT NULL,\n  PRIMARY KEY (`agent_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `customers` (\n  `customer_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `id_card_number` varchar(50) NOT NULL,\n  `contact_phone` varchar(20) NOT NULL,\n  `agent_id` int(11) NOT NULL,\n  PRIMARY KEY (`customer_id`),\n  CONSTRAINT `customers_ibfk_1` FOREIGN KEY (`agent_id`) REFERENCES `agents` (`agent_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `policies` (\n  `policy_number` varchar(50) NOT NULL,\n  `insurance_type` varchar(20) NOT NULL,\n  `insured_amount` decimal(15,2) NOT NULL,\n  `insurance_term` int(11) NOT NULL,\n  `premium` decimal(15,2) NOT NULL,\n  `customer_id` int(11) NOT NULL,\n  PRIMARY KEY (`policy_number`),\n  CONSTRAINT `policies_ibfk_1` FOREIGN KEY (`customer_id`) REFERENCES `customers` (`customer_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `premium_payments` (\n  `payment_id` int(11) NOT NULL AUTO_INCREMENT,\n  `policy_number` varchar(50) NOT NULL,\n  `payment_amount` decimal(15,2) NOT NULL,\n  `payment_time` datetime NOT NULL,\n  `payment_method` varchar(50) NOT NULL,\n  PRIMARY KEY (`payment_id`),\n  CONSTRAINT `premium_payments_ibfk_1` FOREIGN KEY (`policy_number`) REFERENCES `policies` (`policy_number`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `claim_records` (\n  `claim_id` int(11) NOT NULL AUTO_INCREMENT,\n  `customer_id` int(11) NOT NULL,\n  `policy_number` varchar(50) NOT NULL,\n  `claim_date` datetime NOT NULL,\n  `claim_amount` decimal(15,2) NOT NULL,\n  `claim_reason` varchar(500) DEFAULT NULL,\n  `claim_status` varchar(50) NOT NULL,\n  PRIMARY KEY (`claim_id`),\n  CONSTRAINT `claim_records_ibfk_1` FOREIGN KEY (`customer_id`) REFERENCES `customers` (`customer_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `claim_records_ibfk_2` FOREIGN KEY (`policy_number`) REFERENCES `policies` (`policy_number`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
