  "database": "rschema_0084",
  "question": "The land project management system shall meet the following business requirements:\n\nThe land management department manages multiple land parcels. Each land parcel has a Land ID, Land Location, and Total Land Area. \n\nThe department manages multiple projects. Each project has a Project ID, Project Name, Project Location, Purpose, and Person in Charge.\n\nEach land usage record shall capture the relationship between the land and project, including Used Land Area, Usage Duration, Current Status, Record Time, and Recording Personnel. \n\nBy recording the usage of land by projects, the system shall ensure reasonable allocation and effective management of land resources. \n\nA project can use multiple land parcels, and a land parcel can be used by multiple projects successively over time.",
  "ddl": "-- Schema for database: rschema_0084\n\nCREATE TABLE `land_parcel` (\n  `land_id` int(11) NOT NULL AUTO_INCREMENT,\n  `land_location` varchar(255) NOT NULL,\n  `total_land_area` decimal(15,2) NOT NULL,\n  PRIMARY KEY (`land_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `project` (\n  `project_id` int(11) NOT NULL AUTO_INCREMENT,\n  `project_name` varchar(255) NOT NULL,\n  `project_location` varchar(255) NOT NULL,\n  `purpose` varchar(500) DEFAULT NULL,\n  `person_in_charge` varchar(100) NOT NULL,\n  PRIMARY KEY (`project_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `land_usage_record` (\n  `record_id` int(11) NOT NULL AUTO_INCREMENT,\n  `land_id` int(11) NOT NULL,\n  `project_id` int(11) NOT NULL,\n  `used_land_area` decimal(15,2) NOT NULL,\n  `usage_duration` varchar(100) DEFAULT NULL,\n  `current_status` varchar(50) DEFAULT NULL,\n  `record_time` datetime NOT NULL,\n  `recording_personnel` varchar(100) NOT NULL,\n  PRIMARY KEY (`record_id`),\n  CONSTRAINT `land_usage_record_ibfk_1` FOREIGN KEY (`land_id`) REFERENCES `land_parcel` (`land_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `land_usage_record_ibfk_2` FOREIGN KEY (`project_id`) REFERENCES `project` (`project_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
