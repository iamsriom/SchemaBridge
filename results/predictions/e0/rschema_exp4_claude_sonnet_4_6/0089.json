  "question": "Design a database for a blockchain or cryptocurrency system to store and manage transactions, blocks, and account information.\nThe system shall record detailed information about transactions, including transaction hash, timestamp, fee, input address, and output address;     \ninformation about blocks, including block hash, height, timestamp, previous block hash, and Merkle root;\nas well as account addresses and balances.\nThe system shall support querying the block a transaction belongs to, as well as the relationship between transactions and accounts.",
  "ddl": "-- Schema for database: rschema_0089\n\nCREATE TABLE `account` (\n  `account_id` int(11) NOT NULL AUTO_INCREMENT,\n  `address` varchar(255) NOT NULL,\n  `balance` decimal(20,8) NOT NULL DEFAULT '0.00000000',\n  `created_at` datetime NOT NULL,\n  `updated_at` datetime DEFAULT NULL,\n  PRIMARY KEY (`account_id`),\n  UNIQUE KEY `address` (`address`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `block` (\n  `block_id` int(11) NOT NULL AUTO_INCREMENT,\n  `block_hash` varchar(255) NOT NULL,\n  `height` int(11) NOT NULL,\n  `timestamp` datetime NOT NULL,\n  `previous_block_hash` varchar(255) DEFAULT NULL,\n  `merkle_root` varchar(255) NOT NULL,\n  `created_at` datetime NOT NULL,\n  PRIMARY KEY (`block_id`),\n  UNIQUE KEY `block_hash` (`block_hash`),\n  UNIQUE KEY `height` (`height`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `transaction` (\n  `transaction_id` int(11) NOT NULL AUTO_INCREMENT,\n  `block_id` int(11) DEFAULT NULL,\n  `tx_hash` varchar(255) NOT NULL,\n  `timestamp` datetime NOT NULL,\n  `fee` decimal(20,8) NOT NULL DEFAULT '0.00000000',\n  `input_address` varchar(255) NOT NULL,\n  `output_address` varchar(255) NOT NULL,\n  `amount` decimal(20,8) NOT NULL DEFAULT '0.00000000',\n  `status` varchar(50) NOT NULL DEFAULT 'pending',\n  `created_at` datetime NOT NULL,\n  PRIMARY KEY (`transaction_id`),\n  UNIQUE KEY `tx_hash` (`tx_hash`),\n  KEY `block_id` (`block_id`),\n  KEY `input_address` (`input_address`),\n  KEY `output_address` (`output_address`),\n  CONSTRAINT `transaction_ibfk_1` FOREIGN KEY (`block_id`) REFERENCES `block` (`block_id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `transaction_account` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `transaction_id` int(11) NOT NULL,\n  `account_id` int(11) NOT NULL,\n  `role` varchar(50) NOT NULL COMMENT 'sender or receiver',\n  PRIMARY KEY (`id`),\n  KEY `transaction_id` (`transaction_id`),\n  KEY `account_id` (`account_id`),\n  CONSTRAINT `transaction_account_ibfk_1` FOREIGN KEY (`transaction_id`) REFERENCES `transaction` (`transaction_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `transaction_account_ibfk_2` FOREIGN KEY (`account_id`) REFERENCES `account` (`account_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
