  "question": "Meilong Salon Management System\nThis database is for a salon management system. It records the customer’s name, hair color, and appointment time. Based on the appointment time, customers are assigned to specific hairstylists. The system also records the hairstylist’s name and expertise. Additionally, the service time and service content provided to customers by each hairstylist are recorded.",
  "ddl": "-- Schema for database: rschema_0096\n\nCREATE TABLE `customer` (\n  `customer_id` int(11) NOT NULL AUTO_INCREMENT,\n  `customer_name` varchar(255) NOT NULL,\n  `hair_color` varchar(100) DEFAULT NULL,\n  `appointment_time` datetime NOT NULL,\n  PRIMARY KEY (`customer_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `hairstylist` (\n  `hairstylist_id` int(11) NOT NULL AUTO_INCREMENT,\n  `hairstylist_name` varchar(255) NOT NULL,\n  `expertise` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`hairstylist_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `appointment` (\n  `appointment_id` int(11) NOT NULL AUTO_INCREMENT,\n  `customer_id` int(11) NOT NULL,\n  `hairstylist_id` int(11) NOT NULL,\n  `appointment_time` datetime NOT NULL,\n  PRIMARY KEY (`appointment_id`),\n  CONSTRAINT `appointment_ibfk_1` FOREIGN KEY (`customer_id`) REFERENCES `customer` (`customer_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `appointment_ibfk_2` FOREIGN KEY (`hairstylist_id`) REFERENCES `hairstylist` (`hairstylist_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `service_record` (\n  `service_id` int(11) NOT NULL AUTO_INCREMENT,\n  `appointment_id` int(11) NOT NULL,\n  `service_time` datetime NOT NULL,\n  `service_content` varchar(500) DEFAULT NULL,\n  PRIMARY KEY (`service_id`),\n  CONSTRAINT `service_record_ibfk_1` FOREIGN KEY (`appointment_id`) REFERENCES `appointment` (`appointment_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
