  "question": "The main functions of a store management system may include:\n1. Manage employee information, including employee number, name, gender and performance.\n2. Manage store information, including store number, store name and address.\n3. Manage product information, including product number, product name, specifications and unit price.\n4. Record employee employment information, including employment period and monthly salary.\n5. Record product sales information, including monthly sales volume.",
  "ddl": "-- Schema for database: rschema_0138\n\nCREATE TABLE `employee` (\n  `employee_id` int(11) NOT NULL AUTO_INCREMENT,\n  `employee_number` varchar(50) NOT NULL,\n  `name` varchar(100) NOT NULL,\n  `gender` char(1) NOT NULL,\n  `performance` decimal(10,2) DEFAULT NULL,\n  PRIMARY KEY (`employee_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `store` (\n  `store_id` int(11) NOT NULL AUTO_INCREMENT,\n  `store_number` varchar(50) NOT NULL,\n  `store_name` varchar(100) NOT NULL,\n  `address` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`store_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `product` (\n  `product_id` int(11) NOT NULL AUTO_INCREMENT,\n  `product_number` varchar(50) NOT NULL,\n  `product_name` varchar(100) NOT NULL,\n  `specifications` varchar(255) DEFAULT NULL,\n  `unit_price` decimal(10,2) NOT NULL,\n  PRIMARY KEY (`product_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `employment` (\n  `employment_id` int(11) NOT NULL AUTO_INCREMENT,\n  `employee_id` int(11) NOT NULL,\n  `store_id` int(11) NOT NULL,\n  `start_date` datetime NOT NULL,\n  `end_date` datetime DEFAULT NULL,\n  `monthly_salary` decimal(10,2) NOT NULL,\n  PRIMARY KEY (`employment_id`),\n  CONSTRAINT `employment_ibfk_1` FOREIGN KEY (`employee_id`) REFERENCES `employee` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `employment_ibfk_2` FOREIGN KEY (`store_id`) REFERENCES `store` (`store_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `product_sales` (\n  `sales_id` int(11) NOT NULL AUTO_INCREMENT,\n  `product_id` int(11) NOT NULL,\n  `store_id` int(11) NOT NULL,\n  `sale_year` int(11) NOT NULL,\n  `sale_month` int(11) NOT NULL,\n  `monthly_sales_volume` int(11) NOT NULL DEFAULT 0,\n  PRIMARY KEY (`sales_id`),\n  CONSTRAINT `product_sales_ibfk_1` FOREIGN KEY (`product_id`) REFERENCES `product` (`product_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `product_sales_ibfk_2` FOREIGN KEY (`store_id`) REFERENCES `store` (`store_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
