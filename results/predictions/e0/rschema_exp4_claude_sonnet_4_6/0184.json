  "question": "The hotel has a membership system, and members can enjoy discounts and points. Each member has a membership number, name, phone number, registration date, and points. Members can book rooms, and each booking records member information, room information, booking status, and point changes.",
  "ddl": "-- Schema for database: rschema_0184\n\nCREATE TABLE `member` (\n  `membership_number` varchar(20) NOT NULL,\n  `name` varchar(100) NOT NULL,\n  `phone_number` varchar(20) NOT NULL,\n  `registration_date` datetime NOT NULL,\n  `points` int(11) NOT NULL DEFAULT '0',\n  PRIMARY KEY (`membership_number`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `room` (\n  `room_id` int(11) NOT NULL AUTO_INCREMENT,\n  `room_number` varchar(20) NOT NULL,\n  `room_type` varchar(50) NOT NULL,\n  `price_per_night` decimal(10,2) NOT NULL,\n  `discount_rate` decimal(5,2) DEFAULT NULL,\n  `description` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`room_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `booking` (\n  `booking_id` int(11) NOT NULL AUTO_INCREMENT,\n  `membership_number` varchar(20) NOT NULL,\n  `room_id` int(11) NOT NULL,\n  `check_in_date` datetime NOT NULL,\n  `check_out_date` datetime NOT NULL,\n  `booking_status` varchar(50) NOT NULL DEFAULT 'pending',\n  `total_amount` decimal(10,2) NOT NULL,\n  `discount_applied` decimal(10,2) DEFAULT NULL,\n  `points_earned` int(11) NOT NULL DEFAULT '0',\n  `points_redeemed` int(11) NOT NULL DEFAULT '0',\n  `created_at` datetime NOT NULL,\n  PRIMARY KEY (`booking_id`),\n  CONSTRAINT `booking_ibfk_1` FOREIGN KEY (`membership_number`) REFERENCES `member` (`membership_number`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `booking_ibfk_2` FOREIGN KEY (`room_id`) REFERENCES `room` (`room_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
