  "question": "A sports event management company requires the development of a system to manage event, team, and referee information. The system will encompass basic event information such as event name, type, and start and end dates, team information such as team name, head coach name, and associated event, and referee information such as referee name and contact details. The system must support recording referee information for each event and associating referees with events to ensure that the arrangement of referees for each activity in the event is reasonable and transparent.",
  "ddl": "-- Schema for database: rschema_0204\n\nCREATE TABLE `event` (\n  `event_id` int(11) NOT NULL AUTO_INCREMENT,\n  `event_name` varchar(255) NOT NULL,\n  `event_type` varchar(100) NOT NULL,\n  `start_date` datetime NOT NULL,\n  `end_date` datetime NOT NULL,\n  PRIMARY KEY (`event_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `team` (\n  `team_id` int(11) NOT NULL AUTO_INCREMENT,\n  `team_name` varchar(255) NOT NULL,\n  `head_coach_name` varchar(255) NOT NULL,\n  `event_id` int(11) NOT NULL,\n  PRIMARY KEY (`team_id`),\n  CONSTRAINT `team_ibfk_1` FOREIGN KEY (`event_id`) REFERENCES `event` (`event_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `referee` (\n  `referee_id` int(11) NOT NULL AUTO_INCREMENT,\n  `referee_name` varchar(255) NOT NULL,\n  `contact_details` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`referee_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `event_referee` (\n  `event_referee_id` int(11) NOT NULL AUTO_INCREMENT,\n  `event_id` int(11) NOT NULL,\n  `referee_id` int(11) NOT NULL,\n  `activity_description` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`event_referee_id`),\n  CONSTRAINT `event_referee_ibfk_1` FOREIGN KEY (`event_id`) REFERENCES `event` (`event_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `event_referee_ibfk_2` FOREIGN KEY (`referee_id`) REFERENCES `referee` (`referee_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
