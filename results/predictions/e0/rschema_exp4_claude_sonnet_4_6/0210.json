  "question": "The system shall record basic information of attendees, including name, gender, organization, and position. Attendee information helps with post-conference statistical analysis, allowing conference organizers to understand the composition of participants and facilitate subsequent contact and arrangements.\n\nAttendance management:\nThe system shall track each attendee's participation and record the conferences they attend. This ensures that each attendee's attendance information is accurate and facilitates conference management and follow-up.\n\nPresentation management:\nThe system shall support recording each speaker's presentation schedule at the conference, including the topic, time, and location of the presentation. Detailed information for each presentation is recorded to track the progress of each presentation and ensure the smooth running of the conference proceedings.\n\nThe system provides comprehensive conference data management functions, from conference organization and attendee information management to presentation scheduling and tracking, efficiently supporting the organization and execution of conferences.",
  "ddl": "-- Schema for database: rschema_0210\n\nCREATE TABLE `attendee` (\n  `attendee_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `gender` varchar(50) DEFAULT NULL,\n  `organization` varchar(255) DEFAULT NULL,\n  `position` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`attendee_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `conference` (\n  `conference_id` int(11) NOT NULL AUTO_INCREMENT,\n  `conference_name` varchar(255) NOT NULL,\n  `start_date` datetime DEFAULT NULL,\n  `end_date` datetime DEFAULT NULL,\n  `location` varchar(255) DEFAULT NULL,\n  `organizer` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`conference_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `attendance` (\n  `attendance_id` int(11) NOT NULL AUTO_INCREMENT,\n  `attendee_id` int(11) NOT NULL,\n  `conference_id` int(11) NOT NULL,\n  `check_in_time` datetime DEFAULT NULL,\n  `check_out_time` datetime DEFAULT NULL,\n  PRIMARY KEY (`attendance_id`),\n  CONSTRAINT `attendance_ibfk_1` FOREIGN KEY (`attendee_id`) REFERENCES `attendee` (`attendee_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `attendance_ibfk_2` FOREIGN KEY (`conference_id`) REFERENCES `conference` (`conference_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `presentation` (\n  `presentation_id` int(11) NOT NULL AUTO_INCREMENT,\n  `conference_id` int(11) NOT NULL,\n  `speaker_id` int(11) NOT NULL,\n  `topic` varchar(255) NOT NULL,\n  `start_time` datetime DEFAULT NULL,\n  `end_time` datetime DEFAULT NULL,\n  `venue` varchar(255) DEFAULT NULL,\n  `status` varchar(100) DEFAULT NULL,\n  PRIMARY KEY (`presentation_id`),\n  CONSTRAINT `presentation_ibfk_1` FOREIGN KEY (`conference_id`) REFERENCES `conference` (`conference_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `presentation_ibfk_2` FOREIGN KEY (`speaker_id`) REFERENCES `attendee` (`attendee_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
