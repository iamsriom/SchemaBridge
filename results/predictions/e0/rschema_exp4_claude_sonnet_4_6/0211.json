  "question": "Consulting Service System Business Requirement Description:\nThe Technical Consulting Department provides multiple technical consulting service projects, each of which involves multiple consultants. Consulting service projects have a Project ID, Name, Start Date, End Date, and Client Name. Consultants have a Consultant ID, Name, Date of Birth, Gender, Phone Number, and Professional Field. Consulting service records need to record the Service ID, Project ID, Consultant ID, Service Date, and Service Content.",
  "ddl": "-- Schema for database: rschema_0211\n\nCREATE TABLE `project` (\n  `project_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `start_date` datetime NOT NULL,\n  `end_date` datetime DEFAULT NULL,\n  `client_name` varchar(255) NOT NULL,\n  PRIMARY KEY (`project_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `consultant` (\n  `consultant_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `date_of_birth` datetime DEFAULT NULL,\n  `gender` char(6) DEFAULT NULL,\n  `phone_number` varchar(20) DEFAULT NULL,\n  `professional_field` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`consultant_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `consulting_service_record` (\n  `service_id` int(11) NOT NULL,\n  `project_id` int(11) NOT NULL,\n  `consultant_id` int(11) NOT NULL,\n  `service_date` datetime NOT NULL,\n  `service_content` varchar(1000) DEFAULT NULL,\n  PRIMARY KEY (`service_id`),\n  CONSTRAINT `consulting_service_record_ibfk_1` FOREIGN KEY (`project_id`) REFERENCES `project` (`project_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `consulting_service_record_ibfk_2` FOREIGN KEY (`consultant_id`) REFERENCES `consultant` (`consultant_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
