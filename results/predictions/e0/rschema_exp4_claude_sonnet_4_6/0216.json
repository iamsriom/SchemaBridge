  "question": "The Credit Card Management System for a credit card company requires managing various types of credit cards and associated transactions:\nThe company issues multiple types of credit cards, each with a unique Card Type Code, Card Type Name, and Annual Fee.\nThe company has several customers, each identified by a unique Customer ID, Name, ID Number, and Contact Number. Each customer can have multiple credit cards.\nEach credit card has a unique Card Number, Card Type Code, Account Opening Date, and Credit Limit. A customer may have several credit cards.\nEvery transaction made using a credit card must record the Amount, Transaction Time, Transaction Location, and Transaction Type.\nThe system also tracks repayments made by customers, including the Repayment Amount and Repayment Time.",
  "ddl": "-- Schema for database: rschema_0216\n\nCREATE TABLE `card_type` (\n  `card_type_code` varchar(20) NOT NULL,\n  `card_type_name` varchar(100) NOT NULL,\n  `annual_fee` decimal(10,2) NOT NULL,\n  PRIMARY KEY (`card_type_code`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `customer` (\n  `customer_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(100) NOT NULL,\n  `id_number` varchar(50) NOT NULL,\n  `contact_number` varchar(20) NOT NULL,\n  PRIMARY KEY (`customer_id`),\n  UNIQUE KEY `id_number` (`id_number`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `credit_card` (\n  `card_number` varchar(20) NOT NULL,\n  `card_type_code` varchar(20) NOT NULL,\n  `customer_id` int(11) NOT NULL,\n  `account_opening_date` datetime NOT NULL,\n  `credit_limit` decimal(15,2) NOT NULL,\n  PRIMARY KEY (`card_number`),\n  CONSTRAINT `credit_card_ibfk_1` FOREIGN KEY (`card_type_code`) REFERENCES `card_type` (`card_type_code`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `credit_card_ibfk_2` FOREIGN KEY (`customer_id`) REFERENCES `customer` (`customer_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `transaction` (\n  `transaction_id` int(11) NOT NULL AUTO_INCREMENT,\n  `card_number` varchar(20) NOT NULL,\n  `amount` decimal(15,2) NOT NULL,\n  `transaction_time` datetime NOT NULL,\n  `transaction_location` varchar(255) NOT NULL,\n  `transaction_type` varchar(50) NOT NULL,\n  PRIMARY KEY (`transaction_id`),\n  CONSTRAINT `transaction_ibfk_1` FOREIGN KEY (`card_number`) REFERENCES `credit_card` (`card_number`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `repayment` (\n  `repayment_id` int(11) NOT NULL AUTO_INCREMENT,\n  `customer_id` int(11) NOT NULL,\n  `card_number` varchar(20) NOT NULL,\n  `repayment_amount` decimal(15,2) NOT NULL,\n  `repayment_time` datetime NOT NULL,\n  PRIMARY KEY (`repayment_id`),\n  CONSTRAINT `repayment_ibfk_1` FOREIGN KEY (`customer_id`) REFERENCES `customer` (`customer_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `repayment_ibfk_2` FOREIGN KEY (`card_number`) REFERENCES `credit_card` (`card_number`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
