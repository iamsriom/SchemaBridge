  "database": "rschema_0266",
  "question": "The pipeline company manages multiple pipelines, each identified by a pipeline ID, starting point, ending point, length, and diameter. The company employs multiple maintenance personnel, and each maintenance task must record the pipeline ID, maintenance personnel, maintenance details, and maintenance time. The system shall support real-time monitoring of pipeline maintenance tasks and performance evaluation.",
  "ddl": "-- Schema for database: rschema_0266\n\nCREATE TABLE `pipeline` (\n  `pipeline_id` int(11) NOT NULL AUTO_INCREMENT,\n  `starting_point` varchar(255) NOT NULL,\n  `ending_point` varchar(255) NOT NULL,\n  `length` decimal(10,2) NOT NULL,\n  `diameter` decimal(10,2) NOT NULL,\n  PRIMARY KEY (`pipeline_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `maintenance_personnel` (\n  `personnel_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `contact` varchar(100) DEFAULT NULL,\n  `department` varchar(255) DEFAULT NULL,\n  `position` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`personnel_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `maintenance_task` (\n  `task_id` int(11) NOT NULL AUTO_INCREMENT,\n  `pipeline_id` int(11) NOT NULL,\n  `personnel_id` int(11) NOT NULL,\n  `maintenance_details` text NOT NULL,\n  `maintenance_time` datetime NOT NULL,\n  `status` varchar(50) DEFAULT NULL,\n  `created_at` datetime DEFAULT NULL,\n  PRIMARY KEY (`task_id`),\n  CONSTRAINT `maintenance_task_ibfk_1` FOREIGN KEY (`pipeline_id`) REFERENCES `pipeline` (`pipeline_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `maintenance_task_ibfk_2` FOREIGN KEY (`personnel_id`) REFERENCES `maintenance_personnel` (`personnel_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `performance_evaluation` (\n  `evaluation_id` int(11) NOT NULL AUTO_INCREMENT,\n  `personnel_id` int(11) NOT NULL,\n  `task_id` int(11) NOT NULL,\n  `score` decimal(5,2) DEFAULT NULL,\n  `comments` text DEFAULT NULL,\n  `evaluation_time` datetime NOT NULL,\n  PRIMARY KEY (`evaluation_id`),\n  CONSTRAINT `performance_evaluation_ibfk_1` FOREIGN KEY (`personnel_id`) REFERENCES `maintenance_personnel` (`personnel_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `performance_evaluation_ibfk_2` FOREIGN KEY (`task_id`) REFERENCES `maintenance_task` (`task_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `monitoring_record` (\n  `record_id` int(11) NOT NULL AUTO_INCREMENT,\n  `task_id` int(11) NOT NULL,\n  `monitor_time` datetime NOT NULL,\n  `status` varchar(100) DEFAULT NULL,\n  `remarks` text DEFAULT NULL,\n  PRIMARY KEY (`record_id`),\n  CONSTRAINT `monitoring_record_ibfk_1` FOREIGN KEY (`task_id`) REFERENCES `maintenance_task` (`task_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
