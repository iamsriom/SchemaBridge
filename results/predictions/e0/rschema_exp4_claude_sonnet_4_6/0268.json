  "question": "The hotel has multiple restaurants, each with a name, location, and operating hours. The restaurants offer various dishes, each with a name, price, and category. Customers can make table reservations at the restaurants. Each reservation records the customer information, restaurant information, reservation time, and number of diners.",
  "ddl": "-- Schema for database: rschema_0268\n\nCREATE TABLE `restaurant` (\n  `restaurant_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `location` varchar(255) NOT NULL,\n  `opening_time` time NOT NULL,\n  `closing_time` time NOT NULL,\n  PRIMARY KEY (`restaurant_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `dish` (\n  `dish_id` int(11) NOT NULL AUTO_INCREMENT,\n  `restaurant_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `price` decimal(10,2) NOT NULL,\n  `category` varchar(100) NOT NULL,\n  PRIMARY KEY (`dish_id`),\n  CONSTRAINT `dish_ibfk_1` FOREIGN KEY (`restaurant_id`) REFERENCES `restaurant` (`restaurant_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `customer` (\n  `customer_id` int(11) NOT NULL AUTO_INCREMENT,\n  `first_name` varchar(100) NOT NULL,\n  `last_name` varchar(100) NOT NULL,\n  `email` varchar(255) DEFAULT NULL,\n  `phone` varchar(20) DEFAULT NULL,\n  PRIMARY KEY (`customer_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `reservation` (\n  `reservation_id` int(11) NOT NULL AUTO_INCREMENT,\n  `customer_id` int(11) NOT NULL,\n  `restaurant_id` int(11) NOT NULL,\n  `reservation_time` datetime NOT NULL,\n  `number_of_diners` int(11) NOT NULL,\n  PRIMARY KEY (`reservation_id`),\n  CONSTRAINT `reservation_ibfk_1` FOREIGN KEY (`customer_id`) REFERENCES `customer` (`customer_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `reservation_ibfk_2` FOREIGN KEY (`restaurant_id`) REFERENCES `restaurant` (`restaurant_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
