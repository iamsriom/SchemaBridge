  "question": "Agricultural Ecosystem Monitoring System requires recording monitoring data for multiple ecosystems. Each ecosystem has a System ID, Name, Location, Type (such as \"Forest\", \"Wetland\", etc.), and Current Status (such as \"Healthy\", \"Degraded\", etc.). Each monitoring record includes System ID, Monitoring Date, Temperature, Humidity, Soil Moisture, Plant Growth, and Operator. Each operator has an Employee ID, Name, Gender, Contact Information, and Position.",
  "ddl": "-- Schema for database: rschema_0275\n\nCREATE TABLE `ecosystem` (\n  `system_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `location` varchar(255) NOT NULL,\n  `type` varchar(100) NOT NULL,\n  `current_status` varchar(100) NOT NULL,\n  PRIMARY KEY (`system_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `operator` (\n  `employee_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `gender` varchar(10) NOT NULL,\n  `contact_information` varchar(255) DEFAULT NULL,\n  `position` varchar(100) NOT NULL,\n  PRIMARY KEY (`employee_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `monitoring_record` (\n  `record_id` int(11) NOT NULL AUTO_INCREMENT,\n  `system_id` int(11) NOT NULL,\n  `monitoring_date` datetime NOT NULL,\n  `temperature` decimal(5,2) DEFAULT NULL,\n  `humidity` decimal(5,2) DEFAULT NULL,\n  `soil_moisture` decimal(5,2) DEFAULT NULL,\n  `plant_growth` decimal(5,2) DEFAULT NULL,\n  `employee_id` int(11) NOT NULL,\n  PRIMARY KEY (`record_id`),\n  CONSTRAINT `monitoring_record_ibfk_1` FOREIGN KEY (`system_id`) REFERENCES `ecosystem` (`system_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `monitoring_record_ibfk_2` FOREIGN KEY (`employee_id`) REFERENCES `operator` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
