  "question": "This is a Construction Company Safety Inspection Management System. For project basic information management, the system records information such as project ID, project name, project manager, construction start date, expected completion date, actual completion date, project budget, and project location. For safety inspection records, the system maintains information including inspection ID, project ID, inspection date, inspection content, inspection results, and inspector. For projects with unsatisfactory inspection results, the system conducts tracking management, recording information such as tracking record ID, project ID, tracking date, tracking content, and tracking results.",
  "ddl": "-- Schema for database: rschema_0278\n\nCREATE TABLE `project` (\n  `project_id` int(11) NOT NULL AUTO_INCREMENT,\n  `project_name` varchar(255) NOT NULL,\n  `project_manager` varchar(100) NOT NULL,\n  `construction_start_date` date NOT NULL,\n  `expected_completion_date` date NOT NULL,\n  `actual_completion_date` date DEFAULT NULL,\n  `project_budget` decimal(15,2) NOT NULL,\n  `project_location` varchar(500) NOT NULL,\n  PRIMARY KEY (`project_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `safety_inspection` (\n  `inspection_id` int(11) NOT NULL AUTO_INCREMENT,\n  `project_id` int(11) NOT NULL,\n  `inspection_date` date NOT NULL,\n  `inspection_content` text NOT NULL,\n  `inspection_result` varchar(255) NOT NULL,\n  `inspector` varchar(100) NOT NULL,\n  PRIMARY KEY (`inspection_id`),\n  CONSTRAINT `safety_inspection_ibfk_1` FOREIGN KEY (`project_id`) REFERENCES `project` (`project_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `tracking_record` (\n  `tracking_record_id` int(11) NOT NULL AUTO_INCREMENT,\n  `project_id` int(11) NOT NULL,\n  `tracking_date` date NOT NULL,\n  `tracking_content` text NOT NULL,\n  `tracking_result` varchar(255) NOT NULL,\n  PRIMARY KEY (`tracking_record_id`),\n  CONSTRAINT `tracking_record_ibfk_1` FOREIGN KEY (`project_id`) REFERENCES `project` (`project_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
