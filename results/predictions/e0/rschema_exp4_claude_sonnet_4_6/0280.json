  "question": "The movie production company needs to manage multiple movie projects, and each project has multiple directors, actors, and producers. The system needs to record each project's name, type, budget, filming time, and relevant personnel information, including name, email, and phone number.",
  "ddl": "-- Schema for database: rschema_0280\n\nCREATE TABLE `project` (\n  `project_id` int(11) NOT NULL AUTO_INCREMENT,\n  `project_name` varchar(255) NOT NULL,\n  `project_type` varchar(100) NOT NULL,\n  `budget` decimal(15,2) DEFAULT NULL,\n  `filming_start_date` datetime DEFAULT NULL,\n  `filming_end_date` datetime DEFAULT NULL,\n  PRIMARY KEY (`project_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `director` (\n  `director_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `email` varchar(255) DEFAULT NULL,\n  `phone` varchar(50) DEFAULT NULL,\n  PRIMARY KEY (`director_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `actor` (\n  `actor_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `email` varchar(255) DEFAULT NULL,\n  `phone` varchar(50) DEFAULT NULL,\n  PRIMARY KEY (`actor_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `producer` (\n  `producer_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `email` varchar(255) DEFAULT NULL,\n  `phone` varchar(50) DEFAULT NULL,\n  PRIMARY KEY (`producer_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `project_director` (\n  `project_id` int(11) NOT NULL,\n  `director_id` int(11) NOT NULL,\n  PRIMARY KEY (`project_id`, `director_id`),\n  CONSTRAINT `project_director_ibfk_1` FOREIGN KEY (`project_id`) REFERENCES `project` (`project_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `project_director_ibfk_2` FOREIGN KEY (`director_id`) REFERENCES `director` (`director_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `project_actor` (\n  `project_id` int(11) NOT NULL,\n  `actor_id` int(11) NOT NULL,\n  `role` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`project_id`, `actor_id`),\n  CONSTRAINT `project_actor_ibfk_1` FOREIGN KEY (`project_id`) REFERENCES `project` (`project_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `project_actor_ibfk_2` FOREIGN KEY (`actor_id`) REFERENCES `actor` (`actor_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `project_producer` (\n  `project_id` int(11) NOT NULL,\n  `producer_id` int(11) NOT NULL,\n  PRIMARY KEY (`project_id`, `producer_id`),\n  CONSTRAINT `project_producer_ibfk_1` FOREIGN KEY (`project_id`) REFERENCES `project` (`project_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `project_producer_ibfk_2` FOREIGN KEY (`producer_id`) REFERENCES `producer` (`producer_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
