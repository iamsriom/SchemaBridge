  "question": "The Cultural Arts Company needs to manage multiple exhibitions. Each exhibition has multiple curators and exhibits. The system needs to record the name, location, start time, and end time of each exhibition, as well as the information of curators and exhibits.",
  "ddl": "-- Schema for database: rschema_0281\n\nCREATE TABLE `exhibition` (\n  `exhibition_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `location` varchar(255) NOT NULL,\n  `start_time` datetime NOT NULL,\n  `end_time` datetime NOT NULL,\n  PRIMARY KEY (`exhibition_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `curator` (\n  `curator_id` int(11) NOT NULL AUTO_INCREMENT,\n  `exhibition_id` int(11) NOT NULL,\n  `first_name` varchar(100) NOT NULL,\n  `last_name` varchar(100) NOT NULL,\n  `email` varchar(255) DEFAULT NULL,\n  `phone` varchar(50) DEFAULT NULL,\n  `bio` text DEFAULT NULL,\n  PRIMARY KEY (`curator_id`),\n  CONSTRAINT `curator_ibfk_1` FOREIGN KEY (`exhibition_id`) REFERENCES `exhibition` (`exhibition_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `exhibit` (\n  `exhibit_id` int(11) NOT NULL AUTO_INCREMENT,\n  `exhibition_id` int(11) NOT NULL,\n  `title` varchar(255) NOT NULL,\n  `description` text DEFAULT NULL,\n  `artist_name` varchar(255) DEFAULT NULL,\n  `medium` varchar(255) DEFAULT NULL,\n  `year_created` int(11) DEFAULT NULL,\n  PRIMARY KEY (`exhibit_id`),\n  CONSTRAINT `exhibit_ibfk_1` FOREIGN KEY (`exhibition_id`) REFERENCES `exhibition` (`exhibition_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
