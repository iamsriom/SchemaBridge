  "question": "The radio station needs to manage multiple advertisements. Each advertisement has multiple clients and multiple broadcast time slots. The system needs to record the name, content, and broadcast time of each advertisement, as well as the contact information of clients and the arrangement of time slots.",
  "ddl": "-- Schema for database: rschema_0284\n\nCREATE TABLE `advertisement` (\n  `advertisement_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `content` text NOT NULL,\n  `broadcast_time` datetime NOT NULL,\n  `created_at` datetime DEFAULT NULL,\n  `updated_at` datetime DEFAULT NULL,\n  PRIMARY KEY (`advertisement_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `client` (\n  `client_id` int(11) NOT NULL AUTO_INCREMENT,\n  `advertisement_id` int(11) NOT NULL,\n  `client_name` varchar(255) NOT NULL,\n  `email` varchar(255) DEFAULT NULL,\n  `phone` varchar(50) DEFAULT NULL,\n  `address` varchar(500) DEFAULT NULL,\n  `contact_person` varchar(255) DEFAULT NULL,\n  `created_at` datetime DEFAULT NULL,\n  PRIMARY KEY (`client_id`),\n  CONSTRAINT `client_ibfk_1` FOREIGN KEY (`advertisement_id`) REFERENCES `advertisement` (`advertisement_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `time_slot` (\n  `time_slot_id` int(11) NOT NULL AUTO_INCREMENT,\n  `advertisement_id` int(11) NOT NULL,\n  `start_time` datetime NOT NULL,\n  `end_time` datetime NOT NULL,\n  `frequency` varchar(100) DEFAULT NULL,\n  `day_of_week` varchar(50) DEFAULT NULL,\n  `status` varchar(50) DEFAULT NULL,\n  `created_at` datetime DEFAULT NULL,\n  PRIMARY KEY (`time_slot_id`),\n  CONSTRAINT `time_slot_ibfk_1` FOREIGN KEY (`advertisement_id`) REFERENCES `advertisement` (`advertisement_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
