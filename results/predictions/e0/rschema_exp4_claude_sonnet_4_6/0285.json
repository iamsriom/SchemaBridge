  "database": "rschema_0285",
  "question": "The database is an advertising management system, whose main function is to manage the broadcast of advertisements and track the advertising broadcast data of customers. The following is a specific description of the requirements:\nAdvertising management: The system can manage the basic information of multiple advertisements, including the name, content, duration, etc. of the advertisement. Each advertisement can have a different broadcast schedule.\n\nCustomer management: The system can record the basic information of customers, including name, email and contact number.\n\nAdvertising broadcast tracking: The system tracks the detailed information of each advertisement broadcast, including the start time, end time, broadcast duration, ratings, etc. of the advertisement.",
  "ddl": "-- Schema for database: rschema_0285\n\nCREATE TABLE `customer` (\n  `customer_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `email` varchar(255) DEFAULT NULL,\n  `contact_number` varchar(50) DEFAULT NULL,\n  PRIMARY KEY (`customer_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `advertisement` (\n  `ad_id` int(11) NOT NULL AUTO_INCREMENT,\n  `customer_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `content` text DEFAULT NULL,\n  `duration` int(11) DEFAULT NULL,\n  PRIMARY KEY (`ad_id`),\n  CONSTRAINT `advertisement_ibfk_1` FOREIGN KEY (`customer_id`) REFERENCES `customer` (`customer_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `broadcast_schedule` (\n  `schedule_id` int(11) NOT NULL AUTO_INCREMENT,\n  `ad_id` int(11) NOT NULL,\n  `scheduled_start` datetime NOT NULL,\n  `scheduled_end` datetime NOT NULL,\n  `channel` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`schedule_id`),\n  CONSTRAINT `broadcast_schedule_ibfk_1` FOREIGN KEY (`ad_id`) REFERENCES `advertisement` (`ad_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `broadcast_log` (\n  `log_id` int(11) NOT NULL AUTO_INCREMENT,\n  `ad_id` int(11) NOT NULL,\n  `schedule_id` int(11) DEFAULT NULL,\n  `start_time` datetime NOT NULL,\n  `end_time` datetime DEFAULT NULL,\n  `broadcast_duration` int(11) DEFAULT NULL,\n  `ratings` decimal(5,2) DEFAULT NULL,\n  PRIMARY KEY (`log_id`),\n  CONSTRAINT `broadcast_log_ibfk_1` FOREIGN KEY (`ad_id`) REFERENCES `advertisement` (`ad_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `broadcast_log_ibfk_2` FOREIGN KEY (`schedule_id`) REFERENCES `broadcast_schedule` (`schedule_id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
