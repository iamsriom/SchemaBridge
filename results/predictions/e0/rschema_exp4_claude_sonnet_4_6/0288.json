  "question": "Environmental Monitoring System Requirements:\nThe system needs to manage multiple monitoring sites. Each site has a unique ID, name, location, and a responsible person. Each monitoring personnel includes an ID, name, contact details, and the scope of monitoring. Each maintenance personnel includes an ID, name, contact details, and the scope of maintenance. Each monitoring session needs to record the air quality, water quality, noise level, timestamp, monitoring personnel, and the monitoring result for each site.\nThe system also needs to record maintenance activities for each monitoring site, including maintenance time, maintenance content, maintenance personnel, and maintenance cost.",
  "ddl": "-- Schema for database: rschema_0288\n\nCREATE TABLE `monitoring_site` (\n  `site_id` int(11) NOT NULL AUTO_INCREMENT,\n  `site_name` varchar(255) NOT NULL,\n  `location` varchar(255) NOT NULL,\n  `responsible_person` varchar(255) NOT NULL,\n  PRIMARY KEY (`site_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `monitoring_personnel` (\n  `personnel_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `contact_details` varchar(255) NOT NULL,\n  `monitoring_scope` varchar(255) NOT NULL,\n  PRIMARY KEY (`personnel_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `maintenance_personnel` (\n  `personnel_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `contact_details` varchar(255) NOT NULL,\n  `maintenance_scope` varchar(255) NOT NULL,\n  PRIMARY KEY (`personnel_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `monitoring_session` (\n  `session_id` int(11) NOT NULL AUTO_INCREMENT,\n  `site_id` int(11) NOT NULL,\n  `personnel_id` int(11) NOT NULL,\n  `air_quality` varchar(255) NOT NULL,\n  `water_quality` varchar(255) NOT NULL,\n  `noise_level` decimal(10,2) NOT NULL,\n  `session_timestamp` datetime NOT NULL,\n  `monitoring_result` varchar(255) NOT NULL,\n  PRIMARY KEY (`session_id`),\n  CONSTRAINT `monitoring_session_ibfk_1` FOREIGN KEY (`site_id`) REFERENCES `monitoring_site` (`site_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `monitoring_session_ibfk_2` FOREIGN KEY (`personnel_id`) REFERENCES `monitoring_personnel` (`personnel_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `maintenance_activity` (\n  `activity_id` int(11) NOT NULL AUTO_INCREMENT,\n  `site_id` int(11) NOT NULL,\n  `personnel_id` int(11) NOT NULL,\n  `maintenance_time` datetime NOT NULL,\n  `maintenance_content` varchar(255) NOT NULL,\n  `maintenance_cost` decimal(10,2) NOT NULL,\n  PRIMARY KEY (`activity_id`),\n  CONSTRAINT `maintenance_activity_ibfk_1` FOREIGN KEY (`site_id`) REFERENCES `monitoring_site` (`site_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `maintenance_activity_ibfk_2` FOREIGN KEY (`personnel_id`) REFERENCES `maintenance_personnel` (`personnel_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
