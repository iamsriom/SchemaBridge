  "question": "A gas company needs to monitor its production processes. Each production process has a process ID, name, start time, end time, and operator ID. Operators have operator ID, name, department, and contact information. Each monitoring record includes recording time, monitoring parameters, production process ID, and operator ID.",
  "ddl": "-- Schema for database: rschema_0289\n\nCREATE TABLE `operators` (\n  `operator_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `department` varchar(255) NOT NULL,\n  `contact_information` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`operator_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `production_processes` (\n  `process_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `start_time` datetime NOT NULL,\n  `end_time` datetime DEFAULT NULL,\n  `operator_id` int(11) NOT NULL,\n  PRIMARY KEY (`process_id`),\n  CONSTRAINT `production_processes_ibfk_1` FOREIGN KEY (`operator_id`) REFERENCES `operators` (`operator_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `monitoring_records` (\n  `record_id` int(11) NOT NULL AUTO_INCREMENT,\n  `recording_time` datetime NOT NULL,\n  `monitoring_parameters` varchar(255) DEFAULT NULL,\n  `process_id` int(11) NOT NULL,\n  `operator_id` int(11) NOT NULL,\n  PRIMARY KEY (`record_id`),\n  CONSTRAINT `monitoring_records_ibfk_1` FOREIGN KEY (`process_id`) REFERENCES `production_processes` (`process_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `monitoring_records_ibfk_2` FOREIGN KEY (`operator_id`) REFERENCES `operators` (`operator_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
