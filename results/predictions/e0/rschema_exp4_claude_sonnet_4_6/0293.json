  "question": "Business Requirements Description:\nA coal mining company operates several mines, and each mine uses various types of equipment. Equipment has an ID, name, model, purchase date, and other relevant details. Mines have a mine ID, name, location, and person in charge. For each equipment maintenance event, the maintenance date, maintenance content, personnel, and maintenance cost need to be recorded. Maintenance personnel include their ID, name, and contact number. The information system should provide statistical analysis of the usage and maintenance of the equipment.",
  "ddl": "-- Schema for database: rschema_0293\n\nCREATE TABLE `mine` (\n  `mine_id` int(11) NOT NULL AUTO_INCREMENT,\n  `mine_name` varchar(255) NOT NULL,\n  `location` varchar(255) NOT NULL,\n  `person_in_charge` varchar(255) NOT NULL,\n  PRIMARY KEY (`mine_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `maintenance_personnel` (\n  `personnel_id` int(11) NOT NULL AUTO_INCREMENT,\n  `personnel_name` varchar(255) NOT NULL,\n  `contact_number` varchar(50) NOT NULL,\n  PRIMARY KEY (`personnel_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `equipment` (\n  `equipment_id` int(11) NOT NULL AUTO_INCREMENT,\n  `equipment_name` varchar(255) NOT NULL,\n  `model` varchar(255) NOT NULL,\n  `purchase_date` datetime NOT NULL,\n  `mine_id` int(11) NOT NULL,\n  `status` varchar(100) DEFAULT NULL,\n  `description` varchar(500) DEFAULT NULL,\n  PRIMARY KEY (`equipment_id`),\n  CONSTRAINT `equipment_ibfk_1` FOREIGN KEY (`mine_id`) REFERENCES `mine` (`mine_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `maintenance_record` (\n  `maintenance_id` int(11) NOT NULL AUTO_INCREMENT,\n  `equipment_id` int(11) NOT NULL,\n  `maintenance_date` datetime NOT NULL,\n  `maintenance_content` varchar(1000) NOT NULL,\n  `personnel_id` int(11) NOT NULL,\n  `maintenance_cost` decimal(10,2) NOT NULL,\n  PRIMARY KEY (`maintenance_id`),\n  CONSTRAINT `maintenance_record_ibfk_1` FOREIGN KEY (`equipment_id`) REFERENCES `equipment` (`equipment_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `maintenance_record_ibfk_2` FOREIGN KEY (`personnel_id`) REFERENCES `maintenance_personnel` (`personnel_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `equipment_usage` (\n  `usage_id` int(11) NOT NULL AUTO_INCREMENT,\n  `equipment_id` int(11) NOT NULL,\n  `usage_date` datetime NOT NULL,\n  `usage_hours` decimal(8,2) NOT NULL,\n  `operator` varchar(255) DEFAULT NULL,\n  `usage_description` varchar(500) DEFAULT NULL,\n  PRIMARY KEY (`usage_id`),\n  CONSTRAINT `equipment_usage_ibfk_1` FOREIGN KEY (`equipment_id`) REFERENCES `equipment` (`equipment_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
