  "question": "The futures company employs multiple traders, each of whom is assigned a unique trader ID, name, hire date, and contact number. Traders execute futures transactions for clients, with each client identified by a client ID, name, ID number, and contact number. Each transaction must record the futures code, transaction type (buy, sell), transaction quantity, transaction price, and transaction time. Additionally, the futures company shall maintain records of each trader's transaction performance and the risk level of each client.",
  "ddl": "-- Schema for database: rschema_0295\n\nCREATE TABLE `trader` (\n  `trader_id` int(11) NOT NULL AUTO_INCREMENT,\n  `trader_name` varchar(255) NOT NULL,\n  `hire_date` datetime NOT NULL,\n  `contact_number` varchar(50) NOT NULL,\n  PRIMARY KEY (`trader_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `client` (\n  `client_id` int(11) NOT NULL AUTO_INCREMENT,\n  `client_name` varchar(255) NOT NULL,\n  `id_number` varchar(100) NOT NULL,\n  `contact_number` varchar(50) NOT NULL,\n  `risk_level` varchar(50) DEFAULT NULL,\n  PRIMARY KEY (`client_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `futures` (\n  `futures_code` varchar(50) NOT NULL,\n  `futures_name` varchar(255) NOT NULL,\n  `futures_type` varchar(100) DEFAULT NULL,\n  `contract_size` decimal(15,4) DEFAULT NULL,\n  PRIMARY KEY (`futures_code`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `transaction` (\n  `transaction_id` int(11) NOT NULL AUTO_INCREMENT,\n  `trader_id` int(11) NOT NULL,\n  `client_id` int(11) NOT NULL,\n  `futures_code` varchar(50) NOT NULL,\n  `transaction_type` varchar(10) NOT NULL,\n  `transaction_quantity` decimal(15,4) NOT NULL,\n  `transaction_price` decimal(15,4) NOT NULL,\n  `transaction_time` datetime NOT NULL,\n  PRIMARY KEY (`transaction_id`),\n  CONSTRAINT `transaction_ibfk_1` FOREIGN KEY (`trader_id`) REFERENCES `trader` (`trader_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `transaction_ibfk_2` FOREIGN KEY (`client_id`) REFERENCES `client` (`client_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `transaction_ibfk_3` FOREIGN KEY (`futures_code`) REFERENCES `futures` (`futures_code`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `trader_performance` (\n  `performance_id` int(11) NOT NULL AUTO_INCREMENT,\n  `trader_id` int(11) NOT NULL,\n  `performance_period` varchar(50) NOT NULL,\n  `total_transactions` int(11) DEFAULT NULL,\n  `total_volume` decimal(20,4) DEFAULT NULL,\n  `total_profit_loss` decimal(20,4) DEFAULT NULL,\n  `performance_score` decimal(10,2) DEFAULT NULL,\n  PRIMARY KEY (`performance_id`),\n  CONSTRAINT `trader_performance_ibfk_1` FOREIGN KEY (`trader_id`) REFERENCES `trader` (`trader_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
