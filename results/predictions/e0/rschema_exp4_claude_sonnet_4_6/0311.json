  "question": "A company's workflow management system is as follows:\nThe system contains multiple organizations, and each organization can initiate multiple processes.\nProcess information includes Process ID, Parent Process ID (can be null), Organization ID, Process Type, Log Information, Resource ID, Status, Start Time, and End Time.\nEach process may generate multiple events. Event information includes Event ID, Process ID, Event Type, Log Information, Status, and Timestamp.     \nThe system needs to record detailed information for each process and its related events to track the execution of workflows.",
  "ddl": "-- Schema for database: rschema_0311\n\nCREATE TABLE `organization` (\n  `org_id` int(11) NOT NULL AUTO_INCREMENT,\n  `org_name` varchar(255) NOT NULL,\n  `created_at` datetime DEFAULT NULL,\n  PRIMARY KEY (`org_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `process` (\n  `process_id` int(11) NOT NULL AUTO_INCREMENT,\n  `parent_process_id` int(11) DEFAULT NULL,\n  `org_id` int(11) NOT NULL,\n  `process_type` varchar(100) NOT NULL,\n  `log_info` text DEFAULT NULL,\n  `resource_id` varchar(100) DEFAULT NULL,\n  `status` varchar(50) NOT NULL,\n  `start_time` datetime DEFAULT NULL,\n  `end_time` datetime DEFAULT NULL,\n  PRIMARY KEY (`process_id`),\n  CONSTRAINT `process_ibfk_1` FOREIGN KEY (`org_id`) REFERENCES `organization` (`org_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `process_ibfk_2` FOREIGN KEY (`parent_process_id`) REFERENCES `process` (`process_id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `event` (\n  `event_id` int(11) NOT NULL AUTO_INCREMENT,\n  `process_id` int(11) NOT NULL,\n  `event_type` varchar(100) NOT NULL,\n  `log_info` text DEFAULT NULL,\n  `status` varchar(50) NOT NULL,\n  `timestamp` datetime NOT NULL,\n  PRIMARY KEY (`event_id`),\n  CONSTRAINT `event_ibfk_1` FOREIGN KEY (`process_id`) REFERENCES `process` (`process_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
