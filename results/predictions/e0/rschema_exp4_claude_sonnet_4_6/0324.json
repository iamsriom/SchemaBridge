  "database": "rschema_0324",
  "question": "The database is a geolocation system used to determine the user's geographic location information based on the IP address. Such systems are often used in websites and applications to provide services or content based on geographic location.\n\nMain functions\n\n1. Mapping of IP address to geographic location:\nDetermine the user's geographic location through the IP address (network), including information such as continent and country.\nSupport querying whether the IP address belongs to an anonymous proxy or satellite provider.\n\n2. Geographic location information query:\nProvide detailed geographic location information, such as country name, ISO code, whether it is in the European Union, etc.\nSupport quick search of geographic location information by country ISO code.\n\n3. Data management and maintenance:\nSupport importing and updating geographic location data and IP network data.\nEnsure data consistency and integrity through Foreign key relationships.",
  "ddl": "-- Schema for database: rschema_0324\n\nCREATE TABLE `geoname` (\n  `geoname_id` int(11) NOT NULL,\n  `locale_code` varchar(10) NOT NULL,\n  `continent_code` char(2) NOT NULL,\n  `continent_name` varchar(100) NOT NULL,\n  `country_iso_code` char(2) DEFAULT NULL,\n  `country_name` varchar(255) DEFAULT NULL,\n  `is_in_european_union` tinyint(1) NOT NULL DEFAULT 0,\n  PRIMARY KEY (`geoname_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `geoname_country_index` (\n  `country_iso_code` char(2) NOT NULL,\n  `geoname_id` int(11) NOT NULL,\n  PRIMARY KEY (`country_iso_code`),\n  KEY `geoname_country_index_ibfk_1` (`geoname_id`),\n  CONSTRAINT `geoname_country_index_ibfk_1` FOREIGN KEY (`geoname_id`) REFERENCES `geoname` (`geoname_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `ip_network` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `network` varchar(50) NOT NULL,\n  `geoname_id` int(11) DEFAULT NULL,\n  `registered_country_geoname_id` int(11) DEFAULT NULL,\n  `represented_country_geoname_id` int(11) DEFAULT NULL,\n  `is_anonymous_proxy` tinyint(1) NOT NULL DEFAULT 0,\n  `is_satellite_provider` tinyint(1) NOT NULL DEFAULT 0,\n  PRIMARY KEY (`id`),\n  KEY `ip_network_ibfk_1` (`geoname_id`),\n  KEY `ip_network_ibfk_2` (`registered_country_geoname_id`),\n  KEY `ip_network_ibfk_3` (`represented_country_geoname_id`),\n  CONSTRAINT `ip_network_ibfk_1` FOREIGN KEY (`geoname_id`) REFERENCES `geoname` (`geoname_id`) ON DELETE SET NULL ON UPDATE CASCADE,\n  CONSTRAINT `ip_network_ibfk_2` FOREIGN KEY (`registered_country_geoname_id`) REFERENCES `geoname` (`geoname_id`) ON DELETE SET NULL ON UPDATE CASCADE,\n  CONSTRAINT `ip_network_ibfk_3` FOREIGN KEY (`represented_country_geoname_id`) REFERENCES `geoname` (`geoname_id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
