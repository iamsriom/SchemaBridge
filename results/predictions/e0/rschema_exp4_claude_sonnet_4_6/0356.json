  "question": "Business Requirements Description:\nThis system is designed for managing work items, with the following core functionalities:\nStores the Attributes for each work item, including Attributes name, Attributes value, and link status.\nRecords the work item’s ID, name, description, creation date, update date, and other relevant information.\nTracks the link status of work items, which can be used to record the current status or related information about the work item.",
  "ddl": "-- Schema for database: rschema_0356\n\nCREATE TABLE `work_item` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `description` text DEFAULT NULL,\n  `created_at` datetime NOT NULL,\n  `updated_at` datetime DEFAULT NULL,\n  `link_status` varchar(100) DEFAULT NULL,\n  PRIMARY KEY (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `work_item_attribute` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `work_item_id` int(11) NOT NULL,\n  `attribute_name` varchar(255) NOT NULL,\n  `attribute_value` varchar(255) DEFAULT NULL,\n  `link_status` varchar(100) DEFAULT NULL,\n  PRIMARY KEY (`id`),\n  CONSTRAINT `work_item_attribute_ibfk_1` FOREIGN KEY (`work_item_id`) REFERENCES `work_item` (`id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `work_item_link_status` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `work_item_id` int(11) NOT NULL,\n  `status_code` varchar(100) NOT NULL,\n  `status_description` varchar(255) DEFAULT NULL,\n  `recorded_at` datetime NOT NULL,\n  PRIMARY KEY (`id`),\n  CONSTRAINT `work_item_link_status_ibfk_1` FOREIGN KEY (`work_item_id`) REFERENCES `work_item` (`id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
