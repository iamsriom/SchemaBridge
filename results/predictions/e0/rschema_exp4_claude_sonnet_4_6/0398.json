  "question": "Requirement Description:\n1.Menu Management: Manages restaurant menu information, including Dish ID, Dish Name, Dish Category, and Dish Price.\n2.Table Management: Manages restaurant table information, including Table ID and Seat Number.\n3.Customer Management: Manages customer information, including Customer ID, Customer Name, Gender, and Phone Number.\n4.Employee Management: Manages restaurant employee information, including Employee ID, Employee Name, Age, Gender, and Salary.\n5.Order Management: Manages customer order information, including Order ID, Table ID, and Dining Time.\n6.Service Management: Manages employee service information, including Service Employee ID and Order ID.",
  "ddl": "-- Schema for database: rschema_0398\n\nCREATE TABLE `menu` (\n  `dish_id` int(11) NOT NULL AUTO_INCREMENT,\n  `dish_name` varchar(255) NOT NULL,\n  `dish_category` varchar(255) NOT NULL,\n  `dish_price` decimal(10,2) NOT NULL,\n  PRIMARY KEY (`dish_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `tables` (\n  `table_id` int(11) NOT NULL AUTO_INCREMENT,\n  `seat_number` int(11) NOT NULL,\n  PRIMARY KEY (`table_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `customer` (\n  `customer_id` int(11) NOT NULL AUTO_INCREMENT,\n  `customer_name` varchar(255) NOT NULL,\n  `gender` char(6) DEFAULT NULL,\n  `phone_number` varchar(20) DEFAULT NULL,\n  PRIMARY KEY (`customer_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `employee` (\n  `employee_id` int(11) NOT NULL AUTO_INCREMENT,\n  `employee_name` varchar(255) NOT NULL,\n  `age` int(11) DEFAULT NULL,\n  `gender` char(6) DEFAULT NULL,\n  `salary` decimal(10,2) DEFAULT NULL,\n  PRIMARY KEY (`employee_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `orders` (\n  `order_id` int(11) NOT NULL AUTO_INCREMENT,\n  `table_id` int(11) NOT NULL,\n  `dining_time` datetime NOT NULL,\n  PRIMARY KEY (`order_id`),\n  CONSTRAINT `orders_ibfk_1` FOREIGN KEY (`table_id`) REFERENCES `tables` (`table_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `service` (\n  `service_id` int(11) NOT NULL AUTO_INCREMENT,\n  `employee_id` int(11) NOT NULL,\n  `order_id` int(11) NOT NULL,\n  PRIMARY KEY (`service_id`),\n  CONSTRAINT `service_ibfk_1` FOREIGN KEY (`employee_id`) REFERENCES `employee` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `service_ibfk_2` FOREIGN KEY (`order_id`) REFERENCES `orders` (`order_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
