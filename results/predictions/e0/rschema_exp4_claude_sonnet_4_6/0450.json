  "database": "rschema_0450",
  "question": "Asset Management System Design for a Company is as follows:\nThe company has multiple departments, with department information including Department ID, name, and description.\nEach department has multiple users, with user information including User ID, name, and affiliated department.\nThe company manages assets by categories, with asset category information including Type ID, category name, and description.\nAsset information includes Asset ID, name, type, affiliated department, status (such as \"idle\", \"in use\", \"returning\", \"scrapped\"), and scrapping indicator, etc.\nThe asset circulation record includes Asset ID, circulating User ID, circulation status (such as \"pending receipt\", \"received\", \"allocating\", \"allocated\"), etc.\nThe system needs to record the creation and update information of assets, including creator and creation time, updater and update time.",
  "ddl": "-- Schema for database: rschema_0450\n\nCREATE TABLE `department` (\n  `dept_id` int(11) NOT NULL AUTO_INCREMENT,\n  `dept_name` varchar(255) NOT NULL,\n  `description` varchar(500) DEFAULT NULL,\n  PRIMARY KEY (`dept_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `user` (\n  `user_id` int(11) NOT NULL AUTO_INCREMENT,\n  `user_name` varchar(255) NOT NULL,\n  `dept_id` int(11) NOT NULL,\n  PRIMARY KEY (`user_id`),\n  CONSTRAINT `user_ibfk_1` FOREIGN KEY (`dept_id`) REFERENCES `department` (`dept_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `asset_category` (\n  `type_id` int(11) NOT NULL AUTO_INCREMENT,\n  `category_name` varchar(255) NOT NULL,\n  `description` varchar(500) DEFAULT NULL,\n  PRIMARY KEY (`type_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `asset` (\n  `asset_id` int(11) NOT NULL AUTO_INCREMENT,\n  `asset_name` varchar(255) NOT NULL,\n  `type_id` int(11) NOT NULL,\n  `dept_id` int(11) NOT NULL,\n  `status` varchar(50) NOT NULL DEFAULT 'idle',\n  `is_scrapped` tinyint(1) NOT NULL DEFAULT 0,\n  `created_by` int(11) DEFAULT NULL,\n  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  `updated_by` int(11) DEFAULT NULL,\n  `updated_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,\n  PRIMARY KEY (`asset_id`),\n  CONSTRAINT `asset_ibfk_1` FOREIGN KEY (`type_id`) REFERENCES `asset_category` (`type_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `asset_ibfk_2` FOREIGN KEY (`dept_id`) REFERENCES `department` (`dept_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `asset_ibfk_3` FOREIGN KEY (`created_by`) REFERENCES `user` (`user_id`) ON DELETE SET NULL ON UPDATE CASCADE,\n  CONSTRAINT `asset_ibfk_4` FOREIGN KEY (`updated_by`) REFERENCES `user` (`user_id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `asset_circulation` (\n  `circulation_id` int(11) NOT NULL AUTO_INCREMENT,\n  `asset_id` int(11) NOT NULL,\n  `user_id` int(11) NOT NULL,\n  `circulation_status` varchar(50) NOT NULL DEFAULT 'pending receipt',\n  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  `updated_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,\n  PRIMARY KEY (`circulation_id`),\n  CONSTRAINT `asset_circulation_ibfk_1` FOREIGN KEY (`asset_id`) REFERENCES `asset` (`asset_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `asset_circulation_ibfk_2` FOREIGN KEY (`user_id`) REFERENCES `user` (`user_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
