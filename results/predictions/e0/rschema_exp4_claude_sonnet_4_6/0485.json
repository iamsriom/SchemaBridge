  "database": "rschema_0485",
  "question": "The wetland protection organization needs to manage multiple wetland protection areas. Each protection area has an ID, name, location, and person in charge. The system shall record the species, quantity, and growth status of flora and fauna in each protection area. Each record shall include the recording time, recording personnel, species, and quantity of flora and fauna. The system also needs to record environmental changes within the protection areas, including temperature, humidity, rainfall, etc., and specify the time and location of the changes. The system can automatically record environmental changes through sensors, and there is no need to store recorder information here.",
  "ddl": "-- Schema for database: rschema_0485\n\nCREATE TABLE `protection_area` (\n  `area_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `location` varchar(255) NOT NULL,\n  `person_in_charge` varchar(100) NOT NULL,\n  PRIMARY KEY (`area_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `species` (\n  `species_id` int(11) NOT NULL AUTO_INCREMENT,\n  `species_name` varchar(255) NOT NULL,\n  `species_type` varchar(50) NOT NULL COMMENT 'flora or fauna',\n  `description` varchar(500) DEFAULT NULL,\n  PRIMARY KEY (`species_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `flora_fauna_record` (\n  `record_id` int(11) NOT NULL AUTO_INCREMENT,\n  `area_id` int(11) NOT NULL,\n  `species_id` int(11) NOT NULL,\n  `quantity` int(11) NOT NULL,\n  `growth_status` varchar(255) NOT NULL,\n  `record_time` datetime NOT NULL,\n  `recorder` varchar(100) NOT NULL,\n  PRIMARY KEY (`record_id`),\n  CONSTRAINT `flora_fauna_record_ibfk_1` FOREIGN KEY (`area_id`) REFERENCES `protection_area` (`area_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `flora_fauna_record_ibfk_2` FOREIGN KEY (`species_id`) REFERENCES `species` (`species_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `environmental_change` (\n  `change_id` int(11) NOT NULL AUTO_INCREMENT,\n  `area_id` int(11) NOT NULL,\n  `temperature` decimal(5,2) DEFAULT NULL COMMENT 'in Celsius',\n  `humidity` decimal(5,2) DEFAULT NULL COMMENT 'in percentage',\n  `rainfall` decimal(7,2) DEFAULT NULL COMMENT 'in mm',\n  `record_time` datetime NOT NULL,\n  `location` varchar(255) NOT NULL,\n  PRIMARY KEY (`change_id`),\n  CONSTRAINT `environmental_change_ibfk_1` FOREIGN KEY (`area_id`) REFERENCES `protection_area` (`area_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
