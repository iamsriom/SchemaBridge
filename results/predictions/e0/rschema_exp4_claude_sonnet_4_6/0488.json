  "database": "rschema_0488",
  "question": "This backend system is designed for managing work order processing information across different support departments.\n1.Department Management:The system allows you to create, modify, and delete different support departments. For each department, you can set:\nDepartment name, description, and email address.Sorting order. Whether the department only allows customers to submit work orders.Whether work orders are only responded to via email pipeline.Whether auto-replies are disabled.Whether the department is hidden from users.\n2.Email Configuration:For each department, configure the email server’s host address, port number, login username, and password, allowing the system to automatically handle emails.\n3.Employee Email Server Maintenance:\nEmployees can maintain the email server in real-time.",
  "ddl": "-- Schema for database: rschema_0488\n\nCREATE TABLE `department` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `description` text DEFAULT NULL,\n  `email` varchar(255) DEFAULT NULL,\n  `sort_order` int(11) NOT NULL DEFAULT 0,\n  `only_customers` tinyint(1) NOT NULL DEFAULT 0,\n  `email_pipeline_only` tinyint(1) NOT NULL DEFAULT 0,\n  `auto_reply_disabled` tinyint(1) NOT NULL DEFAULT 0,\n  `hidden` tinyint(1) NOT NULL DEFAULT 0,\n  PRIMARY KEY (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `email_configuration` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `department_id` int(11) NOT NULL,\n  `host` varchar(255) NOT NULL,\n  `port` int(11) NOT NULL,\n  `username` varchar(255) NOT NULL,\n  `password` varchar(255) NOT NULL,\n  PRIMARY KEY (`id`),\n  CONSTRAINT `email_configuration_ibfk_1` FOREIGN KEY (`department_id`) REFERENCES `department` (`id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `employee` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `email` varchar(255) NOT NULL,\n  `department_id` int(11) DEFAULT NULL,\n  PRIMARY KEY (`id`),\n  CONSTRAINT `employee_ibfk_1` FOREIGN KEY (`department_id`) REFERENCES `department` (`id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `email_server_maintenance` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `employee_id` int(11) NOT NULL,\n  `email_configuration_id` int(11) NOT NULL,\n  `maintenance_time` datetime NOT NULL,\n  `notes` text DEFAULT NULL,\n  PRIMARY KEY (`id`),\n  CONSTRAINT `email_server_maintenance_ibfk_1` FOREIGN KEY (`employee_id`) REFERENCES `employee` (`id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `email_server_maintenance_ibfk_2` FOREIGN KEY (`email_configuration_id`) REFERENCES `email_configuration` (`id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
