  "question": "The database shall serve as a school sports event management system, managing information on various events, participants, results, and awards. It includes the following information:  \n\nRecords of participating students' basic information: Student ID, Name, Gender, Grade, Class, Contact Information  \n\nRecords of various school sports events: Event ID, Event Name, Event Type (such as running, long jump, throwing, etc.), Event Time  \n\nRecords of students registering for events: Student ID, Event ID, Registration Time  \n\nRecords of students' results in each event: Student ID, Event ID, Result, Event Date",
  "ddl": "-- Schema for database: rschema_0497\n\nCREATE TABLE `students` (\n  `student_id` varchar(20) NOT NULL,\n  `name` varchar(100) NOT NULL,\n  `gender` char(1) NOT NULL,\n  `grade` int(11) NOT NULL,\n  `class` varchar(20) NOT NULL,\n  `contact_info` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`student_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `events` (\n  `event_id` varchar(20) NOT NULL,\n  `event_name` varchar(255) NOT NULL,\n  `event_type` varchar(100) NOT NULL,\n  `event_time` datetime NOT NULL,\n  PRIMARY KEY (`event_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `registrations` (\n  `student_id` varchar(20) NOT NULL,\n  `event_id` varchar(20) NOT NULL,\n  `registration_time` datetime NOT NULL,\n  PRIMARY KEY (`student_id`, `event_id`),\n  CONSTRAINT `registrations_ibfk_1` FOREIGN KEY (`student_id`) REFERENCES `students` (`student_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `registrations_ibfk_2` FOREIGN KEY (`event_id`) REFERENCES `events` (`event_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `results` (\n  `result_id` int(11) NOT NULL AUTO_INCREMENT,\n  `student_id` varchar(20) NOT NULL,\n  `event_id` varchar(20) NOT NULL,\n  `result` varchar(100) NOT NULL,\n  `event_date` date NOT NULL,\n  PRIMARY KEY (`result_id`),\n  CONSTRAINT `results_ibfk_1` FOREIGN KEY (`student_id`) REFERENCES `students` (`student_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `results_ibfk_2` FOREIGN KEY (`event_id`) REFERENCES `events` (`event_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
