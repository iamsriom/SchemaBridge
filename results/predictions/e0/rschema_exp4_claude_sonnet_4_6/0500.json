  "question": "Business Requirements Description:\nThis is a task management system with the following main features:\n1.Task Management:Create, assign, track, and complete tasks.Each task includes:Task ID, Task Name, Task Description, Task Deadline, and Task Progress.Task Type, Task Status, and Task Priority.Each task is assigned to a user.\n2.User Management:Add, delete, and manage users.Each user has a unique User ID, Username, Password, and Email.Each user has a fixed role.\n3.Role Management:Define and assign user roles.Each role includes:Role ID, Role Name, and Role Description.\n4.Task Type Management:Define and manage different task types.Each task type includes:Task Type ID, Task Type Name, and Task Type Description.\n5.Task Status Management:Track task statuses (e.g., To Do, In Progress, Completed), including the status name and description.\n6.Task Priority Management:Set task priorities.Each priority includes:\nTask Priority ID, Task Priority Name, and Task Priority Description.",
  "ddl": "-- Schema for database: rschema_0500\n\nCREATE TABLE `role` (\n  `role_id` int(11) NOT NULL AUTO_INCREMENT,\n  `role_name` varchar(255) NOT NULL,\n  `role_description` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`role_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `user` (\n  `user_id` int(11) NOT NULL AUTO_INCREMENT,\n  `username` varchar(255) NOT NULL,\n  `password` varchar(255) NOT NULL,\n  `email` varchar(255) NOT NULL,\n  `role_id` int(11) NOT NULL,\n  PRIMARY KEY (`user_id`),\n  UNIQUE KEY `email` (`email`),\n  CONSTRAINT `user_ibfk_1` FOREIGN KEY (`role_id`) REFERENCES `role` (`role_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `task_type` (\n  `task_type_id` int(11) NOT NULL AUTO_INCREMENT,\n  `task_type_name` varchar(255) NOT NULL,\n  `task_type_description` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`task_type_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `task_status` (\n  `task_status_id` int(11) NOT NULL AUTO_INCREMENT,\n  `task_status_name` varchar(255) NOT NULL,\n  `task_status_description` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`task_status_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `task_priority` (\n  `task_priority_id` int(11) NOT NULL AUTO_INCREMENT,\n  `task_priority_name` varchar(255) NOT NULL,\n  `task_priority_description` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`task_priority_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `task` (\n  `task_id` int(11) NOT NULL AUTO_INCREMENT,\n  `task_name` varchar(255) NOT NULL,\n  `task_description` varchar(255) DEFAULT NULL,\n  `task_deadline` datetime DEFAULT NULL,\n  `task_progress` int(11) DEFAULT NULL,\n  `task_type_id` int(11) NOT NULL,\n  `task_status_id` int(11) NOT NULL,\n  `task_priority_id` int(11) NOT NULL,\n  `user_id` int(11) NOT NULL,\n  PRIMARY KEY (`task_id`),\n  CONSTRAINT `task_ibfk_1` FOREIGN KEY (`task_type_id`) REFERENCES `task_type` (`task_type_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `task_ibfk_2` FOREIGN KEY (`task_status_id`) REFERENCES `task_status` (`task_status_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `task_ibfk_3` FOREIGN KEY (`task_priority_id`) REFERENCES `task_priority` (`task_priority_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `task_ibfk_4` FOREIGN KEY (`user_id`) REFERENCES `user` (`user_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
