  "question": "System: Parking lot management system\n\nDescription of required functions:\n1. Parking space management:\nThe system queries available parking spaces, and when a vehicle enters, it marks the parking space as occupied.\nWhen a vehicle exits from the exit, it marks the parking space as empty.\n\n2. Parking space owner management:\nThe system needs to record the information of certain car owners who have purchased parking spaces, including their license plate number, name, and contact information.",
  "ddl": "-- Schema for database: rschema_0510\n\nCREATE TABLE `parking_space` (\n  `space_id` int(11) NOT NULL AUTO_INCREMENT,\n  `space_number` varchar(20) NOT NULL,\n  `floor` varchar(10) DEFAULT NULL,\n  `zone` varchar(10) DEFAULT NULL,\n  `status` varchar(20) NOT NULL DEFAULT 'available',\n  `space_type` varchar(20) DEFAULT NULL,\n  PRIMARY KEY (`space_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `parking_space_owner` (\n  `owner_id` int(11) NOT NULL AUTO_INCREMENT,\n  `space_id` int(11) NOT NULL,\n  `owner_name` varchar(100) NOT NULL,\n  `license_plate` varchar(20) NOT NULL,\n  `phone` varchar(20) DEFAULT NULL,\n  `email` varchar(100) DEFAULT NULL,\n  `purchase_date` datetime DEFAULT NULL,\n  PRIMARY KEY (`owner_id`),\n  CONSTRAINT `parking_space_owner_ibfk_1` FOREIGN KEY (`space_id`) REFERENCES `parking_space` (`space_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `vehicle_entry_exit` (\n  `record_id` int(11) NOT NULL AUTO_INCREMENT,\n  `space_id` int(11) NOT NULL,\n  `license_plate` varchar(20) NOT NULL,\n  `entry_time` datetime NOT NULL,\n  `exit_time` datetime DEFAULT NULL,\n  `fee` decimal(10,2) DEFAULT NULL,\n  PRIMARY KEY (`record_id`),\n  CONSTRAINT `vehicle_entry_exit_ibfk_1` FOREIGN KEY (`space_id`) REFERENCES `parking_space` (`space_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
