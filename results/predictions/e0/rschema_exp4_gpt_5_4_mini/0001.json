  "database": "rschema_0001",
  "question": "The airline company operates as follows:\nThe company owns multiple airplanes, each with an Airplane Number, Model, and Passenger Capacity.\nEach airplane can perform multiple flights. Flight information includes Flight Number, Departure Time, Arrival Time, Origin, Destination, Airplane Number, Captain ID, First Officer ID, Start Time, and End Time.\nEach flight is operated by a captain and a first officer, each having their own ID, Name, and Phone Number.",
  "ddl": "-- Schema for database: rschema_0001\nCREATE TABLE `airplanes` (\n  `airplane_number` int(11) NOT NULL,\n  `model` varchar(255) NOT NULL,\n  `passenger_capacity` int(11) NOT NULL,\n  PRIMARY KEY (`airplane_number`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `crew_members` (\n  `crew_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `phone_number` varchar(20) NOT NULL,\n  PRIMARY KEY (`crew_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `flights` (\n  `flight_number` int(11) NOT NULL,\n  `departure_time` datetime NOT NULL,\n  `arrival_time` datetime NOT NULL,\n  `origin` varchar(255) NOT NULL,\n  `destination` varchar(255) NOT NULL,\n  `airplane_number` int(11) NOT NULL,\n  `captain_id` int(11) NOT NULL,\n  `first_officer_id` int(11) NOT NULL,\n  `start_time` datetime NOT NULL,\n  `end_time` datetime NOT NULL,\n  PRIMARY KEY (`flight_number`),\n  KEY `flights_ibfk_1` (`airplane_number`),\n  KEY `flights_ibfk_2` (`captain_id`),\n  KEY `flights_ibfk_3` (`first_officer_id`),\n  CONSTRAINT `flights_ibfk_1` FOREIGN KEY (`airplane_number`) REFERENCES `airplanes` (`airplane_number`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `flights_ibfk_2` FOREIGN KEY (`captain_id`) REFERENCES `crew_members` (`crew_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `flights_ibfk_3` FOREIGN KEY (`first_officer_id`) REFERENCES `crew_members` (`crew_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
