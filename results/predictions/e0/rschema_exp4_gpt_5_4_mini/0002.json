  "question": "The multimodal transportation company undertakes multiple transportation tasks, each with a task number, origin, destination, cargo name, weight, and transportation time. Tasks may involve various transportation methods such as rail, road, water, and air. Each task requires recording the carrier information (including name and contact phone number) and the task start time and end time. The system shall support real-time monitoring and performance evaluation of the multimodal transportation tasks.",
  "ddl": "-- Schema for database: rschema_0002\nCREATE TABLE `transport_task` (\n  `task_id` int(11) NOT NULL AUTO_INCREMENT,\n  `task_number` varchar(50) NOT NULL,\n  `origin` varchar(255) NOT NULL,\n  `destination` varchar(255) NOT NULL,\n  `cargo_name` varchar(255) NOT NULL,\n  `weight` decimal(10,2) NOT NULL,\n  `transportation_time` int(11) NOT NULL,\n  `carrier_name` varchar(255) NOT NULL,\n  `carrier_phone` varchar(20) NOT NULL,\n  `start_time` datetime NOT NULL,\n  `end_time` datetime NOT NULL,\n  PRIMARY KEY (`task_id`),\n  UNIQUE KEY `uk_transport_task_task_number` (`task_number`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `transport_method` (\n  `method_id` int(11) NOT NULL AUTO_INCREMENT,\n  `method_name` varchar(50) NOT NULL,\n  PRIMARY KEY (`method_id`),\n  UNIQUE KEY `uk_transport_method_method_name` (`method_name`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `task_transport_method` (\n  `task_id` int(11) NOT NULL,\n  `method_id` int(11) NOT NULL,\n  PRIMARY KEY (`task_id`,`method_id`),\n  KEY `task_transport_method_ibfk_2` (`method_id`),\n  CONSTRAINT `task_transport_method_ibfk_1` FOREIGN KEY (`task_id`) REFERENCES `transport_task` (`task_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `task_transport_method_ibfk_2` FOREIGN KEY (`method_id`) REFERENCES `transport_method` (`method_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
