  "question": "The software development company manages multiple projects, each with a Project ID, Name, Start Date, End Date, and Budget. The company employs multiple developers, and each developer can participate in multiple projects. Each project progress update must record the Update Time, Current Status, and the person who performed the update.",
  "ddl": "-- Schema for database: rschema_0006\nCREATE TABLE `projects` (\n  `project_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `start_date` date NOT NULL,\n  `end_date` date DEFAULT NULL,\n  `budget` decimal(12,2) NOT NULL,\n  PRIMARY KEY (`project_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `developers` (\n  `developer_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  PRIMARY KEY (`developer_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `project_developers` (\n  `project_id` int(11) NOT NULL,\n  `developer_id` int(11) NOT NULL,\n  PRIMARY KEY (`project_id`,`developer_id`),\n  CONSTRAINT `project_developers_ibfk_1` FOREIGN KEY (`project_id`) REFERENCES `projects` (`project_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `project_developers_ibfk_2` FOREIGN KEY (`developer_id`) REFERENCES `developers` (`developer_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `project_updates` (\n  `update_id` int(11) NOT NULL,\n  `project_id` int(11) NOT NULL,\n  `update_time` datetime NOT NULL,\n  `current_status` varchar(255) NOT NULL,\n  `updated_by_developer_id` int(11) NOT NULL,\n  PRIMARY KEY (`update_id`),\n  CONSTRAINT `project_updates_ibfk_1` FOREIGN KEY (`project_id`) REFERENCES `projects` (`project_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `project_updates_ibfk_2` FOREIGN KEY (`updated_by_developer_id`) REFERENCES `developers` (`developer_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
