  "question": "Broadcasting company has multiple advertising clients, and each client can place multiple advertisements. Each advertisement has an Advertisement ID, Name, Broadcast Time, Duration, and Price. For each advertisement broadcast, the system shall record the Broadcast Time, Broadcast Channel, and Operating Personnel.",
  "ddl": "-- Schema for database: rschema_0007\nCREATE TABLE `clients` (\n  `client_id` int(11) NOT NULL AUTO_INCREMENT,\n  `client_name` varchar(255) NOT NULL,\n  PRIMARY KEY (`client_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `advertisements` (\n  `advertisement_id` int(11) NOT NULL AUTO_INCREMENT,\n  `client_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `broadcast_time` datetime NOT NULL,\n  `duration` int(11) NOT NULL,\n  `price` decimal(10,2) NOT NULL,\n  PRIMARY KEY (`advertisement_id`),\n  KEY `advertisements_ibfk_1` (`client_id`),\n  CONSTRAINT `advertisements_ibfk_1` FOREIGN KEY (`client_id`) REFERENCES `clients` (`client_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `broadcast_records` (\n  `broadcast_record_id` int(11) NOT NULL AUTO_INCREMENT,\n  `advertisement_id` int(11) NOT NULL,\n  `broadcast_time` datetime NOT NULL,\n  `broadcast_channel` varchar(255) NOT NULL,\n  `operating_personnel` varchar(255) NOT NULL,\n  PRIMARY KEY (`broadcast_record_id`),\n  KEY `broadcast_records_ibfk_1` (`advertisement_id`),\n  CONSTRAINT `broadcast_records_ibfk_1` FOREIGN KEY (`advertisement_id`) REFERENCES `advertisements` (`advertisement_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
