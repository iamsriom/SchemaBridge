  "database": "rschema_0011",
  "question": "The agricultural machinery and equipment management system needs to manage the machinery and equipment of multiple farms. Each equipment has equipment ID, name, model, purchase date, usage status (such as \"normal\", \"maintenance\", \"disabled\", etc.), maintenance record and operator. Each farm has farm ID, name, address and contact information. Each maintenance record includes equipment ID, maintenance date, maintenance type (such as \"routine inspection\", \"fault repair\", etc.), operator and maintenance result (such as \"completed\", \"uncompleted\", etc.). It is necessary to record the basic information of the operator (operator ID, name, phone number) to facilitate the tracing of operation records.",
  "ddl": "-- Schema for database: rschema_0011\nCREATE TABLE `farm` (\n  `farm_id` int(11) NOT NULL,\n  `farm_name` varchar(255) NOT NULL,\n  `address` varchar(255) DEFAULT NULL,\n  `contact_info` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`farm_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `operator` (\n  `operator_id` int(11) NOT NULL,\n  `operator_name` varchar(255) NOT NULL,\n  `phone_number` varchar(50) DEFAULT NULL,\n  PRIMARY KEY (`operator_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `equipment` (\n  `equipment_id` int(11) NOT NULL,\n  `farm_id` int(11) NOT NULL,\n  `equipment_name` varchar(255) NOT NULL,\n  `model` varchar(255) DEFAULT NULL,\n  `purchase_date` date DEFAULT NULL,\n  `usage_status` varchar(50) DEFAULT NULL,\n  `operator_id` int(11) DEFAULT NULL,\n  PRIMARY KEY (`equipment_id`),\n  KEY `equipment_ibfk_1` (`farm_id`),\n  KEY `equipment_ibfk_2` (`operator_id`),\n  CONSTRAINT `equipment_ibfk_1` FOREIGN KEY (`farm_id`) REFERENCES `farm` (`farm_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `equipment_ibfk_2` FOREIGN KEY (`operator_id`) REFERENCES `operator` (`operator_id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `maintenance_record` (\n  `maintenance_record_id` int(11) NOT NULL,\n  `equipment_id` int(11) NOT NULL,\n  `maintenance_date` date NOT NULL,\n  `maintenance_type` varchar(100) DEFAULT NULL,\n  `operator_id` int(11) DEFAULT NULL,\n  `maintenance_result` varchar(50) DEFAULT NULL,\n  PRIMARY KEY (`maintenance_record_id`),\n  KEY `maintenance_record_ibfk_1` (`equipment_id`),\n  KEY `maintenance_record_ibfk_2` (`operator_id`),\n  CONSTRAINT `maintenance_record_ibfk_1` FOREIGN KEY (`equipment_id`) REFERENCES `equipment` (`equipment_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `maintenance_record_ibfk_2` FOREIGN KEY (`operator_id`) REFERENCES `operator` (`operator_id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
