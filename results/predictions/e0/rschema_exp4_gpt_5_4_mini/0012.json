  "database": "rschema_0012",
  "question": "Agricultural Product Warehouse Management System requires managing multiple warehouses, where each warehouse can store various agricultural products. Agricultural products in a warehouse may have the same name, depending on the cultural differences of different regions.  \nEach warehouse has a Warehouse ID, name, address, capacity, and current inventory.  \nEach type of agricultural product has a Product ID, name, specification, date of storage, date of dispatch, quantity stored, quantity dispatched, and current inventory.  \nEach storage record includes Warehouse ID, Product ID, storage date, quantity stored, and operator.  \nEach dispatch record includes Warehouse ID, Product ID, dispatch date, quantity dispatched, and operator.",
  "ddl": "-- Schema for database: rschema_0012\nCREATE TABLE `warehouse` (\n  `warehouse_id` int(11) NOT NULL AUTO_INCREMENT,\n  `warehouse_name` varchar(255) NOT NULL,\n  `address` varchar(255) NOT NULL,\n  `capacity` int(11) NOT NULL,\n  `current_inventory` int(11) NOT NULL,\n  PRIMARY KEY (`warehouse_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `agricultural_product` (\n  `product_id` int(11) NOT NULL AUTO_INCREMENT,\n  `product_name` varchar(255) NOT NULL,\n  `specification` varchar(255) NOT NULL,\n  `date_of_storage` datetime DEFAULT NULL,\n  `date_of_dispatch` datetime DEFAULT NULL,\n  `quantity_stored` int(11) NOT NULL,\n  `quantity_dispatched` int(11) NOT NULL,\n  `current_inventory` int(11) NOT NULL,\n  PRIMARY KEY (`product_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `storage_record` (\n  `storage_record_id` int(11) NOT NULL AUTO_INCREMENT,\n  `warehouse_id` int(11) NOT NULL,\n  `product_id` int(11) NOT NULL,\n  `storage_date` datetime NOT NULL,\n  `quantity_stored` int(11) NOT NULL,\n  `operator` varchar(255) NOT NULL,\n  PRIMARY KEY (`storage_record_id`),\n  KEY `storage_record_ibfk_1` (`warehouse_id`),\n  KEY `storage_record_ibfk_2` (`product_id`),\n  CONSTRAINT `storage_record_ibfk_1` FOREIGN KEY (`warehouse_id`) REFERENCES `warehouse` (`warehouse_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `storage_record_ibfk_2` FOREIGN KEY (`product_id`) REFERENCES `agricultural_product` (`product_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `dispatch_record` (\n  `dispatch_record_id` int(11) NOT NULL AUTO_INCREMENT,\n  `warehouse_id` int(11) NOT NULL,\n  `product_id` int(11) NOT NULL,\n  `dispatch_date` datetime NOT NULL,\n  `quantity_dispatched` int(11) NOT NULL,\n  `operator` varchar(255) NOT NULL,\n  PRIMARY KEY (`dispatch_record_id`),\n  KEY `dispatch_record_ibfk_1` (`warehouse_id`),\n  KEY `dispatch_record_ibfk_2` (`product_id`),\n  CONSTRAINT `dispatch_record_ibfk_1` FOREIGN KEY (`warehouse_id`) REFERENCES `warehouse` (`warehouse_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `dispatch_record_ibfk_2` FOREIGN KEY (`product_id`) REFERENCES `agricultural_product` (`product_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
