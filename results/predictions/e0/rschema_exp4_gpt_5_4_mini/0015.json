  "database": "rschema_0015",
  "question": "The agricultural pest and disease monitoring system is designed to monitor and record the pest and disease conditions of farmland plots in real time, helping agricultural managers to timely discover, evaluate and prevent pests and diseases, and improve crop yields and quality. The system can record the basic information of each plot, the type of pests and diseases, monitoring results, prevention and control measures and their effects, and provide data support for agricultural production decisions. Each plot has a plot ID, area, soil type, geographical location and current pest and disease status (such as \"normal\", \"mild pests and diseases\", \"severe pests and diseases\", etc.). Each pest and disease has a pest and disease ID, name, degree of damage (such as \"mild\", \"severe\", etc.) and prevention and control methods, and the season of occurrence. Each monitoring record includes the plot ID, pest and disease ID, monitoring date, monitoring results and operator. Each operator has records such as employee ID, name, gender, age and contact information.",
  "ddl": "-- Schema for database: rschema_0015\nCREATE TABLE `plots` (\n  `plot_id` int(11) NOT NULL AUTO_INCREMENT,\n  `area` decimal(10,2) NOT NULL,\n  `soil_type` varchar(100) NOT NULL,\n  `geographical_location` varchar(255) NOT NULL,\n  `current_pest_disease_status` varchar(50) NOT NULL,\n  PRIMARY KEY (`plot_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `pest_diseases` (\n  `pest_disease_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `damage_degree` varchar(50) NOT NULL,\n  `prevention_control_methods` text NOT NULL,\n  `occurrence_season` varchar(50) NOT NULL,\n  PRIMARY KEY (`pest_disease_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `operators` (\n  `employee_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(100) NOT NULL,\n  `gender` char(1) NOT NULL,\n  `age` int(11) NOT NULL,\n  `contact_information` varchar(255) NOT NULL,\n  PRIMARY KEY (`employee_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `monitoring_records` (\n  `monitoring_record_id` int(11) NOT NULL AUTO_INCREMENT,\n  `plot_id` int(11) NOT NULL,\n  `pest_disease_id` int(11) NOT NULL,\n  `monitoring_date` datetime NOT NULL,\n  `monitoring_results` text NOT NULL,\n  `operator_id` int(11) NOT NULL,\n  PRIMARY KEY (`monitoring_record_id`),\n  KEY `monitoring_records_ibfk_1` (`plot_id`),\n  KEY `monitoring_records_ibfk_2` (`pest_disease_id`),\n  KEY `monitoring_records_ibfk_3` (`operator_id`),\n  CONSTRAINT `monitoring_records_ibfk_1` FOREIGN KEY (`plot_id`) REFERENCES `plots` (`plot_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `monitoring_records_ibfk_2` FOREIGN KEY (`pest_disease_id`) REFERENCES `pest_diseases` (`pest_disease_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `monitoring_records_ibfk_3` FOREIGN KEY (`operator_id`) REFERENCES `operators` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
