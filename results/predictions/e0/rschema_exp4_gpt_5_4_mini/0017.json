  "question": "The business requirements for a forest product processing management system are described as follows: This system is mainly used for managing the production operations of forest product processing factories. For workshop management, the system needs to record each workshop's ID, name and address information. Each workshop is equipped with multiple workers, whose information includes worker ID, name and contact number. In their daily work, workers need to record detailed processing information, including raw materials used, processing time, specific product name, production quantity and product quality rating. The system also needs to manage the inventory of raw materials for each workshop, recording the name and real-time inventory quantity of various raw materials. For production quality management, the system will automatically calculate production performance metrics for each workshop based on workers' processing records, including monthly total processing volume, product qualification rate and other assessment indicators. Managers can use this data to understand production status in real time and make adjustments to production planning and quality control.",
  "ddl": "-- Schema for database: rschema_0017\nCREATE TABLE `workshop` (\n  `workshop_id` int(11) NOT NULL AUTO_INCREMENT,\n  `workshop_name` varchar(255) NOT NULL,\n  `address` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`workshop_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `worker` (\n  `worker_id` int(11) NOT NULL AUTO_INCREMENT,\n  `workshop_id` int(11) NOT NULL,\n  `worker_name` varchar(255) NOT NULL,\n  `contact_number` varchar(50) DEFAULT NULL,\n  PRIMARY KEY (`worker_id`),\n  KEY `worker_ibfk_1` (`workshop_id`),\n  CONSTRAINT `worker_ibfk_1` FOREIGN KEY (`workshop_id`) REFERENCES `workshop` (`workshop_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `processing_record` (\n  `record_id` int(11) NOT NULL AUTO_INCREMENT,\n  `worker_id` int(11) NOT NULL,\n  `raw_material_name` varchar(255) NOT NULL,\n  `processing_time` datetime NOT NULL,\n  `product_name` varchar(255) NOT NULL,\n  `production_quantity` int(11) NOT NULL,\n  `product_quality_rating` varchar(50) NOT NULL,\n  PRIMARY KEY (`record_id`),\n  KEY `processing_record_ibfk_1` (`worker_id`),\n  CONSTRAINT `processing_record_ibfk_1` FOREIGN KEY (`worker_id`) REFERENCES `worker` (`worker_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `raw_material_inventory` (\n  `inventory_id` int(11) NOT NULL AUTO_INCREMENT,\n  `workshop_id` int(11) NOT NULL,\n  `raw_material_name` varchar(255) NOT NULL,\n  `inventory_quantity` int(11) NOT NULL,\n  PRIMARY KEY (`inventory_id`),\n  KEY `raw_material_inventory_ibfk_1` (`workshop_id`),\n  CONSTRAINT `raw_material_inventory_ibfk_1` FOREIGN KEY (`workshop_id`) REFERENCES `workshop` (`workshop_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `workshop_performance` (\n  `performance_id` int(11) NOT NULL AUTO_INCREMENT,\n  `workshop_id` int(11) NOT NULL,\n  `performance_month` char(7) NOT NULL,\n  `monthly_total_processing_volume` int(11) NOT NULL,\n  `product_qualification_rate` decimal(5,2) NOT NULL,\n  `assessment_indicators` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`performance_id`),\n  KEY `workshop_performance_ibfk_1` (`workshop_id`),\n  CONSTRAINT `workshop_performance_ibfk_1` FOREIGN KEY (`workshop_id`) REFERENCES `workshop` (`workshop_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
