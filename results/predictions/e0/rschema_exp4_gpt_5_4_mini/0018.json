  "database": "rschema_0018",
  "question": "The business requirements for a company's equipment management system are as follows: The company owns various types of equipment, each with a unique Equipment ID, name, model, and usage frequency. To effectively manage the equipment, the system needs to record each equipment's usage, including usage time, user, and location. It should also track the equipment's maintenance history, including maintenance time, maintenance content, and maintenance personnel. The system must manage equipment information, usage records, and maintenance records to enable querying of equipment usage and maintenance history.",
  "ddl": "-- Schema for database: rschema_0018\nCREATE TABLE `equipment` (\n  `equipment_id` int(11) NOT NULL,\n  `equipment_name` varchar(255) NOT NULL,\n  `model` varchar(255) NOT NULL,\n  `usage_frequency` int(11) NOT NULL,\n  PRIMARY KEY (`equipment_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `equipment_usage_record` (\n  `usage_record_id` int(11) NOT NULL,\n  `equipment_id` int(11) NOT NULL,\n  `usage_time` datetime NOT NULL,\n  `user_name` varchar(255) NOT NULL,\n  `location` varchar(255) NOT NULL,\n  PRIMARY KEY (`usage_record_id`),\n  KEY `equipment_usage_record_ibfk_1` (`equipment_id`),\n  CONSTRAINT `equipment_usage_record_ibfk_1` FOREIGN KEY (`equipment_id`) REFERENCES `equipment` (`equipment_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `equipment_maintenance_record` (\n  `maintenance_record_id` int(11) NOT NULL,\n  `equipment_id` int(11) NOT NULL,\n  `maintenance_time` datetime NOT NULL,\n  `maintenance_content` varchar(500) NOT NULL,\n  `maintenance_personnel` varchar(255) NOT NULL,\n  PRIMARY KEY (`maintenance_record_id`),\n  KEY `equipment_maintenance_record_ibfk_1` (`equipment_id`),\n  CONSTRAINT `equipment_maintenance_record_ibfk_1` FOREIGN KEY (`equipment_id`) REFERENCES `equipment` (`equipment_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
