  "database": "rschema_0022",
  "question": "A national agency requires management of the document circulation process, including approval, archiving, and querying of documents.\nDocuments have a document ID, name, category, creation time, and status;\nApproval records include document ID, approver, approval time, and approval comments;\nArchiving records include document ID, archivist, archiving time, and archiving location;\nQuery records include document ID, query personnel, query time, and query results;\nThe approval and querying operations of documents can occur multiple times, whereas archiving occurs only once.\nDocument management personnel are responsible for approving, archiving, and querying documents; they have employee ID, name, gender, position, and contact information.",
  "ddl": "-- Schema for database: rschema_0022\nCREATE TABLE `document_management_personnel` (\n  `employee_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `gender` varchar(20) DEFAULT NULL,\n  `position` varchar(255) DEFAULT NULL,\n  `contact_information` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`employee_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `documents` (\n  `document_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `category` varchar(255) DEFAULT NULL,\n  `creation_time` datetime NOT NULL,\n  `status` varchar(50) NOT NULL,\n  PRIMARY KEY (`document_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `approval_records` (\n  `approval_record_id` int(11) NOT NULL AUTO_INCREMENT,\n  `document_id` int(11) NOT NULL,\n  `approver_employee_id` int(11) NOT NULL,\n  `approval_time` datetime NOT NULL,\n  `approval_comments` text DEFAULT NULL,\n  PRIMARY KEY (`approval_record_id`),\n  KEY `approval_records_ibfk_1` (`document_id`),\n  KEY `approval_records_ibfk_2` (`approver_employee_id`),\n  CONSTRAINT `approval_records_ibfk_1` FOREIGN KEY (`document_id`) REFERENCES `documents` (`document_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `approval_records_ibfk_2` FOREIGN KEY (`approver_employee_id`) REFERENCES `document_management_personnel` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `archiving_records` (\n  `document_id` int(11) NOT NULL,\n  `archivist_employee_id` int(11) NOT NULL,\n  `archiving_time` datetime NOT NULL,\n  `archiving_location` varchar(255) NOT NULL,\n  PRIMARY KEY (`document_id`),\n  KEY `archiving_records_ibfk_1` (`archivist_employee_id`),\n  CONSTRAINT `archiving_records_ibfk_1` FOREIGN KEY (`archivist_employee_id`) REFERENCES `document_management_personnel` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `archiving_records_ibfk_2` FOREIGN KEY (`document_id`) REFERENCES `documents` (`document_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `query_records` (\n  `query_record_id` int(11) NOT NULL AUTO_INCREMENT,\n  `document_id` int(11) NOT NULL,\n  `query_personnel_employee_id` int(11) NOT NULL,\n  `query_time` datetime NOT NULL,\n  `query_results` text DEFAULT NULL,\n  PRIMARY KEY (`query_record_id`),\n  KEY `query_records_ibfk_1` (`document_id`),\n  KEY `query_records_ibfk_2` (`query_personnel_employee_id`),\n  CONSTRAINT `query_records_ibfk_1` FOREIGN KEY (`document_id`) REFERENCES `documents` (`document_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `query_records_ibfk_2` FOREIGN KEY (`query_personnel_employee_id`) REFERENCES `document_management_personnel` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
