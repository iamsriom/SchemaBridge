  "question": "A mass organization needs to manage donation affairs, including donors, recipients, donation records and donated items.\nDonors have donor number, name, gender, date of birth and contact information;\nRecipients have recipient number, name, gender, date of birth and contact information;\nDonation records include donor number, recipient number, donation time and donated items;\nDonated items have item number, name, quantity and description. The system also needs to be able to count the number of donations made by each donor.",
  "ddl": "-- Schema for database: rschema_0023\nCREATE TABLE `donors` (\n  `donor_no` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `gender` char(1) DEFAULT NULL,\n  `date_of_birth` date DEFAULT NULL,\n  `contact_information` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`donor_no`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `recipients` (\n  `recipient_no` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `gender` char(1) DEFAULT NULL,\n  `date_of_birth` date DEFAULT NULL,\n  `contact_information` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`recipient_no`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `donated_items` (\n  `item_no` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `quantity` int(11) NOT NULL,\n  `description` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`item_no`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `donation_records` (\n  `donation_no` int(11) NOT NULL,\n  `donor_no` int(11) NOT NULL,\n  `recipient_no` int(11) NOT NULL,\n  `donation_time` datetime NOT NULL,\n  `item_no` int(11) NOT NULL,\n  PRIMARY KEY (`donation_no`),\n  KEY `donation_records_ibfk_1` (`donor_no`),\n  KEY `donation_records_ibfk_2` (`recipient_no`),\n  KEY `donation_records_ibfk_3` (`item_no`),\n  CONSTRAINT `donation_records_ibfk_1` FOREIGN KEY (`donor_no`) REFERENCES `donors` (`donor_no`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `donation_records_ibfk_2` FOREIGN KEY (`recipient_no`) REFERENCES `recipients` (`recipient_no`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `donation_records_ibfk_3` FOREIGN KEY (`item_no`) REFERENCES `donated_items` (`item_no`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
