  "database": "rschema_0024",
  "question": "The management system of agricultural and sideline products processing enterprises aims to achieve the whole process management from acquisition, processing to sales, and record, track and analyze the operation of enterprises through a unified platform. The system not only includes product, employee and department management, but also covers the records of acquisition, processing, sales and other links. Agricultural and sideline products have information such as name, origin, acquisition price, processing cost, and sales price. Multiple departments of the enterprise collaborate, and each department has information such as department name, person in charge, contact information, total number of department personnel, and department responsibilities. Employee management includes employee number, name, gender, telephone number, position and entry time. Each time you purchase, you need to record the purchased products, quantity, purchaser information, consignor, purchase time, consignor telephone number, shipping address, shipping time, etc. When processing, record the processed products, quantity, processor, and processing time. When selling, record the sold products, quantity, salesperson, customer, sales time, and sales price.",
  "ddl": "-- Schema for database: rschema_0024\nCREATE TABLE `product` (\n  `product_id` int(11) NOT NULL AUTO_INCREMENT,\n  `product_name` varchar(255) NOT NULL,\n  `origin` varchar(255) DEFAULT NULL,\n  `purchase_price` decimal(10,2) DEFAULT NULL,\n  `processing_cost` decimal(10,2) DEFAULT NULL,\n  `sales_price` decimal(10,2) DEFAULT NULL,\n  PRIMARY KEY (`product_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `department` (\n  `department_id` int(11) NOT NULL AUTO_INCREMENT,\n  `department_name` varchar(255) NOT NULL,\n  `manager_name` varchar(255) DEFAULT NULL,\n  `contact_phone` varchar(20) DEFAULT NULL,\n  `employee_count` int(11) DEFAULT NULL,\n  `responsibilities` varchar(500) DEFAULT NULL,\n  PRIMARY KEY (`department_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `employee` (\n  `employee_id` int(11) NOT NULL AUTO_INCREMENT,\n  `employee_no` varchar(50) NOT NULL,\n  `employee_name` varchar(255) NOT NULL,\n  `gender` varchar(10) DEFAULT NULL,\n  `phone_number` varchar(20) DEFAULT NULL,\n  `position` varchar(100) DEFAULT NULL,\n  `entry_time` datetime DEFAULT NULL,\n  `department_id` int(11) DEFAULT NULL,\n  PRIMARY KEY (`employee_id`),\n  UNIQUE KEY `employee_no` (`employee_no`),\n  KEY `employee_ibfk_1` (`department_id`),\n  CONSTRAINT `employee_ibfk_1` FOREIGN KEY (`department_id`) REFERENCES `department` (`department_id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `purchase_record` (\n  `purchase_id` int(11) NOT NULL AUTO_INCREMENT,\n  `product_id` int(11) NOT NULL,\n  `quantity` int(11) NOT NULL,\n  `purchaser_id` int(11) DEFAULT NULL,\n  `consignor_name` varchar(255) DEFAULT NULL,\n  `purchase_time` datetime DEFAULT NULL,\n  `consignor_phone` varchar(20) DEFAULT NULL,\n  `shipping_address` varchar(500) DEFAULT NULL,\n  `shipping_time` datetime DEFAULT NULL,\n  PRIMARY KEY (`purchase_id`),\n  KEY `purchase_record_ibfk_1` (`product_id`),\n  KEY `purchase_record_ibfk_2` (`purchaser_id`),\n  CONSTRAINT `purchase_record_ibfk_1` FOREIGN KEY (`product_id`) REFERENCES `product` (`product_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `purchase_record_ibfk_2` FOREIGN KEY (`purchaser_id`) REFERENCES `employee` (`employee_id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `processing_record` (\n  `processing_id` int(11) NOT NULL AUTO_INCREMENT,\n  `product_id` int(11) NOT NULL,\n  `quantity` int(11) NOT NULL,\n  `processor_id` int(11) DEFAULT NULL,\n  `processing_time` datetime DEFAULT NULL,\n  PRIMARY KEY (`processing_id`),\n  KEY `processing_record_ibfk_1` (`product_id`),\n  KEY `processing_record_ibfk_2` (`processor_id`),\n  CONSTRAINT `processing_record_ibfk_1` FOREIGN KEY (`product_id`) REFERENCES `product` (`product_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `processing_record_ibfk_2` FOREIGN KEY (`processor_id`) REFERENCES `employee` (`employee_id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `sales_record` (\n  `sales_id` int(11) NOT NULL AUTO_INCREMENT,\n  `product_id` int(11) NOT NULL,\n  `quantity` int(11) NOT NULL,\n  `salesperson_id` int(11) DEFAULT NULL,\n  `customer_name` varchar(255) DEFAULT NULL,\n  `sales_time` datetime DEFAULT NULL,\n  `sales_price` decimal(10,2) DEFAULT NULL,\n  PRIMARY KEY (`sales_id`),\n  KEY `sales_record_ibfk_1` (`product_id`),\n  KEY `sales_record_ibfk_2` (`salesperson_id`),\n  CONSTRAINT `sales_record_ibfk_1` FOREIGN KEY (`product_id`) REFERENCES `product` (`product_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `sales_record_ibfk_2` FOREIGN KEY (`salesperson_id`) REFERENCES `employee` (`employee_id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
