  "database": "rschema_0025",
  "question": "The tobacco product enterprise management system needs to comprehensively manage the company's tobacco products from production, inventory, sales and other aspects. The system should support functions such as detailed records of tobacco products, sales tracking, and production process monitoring, and be able to generate various reports to help management make scientific decisions. At the same time, the system should also have the functions of department collaboration, employee management, and department performance appraisal to improve the overall operational efficiency of the enterprise. Tobacco has information such as name, type, production date, shelf life, price, and production batch number. Multiple departments of the enterprise collaborate, and each department has a department name, person in charge, and contact information. Employee management includes employee number, name, gender, telephone number, and position. Each time production is carried out, the products, quantity, producer, and production time produced must be recorded. When selling, the products, quantity, salesperson, customer, and sales time sold must be recorded.",
  "ddl": "-- Schema for database: rschema_0025\nCREATE TABLE `tobacco_products` (\n  `product_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `type` varchar(100) NOT NULL,\n  `production_date` date NOT NULL,\n  `shelf_life` int(11) NOT NULL,\n  `price` decimal(10,2) NOT NULL,\n  `production_batch_number` varchar(100) NOT NULL,\n  PRIMARY KEY (`product_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `departments` (\n  `department_id` int(11) NOT NULL AUTO_INCREMENT,\n  `department_name` varchar(255) NOT NULL,\n  `person_in_charge` varchar(255) NOT NULL,\n  `contact_information` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`department_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `employees` (\n  `employee_id` int(11) NOT NULL AUTO_INCREMENT,\n  `employee_number` varchar(50) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `gender` varchar(10) NOT NULL,\n  `telephone_number` varchar(20) DEFAULT NULL,\n  `position` varchar(100) NOT NULL,\n  `department_id` int(11) DEFAULT NULL,\n  PRIMARY KEY (`employee_id`),\n  UNIQUE KEY `employee_number` (`employee_number`),\n  KEY `department_id` (`department_id`),\n  CONSTRAINT `employees_ibfk_1` FOREIGN KEY (`department_id`) REFERENCES `departments` (`department_id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `production_records` (\n  `production_record_id` int(11) NOT NULL AUTO_INCREMENT,\n  `product_id` int(11) NOT NULL,\n  `quantity` int(11) NOT NULL,\n  `producer_id` int(11) NOT NULL,\n  `production_time` datetime NOT NULL,\n  PRIMARY KEY (`production_record_id`),\n  KEY `product_id` (`product_id`),\n  KEY `producer_id` (`producer_id`),\n  CONSTRAINT `production_records_ibfk_1` FOREIGN KEY (`product_id`) REFERENCES `tobacco_products` (`product_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `production_records_ibfk_2` FOREIGN KEY (`producer_id`) REFERENCES `employees` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `sales_records` (\n  `sales_record_id` int(11) NOT NULL AUTO_INCREMENT,\n  `product_id` int(11) NOT NULL,\n  `quantity` int(11) NOT NULL,\n  `salesperson_id` int(11) NOT NULL,\n  `customer` varchar(255) NOT NULL,\n  `sales_time` datetime NOT NULL,\n  PRIMARY KEY (`sales_record_id`),\n  KEY `product_id` (`product_id`),\n  KEY `salesperson_id` (`salesperson_id`),\n  CONSTRAINT `sales_records_ibfk_1` FOREIGN KEY (`product_id`) REFERENCES `tobacco_products` (`product_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `sales_records_ibfk_2` FOREIGN KEY (`salesperson_id`) REFERENCES `employees` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
