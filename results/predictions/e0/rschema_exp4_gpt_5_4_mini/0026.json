  "database": "rschema_0026",
  "question": "A textile enterprise needs to manage the production, inventory, and sales of textiles. Each textile has information such as name, type, production date, and price. The enterprise has multiple departments, and each department has a name, manager, and contact information. Employee management includes employee ID, name, gender, phone, and position. For each production, the system needs to record the produced product, quantity, producer, and production time. For inventory management, the system should record the products in stock, quantity, and stock-in time. For sales, the system should record the products sold, quantity, sales personnel, customer, and sales time. The system should also support performance evaluation for each department. The performance evaluation should record the evaluation date and performance score of each employee.",
  "ddl": "-- Schema for database: rschema_0026\nCREATE TABLE `textile` (\n  `textile_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `type` varchar(100) NOT NULL,\n  `production_date` date DEFAULT NULL,\n  `price` decimal(10,2) NOT NULL,\n  PRIMARY KEY (`textile_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `department` (\n  `department_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `manager` varchar(255) DEFAULT NULL,\n  `contact_info` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`department_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `employee` (\n  `employee_id` int(11) NOT NULL AUTO_INCREMENT,\n  `department_id` int(11) DEFAULT NULL,\n  `name` varchar(255) NOT NULL,\n  `gender` char(1) DEFAULT NULL,\n  `phone` varchar(20) DEFAULT NULL,\n  `position` varchar(100) DEFAULT NULL,\n  PRIMARY KEY (`employee_id`),\n  KEY `department_id` (`department_id`),\n  CONSTRAINT `employee_ibfk_1` FOREIGN KEY (`department_id`) REFERENCES `department` (`department_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `production_record` (\n  `production_id` int(11) NOT NULL AUTO_INCREMENT,\n  `textile_id` int(11) NOT NULL,\n  `quantity` int(11) NOT NULL,\n  `producer_id` int(11) DEFAULT NULL,\n  `production_time` datetime NOT NULL,\n  PRIMARY KEY (`production_id`),\n  KEY `textile_id` (`textile_id`),\n  KEY `producer_id` (`producer_id`),\n  CONSTRAINT `production_record_ibfk_1` FOREIGN KEY (`textile_id`) REFERENCES `textile` (`textile_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `production_record_ibfk_2` FOREIGN KEY (`producer_id`) REFERENCES `employee` (`employee_id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `inventory_record` (\n  `inventory_id` int(11) NOT NULL AUTO_INCREMENT,\n  `textile_id` int(11) NOT NULL,\n  `quantity` int(11) NOT NULL,\n  `stock_in_time` datetime NOT NULL,\n  PRIMARY KEY (`inventory_id`),\n  KEY `textile_id` (`textile_id`),\n  CONSTRAINT `inventory_record_ibfk_1` FOREIGN KEY (`textile_id`) REFERENCES `textile` (`textile_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `sales_record` (\n  `sales_id` int(11) NOT NULL AUTO_INCREMENT,\n  `textile_id` int(11) NOT NULL,\n  `quantity` int(11) NOT NULL,\n  `sales_person_id` int(11) DEFAULT NULL,\n  `customer` varchar(255) DEFAULT NULL,\n  `sales_time` datetime NOT NULL,\n  PRIMARY KEY (`sales_id`),\n  KEY `textile_id` (`textile_id`),\n  KEY `sales_person_id` (`sales_person_id`),\n  CONSTRAINT `sales_record_ibfk_1` FOREIGN KEY (`textile_id`) REFERENCES `textile` (`textile_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `sales_record_ibfk_2` FOREIGN KEY (`sales_person_id`) REFERENCES `employee` (`employee_id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `performance_evaluation` (\n  `evaluation_id` int(11) NOT NULL AUTO_INCREMENT,\n  `department_id` int(11) NOT NULL,\n  `employee_id` int(11) NOT NULL,\n  `evaluation_date` date NOT NULL,\n  `performance_score` decimal(5,2) NOT NULL,\n  PRIMARY KEY (`evaluation_id`),\n  KEY `department_id` (`department_id`),\n  KEY `employee_id` (`employee_id`),\n  CONSTRAINT `performance_evaluation_ibfk_1` FOREIGN KEY (`department_id`) REFERENCES `department` (`department_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `performance_evaluation_ibfk_2` FOREIGN KEY (`employee_id`) REFERENCES `employee` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
