  "database": "rschema_0027",
  "question": "The textile and apparel company needs to manage clothing production, inventory, and sales, so a high-performance database is used to manage the entire production line. Clothing has information such as name, style, production date, and price. Multiple departments in the company collaborate, and each department has a department name, person in charge, and contact information. Employee management includes employee ID, name, gender, phone number, and position. During each production, the products produced, quantity, producer, and production time need to be recorded. During inventory management, the products in stock, quantity, and storage time are recorded. During sales, the products sold, quantity, salesperson, customer, and sales time are recorded. The system needs to support performance appraisal of each department.",
  "ddl": "-- Schema for database: rschema_0027\nCREATE TABLE `clothing` (\n  `clothing_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `style` varchar(255) NOT NULL,\n  `production_date` date NOT NULL,\n  `price` decimal(10,2) NOT NULL,\n  PRIMARY KEY (`clothing_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `department` (\n  `department_id` int(11) NOT NULL AUTO_INCREMENT,\n  `department_name` varchar(255) NOT NULL,\n  `person_in_charge` varchar(255) NOT NULL,\n  `contact_info` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`department_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `employee` (\n  `employee_id` int(11) NOT NULL AUTO_INCREMENT,\n  `employee_code` varchar(50) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `gender` char(1) NOT NULL,\n  `phone_number` varchar(20) DEFAULT NULL,\n  `position` varchar(255) NOT NULL,\n  `department_id` int(11) DEFAULT NULL,\n  PRIMARY KEY (`employee_id`),\n  UNIQUE KEY `employee_code` (`employee_code`),\n  KEY `department_id` (`department_id`),\n  CONSTRAINT `employee_ibfk_1` FOREIGN KEY (`department_id`) REFERENCES `department` (`department_id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `production_record` (\n  `production_id` int(11) NOT NULL AUTO_INCREMENT,\n  `clothing_id` int(11) NOT NULL,\n  `quantity` int(11) NOT NULL,\n  `producer_id` int(11) NOT NULL,\n  `production_time` datetime NOT NULL,\n  PRIMARY KEY (`production_id`),\n  KEY `clothing_id` (`clothing_id`),\n  KEY `producer_id` (`producer_id`),\n  CONSTRAINT `production_record_ibfk_1` FOREIGN KEY (`clothing_id`) REFERENCES `clothing` (`clothing_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `production_record_ibfk_2` FOREIGN KEY (`producer_id`) REFERENCES `employee` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `inventory_record` (\n  `inventory_id` int(11) NOT NULL AUTO_INCREMENT,\n  `clothing_id` int(11) NOT NULL,\n  `quantity` int(11) NOT NULL,\n  `storage_time` datetime NOT NULL,\n  PRIMARY KEY (`inventory_id`),\n  KEY `clothing_id` (`clothing_id`),\n  CONSTRAINT `inventory_record_ibfk_1` FOREIGN KEY (`clothing_id`) REFERENCES `clothing` (`clothing_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `sales_record` (\n  `sales_id` int(11) NOT NULL AUTO_INCREMENT,\n  `clothing_id` int(11) NOT NULL,\n  `quantity` int(11) NOT NULL,\n  `salesperson_id` int(11) NOT NULL,\n  `customer_name` varchar(255) NOT NULL,\n  `sales_time` datetime NOT NULL,\n  PRIMARY KEY (`sales_id`),\n  KEY `clothing_id` (`clothing_id`),\n  KEY `salesperson_id` (`salesperson_id`),\n  CONSTRAINT `sales_record_ibfk_1` FOREIGN KEY (`clothing_id`) REFERENCES `clothing` (`clothing_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `sales_record_ibfk_2` FOREIGN KEY (`salesperson_id`) REFERENCES `employee` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `department_appraisal` (\n  `appraisal_id` int(11) NOT NULL AUTO_INCREMENT,\n  `department_id` int(11) NOT NULL,\n  `appraisal_period` varchar(50) NOT NULL,\n  `score` decimal(5,2) NOT NULL,\n  `remarks` varchar(255) DEFAULT NULL,\n  `appraisal_time` datetime NOT NULL,\n  PRIMARY KEY (`appraisal_id`),\n  KEY `department_id` (`department_id`),\n  CONSTRAINT `department_appraisal_ibfk_1` FOREIGN KEY (`department_id`) REFERENCES `department` (`department_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
