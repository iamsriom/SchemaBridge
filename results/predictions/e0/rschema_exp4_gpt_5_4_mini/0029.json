  "database": "rschema_0029",
  "question": "A furniture manufacturing enterprise requires management of furniture production, inventory, and sales. Furniture products contain information including product name, type, production date, and price. Multiple departments collaborate within the enterprise, with each department containing department name, supervisor, and contact information. Employee management includes employee number, name, gender, phone number, and position. For each production event, the system shall record the produced product, quantity, producer, and production time. For inventory management, the system shall record the product in stock, quantity, and storage time. For sales transactions, the system shall record the sold product, quantity, sales representative, customer, and sales time. The system shall support performance evaluation for all departments.",
  "ddl": "-- Schema for database: rschema_0029\nCREATE TABLE `furniture_product` (\n  `product_id` int(11) NOT NULL AUTO_INCREMENT,\n  `product_name` varchar(255) NOT NULL,\n  `product_type` varchar(255) NOT NULL,\n  `production_date` date DEFAULT NULL,\n  `price` decimal(10,2) NOT NULL,\n  PRIMARY KEY (`product_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `department` (\n  `department_id` int(11) NOT NULL AUTO_INCREMENT,\n  `department_name` varchar(255) NOT NULL,\n  `supervisor` varchar(255) DEFAULT NULL,\n  `contact_info` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`department_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `employee` (\n  `employee_id` int(11) NOT NULL AUTO_INCREMENT,\n  `employee_number` varchar(50) NOT NULL,\n  `employee_name` varchar(255) NOT NULL,\n  `gender` char(1) NOT NULL,\n  `phone_number` varchar(20) DEFAULT NULL,\n  `position` varchar(255) NOT NULL,\n  `department_id` int(11) DEFAULT NULL,\n  PRIMARY KEY (`employee_id`),\n  UNIQUE KEY `uk_employee_number` (`employee_number`),\n  KEY `employee_ibfk_1` (`department_id`),\n  CONSTRAINT `employee_ibfk_1` FOREIGN KEY (`department_id`) REFERENCES `department` (`department_id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `production_event` (\n  `production_event_id` int(11) NOT NULL AUTO_INCREMENT,\n  `product_id` int(11) NOT NULL,\n  `quantity` int(11) NOT NULL,\n  `producer_id` int(11) NOT NULL,\n  `production_time` datetime NOT NULL,\n  PRIMARY KEY (`production_event_id`),\n  KEY `production_event_ibfk_1` (`product_id`),\n  KEY `production_event_ibfk_2` (`producer_id`),\n  CONSTRAINT `production_event_ibfk_1` FOREIGN KEY (`product_id`) REFERENCES `furniture_product` (`product_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `production_event_ibfk_2` FOREIGN KEY (`producer_id`) REFERENCES `employee` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `inventory_record` (\n  `inventory_record_id` int(11) NOT NULL AUTO_INCREMENT,\n  `product_id` int(11) NOT NULL,\n  `quantity` int(11) NOT NULL,\n  `storage_time` datetime NOT NULL,\n  PRIMARY KEY (`inventory_record_id`),\n  KEY `inventory_record_ibfk_1` (`product_id`),\n  CONSTRAINT `inventory_record_ibfk_1` FOREIGN KEY (`product_id`) REFERENCES `furniture_product` (`product_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `sales_transaction` (\n  `sales_transaction_id` int(11) NOT NULL AUTO_INCREMENT,\n  `product_id` int(11) NOT NULL,\n  `quantity` int(11) NOT NULL,\n  `sales_rep_id` int(11) NOT NULL,\n  `customer_name` varchar(255) NOT NULL,\n  `sales_time` datetime NOT NULL,\n  PRIMARY KEY (`sales_transaction_id`),\n  KEY `sales_transaction_ibfk_1` (`product_id`),\n  KEY `sales_transaction_ibfk_2` (`sales_rep_id`),\n  CONSTRAINT `sales_transaction_ibfk_1` FOREIGN KEY (`product_id`) REFERENCES `furniture_product` (`product_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `sales_transaction_ibfk_2` FOREIGN KEY (`sales_rep_id`) REFERENCES `employee` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `department_performance` (\n  `performance_id` int(11) NOT NULL AUTO_INCREMENT,\n  `department_id` int(11) NOT NULL,\n  `evaluation_period` varchar(50) NOT NULL,\n  `performance_score` decimal(5,2) NOT NULL,\n  `evaluation_time` datetime NOT NULL,\n  `remarks` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`performance_id`),\n  KEY `department_performance_ibfk_1` (`department_id`),\n  CONSTRAINT `department_performance_ibfk_1` FOREIGN KEY (`department_id`) REFERENCES `department` (`department_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
