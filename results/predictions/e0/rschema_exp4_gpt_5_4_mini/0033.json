  "question": "An electronic product sales company sells products such as mobile phones, computers, and other electronic goods. Each product has information including name, model, and price. The company has multiple sales teams, each with a team ID, team name, manager, and contact information. Each team has multiple sales personnel, whose details include name, phone number, position, and gender. Each sales task includes customer information (customer name, customer phone number), product details (product name, model, price), sales date, quantity, and sales cost. After the sale, customer feedback and rating need to be recorded.",
  "ddl": "-- Schema for database: rschema_0033\nCREATE TABLE `sales_team` (\n  `team_id` int(11) NOT NULL AUTO_INCREMENT,\n  `team_name` varchar(255) NOT NULL,\n  `manager_name` varchar(255) NOT NULL,\n  `contact_info` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`team_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `sales_personnel` (\n  `personnel_id` int(11) NOT NULL AUTO_INCREMENT,\n  `team_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `phone_number` varchar(50) DEFAULT NULL,\n  `position` varchar(100) DEFAULT NULL,\n  `gender` char(1) DEFAULT NULL,\n  PRIMARY KEY (`personnel_id`),\n  KEY `sales_personnel_ibfk_1` (`team_id`),\n  CONSTRAINT `sales_personnel_ibfk_1` FOREIGN KEY (`team_id`) REFERENCES `sales_team` (`team_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `product` (\n  `product_id` int(11) NOT NULL AUTO_INCREMENT,\n  `product_name` varchar(255) NOT NULL,\n  `model` varchar(255) NOT NULL,\n  `price` decimal(10,2) NOT NULL,\n  PRIMARY KEY (`product_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `sales_task` (\n  `task_id` int(11) NOT NULL AUTO_INCREMENT,\n  `personnel_id` int(11) NOT NULL,\n  `customer_name` varchar(255) NOT NULL,\n  `customer_phone_number` varchar(50) DEFAULT NULL,\n  `product_id` int(11) NOT NULL,\n  `sales_date` datetime NOT NULL,\n  `quantity` int(11) NOT NULL,\n  `sales_cost` decimal(10,2) NOT NULL,\n  `customer_feedback` text DEFAULT NULL,\n  `rating` int(11) DEFAULT NULL,\n  PRIMARY KEY (`task_id`),\n  KEY `sales_task_ibfk_1` (`personnel_id`),\n  KEY `sales_task_ibfk_2` (`product_id`),\n  CONSTRAINT `sales_task_ibfk_1` FOREIGN KEY (`personnel_id`) REFERENCES `sales_personnel` (`personnel_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `sales_task_ibfk_2` FOREIGN KEY (`product_id`) REFERENCES `product` (`product_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
