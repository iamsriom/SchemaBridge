  "question": "The Company Manages Multiple Civil Engineering Projects\nEach project has a project ID, name, location, start date, expected completion date, actual completion date, and is supervised by a project manager. Each building is part of a project and records the number of floors, area, and price. Sales records track the sales status of buildings, involving sales personnel and customer information. The sales personnel include their ID, name, position, and contact information. The project manager includes their ID, name, position, and contact information.",
  "ddl": "-- Schema for database: rschema_0039\nCREATE TABLE `project_manager` (\n  `manager_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `position` varchar(255) NOT NULL,\n  `contact_info` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`manager_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `project` (\n  `project_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `location` varchar(255) NOT NULL,\n  `start_date` date NOT NULL,\n  `expected_completion_date` date DEFAULT NULL,\n  `actual_completion_date` date DEFAULT NULL,\n  `manager_id` int(11) NOT NULL,\n  PRIMARY KEY (`project_id`),\n  KEY `project_ibfk_1` (`manager_id`),\n  CONSTRAINT `project_ibfk_1` FOREIGN KEY (`manager_id`) REFERENCES `project_manager` (`manager_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `building` (\n  `building_id` int(11) NOT NULL,\n  `project_id` int(11) NOT NULL,\n  `number_of_floors` int(11) NOT NULL,\n  `area` decimal(10,2) NOT NULL,\n  `price` decimal(12,2) NOT NULL,\n  PRIMARY KEY (`building_id`),\n  KEY `building_ibfk_1` (`project_id`),\n  CONSTRAINT `building_ibfk_1` FOREIGN KEY (`project_id`) REFERENCES `project` (`project_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `sales_personnel` (\n  `sales_personnel_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `position` varchar(255) NOT NULL,\n  `contact_info` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`sales_personnel_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `sales_record` (\n  `sales_record_id` int(11) NOT NULL,\n  `building_id` int(11) NOT NULL,\n  `sales_personnel_id` int(11) NOT NULL,\n  `customer_name` varchar(255) NOT NULL,\n  `customer_contact_info` varchar(255) DEFAULT NULL,\n  `sales_status` varchar(100) NOT NULL,\n  PRIMARY KEY (`sales_record_id`),\n  KEY `sales_record_ibfk_1` (`building_id`),\n  KEY `sales_record_ibfk_2` (`sales_personnel_id`),\n  CONSTRAINT `sales_record_ibfk_1` FOREIGN KEY (`building_id`) REFERENCES `building` (`building_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `sales_record_ibfk_2` FOREIGN KEY (`sales_personnel_id`) REFERENCES `sales_personnel` (`sales_personnel_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
