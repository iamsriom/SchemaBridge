  "question": "A wholesaler needs to manage its inventory, including multiple warehouses and the goods in the warehouses. Each warehouse has a warehouse number, name, and address. Each product has a product number, name, model, barcode, price, and inventory quantity. The warehouse must conduct regular inventory counts and record the inventory time, inventory counter, good number, and inventory quantity. When the goods are shipped out, the shipment time, shipment quantity, shipment person, and receiving unit need to be recorded. The system also needs to conduct performance appraisals on the warehouse, and the appraisal indicators include inventory accuracy and shipment efficiency.",
  "ddl": "-- Schema for database: rschema_0045\nCREATE TABLE `warehouse` (\n  `warehouse_id` int(11) NOT NULL AUTO_INCREMENT,\n  `warehouse_number` varchar(50) NOT NULL,\n  `warehouse_name` varchar(255) NOT NULL,\n  `address` varchar(255) NOT NULL,\n  PRIMARY KEY (`warehouse_id`),\n  UNIQUE KEY `warehouse_number` (`warehouse_number`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `product` (\n  `product_id` int(11) NOT NULL AUTO_INCREMENT,\n  `product_number` varchar(50) NOT NULL,\n  `product_name` varchar(255) NOT NULL,\n  `model` varchar(255) DEFAULT NULL,\n  `barcode` varchar(100) DEFAULT NULL,\n  `price` decimal(10,2) NOT NULL,\n  `inventory_quantity` int(11) NOT NULL,\n  PRIMARY KEY (`product_id`),\n  UNIQUE KEY `product_number` (`product_number`),\n  UNIQUE KEY `barcode` (`barcode`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `inventory_count` (\n  `inventory_count_id` int(11) NOT NULL AUTO_INCREMENT,\n  `warehouse_id` int(11) NOT NULL,\n  `product_id` int(11) NOT NULL,\n  `inventory_time` datetime NOT NULL,\n  `inventory_counter` varchar(255) NOT NULL,\n  `inventory_quantity` int(11) NOT NULL,\n  PRIMARY KEY (`inventory_count_id`),\n  KEY `warehouse_id` (`warehouse_id`),\n  KEY `product_id` (`product_id`),\n  CONSTRAINT `inventory_count_ibfk_1` FOREIGN KEY (`warehouse_id`) REFERENCES `warehouse` (`warehouse_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `inventory_count_ibfk_2` FOREIGN KEY (`product_id`) REFERENCES `product` (`product_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `shipment` (\n  `shipment_id` int(11) NOT NULL AUTO_INCREMENT,\n  `warehouse_id` int(11) NOT NULL,\n  `product_id` int(11) NOT NULL,\n  `shipment_time` datetime NOT NULL,\n  `shipment_quantity` int(11) NOT NULL,\n  `shipment_person` varchar(255) NOT NULL,\n  `receiving_unit` varchar(255) NOT NULL,\n  PRIMARY KEY (`shipment_id`),\n  KEY `warehouse_id` (`warehouse_id`),\n  KEY `product_id` (`product_id`),\n  CONSTRAINT `shipment_ibfk_1` FOREIGN KEY (`warehouse_id`) REFERENCES `warehouse` (`warehouse_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `shipment_ibfk_2` FOREIGN KEY (`product_id`) REFERENCES `product` (`product_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `warehouse_appraisal` (\n  `appraisal_id` int(11) NOT NULL AUTO_INCREMENT,\n  `warehouse_id` int(11) NOT NULL,\n  `appraisal_time` datetime NOT NULL,\n  `inventory_accuracy` decimal(5,2) NOT NULL,\n  `shipment_efficiency` decimal(5,2) NOT NULL,\n  PRIMARY KEY (`appraisal_id`),\n  KEY `warehouse_id` (`warehouse_id`),\n  CONSTRAINT `warehouse_appraisal_ibfk_1` FOREIGN KEY (`warehouse_id`) REFERENCES `warehouse` (`warehouse_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
