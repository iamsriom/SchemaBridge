  "question": "The news publishing company needs to manage the submission, review, and publishing process of news articles. Each reporter can submit multiple articles, and each article needs to be reviewed by an editor. After passing the review, the article is published by a publisher. The system needs to record the submission time, review time, and publishing time of each article, as well as the information of the reporter, editor, and publisher.",
  "ddl": "-- Schema for database: rschema_0047\nCREATE TABLE `reporters` (\n  `reporter_id` int(11) NOT NULL AUTO_INCREMENT,\n  `reporter_name` varchar(255) NOT NULL,\n  `email` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`reporter_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `editors` (\n  `editor_id` int(11) NOT NULL AUTO_INCREMENT,\n  `editor_name` varchar(255) NOT NULL,\n  `email` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`editor_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `publishers` (\n  `publisher_id` int(11) NOT NULL AUTO_INCREMENT,\n  `publisher_name` varchar(255) NOT NULL,\n  `email` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`publisher_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `articles` (\n  `article_id` int(11) NOT NULL AUTO_INCREMENT,\n  `reporter_id` int(11) NOT NULL,\n  `editor_id` int(11) NOT NULL,\n  `publisher_id` int(11) DEFAULT NULL,\n  `title` varchar(255) NOT NULL,\n  `content` text NOT NULL,\n  `submission_time` datetime NOT NULL,\n  `review_time` datetime DEFAULT NULL,\n  `publishing_time` datetime DEFAULT NULL,\n  `review_status` varchar(50) NOT NULL,\n  PRIMARY KEY (`article_id`),\n  KEY `articles_ibfk_1` (`reporter_id`),\n  KEY `articles_ibfk_2` (`editor_id`),\n  KEY `articles_ibfk_3` (`publisher_id`),\n  CONSTRAINT `articles_ibfk_1` FOREIGN KEY (`reporter_id`) REFERENCES `reporters` (`reporter_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `articles_ibfk_2` FOREIGN KEY (`editor_id`) REFERENCES `editors` (`editor_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `articles_ibfk_3` FOREIGN KEY (`publisher_id`) REFERENCES `publishers` (`publisher_id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
