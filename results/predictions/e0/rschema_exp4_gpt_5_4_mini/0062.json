  "question": "The Technical Document Management Department manages multiple technical documents, and each document is written by multiple authors. A document has a Document ID, Title, Creation Date, and Version Number. An author has an ID, Name, Date of Birth, Gender, Phone Number, and Position. The document version record needs to record the Modification ID, Document ID, Version Number, Modification Date, Modifying Author, and Modification Content.",
  "ddl": "-- Schema for database: rschema_0062\nCREATE TABLE `author` (\n  `author_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `date_of_birth` date DEFAULT NULL,\n  `gender` varchar(20) DEFAULT NULL,\n  `phone_number` varchar(20) DEFAULT NULL,\n  `position` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`author_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `technical_document` (\n  `document_id` int(11) NOT NULL,\n  `title` varchar(255) NOT NULL,\n  `creation_date` date DEFAULT NULL,\n  `version_number` int(11) NOT NULL,\n  PRIMARY KEY (`document_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `document_author` (\n  `document_id` int(11) NOT NULL,\n  `author_id` int(11) NOT NULL,\n  PRIMARY KEY (`document_id`,`author_id`),\n  CONSTRAINT `document_author_ibfk_1` FOREIGN KEY (`document_id`) REFERENCES `technical_document` (`document_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `document_author_ibfk_2` FOREIGN KEY (`author_id`) REFERENCES `author` (`author_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `document_version_record` (\n  `modification_id` int(11) NOT NULL,\n  `document_id` int(11) NOT NULL,\n  `version_number` int(11) NOT NULL,\n  `modification_date` datetime NOT NULL,\n  `modifying_author_id` int(11) NOT NULL,\n  `modification_content` text NOT NULL,\n  PRIMARY KEY (`modification_id`),\n  CONSTRAINT `document_version_record_ibfk_1` FOREIGN KEY (`document_id`) REFERENCES `technical_document` (`document_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `document_version_record_ibfk_2` FOREIGN KEY (`modifying_author_id`) REFERENCES `author` (`author_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
