  "question": "The science and technology project review department manages multiple project review processes, and each project has multiple review experts involved.\nProjects have project numbers, names, application dates, and application units.\nReview experts have expert numbers, names, units, and titles.\nProject review records need to record project numbers, expert numbers, review dates, and review opinions.",
  "ddl": "-- Schema for database: rschema_0064\nCREATE TABLE `project` (\n  `project_no` varchar(50) NOT NULL,\n  `project_name` varchar(255) NOT NULL,\n  `application_date` date NOT NULL,\n  `application_unit` varchar(255) NOT NULL,\n  PRIMARY KEY (`project_no`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `review_expert` (\n  `expert_no` varchar(50) NOT NULL,\n  `expert_name` varchar(255) NOT NULL,\n  `unit` varchar(255) NOT NULL,\n  `title` varchar(255) NOT NULL,\n  PRIMARY KEY (`expert_no`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `project_review_record` (\n  `project_no` varchar(50) NOT NULL,\n  `expert_no` varchar(50) NOT NULL,\n  `review_date` date NOT NULL,\n  `review_opinion` varchar(1000) NOT NULL,\n  PRIMARY KEY (`project_no`,`expert_no`),\n  CONSTRAINT `project_review_record_ibfk_1` FOREIGN KEY (`project_no`) REFERENCES `project` (`project_no`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `project_review_record_ibfk_2` FOREIGN KEY (`expert_no`) REFERENCES `review_expert` (`expert_no`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
