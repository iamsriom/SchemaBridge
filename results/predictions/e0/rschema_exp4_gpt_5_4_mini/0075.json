  "question": "A financial analysis company manages multiple analysts, each with a unique Analyst ID, name, date of hire, and contact number. The company tracks information on multiple stocks, each having a unique stock code, stock name, and current price. Analysts can analyze multiple stocks, with each analysis recording the date of analysis, results, and reasoning. Additionally, the company maintains historical price data for each stock, recording closing price, opening price, highest price, lowest price, and trading volume by date.",
  "ddl": "-- Schema for database: rschema_0075\nCREATE TABLE `analysts` (\n  `analyst_id` int(11) NOT NULL,\n  `analyst_name` varchar(255) NOT NULL,\n  `date_of_hire` date NOT NULL,\n  `contact_number` varchar(20) NOT NULL,\n  PRIMARY KEY (`analyst_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `stocks` (\n  `stock_code` varchar(20) NOT NULL,\n  `stock_name` varchar(255) NOT NULL,\n  `current_price` decimal(10,2) NOT NULL,\n  PRIMARY KEY (`stock_code`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `analyses` (\n  `analysis_id` int(11) NOT NULL AUTO_INCREMENT,\n  `analyst_id` int(11) NOT NULL,\n  `stock_code` varchar(20) NOT NULL,\n  `analysis_date` date NOT NULL,\n  `results` text NOT NULL,\n  `reasoning` text NOT NULL,\n  PRIMARY KEY (`analysis_id`),\n  KEY `analyst_id` (`analyst_id`),\n  KEY `stock_code` (`stock_code`),\n  CONSTRAINT `analyses_ibfk_1` FOREIGN KEY (`analyst_id`) REFERENCES `analysts` (`analyst_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `analyses_ibfk_2` FOREIGN KEY (`stock_code`) REFERENCES `stocks` (`stock_code`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `stock_price_history` (\n  `price_history_id` int(11) NOT NULL AUTO_INCREMENT,\n  `stock_code` varchar(20) NOT NULL,\n  `price_date` date NOT NULL,\n  `closing_price` decimal(10,2) NOT NULL,\n  `opening_price` decimal(10,2) NOT NULL,\n  `highest_price` decimal(10,2) NOT NULL,\n  `lowest_price` decimal(10,2) NOT NULL,\n  `trading_volume` bigint(20) NOT NULL,\n  PRIMARY KEY (`price_history_id`),\n  KEY `stock_code` (`stock_code`),\n  CONSTRAINT `stock_price_history_ibfk_1` FOREIGN KEY (`stock_code`) REFERENCES `stocks` (`stock_code`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
