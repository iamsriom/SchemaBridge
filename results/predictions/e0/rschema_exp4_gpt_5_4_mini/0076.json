  "database": "rschema_0076",
  "question": "This system is a bar management system, which aims to record the information of beer manufacturers, beer types, bars and drinkers, and the relationship between them. The beer manufacturer information includes the manufacturer number, manufacturer name and manufacturer country. The beer type information includes the beer number, beer name, manufacturer number and beer price. The bar information includes the bar number, bar name, bar address and bar phone number. The drinker information includes the drinker number, drinker name, drinker gender, drinker age and drinker phone number. The relationship between beer manufacturers and beer types is that beer manufacturers produce beer types, and beer types are sold in bars. Sales records include sales date, sales quantity and sales price.",
  "ddl": "-- Schema for database: rschema_0076\nCREATE TABLE `beer_manufacturer` (\n  `manufacturer_no` int(11) NOT NULL,\n  `manufacturer_name` varchar(255) NOT NULL,\n  `manufacturer_country` varchar(255) NOT NULL,\n  PRIMARY KEY (`manufacturer_no`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `beer_type` (\n  `beer_no` int(11) NOT NULL,\n  `beer_name` varchar(255) NOT NULL,\n  `manufacturer_no` int(11) NOT NULL,\n  `beer_price` decimal(10,2) NOT NULL,\n  PRIMARY KEY (`beer_no`),\n  KEY `beer_type_ibfk_1` (`manufacturer_no`),\n  CONSTRAINT `beer_type_ibfk_1` FOREIGN KEY (`manufacturer_no`) REFERENCES `beer_manufacturer` (`manufacturer_no`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `bar` (\n  `bar_no` int(11) NOT NULL,\n  `bar_name` varchar(255) NOT NULL,\n  `bar_address` varchar(255) NOT NULL,\n  `bar_phone` varchar(20) NOT NULL,\n  PRIMARY KEY (`bar_no`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `drinker` (\n  `drinker_no` int(11) NOT NULL,\n  `drinker_name` varchar(255) NOT NULL,\n  `drinker_gender` char(1) NOT NULL,\n  `drinker_age` int(11) NOT NULL,\n  `drinker_phone` varchar(20) NOT NULL,\n  PRIMARY KEY (`drinker_no`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `sales_record` (\n  `sales_id` int(11) NOT NULL,\n  `beer_no` int(11) NOT NULL,\n  `bar_no` int(11) NOT NULL,\n  `sales_date` datetime NOT NULL,\n  `sales_quantity` int(11) NOT NULL,\n  `sales_price` decimal(10,2) NOT NULL,\n  PRIMARY KEY (`sales_id`),\n  KEY `sales_record_ibfk_1` (`beer_no`),\n  KEY `sales_record_ibfk_2` (`bar_no`),\n  CONSTRAINT `sales_record_ibfk_1` FOREIGN KEY (`beer_no`) REFERENCES `beer_type` (`beer_no`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `sales_record_ibfk_2` FOREIGN KEY (`bar_no`) REFERENCES `bar` (`bar_no`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
