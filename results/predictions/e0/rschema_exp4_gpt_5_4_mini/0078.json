  "database": "rschema_0078",
  "question": "The article management system manages multiple articles. Each article has an article ID, article title, article content, creation time, total number of words, article reading volume, article like volume, article collection volume, article comment volume, the time of the last modification and save, and the author ID of the last modification and save. The system also manages multiple authors. Each author has an author ID, name, gender, phone number, email address, and introduction. Each article can be created by multiple authors, and the author order, responsible part, and role of each author are recorded. Authors can modify articles, and each modification records the modification start time, modification save time, and modification notes. The system ensures the accuracy of article content and the transparency of author contributions by recording article creation and modification information.",
  "ddl": "-- Schema for database: rschema_0078\nCREATE TABLE `author` (\n  `author_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `gender` varchar(20) DEFAULT NULL,\n  `phone_number` varchar(50) DEFAULT NULL,\n  `email_address` varchar(255) DEFAULT NULL,\n  `introduction` text DEFAULT NULL,\n  PRIMARY KEY (`author_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `article` (\n  `article_id` int(11) NOT NULL,\n  `article_title` varchar(255) NOT NULL,\n  `article_content` longtext DEFAULT NULL,\n  `creation_time` datetime NOT NULL,\n  `total_word_count` int(11) DEFAULT NULL,\n  `reading_volume` int(11) DEFAULT NULL,\n  `like_volume` int(11) DEFAULT NULL,\n  `collection_volume` int(11) DEFAULT NULL,\n  `comment_volume` int(11) DEFAULT NULL,\n  `last_modified_save_time` datetime DEFAULT NULL,\n  `last_modified_save_author_id` int(11) DEFAULT NULL,\n  PRIMARY KEY (`article_id`),\n  KEY `article_ibfk_1` (`last_modified_save_author_id`),\n  CONSTRAINT `article_ibfk_1` FOREIGN KEY (`last_modified_save_author_id`) REFERENCES `author` (`author_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `article_author` (\n  `article_id` int(11) NOT NULL,\n  `author_id` int(11) NOT NULL,\n  `author_order` int(11) NOT NULL,\n  `responsible_part` varchar(255) DEFAULT NULL,\n  `author_role` varchar(100) DEFAULT NULL,\n  PRIMARY KEY (`article_id`,`author_id`),\n  KEY `article_author_ibfk_2` (`author_id`),\n  CONSTRAINT `article_author_ibfk_1` FOREIGN KEY (`article_id`) REFERENCES `article` (`article_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `article_author_ibfk_2` FOREIGN KEY (`author_id`) REFERENCES `author` (`author_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `article_modification` (\n  `modification_id` int(11) NOT NULL,\n  `article_id` int(11) NOT NULL,\n  `author_id` int(11) NOT NULL,\n  `modification_start_time` datetime NOT NULL,\n  `modification_save_time` datetime DEFAULT NULL,\n  `modification_notes` text DEFAULT NULL,\n  PRIMARY KEY (`modification_id`),\n  KEY `article_modification_ibfk_1` (`article_id`),\n  KEY `article_modification_ibfk_2` (`author_id`),\n  CONSTRAINT `article_modification_ibfk_1` FOREIGN KEY (`article_id`) REFERENCES `article` (`article_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `article_modification_ibfk_2` FOREIGN KEY (`author_id`) REFERENCES `author` (`author_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
