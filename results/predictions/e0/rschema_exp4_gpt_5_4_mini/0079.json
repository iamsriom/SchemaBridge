  "database": "rschema_0079",
  "question": "A system for managing stock and fund investments, especially for fixed investment (regular investment). The main functions of the system include:\n1. Stock and fund management: record the basic information of each stock or fund, such as code, type, market, owner, etc. Manage the holdings of each stock or fund, including total investment amount, holding shares, last trading date, etc. Maintain the trading configuration of each stock or fund, such as trading fees, etc.\n2. Trading order management: record the detailed information of each trading order, including order type (buy, sell, compensation), creation time, trading date, transaction amount, transaction quantity, transaction service fee, etc. Ensure the uniqueness of each order through the external order ID (`out_id`). Manage the transaction status of the order and distinguish whether the order has been settled.\n3. Data query and statistics: query the holdings and historical transaction records of a specific stock or fund. Statistics on the total transaction amount, transaction quantity and other information within a certain period of time. Filter and summarize data according to different markets, categories and subcategories.",
  "ddl": "-- Schema for database: rschema_0079\nCREATE TABLE `investment_asset` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `code` varchar(32) NOT NULL,\n  `asset_type` varchar(20) NOT NULL,\n  `market` varchar(50) DEFAULT NULL,\n  `owner` varchar(100) DEFAULT NULL,\n  `name` varchar(255) DEFAULT NULL,\n  `category` varchar(50) DEFAULT NULL,\n  `subcategory` varchar(50) DEFAULT NULL,\n  `created_at` datetime NOT NULL,\n  `updated_at` datetime NOT NULL,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uk_investment_asset_code_type` (`code`,`asset_type`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `investment_holding` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `asset_id` int(11) NOT NULL,\n  `total_investment_amount` decimal(18,2) NOT NULL DEFAULT '0.00',\n  `holding_shares` decimal(18,6) NOT NULL DEFAULT '0.000000',\n  `last_trading_date` date DEFAULT NULL,\n  `last_settled_at` datetime DEFAULT NULL,\n  `created_at` datetime NOT NULL,\n  `updated_at` datetime NOT NULL,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uk_investment_holding_asset_id` (`asset_id`),\n  CONSTRAINT `investment_holding_ibfk_1` FOREIGN KEY (`asset_id`) REFERENCES `investment_asset` (`id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `investment_trading_config` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `asset_id` int(11) NOT NULL,\n  `buy_fee_rate` decimal(10,6) DEFAULT NULL,\n  `sell_fee_rate` decimal(10,6) DEFAULT NULL,\n  `compensation_fee_rate` decimal(10,6) DEFAULT NULL,\n  `min_fee` decimal(18,2) DEFAULT NULL,\n  `max_fee` decimal(18,2) DEFAULT NULL,\n  `fee_note` varchar(255) DEFAULT NULL,\n  `created_at` datetime NOT NULL,\n  `updated_at` datetime NOT NULL,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uk_investment_trading_config_asset_id` (`asset_id`),\n  CONSTRAINT `investment_trading_config_ibfk_1` FOREIGN KEY (`asset_id`) REFERENCES `investment_asset` (`id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `investment_order` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `asset_id` int(11) NOT NULL,\n  `out_id` varchar(64) NOT NULL,\n  `order_type` varchar(20) NOT NULL,\n  `status` varchar(20) NOT NULL,\n  `is_settled` tinyint(1) NOT NULL DEFAULT '0',\n  `created_at` datetime NOT NULL,\n  `trading_date` date DEFAULT NULL,\n  `settled_at` datetime DEFAULT NULL,\n  `transaction_amount` decimal(18,2) NOT NULL DEFAULT '0.00',\n  `transaction_quantity` decimal(18,6) NOT NULL DEFAULT '0.000000',\n  `transaction_service_fee` decimal(18,2) NOT NULL DEFAULT '0.00',\n  `currency` char(6) DEFAULT NULL,\n  `remark` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uk_investment_order_out_id` (`out_id`),\n  KEY `investment_order_ibfk_1` (`asset_id`),\n  CONSTRAINT `investment_order_ibfk_1` FOREIGN KEY (`asset_id`) REFERENCES `investment_asset` (`id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
