  "question": "Design a database for a blockchain or cryptocurrency system to store and manage transactions, blocks, and account information.\nThe system shall record detailed information about transactions, including transaction hash, timestamp, fee, input address, and output address;     \ninformation about blocks, including block hash, height, timestamp, previous block hash, and Merkle root;\nas well as account addresses and balances.\nThe system shall support querying the block a transaction belongs to, as well as the relationship between transactions and accounts.",
  "ddl": "-- Schema for database: rschema_0089\nCREATE TABLE `accounts` (\n  `account_id` int(11) NOT NULL AUTO_INCREMENT,\n  `address` varchar(255) NOT NULL,\n  `balance` decimal(20,8) NOT NULL DEFAULT 0.00000000,\n  PRIMARY KEY (`account_id`),\n  UNIQUE KEY `address` (`address`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `blocks` (\n  `block_id` int(11) NOT NULL AUTO_INCREMENT,\n  `block_hash` varchar(255) NOT NULL,\n  `height` int(11) NOT NULL,\n  `block_timestamp` datetime NOT NULL,\n  `previous_block_hash` varchar(255) DEFAULT NULL,\n  `merkle_root` varchar(255) NOT NULL,\n  PRIMARY KEY (`block_id`),\n  UNIQUE KEY `block_hash` (`block_hash`),\n  UNIQUE KEY `height` (`height`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `transactions` (\n  `transaction_id` int(11) NOT NULL AUTO_INCREMENT,\n  `transaction_hash` varchar(255) NOT NULL,\n  `block_id` int(11) NOT NULL,\n  `transaction_timestamp` datetime NOT NULL,\n  `fee` decimal(20,8) NOT NULL DEFAULT 0.00000000,\n  `input_account_id` int(11) NOT NULL,\n  `output_account_id` int(11) NOT NULL,\n  PRIMARY KEY (`transaction_id`),\n  UNIQUE KEY `transaction_hash` (`transaction_hash`),\n  KEY `block_id` (`block_id`),\n  KEY `input_account_id` (`input_account_id`),\n  KEY `output_account_id` (`output_account_id`),\n  CONSTRAINT `transactions_ibfk_1` FOREIGN KEY (`block_id`) REFERENCES `blocks` (`block_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `transactions_ibfk_2` FOREIGN KEY (`input_account_id`) REFERENCES `accounts` (`account_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `transactions_ibfk_3` FOREIGN KEY (`output_account_id`) REFERENCES `accounts` (`account_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
