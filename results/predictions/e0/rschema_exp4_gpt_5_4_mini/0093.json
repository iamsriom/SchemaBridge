  "question": "In a library management system, the relationships between books, types, and tags are as follows:\nThe system contains multiple books, each book's information includes Book Title, Author, ISBN Number, Publication Year, and Publishing House.       \nEach book can belong to multiple types, type information includes Type ID and Type Name, where Type Name is unique.\nAdditionally, each book can have multiple tags, tag information includes Tag ID and Tag Name, where Tag Name is unique.",
  "ddl": "-- Schema for database: rschema_0093\nCREATE TABLE `books` (\n  `book_id` int(11) NOT NULL AUTO_INCREMENT,\n  `book_title` varchar(255) NOT NULL,\n  `author` varchar(255) NOT NULL,\n  `isbn_number` varchar(20) NOT NULL,\n  `publication_year` int(11) NOT NULL,\n  `publishing_house` varchar(255) NOT NULL,\n  PRIMARY KEY (`book_id`),\n  UNIQUE KEY `isbn_number` (`isbn_number`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `types` (\n  `type_id` int(11) NOT NULL AUTO_INCREMENT,\n  `type_name` varchar(255) NOT NULL,\n  PRIMARY KEY (`type_id`),\n  UNIQUE KEY `type_name` (`type_name`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `tags` (\n  `tag_id` int(11) NOT NULL AUTO_INCREMENT,\n  `tag_name` varchar(255) NOT NULL,\n  PRIMARY KEY (`tag_id`),\n  UNIQUE KEY `tag_name` (`tag_name`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `book_types` (\n  `book_id` int(11) NOT NULL,\n  `type_id` int(11) NOT NULL,\n  PRIMARY KEY (`book_id`,`type_id`),\n  KEY `type_id` (`type_id`),\n  CONSTRAINT `book_types_ibfk_1` FOREIGN KEY (`book_id`) REFERENCES `books` (`book_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `book_types_ibfk_2` FOREIGN KEY (`type_id`) REFERENCES `types` (`type_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `book_tags` (\n  `book_id` int(11) NOT NULL,\n  `tag_id` int(11) NOT NULL,\n  PRIMARY KEY (`book_id`,`tag_id`),\n  KEY `tag_id` (`tag_id`),\n  CONSTRAINT `book_tags_ibfk_1` FOREIGN KEY (`book_id`) REFERENCES `books` (`book_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `book_tags_ibfk_2` FOREIGN KEY (`tag_id`) REFERENCES `tags` (`tag_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
