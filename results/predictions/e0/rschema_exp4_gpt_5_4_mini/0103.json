  "question": "This is a Human Resource Management System (HR System). The system maintains employee basic records, including employee ID, name, gender, date of birth, and hire date. It also manages employee position change history, recording original department, original position, current department, current position, entry date, and departure date. For organizational structure management, the system maintains the company's departmental structure, including department code, name, and person in charge, manages employee department affiliations, and handles personnel transfers. For compensation management, the system maintains employee salary standards (including standard description and standard value), ensures accurate and timely salary payment, and provides individual salary inquiry and departmental salary statistical analysis functions.",
  "ddl": "-- Schema for database: rschema_0103\nCREATE TABLE `employee` (\n  `employee_id` int(11) NOT NULL,\n  `employee_name` varchar(100) NOT NULL,\n  `gender` char(1) NOT NULL,\n  `date_of_birth` date DEFAULT NULL,\n  `hire_date` date NOT NULL,\n  PRIMARY KEY (`employee_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `department` (\n  `department_code` varchar(20) NOT NULL,\n  `department_name` varchar(100) NOT NULL,\n  `person_in_charge_employee_id` int(11) DEFAULT NULL,\n  PRIMARY KEY (`department_code`),\n  KEY `department_ibfk_1` (`person_in_charge_employee_id`),\n  CONSTRAINT `department_ibfk_1` FOREIGN KEY (`person_in_charge_employee_id`) REFERENCES `employee` (`employee_id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `employee_department` (\n  `employee_department_id` int(11) NOT NULL AUTO_INCREMENT,\n  `employee_id` int(11) NOT NULL,\n  `department_code` varchar(20) NOT NULL,\n  `entry_date` date NOT NULL,\n  `departure_date` date DEFAULT NULL,\n  PRIMARY KEY (`employee_department_id`),\n  KEY `employee_department_ibfk_1` (`employee_id`),\n  KEY `employee_department_ibfk_2` (`department_code`),\n  CONSTRAINT `employee_department_ibfk_1` FOREIGN KEY (`employee_id`) REFERENCES `employee` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `employee_department_ibfk_2` FOREIGN KEY (`department_code`) REFERENCES `department` (`department_code`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `position_change_history` (\n  `position_change_id` int(11) NOT NULL AUTO_INCREMENT,\n  `employee_id` int(11) NOT NULL,\n  `original_department_code` varchar(20) DEFAULT NULL,\n  `original_position_name` varchar(100) DEFAULT NULL,\n  `current_department_code` varchar(20) DEFAULT NULL,\n  `current_position_name` varchar(100) DEFAULT NULL,\n  `entry_date` date NOT NULL,\n  `departure_date` date DEFAULT NULL,\n  PRIMARY KEY (`position_change_id`),\n  KEY `position_change_history_ibfk_1` (`employee_id`),\n  KEY `position_change_history_ibfk_2` (`original_department_code`),\n  KEY `position_change_history_ibfk_3` (`current_department_code`),\n  CONSTRAINT `position_change_history_ibfk_1` FOREIGN KEY (`employee_id`) REFERENCES `employee` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `position_change_history_ibfk_2` FOREIGN KEY (`original_department_code`) REFERENCES `department` (`department_code`) ON DELETE SET NULL ON UPDATE CASCADE,\n  CONSTRAINT `position_change_history_ibfk_3` FOREIGN KEY (`current_department_code`) REFERENCES `department` (`department_code`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `salary_standard` (\n  `salary_standard_id` int(11) NOT NULL AUTO_INCREMENT,\n  `employee_id` int(11) NOT NULL,\n  `standard_description` varchar(255) NOT NULL,\n  `standard_value` decimal(10,2) NOT NULL,\n  `effective_date` date DEFAULT NULL,\n  `end_date` date DEFAULT NULL,\n  PRIMARY KEY (`salary_standard_id`),\n  KEY `salary_standard_ibfk_1` (`employee_id`),\n  CONSTRAINT `salary_standard_ibfk_1` FOREIGN KEY (`employee_id`) REFERENCES `employee` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `salary_payment` (\n  `salary_payment_id` int(11) NOT NULL AUTO_INCREMENT,\n  `employee_id` int(11) NOT NULL,\n  `salary_standard_id` int(11) DEFAULT NULL,\n  `pay_period` char(7) NOT NULL,\n  `pay_date` date NOT NULL,\n  `amount_paid` decimal(10,2) NOT NULL,\n  PRIMARY KEY (`salary_payment_id`),\n  KEY `salary_payment_ibfk_1` (`employee_id`),\n  KEY `salary_payment_ibfk_2` (`salary_standard_id`),\n  CONSTRAINT `salary_payment_ibfk_1` FOREIGN KEY (`employee_id`) REFERENCES `employee` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `salary_payment_ibfk_2` FOREIGN KEY (`salary_standard_id`) REFERENCES `salary_standard` (`salary_standard_id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
