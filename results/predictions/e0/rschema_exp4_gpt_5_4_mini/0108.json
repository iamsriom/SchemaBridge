  "database": "rschema_0108",
  "question": "This is a mini Employee Management System (miniEMS). For department management, the system records company department information, including department ID, department name, and department responsibilities, where department IDs are fixed as 10, 20, 30, 40, 50, and department names are fixed as IT, Marketing, HR, Sale, president office. For employee management, the system records employee basic information, including employee ID, name, gender, age, social security number, department ID, position, email address, phone number, and base salary. The employee ID is automatically generated and uniquely identifies each employee, name is divided into first and last name with both being required, gender defaults to female but allows selection of male or female, age range is between 18 and 100, social security number is unique and used for identity verification, department ID is linked to the department table to ensure employees belong to a department, position defaults to staff but allows selection of staff, assistant, supervisor, manager, director, president, etc., email address and phone number are required for contacting employees, and base salary is required for recording employee compensation information.",
  "ddl": "-- Schema for database: rschema_0108\nCREATE TABLE `department` (\n  `department_id` int(11) NOT NULL,\n  `department_name` varchar(100) NOT NULL,\n  `department_responsibilities` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`department_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `employee` (\n  `employee_id` int(11) NOT NULL AUTO_INCREMENT,\n  `first_name` varchar(100) NOT NULL,\n  `last_name` varchar(100) NOT NULL,\n  `gender` enum('female','male') NOT NULL DEFAULT 'female',\n  `age` int(11) NOT NULL,\n  `social_security_number` varchar(20) NOT NULL,\n  `department_id` int(11) NOT NULL,\n  `position` enum('staff','assistant','supervisor','manager','director','president') NOT NULL DEFAULT 'staff',\n  `email_address` varchar(255) NOT NULL,\n  `phone_number` varchar(30) NOT NULL,\n  `base_salary` decimal(10,2) NOT NULL,\n  PRIMARY KEY (`employee_id`),\n  UNIQUE KEY `social_security_number` (`social_security_number`),\n  KEY `department_id` (`department_id`),\n  CONSTRAINT `employee_ibfk_1` FOREIGN KEY (`department_id`) REFERENCES `department` (`department_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `employee_chk_1` CHECK (`age` >= 18 AND `age` <= 100)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
