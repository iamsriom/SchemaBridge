  "database": "rschema_0109",
  "question": "The membership management system shall record each member's country code, name (with optional pronunciation), and company name, allowing the option to set whether this information is publicly accessible. To expedite the retrieval of certain member information, these details shall be cached in a data cache table. The system shall also manage multiple address entries for each member, with each address containing detailed information such as country, postal code, specific address, and telephone number.",
  "ddl": "-- Schema for database: rschema_0109\nCREATE TABLE `members` (\n  `member_id` int(11) NOT NULL AUTO_INCREMENT,\n  `country_code` char(2) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `name_pronunciation` varchar(255) DEFAULT NULL,\n  `company_name` varchar(255) DEFAULT NULL,\n  `is_public_country_code` tinyint(1) NOT NULL DEFAULT 0,\n  `is_public_name` tinyint(1) NOT NULL DEFAULT 0,\n  `is_public_name_pronunciation` tinyint(1) NOT NULL DEFAULT 0,\n  `is_public_company_name` tinyint(1) NOT NULL DEFAULT 0,\n  PRIMARY KEY (`member_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `member_data_cache` (\n  `member_id` int(11) NOT NULL,\n  `country_code` char(2) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `name_pronunciation` varchar(255) DEFAULT NULL,\n  `company_name` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`member_id`),\n  CONSTRAINT `member_data_cache_ibfk_1` FOREIGN KEY (`member_id`) REFERENCES `members` (`member_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `member_addresses` (\n  `address_id` int(11) NOT NULL AUTO_INCREMENT,\n  `member_id` int(11) NOT NULL,\n  `country` varchar(100) NOT NULL,\n  `postal_code` varchar(20) NOT NULL,\n  `address_line` varchar(255) NOT NULL,\n  `telephone_number` varchar(30) DEFAULT NULL,\n  PRIMARY KEY (`address_id`),\n  KEY `member_id` (`member_id`),\n  CONSTRAINT `member_addresses_ibfk_1` FOREIGN KEY (`member_id`) REFERENCES `members` (`member_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
