  "question": "The enterprise management system is a system used to manage and record basic company information, employee information, department structure, etc. Its core purpose is to help companies effectively manage internal resources, optimize operational processes, and improve management efficiency. Through the system, managers can easily access various basic data of the company, grasp the detailed information of employees, and conduct personnel deployment, salary management, attendance management, etc. In addition, the system can also support functions such as authority management, enterprise goal setting, and employee performance appraisal. Specific functional requirements include: Employee information management: including detailed records of employees' personal information (such as name, gender, age, date of birth, contact information), position, entry time, salary, etc. Department management: manage information of different departments, including department name, department head, department responsibilities, department location, total number of department personnel, etc. Employee and department association: record the department of each employee, and support cross-department employee transfer and department management. Attendance management: record employee attendance, including attendance (punch time, punch type), leave record (leave time, leave type), overtime record (overtime time, overtime type), etc.",
  "ddl": "-- Schema for database: rschema_0118\nCREATE TABLE `department` (\n  `department_id` int(11) NOT NULL AUTO_INCREMENT,\n  `department_name` varchar(255) NOT NULL,\n  `department_head` varchar(255) DEFAULT NULL,\n  `department_responsibilities` varchar(500) DEFAULT NULL,\n  `department_location` varchar(255) DEFAULT NULL,\n  `total_personnel` int(11) DEFAULT NULL,\n  PRIMARY KEY (`department_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `employee` (\n  `employee_id` int(11) NOT NULL AUTO_INCREMENT,\n  `employee_name` varchar(255) NOT NULL,\n  `gender` varchar(10) DEFAULT NULL,\n  `age` int(11) DEFAULT NULL,\n  `date_of_birth` date DEFAULT NULL,\n  `contact_information` varchar(255) DEFAULT NULL,\n  `position` varchar(255) DEFAULT NULL,\n  `entry_time` datetime DEFAULT NULL,\n  `salary` decimal(10,2) DEFAULT NULL,\n  `department_id` int(11) DEFAULT NULL,\n  PRIMARY KEY (`employee_id`),\n  KEY `employee_ibfk_1` (`department_id`),\n  CONSTRAINT `employee_ibfk_1` FOREIGN KEY (`department_id`) REFERENCES `department` (`department_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `employee_transfer` (\n  `transfer_id` int(11) NOT NULL AUTO_INCREMENT,\n  `employee_id` int(11) NOT NULL,\n  `from_department_id` int(11) DEFAULT NULL,\n  `to_department_id` int(11) NOT NULL,\n  `transfer_time` datetime NOT NULL,\n  `transfer_reason` varchar(500) DEFAULT NULL,\n  PRIMARY KEY (`transfer_id`),\n  KEY `employee_transfer_ibfk_1` (`employee_id`),\n  KEY `employee_transfer_ibfk_2` (`from_department_id`),\n  KEY `employee_transfer_ibfk_3` (`to_department_id`),\n  CONSTRAINT `employee_transfer_ibfk_1` FOREIGN KEY (`employee_id`) REFERENCES `employee` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `employee_transfer_ibfk_2` FOREIGN KEY (`from_department_id`) REFERENCES `department` (`department_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `employee_transfer_ibfk_3` FOREIGN KEY (`to_department_id`) REFERENCES `department` (`department_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `attendance_record` (\n  `attendance_id` int(11) NOT NULL AUTO_INCREMENT,\n  `employee_id` int(11) NOT NULL,\n  `punch_time` datetime DEFAULT NULL,\n  `punch_type` varchar(50) DEFAULT NULL,\n  `leave_time` datetime DEFAULT NULL,\n  `leave_type` varchar(50) DEFAULT NULL,\n  `overtime_time` datetime DEFAULT NULL,\n  `overtime_type` varchar(50) DEFAULT NULL,\n  PRIMARY KEY (`attendance_id`),\n  KEY `attendance_record_ibfk_1` (`employee_id`),\n  CONSTRAINT `attendance_record_ibfk_1` FOREIGN KEY (`employee_id`) REFERENCES `employee` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
