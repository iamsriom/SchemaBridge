  "question": "The Customer Relationship Management (CRM) or Customer Service system is used to manage customer inquiries, conversation records, and organization information. Its main features include:\n1.Conversation Management: Records basic information about each conversation, including Conversation ID, Customer ID, Organization ID, Creation Time, Last Update Time, and baseId.\n2.Inquiry Management: Records customer inquiry information, including the status (open, closed, draft), category, content, creation time, and end time of the inquiry.\n3.Organization Information Management: Records the basic information of organizations, such as phone number, avatar, location, email, description, homepage link, and image link. Supports detailed management and updating of organization information, ensuring each organization has a unique phone number and avatar. Customers belong to specific organizations.\n4.Data Security: Ensures each conversation is linked to a secure base record, including baseId, encrypted information, creation time, and update time to enhance system security.\nEach customer has a unique Customer ID, name, and contact information.\nEach inquiry may involve multiple customers.\nEach conversation may involve multiple customers and multiple organizations.",
  "ddl": "-- Schema for database: rschema_0122\nCREATE TABLE `organization` (\n  `organization_id` int(11) NOT NULL AUTO_INCREMENT,\n  `phone_number` varchar(20) NOT NULL,\n  `avatar` varchar(255) NOT NULL,\n  `location` varchar(255) DEFAULT NULL,\n  `email` varchar(255) DEFAULT NULL,\n  `description` text DEFAULT NULL,\n  `homepage_link` varchar(255) DEFAULT NULL,\n  `image_link` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`organization_id`),\n  UNIQUE KEY `uk_organization_phone_number` (`phone_number`),\n  UNIQUE KEY `uk_organization_avatar` (`avatar`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `customer` (\n  `customer_id` int(11) NOT NULL AUTO_INCREMENT,\n  `organization_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `contact_info` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`customer_id`),\n  KEY `customer_ibfk_1` (`organization_id`),\n  CONSTRAINT `customer_ibfk_1` FOREIGN KEY (`organization_id`) REFERENCES `organization` (`organization_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `base_record` (\n  `base_id` int(11) NOT NULL AUTO_INCREMENT,\n  `encrypted_info` text NOT NULL,\n  `created_at` datetime NOT NULL,\n  `updated_at` datetime NOT NULL,\n  PRIMARY KEY (`base_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `conversation` (\n  `conversation_id` int(11) NOT NULL AUTO_INCREMENT,\n  `customer_id` int(11) NOT NULL,\n  `organization_id` int(11) NOT NULL,\n  `base_id` int(11) NOT NULL,\n  `created_at` datetime NOT NULL,\n  `updated_at` datetime NOT NULL,\n  PRIMARY KEY (`conversation_id`),\n  KEY `conversation_ibfk_1` (`customer_id`),\n  KEY `conversation_ibfk_2` (`organization_id`),\n  KEY `conversation_ibfk_3` (`base_id`),\n  CONSTRAINT `conversation_ibfk_1` FOREIGN KEY (`customer_id`) REFERENCES `customer` (`customer_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `conversation_ibfk_2` FOREIGN KEY (`organization_id`) REFERENCES `organization` (`organization_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `conversation_ibfk_3` FOREIGN KEY (`base_id`) REFERENCES `base_record` (`base_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `conversation_customer` (\n  `conversation_id` int(11) NOT NULL,\n  `customer_id` int(11) NOT NULL,\n  PRIMARY KEY (`conversation_id`,`customer_id`),\n  KEY `conversation_customer_ibfk_2` (`customer_id`),\n  CONSTRAINT `conversation_customer_ibfk_1` FOREIGN KEY (`conversation_id`) REFERENCES `conversation` (`conversation_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `conversation_customer_ibfk_2` FOREIGN KEY (`customer_id`) REFERENCES `customer` (`customer_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `conversation_organization` (\n  `conversation_id` int(11) NOT NULL,\n  `organization_id` int(11) NOT NULL,\n  PRIMARY KEY (`conversation_id`,`organization_id`),\n  KEY `conversation_organization_ibfk_2` (`organization_id`),\n  CONSTRAINT `conversation_organization_ibfk_1` FOREIGN KEY (`conversation_id`) REFERENCES `conversation` (`conversation_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `conversation_organization_ibfk_2` FOREIGN KEY (`organization_id`) REFERENCES `organization` (`organization_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `inquiry` (\n  `inquiry_id` int(11) NOT NULL AUTO_INCREMENT,\n  `status` varchar(20) NOT NULL,\n  `category` varchar(255) DEFAULT NULL,\n  `content` text NOT NULL,\n  `created_at` datetime NOT NULL,\n  `ended_at` datetime DEFAULT NULL,\n  PRIMARY KEY (`inquiry_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `inquiry_customer` (\n  `inquiry_id` int(11) NOT NULL,\n  `customer_id` int(11) NOT NULL,\n  PRIMARY KEY (`inquiry_id`,`customer_id`),\n  KEY `inquiry_customer_ibfk_2` (`customer_id`),\n  CONSTRAINT `inquiry_customer_ibfk_1` FOREIGN KEY (`inquiry_id`) REFERENCES `inquiry` (`inquiry_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `inquiry_customer_ibfk_2` FOREIGN KEY (`customer_id`) REFERENCES `customer` (`customer_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
