  "question": "The multilingual wiki system shall record and manage page content in different languages. Each page shall have configurable settings for editability and visibility. The system shall support page version management, allowing the creation of multiple versions for a page and specifying which version is the current active version. Users shall be able to submit comments on pages, and comments shall support nested replies to other comments for discussion and communication. When creating page versions, users shall have the option to upload image information to enrich the page content. The system shall provide functionality to view page history records, facilitating the tracing and reverting to previous versions.",
  "ddl": "-- Schema for database: rschema_0125\nCREATE TABLE `pages` (\n  `page_id` int(11) NOT NULL AUTO_INCREMENT,\n  `page_slug` varchar(255) NOT NULL,\n  `is_editable` tinyint(1) NOT NULL DEFAULT '1',\n  `is_visible` tinyint(1) NOT NULL DEFAULT '1',\n  `current_version_id` int(11) DEFAULT NULL,\n  PRIMARY KEY (`page_id`),\n  UNIQUE KEY `uk_pages_page_slug` (`page_slug`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `page_translations` (\n  `translation_id` int(11) NOT NULL AUTO_INCREMENT,\n  `page_id` int(11) NOT NULL,\n  `language_code` char(6) NOT NULL,\n  `title` varchar(255) NOT NULL,\n  `content` longtext DEFAULT NULL,\n  PRIMARY KEY (`translation_id`),\n  UNIQUE KEY `uk_page_translations_page_language` (`page_id`,`language_code`),\n  KEY `page_id` (`page_id`),\n  CONSTRAINT `page_translations_ibfk_1` FOREIGN KEY (`page_id`) REFERENCES `pages` (`page_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `page_versions` (\n  `version_id` int(11) NOT NULL AUTO_INCREMENT,\n  `page_id` int(11) NOT NULL,\n  `version_number` int(11) NOT NULL,\n  `created_by_user_id` int(11) DEFAULT NULL,\n  `created_at` datetime NOT NULL,\n  `version_content` longtext NOT NULL,\n  `image_url` varchar(255) DEFAULT NULL,\n  `image_alt_text` varchar(255) DEFAULT NULL,\n  `is_current` tinyint(1) NOT NULL DEFAULT '0',\n  PRIMARY KEY (`version_id`),\n  UNIQUE KEY `uk_page_versions_page_version_number` (`page_id`,`version_number`),\n  KEY `page_id` (`page_id`),\n  CONSTRAINT `page_versions_ibfk_1` FOREIGN KEY (`page_id`) REFERENCES `pages` (`page_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `page_comments` (\n  `comment_id` int(11) NOT NULL AUTO_INCREMENT,\n  `page_id` int(11) NOT NULL,\n  `parent_comment_id` int(11) DEFAULT NULL,\n  `user_id` int(11) DEFAULT NULL,\n  `comment_text` text NOT NULL,\n  `created_at` datetime NOT NULL,\n  `updated_at` datetime DEFAULT NULL,\n  PRIMARY KEY (`comment_id`),\n  KEY `page_id` (`page_id`),\n  KEY `parent_comment_id` (`parent_comment_id`),\n  CONSTRAINT `page_comments_ibfk_1` FOREIGN KEY (`page_id`) REFERENCES `pages` (`page_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `page_comments_ibfk_2` FOREIGN KEY (`parent_comment_id`) REFERENCES `page_comments` (`comment_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `page_history_records` (\n  `history_id` int(11) NOT NULL AUTO_INCREMENT,\n  `page_id` int(11) NOT NULL,\n  `version_id` int(11) NOT NULL,\n  `action_type` varchar(50) NOT NULL,\n  `changed_by_user_id` int(11) DEFAULT NULL,\n  `changed_at` datetime NOT NULL,\n  `notes` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`history_id`),\n  KEY `page_id` (`page_id`),\n  KEY `version_id` (`version_id`),\n  CONSTRAINT `page_history_records_ibfk_1` FOREIGN KEY (`page_id`) REFERENCES `pages` (`page_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `page_history_records_ibfk_2` FOREIGN KEY (`version_id`) REFERENCES `page_versions` (`version_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
