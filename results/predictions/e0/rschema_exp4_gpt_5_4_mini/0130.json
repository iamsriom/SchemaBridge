  "question": "Database design for a company is as follows:\nThe company has multiple corporate and individual clients.\nCorporate client information includes corporate tax ID, corporate name, postal code, corporate size, and corporate type.\nIndividual client information includes person's name, date of birth, and personal tax ID.\nEach client can be a corporate client or an individual client, and client information is stored in corresponding tables.\nThe company conducts several projects, project information includes project value, start date, end date, project status, service type, and whether it is a digital project.\nProjects contain multiple members, member information includes name, position, domain, date of hire, and date of departure, and members can participate in multiple projects simultaneously.",
  "ddl": "-- Schema for database: rschema_0130\nCREATE TABLE `clients` (\n  `client_id` int(11) NOT NULL AUTO_INCREMENT,\n  `client_type` varchar(20) NOT NULL,\n  PRIMARY KEY (`client_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `corporate_clients` (\n  `client_id` int(11) NOT NULL,\n  `corporate_tax_id` varchar(50) NOT NULL,\n  `corporate_name` varchar(255) NOT NULL,\n  `postal_code` varchar(20) NOT NULL,\n  `corporate_size` varchar(50) NOT NULL,\n  `corporate_type` varchar(50) NOT NULL,\n  PRIMARY KEY (`client_id`),\n  UNIQUE KEY `corporate_tax_id` (`corporate_tax_id`),\n  CONSTRAINT `corporate_clients_ibfk_1` FOREIGN KEY (`client_id`) REFERENCES `clients` (`client_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `individual_clients` (\n  `client_id` int(11) NOT NULL,\n  `person_name` varchar(255) NOT NULL,\n  `date_of_birth` date NOT NULL,\n  `personal_tax_id` varchar(50) NOT NULL,\n  PRIMARY KEY (`client_id`),\n  UNIQUE KEY `personal_tax_id` (`personal_tax_id`),\n  CONSTRAINT `individual_clients_ibfk_1` FOREIGN KEY (`client_id`) REFERENCES `clients` (`client_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `projects` (\n  `project_id` int(11) NOT NULL AUTO_INCREMENT,\n  `client_id` int(11) NOT NULL,\n  `project_value` decimal(12,2) NOT NULL,\n  `start_date` date NOT NULL,\n  `end_date` date DEFAULT NULL,\n  `project_status` varchar(50) NOT NULL,\n  `service_type` varchar(100) NOT NULL,\n  `is_digital_project` tinyint(1) NOT NULL,\n  PRIMARY KEY (`project_id`),\n  KEY `client_id` (`client_id`),\n  CONSTRAINT `projects_ibfk_1` FOREIGN KEY (`client_id`) REFERENCES `clients` (`client_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `members` (\n  `member_id` int(11) NOT NULL AUTO_INCREMENT,\n  `member_name` varchar(255) NOT NULL,\n  `position` varchar(100) NOT NULL,\n  `domain` varchar(100) NOT NULL,\n  `date_of_hire` date NOT NULL,\n  `date_of_departure` date DEFAULT NULL,\n  PRIMARY KEY (`member_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `project_members` (\n  `project_id` int(11) NOT NULL,\n  `member_id` int(11) NOT NULL,\n  PRIMARY KEY (`project_id`,`member_id`),\n  KEY `member_id` (`member_id`),\n  CONSTRAINT `project_members_ibfk_1` FOREIGN KEY (`project_id`) REFERENCES `projects` (`project_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `project_members_ibfk_2` FOREIGN KEY (`member_id`) REFERENCES `members` (`member_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
