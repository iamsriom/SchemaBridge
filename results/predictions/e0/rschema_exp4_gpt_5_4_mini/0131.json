  "database": "rschema_0131",
  "question": "\"The enterprise management system requires management of employee information (including positions and performance), supplier information, project progress, attendance, and salaries. The system needs to record and query each employee's corresponding position and performance status, track attendance records and salary distribution, and support monitoring and management of project progress, with each project having a responsible person and a supplier. The system shall be able to retrieve project progress information. Suppliers must maintain an independent information database to interface with the enterprise’s various projects or requirements. The system should be able to be managed entirely by administrators including creating, deleting, modifying, and querying various types of information, and providing functions that facilitate statistical analysis.\"",
  "ddl": "-- Schema for database: rschema_0131\nCREATE TABLE `positions` (\n  `position_id` int(11) NOT NULL AUTO_INCREMENT,\n  `position_name` varchar(100) NOT NULL,\n  `position_description` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`position_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `employees` (\n  `employee_id` int(11) NOT NULL AUTO_INCREMENT,\n  `employee_name` varchar(100) NOT NULL,\n  `gender` varchar(10) DEFAULT NULL,\n  `phone` varchar(20) DEFAULT NULL,\n  `email` varchar(100) DEFAULT NULL,\n  `hire_date` date DEFAULT NULL,\n  `position_id` int(11) NOT NULL,\n  `performance_status` varchar(50) DEFAULT NULL,\n  `status` varchar(20) DEFAULT NULL,\n  PRIMARY KEY (`employee_id`),\n  KEY `position_id` (`position_id`),\n  CONSTRAINT `employees_ibfk_1` FOREIGN KEY (`position_id`) REFERENCES `positions` (`position_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `suppliers` (\n  `supplier_id` int(11) NOT NULL AUTO_INCREMENT,\n  `supplier_name` varchar(150) NOT NULL,\n  `contact_person` varchar(100) DEFAULT NULL,\n  `phone` varchar(20) DEFAULT NULL,\n  `email` varchar(100) DEFAULT NULL,\n  `address` varchar(255) DEFAULT NULL,\n  `supplier_description` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`supplier_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `projects` (\n  `project_id` int(11) NOT NULL AUTO_INCREMENT,\n  `project_name` varchar(150) NOT NULL,\n  `project_description` varchar(255) DEFAULT NULL,\n  `start_date` date DEFAULT NULL,\n  `end_date` date DEFAULT NULL,\n  `progress_percent` decimal(5,2) DEFAULT NULL,\n  `progress_status` varchar(50) DEFAULT NULL,\n  `responsible_employee_id` int(11) NOT NULL,\n  `supplier_id` int(11) NOT NULL,\n  PRIMARY KEY (`project_id`),\n  KEY `responsible_employee_id` (`responsible_employee_id`),\n  KEY `supplier_id` (`supplier_id`),\n  CONSTRAINT `projects_ibfk_1` FOREIGN KEY (`responsible_employee_id`) REFERENCES `employees` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `projects_ibfk_2` FOREIGN KEY (`supplier_id`) REFERENCES `suppliers` (`supplier_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `attendance_records` (\n  `attendance_id` int(11) NOT NULL AUTO_INCREMENT,\n  `employee_id` int(11) NOT NULL,\n  `attendance_date` date NOT NULL,\n  `check_in_time` datetime DEFAULT NULL,\n  `check_out_time` datetime DEFAULT NULL,\n  `attendance_status` varchar(20) DEFAULT NULL,\n  `remark` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`attendance_id`),\n  KEY `employee_id` (`employee_id`),\n  CONSTRAINT `attendance_records_ibfk_1` FOREIGN KEY (`employee_id`) REFERENCES `employees` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `salary_records` (\n  `salary_id` int(11) NOT NULL AUTO_INCREMENT,\n  `employee_id` int(11) NOT NULL,\n  `salary_month` char(7) NOT NULL,\n  `base_salary` decimal(10,2) NOT NULL,\n  `bonus` decimal(10,2) DEFAULT NULL,\n  `deduction` decimal(10,2) DEFAULT NULL,\n  `net_salary` decimal(10,2) NOT NULL,\n  `pay_date` date DEFAULT NULL,\n  PRIMARY KEY (`salary_id`),\n  KEY `employee_id` (`employee_id`),\n  CONSTRAINT `salary_records_ibfk_1` FOREIGN KEY (`employee_id`) REFERENCES `employees` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
