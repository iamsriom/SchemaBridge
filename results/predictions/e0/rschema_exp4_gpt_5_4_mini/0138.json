  "question": "The main functions of a store management system may include:\n1. Manage employee information, including employee number, name, gender and performance.\n2. Manage store information, including store number, store name and address.\n3. Manage product information, including product number, product name, specifications and unit price.\n4. Record employee employment information, including employment period and monthly salary.\n5. Record product sales information, including monthly sales volume.",
  "ddl": "-- Schema for database: rschema_0138\nCREATE TABLE `employee` (\n  `employee_id` int(11) NOT NULL AUTO_INCREMENT,\n  `employee_number` varchar(50) NOT NULL,\n  `employee_name` varchar(100) NOT NULL,\n  `gender` varchar(10) DEFAULT NULL,\n  `performance` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`employee_id`),\n  UNIQUE KEY `employee_number` (`employee_number`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `store` (\n  `store_id` int(11) NOT NULL AUTO_INCREMENT,\n  `store_number` varchar(50) NOT NULL,\n  `store_name` varchar(100) NOT NULL,\n  `address` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`store_id`),\n  UNIQUE KEY `store_number` (`store_number`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `product` (\n  `product_id` int(11) NOT NULL AUTO_INCREMENT,\n  `product_number` varchar(50) NOT NULL,\n  `product_name` varchar(100) NOT NULL,\n  `specifications` varchar(255) DEFAULT NULL,\n  `unit_price` decimal(10,2) NOT NULL,\n  PRIMARY KEY (`product_id`),\n  UNIQUE KEY `product_number` (`product_number`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `employment` (\n  `employment_id` int(11) NOT NULL AUTO_INCREMENT,\n  `employee_id` int(11) NOT NULL,\n  `store_id` int(11) NOT NULL,\n  `employment_start_date` date NOT NULL,\n  `employment_end_date` date DEFAULT NULL,\n  `monthly_salary` decimal(10,2) NOT NULL,\n  PRIMARY KEY (`employment_id`),\n  KEY `employee_id` (`employee_id`),\n  KEY `store_id` (`store_id`),\n  CONSTRAINT `employment_ibfk_1` FOREIGN KEY (`employee_id`) REFERENCES `employee` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `employment_ibfk_2` FOREIGN KEY (`store_id`) REFERENCES `store` (`store_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `product_sales` (\n  `product_sales_id` int(11) NOT NULL AUTO_INCREMENT,\n  `product_id` int(11) NOT NULL,\n  `store_id` int(11) NOT NULL,\n  `sales_month` char(7) NOT NULL,\n  `monthly_sales_volume` int(11) NOT NULL,\n  PRIMARY KEY (`product_sales_id`),\n  KEY `product_id` (`product_id`),\n  KEY `store_id` (`store_id`),\n  CONSTRAINT `product_sales_ibfk_1` FOREIGN KEY (`product_id`) REFERENCES `product` (`product_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `product_sales_ibfk_2` FOREIGN KEY (`store_id`) REFERENCES `store` (`store_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
