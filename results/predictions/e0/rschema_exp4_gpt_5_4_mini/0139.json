  "question": "Hospital Information System\n\nMain functions of the system:\n1. Department management: manage hospital department information, including department name, floor, etc.\n2. Doctor management: manage doctor information, including doctor number, name, gender, title, etc.\n3. Patient management: manage patient information, including patient name, age, gender, etc.\n4. Diagnosis management: record the doctor's diagnosis information on the patient\n5. Prescription management: record the prescription information issued by the doctor for the patient\n6. Drug management: manage drug information, including drug name, price, manufacturer, etc.\n7. Drug list management: record the drugs and their quantities included in the prescription",
  "ddl": "-- Schema for database: rschema_0139\nCREATE TABLE `department` (\n  `department_id` int(11) NOT NULL AUTO_INCREMENT,\n  `department_name` varchar(255) NOT NULL,\n  `floor` varchar(50) DEFAULT NULL,\n  PRIMARY KEY (`department_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `doctor` (\n  `doctor_id` int(11) NOT NULL AUTO_INCREMENT,\n  `doctor_number` varchar(50) NOT NULL,\n  `doctor_name` varchar(255) NOT NULL,\n  `gender` varchar(10) DEFAULT NULL,\n  `title` varchar(100) DEFAULT NULL,\n  `department_id` int(11) NOT NULL,\n  PRIMARY KEY (`doctor_id`),\n  UNIQUE KEY `doctor_number` (`doctor_number`),\n  KEY `department_id` (`department_id`),\n  CONSTRAINT `doctor_ibfk_1` FOREIGN KEY (`department_id`) REFERENCES `department` (`department_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `patient` (\n  `patient_id` int(11) NOT NULL AUTO_INCREMENT,\n  `patient_name` varchar(255) NOT NULL,\n  `age` int(11) DEFAULT NULL,\n  `gender` varchar(10) DEFAULT NULL,\n  PRIMARY KEY (`patient_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `diagnosis` (\n  `diagnosis_id` int(11) NOT NULL AUTO_INCREMENT,\n  `doctor_id` int(11) NOT NULL,\n  `patient_id` int(11) NOT NULL,\n  `diagnosis_time` datetime NOT NULL,\n  `diagnosis_result` text DEFAULT NULL,\n  PRIMARY KEY (`diagnosis_id`),\n  KEY `doctor_id` (`doctor_id`),\n  KEY `patient_id` (`patient_id`),\n  CONSTRAINT `diagnosis_ibfk_1` FOREIGN KEY (`doctor_id`) REFERENCES `doctor` (`doctor_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `diagnosis_ibfk_2` FOREIGN KEY (`patient_id`) REFERENCES `patient` (`patient_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `prescription` (\n  `prescription_id` int(11) NOT NULL AUTO_INCREMENT,\n  `doctor_id` int(11) NOT NULL,\n  `patient_id` int(11) NOT NULL,\n  `diagnosis_id` int(11) DEFAULT NULL,\n  `prescription_time` datetime NOT NULL,\n  `remark` text DEFAULT NULL,\n  PRIMARY KEY (`prescription_id`),\n  KEY `doctor_id` (`doctor_id`),\n  KEY `patient_id` (`patient_id`),\n  KEY `diagnosis_id` (`diagnosis_id`),\n  CONSTRAINT `prescription_ibfk_1` FOREIGN KEY (`doctor_id`) REFERENCES `doctor` (`doctor_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `prescription_ibfk_2` FOREIGN KEY (`patient_id`) REFERENCES `patient` (`patient_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `prescription_ibfk_3` FOREIGN KEY (`diagnosis_id`) REFERENCES `diagnosis` (`diagnosis_id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `drug` (\n  `drug_id` int(11) NOT NULL AUTO_INCREMENT,\n  `drug_name` varchar(255) NOT NULL,\n  `price` decimal(10,2) NOT NULL,\n  `manufacturer` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`drug_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `prescription_drug` (\n  `prescription_drug_id` int(11) NOT NULL AUTO_INCREMENT,\n  `prescription_id` int(11) NOT NULL,\n  `drug_id` int(11) NOT NULL,\n  `quantity` int(11) NOT NULL,\n  PRIMARY KEY (`prescription_drug_id`),\n  KEY `prescription_id` (`prescription_id`),\n  KEY `drug_id` (`drug_id`),\n  CONSTRAINT `prescription_drug_ibfk_1` FOREIGN KEY (`prescription_id`) REFERENCES `prescription` (`prescription_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `prescription_drug_ibfk_2` FOREIGN KEY (`drug_id`) REFERENCES `drug` (`drug_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
