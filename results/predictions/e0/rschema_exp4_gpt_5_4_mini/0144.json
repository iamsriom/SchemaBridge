  "database": "rschema_0144",
  "question": "This is a School Management System. For student management, the system maintains students' basic information including student ID, name, gender, age, records students' major and class information, manages students' exam scores in various courses, and supports students in selecting different courses for study. For course management, the system maintains course information including course ID, course name, credits, arranges teaching staff for courses, and sets classroom and class time. For teacher management, the system maintains teachers' basic information including teacher ID, name, gender, age, records teachers' professional title and specialized field, and manages teachers' employment status in the school. For class management, the system maintains class ID and name, records class's specialized direction, and manages student members in the class. For school management, the system maintains school's basic information including school ID and name, records school's address and contact number, and manages the school's teaching staff.",
  "ddl": "-- Schema for database: rschema_0144\nCREATE TABLE `school` (\n  `school_id` int(11) NOT NULL,\n  `school_name` varchar(255) NOT NULL,\n  `address` varchar(255) DEFAULT NULL,\n  `contact_number` varchar(50) DEFAULT NULL,\n  PRIMARY KEY (`school_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `teacher` (\n  `teacher_id` int(11) NOT NULL,\n  `teacher_name` varchar(255) NOT NULL,\n  `gender` varchar(20) DEFAULT NULL,\n  `age` int(11) DEFAULT NULL,\n  `professional_title` varchar(100) DEFAULT NULL,\n  `specialized_field` varchar(255) DEFAULT NULL,\n  `employment_status` varchar(50) DEFAULT NULL,\n  `school_id` int(11) DEFAULT NULL,\n  PRIMARY KEY (`teacher_id`),\n  KEY `teacher_ibfk_1` (`school_id`),\n  CONSTRAINT `teacher_ibfk_1` FOREIGN KEY (`school_id`) REFERENCES `school` (`school_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `class` (\n  `class_id` int(11) NOT NULL,\n  `class_name` varchar(255) NOT NULL,\n  `specialized_direction` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`class_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `course` (\n  `course_id` int(11) NOT NULL,\n  `course_name` varchar(255) NOT NULL,\n  `credits` decimal(4,1) DEFAULT NULL,\n  `teacher_id` int(11) DEFAULT NULL,\n  `classroom` varchar(100) DEFAULT NULL,\n  `class_time` varchar(100) DEFAULT NULL,\n  PRIMARY KEY (`course_id`),\n  KEY `course_ibfk_1` (`teacher_id`),\n  CONSTRAINT `course_ibfk_1` FOREIGN KEY (`teacher_id`) REFERENCES `teacher` (`teacher_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `student` (\n  `student_id` int(11) NOT NULL,\n  `student_name` varchar(255) NOT NULL,\n  `gender` varchar(20) DEFAULT NULL,\n  `age` int(11) DEFAULT NULL,\n  `major` varchar(255) DEFAULT NULL,\n  `class_id` int(11) DEFAULT NULL,\n  PRIMARY KEY (`student_id`),\n  KEY `student_ibfk_1` (`class_id`),\n  CONSTRAINT `student_ibfk_1` FOREIGN KEY (`class_id`) REFERENCES `class` (`class_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `student_course` (\n  `student_id` int(11) NOT NULL,\n  `course_id` int(11) NOT NULL,\n  PRIMARY KEY (`student_id`,`course_id`),\n  KEY `student_course_ibfk_2` (`course_id`),\n  CONSTRAINT `student_course_ibfk_1` FOREIGN KEY (`student_id`) REFERENCES `student` (`student_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `student_course_ibfk_2` FOREIGN KEY (`course_id`) REFERENCES `course` (`course_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `exam_score` (\n  `student_id` int(11) NOT NULL,\n  `course_id` int(11) NOT NULL,\n  `score` decimal(5,2) DEFAULT NULL,\n  PRIMARY KEY (`student_id`,`course_id`),\n  KEY `exam_score_ibfk_2` (`course_id`),\n  CONSTRAINT `exam_score_ibfk_1` FOREIGN KEY (`student_id`) REFERENCES `student` (`student_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `exam_score_ibfk_2` FOREIGN KEY (`course_id`) REFERENCES `course` (`course_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
