  "question": "The storage management system shall coordinate business processes across departments such as procurement, warehousing, and sales. The procurement department, through procurement personnel, shall be responsible for purchasing solid state drives and storing them in the appropriate warehouse. The warehouse management department shall be responsible for the daily operations of the warehouse, including leasing, managing warehouse personnel, and ensuring the correct storage of solid state drives. The sales department, through sales personnel, shall be responsible for selling solid state drives to customers and arranging shipments. The system shall also store customer information, including name and contact details, to facilitate shipping when sales orders are placed.",
  "ddl": "-- Schema for database: rschema_0145\nCREATE TABLE `procurement_personnel` (\n  `procurement_personnel_id` int(11) NOT NULL AUTO_INCREMENT,\n  `person_name` varchar(255) NOT NULL,\n  `contact_details` varchar(255) DEFAULT NULL,\n  `department_name` varchar(100) NOT NULL,\n  PRIMARY KEY (`procurement_personnel_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `warehouse` (\n  `warehouse_id` int(11) NOT NULL AUTO_INCREMENT,\n  `warehouse_name` varchar(255) NOT NULL,\n  `location` varchar(255) DEFAULT NULL,\n  `lease_start_date` date DEFAULT NULL,\n  `lease_end_date` date DEFAULT NULL,\n  PRIMARY KEY (`warehouse_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `warehouse_personnel` (\n  `warehouse_personnel_id` int(11) NOT NULL AUTO_INCREMENT,\n  `person_name` varchar(255) NOT NULL,\n  `contact_details` varchar(255) DEFAULT NULL,\n  `warehouse_id` int(11) NOT NULL,\n  PRIMARY KEY (`warehouse_personnel_id`),\n  KEY `warehouse_personnel_ibfk_1` (`warehouse_id`),\n  CONSTRAINT `warehouse_personnel_ibfk_1` FOREIGN KEY (`warehouse_id`) REFERENCES `warehouse` (`warehouse_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `sales_personnel` (\n  `sales_personnel_id` int(11) NOT NULL AUTO_INCREMENT,\n  `person_name` varchar(255) NOT NULL,\n  `contact_details` varchar(255) DEFAULT NULL,\n  `department_name` varchar(100) NOT NULL,\n  PRIMARY KEY (`sales_personnel_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `customer` (\n  `customer_id` int(11) NOT NULL AUTO_INCREMENT,\n  `customer_name` varchar(255) NOT NULL,\n  `contact_details` varchar(255) DEFAULT NULL,\n  `shipping_address` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`customer_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `solid_state_drive` (\n  `ssd_id` int(11) NOT NULL AUTO_INCREMENT,\n  `model_name` varchar(255) NOT NULL,\n  `capacity_gb` int(11) NOT NULL,\n  `purchase_date` date DEFAULT NULL,\n  `procurement_personnel_id` int(11) NOT NULL,\n  `warehouse_id` int(11) NOT NULL,\n  PRIMARY KEY (`ssd_id`),\n  KEY `solid_state_drive_ibfk_1` (`procurement_personnel_id`),\n  KEY `solid_state_drive_ibfk_2` (`warehouse_id`),\n  CONSTRAINT `solid_state_drive_ibfk_1` FOREIGN KEY (`procurement_personnel_id`) REFERENCES `procurement_personnel` (`procurement_personnel_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `solid_state_drive_ibfk_2` FOREIGN KEY (`warehouse_id`) REFERENCES `warehouse` (`warehouse_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `sales_order` (\n  `sales_order_id` int(11) NOT NULL AUTO_INCREMENT,\n  `order_date` datetime NOT NULL,\n  `customer_id` int(11) NOT NULL,\n  `sales_personnel_id` int(11) NOT NULL,\n  `shipment_status` varchar(50) DEFAULT NULL,\n  PRIMARY KEY (`sales_order_id`),\n  KEY `sales_order_ibfk_1` (`customer_id`),\n  KEY `sales_order_ibfk_2` (`sales_personnel_id`),\n  CONSTRAINT `sales_order_ibfk_1` FOREIGN KEY (`customer_id`) REFERENCES `customer` (`customer_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `sales_order_ibfk_2` FOREIGN KEY (`sales_personnel_id`) REFERENCES `sales_personnel` (`sales_personnel_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `sales_order_item` (\n  `sales_order_item_id` int(11) NOT NULL AUTO_INCREMENT,\n  `sales_order_id` int(11) NOT NULL,\n  `ssd_id` int(11) NOT NULL,\n  `quantity` int(11) NOT NULL,\n  `unit_price` decimal(10,2) DEFAULT NULL,\n  PRIMARY KEY (`sales_order_item_id`),\n  KEY `sales_order_item_ibfk_1` (`sales_order_id`),\n  KEY `sales_order_item_ibfk_2` (`ssd_id`),\n  CONSTRAINT `sales_order_item_ibfk_1` FOREIGN KEY (`sales_order_id`) REFERENCES `sales_order` (`sales_order_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `sales_order_item_ibfk_2` FOREIGN KEY (`ssd_id`) REFERENCES `solid_state_drive` (`ssd_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
