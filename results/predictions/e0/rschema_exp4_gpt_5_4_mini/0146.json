  "question": "A dormitory management system is used to manage dormitories, users, and related information summaries. The functional requirements are as follows:\nDormitory information management stores relevant information about dormitories, including the unique dormitory ID, dormitory number, number of dormitory members, affiliated college, and dormitory type.\nUser information management stores personal information of users, including the unique user ID, name, gender, age, contact information, and personal profile.\nDormitory member management uses Foreign key to link the dormitory information table and the user information table, thereby recording the user information contained in each dormitory.\nInformation summary management uses Foreign key to link the dormitory information table and the user information table, and stores the summarized data of dormitory and user information.",
  "ddl": "-- Schema for database: rschema_0146\nCREATE TABLE `dormitory_info` (\n  `dormitory_id` int(11) NOT NULL AUTO_INCREMENT,\n  `dormitory_number` varchar(50) NOT NULL,\n  `member_count` int(11) NOT NULL,\n  `affiliated_college` varchar(255) DEFAULT NULL,\n  `dormitory_type` varchar(100) DEFAULT NULL,\n  PRIMARY KEY (`dormitory_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `user_info` (\n  `user_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(100) NOT NULL,\n  `gender` varchar(20) DEFAULT NULL,\n  `age` int(11) DEFAULT NULL,\n  `contact_information` varchar(255) DEFAULT NULL,\n  `personal_profile` text DEFAULT NULL,\n  PRIMARY KEY (`user_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `dormitory_member` (\n  `dormitory_member_id` int(11) NOT NULL AUTO_INCREMENT,\n  `dormitory_id` int(11) NOT NULL,\n  `user_id` int(11) NOT NULL,\n  PRIMARY KEY (`dormitory_member_id`),\n  KEY `dormitory_member_ibfk_1` (`dormitory_id`),\n  KEY `dormitory_member_ibfk_2` (`user_id`),\n  CONSTRAINT `dormitory_member_ibfk_1` FOREIGN KEY (`dormitory_id`) REFERENCES `dormitory_info` (`dormitory_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `dormitory_member_ibfk_2` FOREIGN KEY (`user_id`) REFERENCES `user_info` (`user_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `information_summary` (\n  `summary_id` int(11) NOT NULL AUTO_INCREMENT,\n  `dormitory_id` int(11) NOT NULL,\n  `user_id` int(11) NOT NULL,\n  `summary_content` text DEFAULT NULL,\n  `summary_time` datetime DEFAULT NULL,\n  PRIMARY KEY (`summary_id`),\n  KEY `information_summary_ibfk_1` (`dormitory_id`),\n  KEY `information_summary_ibfk_2` (`user_id`),\n  CONSTRAINT `information_summary_ibfk_1` FOREIGN KEY (`dormitory_id`) REFERENCES `dormitory_info` (`dormitory_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `information_summary_ibfk_2` FOREIGN KEY (`user_id`) REFERENCES `user_info` (`user_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
