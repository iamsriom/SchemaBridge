  "database": "rschema_0147",
  "question": "The key features of the system are as follows:\n1.Class Management: Manage class information, including class name, department name, grade, etc.\n2.Member Management: Manage the information of class members, including member ID, name, password, email, age, workplace, contact number, etc.\n3.Announcement Management: Publish and manage class announcements, including announcement ID, announcement time, and announcement content.\n4.Message Management: Manage class messages, allowing members to send messages. The system records sender ID, receiver ID, message content, send time, and read status.\n5.Log Management: Record class logs, including log ID, log content, time, mood, etc. Each member can post their own logs.\n6.Leave Management: Manage class messages, including message ID, message time, message content, and message count. Each member can leave messages.\n7.Application Management: Handle applications submitted by class members, including application ID, application time, approval status, and application content.",
  "ddl": "-- Schema for database: rschema_0147\nCREATE TABLE `class_info` (\n  `class_id` int(11) NOT NULL AUTO_INCREMENT,\n  `class_name` varchar(255) NOT NULL,\n  `department_name` varchar(255) DEFAULT NULL,\n  `grade` varchar(50) DEFAULT NULL,\n  PRIMARY KEY (`class_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `member_info` (\n  `member_id` int(11) NOT NULL AUTO_INCREMENT,\n  `class_id` int(11) NOT NULL,\n  `member_name` varchar(255) NOT NULL,\n  `password` varchar(255) NOT NULL,\n  `email` varchar(255) DEFAULT NULL,\n  `age` int(11) DEFAULT NULL,\n  `workplace` varchar(255) DEFAULT NULL,\n  `contact_number` varchar(50) DEFAULT NULL,\n  PRIMARY KEY (`member_id`),\n  KEY `member_info_ibfk_1` (`class_id`),\n  CONSTRAINT `member_info_ibfk_1` FOREIGN KEY (`class_id`) REFERENCES `class_info` (`class_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `announcement_info` (\n  `announcement_id` int(11) NOT NULL AUTO_INCREMENT,\n  `class_id` int(11) NOT NULL,\n  `announcement_time` datetime NOT NULL,\n  `announcement_content` text NOT NULL,\n  PRIMARY KEY (`announcement_id`),\n  KEY `announcement_info_ibfk_1` (`class_id`),\n  CONSTRAINT `announcement_info_ibfk_1` FOREIGN KEY (`class_id`) REFERENCES `class_info` (`class_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `message_info` (\n  `message_id` int(11) NOT NULL AUTO_INCREMENT,\n  `sender_id` int(11) NOT NULL,\n  `receiver_id` int(11) NOT NULL,\n  `message_content` text NOT NULL,\n  `send_time` datetime NOT NULL,\n  `read_status` tinyint(1) NOT NULL DEFAULT '0',\n  PRIMARY KEY (`message_id`),\n  KEY `message_info_ibfk_1` (`sender_id`),\n  KEY `message_info_ibfk_2` (`receiver_id`),\n  CONSTRAINT `message_info_ibfk_1` FOREIGN KEY (`sender_id`) REFERENCES `member_info` (`member_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `message_info_ibfk_2` FOREIGN KEY (`receiver_id`) REFERENCES `member_info` (`member_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `log_info` (\n  `log_id` int(11) NOT NULL AUTO_INCREMENT,\n  `member_id` int(11) NOT NULL,\n  `log_content` text NOT NULL,\n  `log_time` datetime NOT NULL,\n  `mood` varchar(50) DEFAULT NULL,\n  PRIMARY KEY (`log_id`),\n  KEY `log_info_ibfk_1` (`member_id`),\n  CONSTRAINT `log_info_ibfk_1` FOREIGN KEY (`member_id`) REFERENCES `member_info` (`member_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `leave_message_info` (\n  `leave_message_id` int(11) NOT NULL AUTO_INCREMENT,\n  `member_id` int(11) NOT NULL,\n  `message_time` datetime NOT NULL,\n  `message_content` text NOT NULL,\n  `message_count` int(11) NOT NULL DEFAULT '0',\n  PRIMARY KEY (`leave_message_id`),\n  KEY `leave_message_info_ibfk_1` (`member_id`),\n  CONSTRAINT `leave_message_info_ibfk_1` FOREIGN KEY (`member_id`) REFERENCES `member_info` (`member_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `application_info` (\n  `application_id` int(11) NOT NULL AUTO_INCREMENT,\n  `member_id` int(11) NOT NULL,\n  `application_time` datetime NOT NULL,\n  `approval_status` varchar(50) NOT NULL DEFAULT 'pending',\n  `application_content` text NOT NULL,\n  PRIMARY KEY (`application_id`),\n  KEY `application_info_ibfk_1` (`member_id`),\n  CONSTRAINT `application_info_ibfk_1` FOREIGN KEY (`member_id`) REFERENCES `member_info` (`member_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
