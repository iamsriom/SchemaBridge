  "database": "rschema_0167",
  "question": "The Jinan City Natural Disaster Comprehensive Risk Data Management System is based on a Browser/Server (B/S) architecture. The system aims to integrate and manage the results of the natural disaster risk survey in Jinan City, achieving efficient data management and multi-level sharing. The main functional requirements of the system include:\n1.Natural Disaster Data Management: The system will record relevant data related to natural disasters, such as Data ID, Data Type, Data Source, Upload Time, Data Content, Data Format, and Layer Type, to analyze natural disaster risks.\n2.Regional Data Management: Each region has Attributes like Region Name, Administrative Division, Latitude and Longitude, Area, and Disaster Risk Level, and each region may contain multiple natural disaster data.\n3.Department Data Management: Each department records Attributes such as Department Name, Person-in-Charge, Contact Information, and Functional Scope. Each region can have multiple departments, and each department can manage multiple regions.\n4.User Management: Each user has a unique User ID, Username, Role, and Contact Information. Each department has multiple users, and each user has a different Permission Level.",
  "ddl": "-- Schema for database: rschema_0167\nCREATE TABLE `region` (\n  `region_id` int(11) NOT NULL AUTO_INCREMENT,\n  `region_name` varchar(255) NOT NULL,\n  `administrative_division` varchar(255) NOT NULL,\n  `latitude` decimal(10,6) DEFAULT NULL,\n  `longitude` decimal(10,6) DEFAULT NULL,\n  `area` decimal(12,2) DEFAULT NULL,\n  `disaster_risk_level` varchar(50) DEFAULT NULL,\n  PRIMARY KEY (`region_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `department` (\n  `department_id` int(11) NOT NULL AUTO_INCREMENT,\n  `department_name` varchar(255) NOT NULL,\n  `person_in_charge` varchar(255) DEFAULT NULL,\n  `contact_information` varchar(255) DEFAULT NULL,\n  `functional_scope` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`department_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `user` (\n  `user_id` int(11) NOT NULL AUTO_INCREMENT,\n  `department_id` int(11) NOT NULL,\n  `username` varchar(255) NOT NULL,\n  `role` varchar(100) NOT NULL,\n  `contact_information` varchar(255) DEFAULT NULL,\n  `permission_level` varchar(50) NOT NULL,\n  PRIMARY KEY (`user_id`),\n  KEY `user_ibfk_1` (`department_id`),\n  CONSTRAINT `user_ibfk_1` FOREIGN KEY (`department_id`) REFERENCES `department` (`department_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `department_region` (\n  `department_id` int(11) NOT NULL,\n  `region_id` int(11) NOT NULL,\n  PRIMARY KEY (`department_id`,`region_id`),\n  KEY `department_region_ibfk_2` (`region_id`),\n  CONSTRAINT `department_region_ibfk_1` FOREIGN KEY (`department_id`) REFERENCES `department` (`department_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `department_region_ibfk_2` FOREIGN KEY (`region_id`) REFERENCES `region` (`region_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `natural_disaster_data` (\n  `data_id` int(11) NOT NULL AUTO_INCREMENT,\n  `region_id` int(11) NOT NULL,\n  `data_type` varchar(100) NOT NULL,\n  `data_source` varchar(255) DEFAULT NULL,\n  `upload_time` datetime DEFAULT NULL,\n  `data_content` text DEFAULT NULL,\n  `data_format` varchar(50) DEFAULT NULL,\n  `layer_type` varchar(100) DEFAULT NULL,\n  PRIMARY KEY (`data_id`),\n  KEY `natural_disaster_data_ibfk_1` (`region_id`),\n  CONSTRAINT `natural_disaster_data_ibfk_1` FOREIGN KEY (`region_id`) REFERENCES `region` (`region_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
