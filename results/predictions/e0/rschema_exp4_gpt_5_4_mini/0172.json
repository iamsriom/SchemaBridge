  "database": "rschema_0172",
  "question": "\"The system is required to routinely record patients' vital signs, including temperature, blood pressure, heart rate, and other data, generating a unique log ID and record time for each entry. These vital signs will be formatted and stored in a log file. If any vital sign exceeds the preset normal range, the system will send an alert message, including alert ID, patient ID, abnormal vital signs, alert time, and alert content. The preset normal ranges are maintained by doctors, and the system will save these normal range details for comparison.\"",
  "ddl": "-- Schema for database: rschema_0172\nCREATE TABLE `patients` (\n  `patient_id` int(11) NOT NULL AUTO_INCREMENT,\n  `patient_name` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`patient_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `doctors` (\n  `doctor_id` int(11) NOT NULL AUTO_INCREMENT,\n  `doctor_name` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`doctor_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `normal_ranges` (\n  `range_id` int(11) NOT NULL AUTO_INCREMENT,\n  `doctor_id` int(11) NOT NULL,\n  `vital_sign_name` varchar(100) NOT NULL,\n  `min_value` decimal(10,2) DEFAULT NULL,\n  `max_value` decimal(10,2) DEFAULT NULL,\n  `unit` varchar(50) DEFAULT NULL,\n  `created_at` datetime DEFAULT NULL,\n  PRIMARY KEY (`range_id`),\n  KEY `normal_ranges_ibfk_1` (`doctor_id`),\n  CONSTRAINT `normal_ranges_ibfk_1` FOREIGN KEY (`doctor_id`) REFERENCES `doctors` (`doctor_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `vital_sign_logs` (\n  `log_id` int(11) NOT NULL AUTO_INCREMENT,\n  `patient_id` int(11) NOT NULL,\n  `record_time` datetime NOT NULL,\n  `temperature` decimal(5,2) DEFAULT NULL,\n  `blood_pressure_systolic` int(11) DEFAULT NULL,\n  `blood_pressure_diastolic` int(11) DEFAULT NULL,\n  `heart_rate` int(11) DEFAULT NULL,\n  `respiratory_rate` int(11) DEFAULT NULL,\n  `oxygen_saturation` decimal(5,2) DEFAULT NULL,\n  `other_vital_signs` varchar(500) DEFAULT NULL,\n  `log_file_path` varchar(500) DEFAULT NULL,\n  PRIMARY KEY (`log_id`),\n  KEY `vital_sign_logs_ibfk_1` (`patient_id`),\n  CONSTRAINT `vital_sign_logs_ibfk_1` FOREIGN KEY (`patient_id`) REFERENCES `patients` (`patient_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `alerts` (\n  `alert_id` int(11) NOT NULL AUTO_INCREMENT,\n  `patient_id` int(11) NOT NULL,\n  `log_id` int(11) NOT NULL,\n  `abnormal_vital_signs` varchar(500) NOT NULL,\n  `alert_time` datetime NOT NULL,\n  `alert_content` varchar(1000) NOT NULL,\n  PRIMARY KEY (`alert_id`),\n  KEY `alerts_ibfk_1` (`patient_id`),\n  KEY `alerts_ibfk_2` (`log_id`),\n  CONSTRAINT `alerts_ibfk_1` FOREIGN KEY (`patient_id`) REFERENCES `patients` (`patient_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `alerts_ibfk_2` FOREIGN KEY (`log_id`) REFERENCES `vital_sign_logs` (`log_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
