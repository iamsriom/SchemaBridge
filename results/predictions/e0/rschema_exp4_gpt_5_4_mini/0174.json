  "database": "rschema_0174",
  "question": "This is a Patient Monitoring System. For patient management, the system records each patient's basic information, including unique medical record number, name, gender, address, ID card number, phone number, and admission time. For vital signs management, the system periodically collects patients' vital sign data, such as body temperature, blood pressure, heart rate, etc. Each vital sign has its upper and lower limits for normal range, which doctors can add or update. The system formats the collected vital sign data and stores it in logs, while comparing these data with preset normal ranges, sending warning messages if limits are exceeded. The system generates medical records based on vital sign data, recording diagnosis time and content. For treatment management, the system generates treatment recommendations based on vital sign data and medical records, which doctors and nurses can query to provide treatment accordingly.",
  "ddl": "-- Schema for database: rschema_0174\nCREATE TABLE `patients` (\n  `patient_id` int(11) NOT NULL AUTO_INCREMENT,\n  `medical_record_number` varchar(50) NOT NULL,\n  `name` varchar(100) NOT NULL,\n  `gender` varchar(10) NOT NULL,\n  `address` varchar(255) DEFAULT NULL,\n  `id_card_number` varchar(20) DEFAULT NULL,\n  `phone_number` varchar(20) DEFAULT NULL,\n  `admission_time` datetime NOT NULL,\n  PRIMARY KEY (`patient_id`),\n  UNIQUE KEY `uk_patients_medical_record_number` (`medical_record_number`),\n  UNIQUE KEY `uk_patients_id_card_number` (`id_card_number`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `vital_sign_types` (\n  `vital_sign_type_id` int(11) NOT NULL AUTO_INCREMENT,\n  `type_name` varchar(100) NOT NULL,\n  `unit` varchar(20) DEFAULT NULL,\n  `normal_lower_limit` decimal(10,2) DEFAULT NULL,\n  `normal_upper_limit` decimal(10,2) DEFAULT NULL,\n  `updated_by` varchar(100) DEFAULT NULL,\n  `updated_at` datetime DEFAULT NULL,\n  PRIMARY KEY (`vital_sign_type_id`),\n  UNIQUE KEY `uk_vital_sign_types_type_name` (`type_name`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `vital_sign_logs` (\n  `vital_sign_log_id` int(11) NOT NULL AUTO_INCREMENT,\n  `patient_id` int(11) NOT NULL,\n  `vital_sign_type_id` int(11) NOT NULL,\n  `measured_value` decimal(10,2) NOT NULL,\n  `formatted_value` varchar(255) DEFAULT NULL,\n  `measured_at` datetime NOT NULL,\n  `is_out_of_range` tinyint(1) NOT NULL DEFAULT '0',\n  `warning_message` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`vital_sign_log_id`),\n  KEY `vital_sign_logs_ibfk_1` (`patient_id`),\n  KEY `vital_sign_logs_ibfk_2` (`vital_sign_type_id`),\n  CONSTRAINT `vital_sign_logs_ibfk_1` FOREIGN KEY (`patient_id`) REFERENCES `patients` (`patient_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `vital_sign_logs_ibfk_2` FOREIGN KEY (`vital_sign_type_id`) REFERENCES `vital_sign_types` (`vital_sign_type_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `medical_records` (\n  `medical_record_id` int(11) NOT NULL AUTO_INCREMENT,\n  `patient_id` int(11) NOT NULL,\n  `vital_sign_log_id` int(11) DEFAULT NULL,\n  `diagnosis_time` datetime NOT NULL,\n  `diagnosis_content` text NOT NULL,\n  PRIMARY KEY (`medical_record_id`),\n  KEY `medical_records_ibfk_1` (`patient_id`),\n  KEY `medical_records_ibfk_2` (`vital_sign_log_id`),\n  CONSTRAINT `medical_records_ibfk_1` FOREIGN KEY (`patient_id`) REFERENCES `patients` (`patient_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `medical_records_ibfk_2` FOREIGN KEY (`vital_sign_log_id`) REFERENCES `vital_sign_logs` (`vital_sign_log_id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `treatment_recommendations` (\n  `treatment_recommendation_id` int(11) NOT NULL AUTO_INCREMENT,\n  `patient_id` int(11) NOT NULL,\n  `medical_record_id` int(11) DEFAULT NULL,\n  `vital_sign_log_id` int(11) DEFAULT NULL,\n  `recommendation_time` datetime NOT NULL,\n  `recommendation_content` text NOT NULL,\n  `recommended_by` varchar(100) DEFAULT NULL,\n  `status` varchar(20) DEFAULT NULL,\n  PRIMARY KEY (`treatment_recommendation_id`),\n  KEY `treatment_recommendations_ibfk_1` (`patient_id`),\n  KEY `treatment_recommendations_ibfk_2` (`medical_record_id`),\n  KEY `treatment_recommendations_ibfk_3` (`vital_sign_log_id`),\n  CONSTRAINT `treatment_recommendations_ibfk_1` FOREIGN KEY (`patient_id`) REFERENCES `patients` (`patient_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `treatment_recommendations_ibfk_2` FOREIGN KEY (`medical_record_id`) REFERENCES `medical_records` (`medical_record_id`) ON DELETE SET NULL ON UPDATE CASCADE,\n  CONSTRAINT `treatment_recommendations_ibfk_3` FOREIGN KEY (`vital_sign_log_id`) REFERENCES `vital_sign_logs` (`vital_sign_log_id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
