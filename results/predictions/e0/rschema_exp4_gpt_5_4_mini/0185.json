  "question": "The People's Political Consultative Conference requires a system to manage proposals from its members. Each proposal includes a Proposal ID, Proposal Content, Proposal Time, Proposer(s), and Status. A proposer can consist of multiple members, each with a Member ID, Name, Gender, Date of Birth, Party Affiliation, and Position. The system also needs to record the handling of each proposal, which includes Handling Time, Handler, and Handling Opinion. The handler is a member different from the proposer.",
  "ddl": "-- Schema for database: rschema_0185\nCREATE TABLE `member` (\n  `member_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `gender` varchar(20) DEFAULT NULL,\n  `date_of_birth` date DEFAULT NULL,\n  `party_affiliation` varchar(255) DEFAULT NULL,\n  `position` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`member_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `proposal` (\n  `proposal_id` int(11) NOT NULL,\n  `proposal_content` text NOT NULL,\n  `proposal_time` datetime NOT NULL,\n  `status` varchar(50) NOT NULL,\n  PRIMARY KEY (`proposal_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `proposal_proposer` (\n  `proposal_id` int(11) NOT NULL,\n  `member_id` int(11) NOT NULL,\n  PRIMARY KEY (`proposal_id`,`member_id`),\n  KEY `proposal_proposer_ibfk_2` (`member_id`),\n  CONSTRAINT `proposal_proposer_ibfk_1` FOREIGN KEY (`proposal_id`) REFERENCES `proposal` (`proposal_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `proposal_proposer_ibfk_2` FOREIGN KEY (`member_id`) REFERENCES `member` (`member_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `proposal_handling` (\n  `handling_id` int(11) NOT NULL AUTO_INCREMENT,\n  `proposal_id` int(11) NOT NULL,\n  `handling_time` datetime NOT NULL,\n  `handler_member_id` int(11) NOT NULL,\n  `handling_opinion` text NOT NULL,\n  PRIMARY KEY (`handling_id`),\n  KEY `proposal_handling_ibfk_1` (`proposal_id`),\n  KEY `proposal_handling_ibfk_2` (`handler_member_id`),\n  CONSTRAINT `proposal_handling_ibfk_1` FOREIGN KEY (`proposal_id`) REFERENCES `proposal` (`proposal_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `proposal_handling_ibfk_2` FOREIGN KEY (`handler_member_id`) REFERENCES `member` (`member_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
