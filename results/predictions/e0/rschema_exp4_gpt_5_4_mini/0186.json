  "database": "rschema_0186",
  "question": "A social security organization requires the management of social security information, including the basic information of the insured, types of social security, payment details, and receipt details. The insured's information includes Social Security ID, name, gender, date of birth, identity card number, and contact information; the social security types include a type ID, name, and description; payment details record the time, amount, and payer of each payment; receipt details record the time, amount, and recipient of each receipt.",
  "ddl": "-- Schema for database: rschema_0186\nCREATE TABLE `insured` (\n  `social_security_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `gender` varchar(10) DEFAULT NULL,\n  `date_of_birth` date DEFAULT NULL,\n  `identity_card_number` varchar(20) DEFAULT NULL,\n  `contact_information` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`social_security_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `social_security_type` (\n  `type_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `description` varchar(500) DEFAULT NULL,\n  PRIMARY KEY (`type_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `payment_detail` (\n  `payment_id` int(11) NOT NULL,\n  `social_security_id` int(11) NOT NULL,\n  `payment_time` datetime NOT NULL,\n  `amount` decimal(10,2) NOT NULL,\n  `payer` varchar(255) NOT NULL,\n  PRIMARY KEY (`payment_id`),\n  KEY `payment_detail_ibfk_1` (`social_security_id`),\n  CONSTRAINT `payment_detail_ibfk_1` FOREIGN KEY (`social_security_id`) REFERENCES `insured` (`social_security_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `receipt_detail` (\n  `receipt_id` int(11) NOT NULL,\n  `social_security_id` int(11) NOT NULL,\n  `receipt_time` datetime NOT NULL,\n  `amount` decimal(10,2) NOT NULL,\n  `recipient` varchar(255) NOT NULL,\n  PRIMARY KEY (`receipt_id`),\n  KEY `receipt_detail_ibfk_1` (`social_security_id`),\n  CONSTRAINT `receipt_detail_ibfk_1` FOREIGN KEY (`social_security_id`) REFERENCES `insured` (`social_security_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
