  "database": "rschema_0190",
  "question": "The Electronic Device Repair Service Center provides repair services for electronic devices such as mobile phones and computers. The service center has multiple repair workstations, with multiple repair technicians at each workstation. Each repair task includes a Task ID, Customer Information (Customer Name, Customer Phone Number), Product Information (Product Name, Model Number, Fault Description), Repair Date, Repair Type, and Repair Duration. After completion of repairs, the system must record Repair Cost, Repair Results, and Customer Feedback. Repair technician performance evaluation is based on the number of completed repair tasks and customer satisfaction ratings.",
  "ddl": "-- Schema for database: rschema_0190\nCREATE TABLE `workstation` (\n  `workstation_id` int(11) NOT NULL AUTO_INCREMENT,\n  `workstation_name` varchar(255) NOT NULL,\n  `location` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`workstation_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `technician` (\n  `technician_id` int(11) NOT NULL AUTO_INCREMENT,\n  `workstation_id` int(11) NOT NULL,\n  `technician_name` varchar(255) NOT NULL,\n  `phone_number` varchar(20) DEFAULT NULL,\n  `hire_date` datetime DEFAULT NULL,\n  PRIMARY KEY (`technician_id`),\n  KEY `technician_ibfk_1` (`workstation_id`),\n  CONSTRAINT `technician_ibfk_1` FOREIGN KEY (`workstation_id`) REFERENCES `workstation` (`workstation_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `repair_task` (\n  `task_id` int(11) NOT NULL AUTO_INCREMENT,\n  `technician_id` int(11) NOT NULL,\n  `customer_name` varchar(255) NOT NULL,\n  `customer_phone_number` varchar(20) NOT NULL,\n  `product_name` varchar(255) NOT NULL,\n  `model_number` varchar(255) NOT NULL,\n  `fault_description` text NOT NULL,\n  `repair_date` datetime NOT NULL,\n  `repair_type` varchar(100) NOT NULL,\n  `repair_duration` int(11) NOT NULL,\n  `repair_cost` decimal(10,2) DEFAULT NULL,\n  `repair_results` text DEFAULT NULL,\n  `customer_feedback` text DEFAULT NULL,\n  `customer_satisfaction_rating` decimal(3,2) DEFAULT NULL,\n  `task_status` varchar(50) NOT NULL DEFAULT 'completed',\n  PRIMARY KEY (`task_id`),\n  KEY `repair_task_ibfk_1` (`technician_id`),\n  CONSTRAINT `repair_task_ibfk_1` FOREIGN KEY (`technician_id`) REFERENCES `technician` (`technician_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
