  "question": "The daily-use products sales company sells home appliances, furniture, and other daily-use products. The company has multiple sales teams, each consisting of several sales personnel. Each sales task is identified by a task ID and includes customer information (customer name, customer telephone), product information (product name, model, price), sales date, sales quantity, and sales cost. After completing a sale, the customer evaluation must be recorded. The performance evaluation of sales personnel is based on the number of sales tasks completed and customer satisfaction.",
  "ddl": "-- Schema for database: rschema_0191\nCREATE TABLE `sales_team` (\n  `team_id` int(11) NOT NULL AUTO_INCREMENT,\n  `team_name` varchar(255) NOT NULL,\n  PRIMARY KEY (`team_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `sales_personnel` (\n  `personnel_id` int(11) NOT NULL AUTO_INCREMENT,\n  `team_id` int(11) NOT NULL,\n  `personnel_name` varchar(255) NOT NULL,\n  `phone` varchar(20) DEFAULT NULL,\n  PRIMARY KEY (`personnel_id`),\n  KEY `sales_personnel_ibfk_1` (`team_id`),\n  CONSTRAINT `sales_personnel_ibfk_1` FOREIGN KEY (`team_id`) REFERENCES `sales_team` (`team_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `sales_task` (\n  `task_id` int(11) NOT NULL AUTO_INCREMENT,\n  `personnel_id` int(11) NOT NULL,\n  `customer_name` varchar(255) NOT NULL,\n  `customer_telephone` varchar(20) NOT NULL,\n  `product_name` varchar(255) NOT NULL,\n  `product_model` varchar(255) NOT NULL,\n  `product_price` decimal(10,2) NOT NULL,\n  `sales_date` datetime NOT NULL,\n  `sales_quantity` int(11) NOT NULL,\n  `sales_cost` decimal(10,2) NOT NULL,\n  PRIMARY KEY (`task_id`),\n  KEY `sales_task_ibfk_1` (`personnel_id`),\n  CONSTRAINT `sales_task_ibfk_1` FOREIGN KEY (`personnel_id`) REFERENCES `sales_personnel` (`personnel_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `customer_evaluation` (\n  `evaluation_id` int(11) NOT NULL AUTO_INCREMENT,\n  `task_id` int(11) NOT NULL,\n  `satisfaction_score` int(11) NOT NULL,\n  `evaluation_content` varchar(1000) DEFAULT NULL,\n  `evaluation_date` datetime NOT NULL,\n  PRIMARY KEY (`evaluation_id`),\n  UNIQUE KEY `task_id` (`task_id`),\n  CONSTRAINT `customer_evaluation_ibfk_1` FOREIGN KEY (`task_id`) REFERENCES `sales_task` (`task_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `personnel_performance` (\n  `performance_id` int(11) NOT NULL AUTO_INCREMENT,\n  `personnel_id` int(11) NOT NULL,\n  `completed_task_count` int(11) NOT NULL,\n  `average_satisfaction_score` decimal(5,2) NOT NULL,\n  `evaluation_date` datetime NOT NULL,\n  PRIMARY KEY (`performance_id`),\n  KEY `personnel_performance_ibfk_1` (`personnel_id`),\n  CONSTRAINT `personnel_performance_ibfk_1` FOREIGN KEY (`personnel_id`) REFERENCES `sales_personnel` (`personnel_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
