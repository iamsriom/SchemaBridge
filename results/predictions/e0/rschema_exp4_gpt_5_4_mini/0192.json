  "database": "rschema_0192",
  "question": "The construction company undertakes multiple construction projects. Each project has a project manager, project name, start date, estimated completion date, actual completion date, project budget, and project location. The company has multiple departments, each responsible for different projects. Each department has a department name and department head. Each project involves multiple employees, and each employee can participate in multiple projects. Each employee has an employee number, name, date of birth, gender, phone number, and position. When an employee participates in a project, the project they participate in, participation time, role, and work hours need to be recorded. The project management information system needs to be able to track project progress and cost, as well as generate statistics on employee workload.",
  "ddl": "-- Schema for database: rschema_0192\nCREATE TABLE `departments` (\n  `department_id` int(11) NOT NULL AUTO_INCREMENT,\n  `department_name` varchar(255) NOT NULL,\n  `department_head` varchar(255) NOT NULL,\n  PRIMARY KEY (`department_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `employees` (\n  `employee_id` int(11) NOT NULL AUTO_INCREMENT,\n  `employee_number` varchar(50) NOT NULL,\n  `employee_name` varchar(255) NOT NULL,\n  `date_of_birth` date NOT NULL,\n  `gender` char(1) NOT NULL,\n  `phone_number` varchar(20) NOT NULL,\n  `position` varchar(255) NOT NULL,\n  PRIMARY KEY (`employee_id`),\n  UNIQUE KEY `employee_number` (`employee_number`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `projects` (\n  `project_id` int(11) NOT NULL AUTO_INCREMENT,\n  `department_id` int(11) NOT NULL,\n  `project_manager_id` int(11) NOT NULL,\n  `project_name` varchar(255) NOT NULL,\n  `start_date` date NOT NULL,\n  `estimated_completion_date` date NOT NULL,\n  `actual_completion_date` date DEFAULT NULL,\n  `project_budget` decimal(12,2) NOT NULL,\n  `project_location` varchar(255) NOT NULL,\n  `project_progress` decimal(5,2) NOT NULL DEFAULT '0.00',\n  `project_cost` decimal(12,2) NOT NULL DEFAULT '0.00',\n  PRIMARY KEY (`project_id`),\n  KEY `department_id` (`department_id`),\n  KEY `project_manager_id` (`project_manager_id`),\n  CONSTRAINT `projects_ibfk_1` FOREIGN KEY (`department_id`) REFERENCES `departments` (`department_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `projects_ibfk_2` FOREIGN KEY (`project_manager_id`) REFERENCES `employees` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `project_participation` (\n  `participation_id` int(11) NOT NULL AUTO_INCREMENT,\n  `project_id` int(11) NOT NULL,\n  `employee_id` int(11) NOT NULL,\n  `participation_time` datetime NOT NULL,\n  `role` varchar(255) NOT NULL,\n  `work_hours` decimal(8,2) NOT NULL DEFAULT '0.00',\n  PRIMARY KEY (`participation_id`),\n  KEY `project_id` (`project_id`),\n  KEY `employee_id` (`employee_id`),\n  CONSTRAINT `project_participation_ibfk_1` FOREIGN KEY (`project_id`) REFERENCES `projects` (`project_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `project_participation_ibfk_2` FOREIGN KEY (`employee_id`) REFERENCES `employees` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
