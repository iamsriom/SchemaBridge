  "question": "The database shall be designed to manage the bank's mortgage application process.\nThe system shall record basic information for each applicant, including Applicant ID, Name, Phone Number, Email Address, and Identification Number. \nEach loan application shall include a unique Application Number, Applicant ID, Requested Loan Amount, Loan Term, and current Approval Status.       \nThe loan approval process shall be recorded in detail in the Loan Approval Form, including Application Number, Approval Date, Approval Result, and Approver ID.\nAdditionally, the system shall record detailed information for each approver, including Approver ID, Name, Phone Number, and Email Address.\nEach loan application may go through multiple approval stages, with each stage handled by different approvers. The system shall record each approval action and result.",
  "ddl": "-- Schema for database: rschema_0196\nCREATE TABLE `applicant` (\n  `applicant_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `phone_number` varchar(20) DEFAULT NULL,\n  `email_address` varchar(255) DEFAULT NULL,\n  `identification_number` varchar(50) NOT NULL,\n  PRIMARY KEY (`applicant_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `approver` (\n  `approver_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `phone_number` varchar(20) DEFAULT NULL,\n  `email_address` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`approver_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `loan_application` (\n  `application_number` varchar(50) NOT NULL,\n  `applicant_id` int(11) NOT NULL,\n  `requested_loan_amount` decimal(15,2) NOT NULL,\n  `loan_term` int(11) NOT NULL,\n  `approval_status` varchar(50) NOT NULL,\n  PRIMARY KEY (`application_number`),\n  KEY `loan_application_ibfk_1` (`applicant_id`),\n  CONSTRAINT `loan_application_ibfk_1` FOREIGN KEY (`applicant_id`) REFERENCES `applicant` (`applicant_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `loan_approval_form` (\n  `approval_form_id` int(11) NOT NULL,\n  `application_number` varchar(50) NOT NULL,\n  `approval_date` datetime NOT NULL,\n  `approval_result` varchar(50) NOT NULL,\n  `approver_id` int(11) NOT NULL,\n  `approval_stage` int(11) NOT NULL,\n  PRIMARY KEY (`approval_form_id`),\n  KEY `loan_approval_form_ibfk_1` (`application_number`),\n  KEY `loan_approval_form_ibfk_2` (`approver_id`),\n  CONSTRAINT `loan_approval_form_ibfk_1` FOREIGN KEY (`application_number`) REFERENCES `loan_application` (`application_number`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `loan_approval_form_ibfk_2` FOREIGN KEY (`approver_id`) REFERENCES `approver` (`approver_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
