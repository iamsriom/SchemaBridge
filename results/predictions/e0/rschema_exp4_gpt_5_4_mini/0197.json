  "question": "A company manages multiple construction projects, each with a Project ID, Project Name, Project Location, and Project Manager.\nThe Project Manager has a unique ID, as well as a Name, Phone Number, and Email.\nEach project generates multiple construction cost records, each record includes Expense Type, Cost Amount, Record Date, and Recording Staff.        \nThe Recording Staff also have their own ID, Name, Phone Number, and Email.",
  "ddl": "-- Schema for database: rschema_0197\nCREATE TABLE `project_manager` (\n  `manager_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `phone_number` varchar(20) DEFAULT NULL,\n  `email` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`manager_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `recording_staff` (\n  `staff_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `phone_number` varchar(20) DEFAULT NULL,\n  `email` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`staff_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `project` (\n  `project_id` int(11) NOT NULL,\n  `project_name` varchar(255) NOT NULL,\n  `project_location` varchar(255) DEFAULT NULL,\n  `manager_id` int(11) NOT NULL,\n  PRIMARY KEY (`project_id`),\n  KEY `manager_id` (`manager_id`),\n  CONSTRAINT `project_ibfk_1` FOREIGN KEY (`manager_id`) REFERENCES `project_manager` (`manager_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `construction_cost_record` (\n  `record_id` int(11) NOT NULL,\n  `project_id` int(11) NOT NULL,\n  `expense_type` varchar(255) NOT NULL,\n  `cost_amount` decimal(10,2) NOT NULL,\n  `record_date` datetime NOT NULL,\n  `staff_id` int(11) NOT NULL,\n  PRIMARY KEY (`record_id`),\n  KEY `project_id` (`project_id`),\n  KEY `staff_id` (`staff_id`),\n  CONSTRAINT `construction_cost_record_ibfk_1` FOREIGN KEY (`project_id`) REFERENCES `project` (`project_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `construction_cost_record_ibfk_2` FOREIGN KEY (`staff_id`) REFERENCES `recording_staff` (`staff_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
