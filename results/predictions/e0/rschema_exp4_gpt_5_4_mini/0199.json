  "question": "A retailer needs to manage its sales data, including multiple stores and the products in the stores. Each store has a store number, name, address, and manager. Each product has a product number, name, model, barcode, and price. The store needs to record daily sales, including sales time, product number, sales quantity, sales amount, and salesperson. The system also needs to conduct performance appraisals on stores, with appraisal indicators including sales and customer satisfaction.",
  "ddl": "-- Schema for database: rschema_0199\nCREATE TABLE `stores` (\n  `store_id` int(11) NOT NULL AUTO_INCREMENT,\n  `store_number` varchar(50) NOT NULL,\n  `store_name` varchar(255) NOT NULL,\n  `address` varchar(255) DEFAULT NULL,\n  `manager` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`store_id`),\n  UNIQUE KEY `store_number` (`store_number`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `products` (\n  `product_id` int(11) NOT NULL AUTO_INCREMENT,\n  `product_number` varchar(50) NOT NULL,\n  `product_name` varchar(255) NOT NULL,\n  `model` varchar(255) DEFAULT NULL,\n  `barcode` varchar(100) DEFAULT NULL,\n  `price` decimal(10,2) NOT NULL,\n  PRIMARY KEY (`product_id`),\n  UNIQUE KEY `product_number` (`product_number`),\n  UNIQUE KEY `barcode` (`barcode`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `store_products` (\n  `store_product_id` int(11) NOT NULL AUTO_INCREMENT,\n  `store_id` int(11) NOT NULL,\n  `product_id` int(11) NOT NULL,\n  PRIMARY KEY (`store_product_id`),\n  UNIQUE KEY `store_product_uk` (`store_id`,`product_id`),\n  KEY `product_id` (`product_id`),\n  CONSTRAINT `store_products_ibfk_1` FOREIGN KEY (`store_id`) REFERENCES `stores` (`store_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `store_products_ibfk_2` FOREIGN KEY (`product_id`) REFERENCES `products` (`product_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `daily_sales` (\n  `sale_id` int(11) NOT NULL AUTO_INCREMENT,\n  `store_id` int(11) NOT NULL,\n  `product_id` int(11) NOT NULL,\n  `sales_time` datetime NOT NULL,\n  `sales_quantity` int(11) NOT NULL,\n  `sales_amount` decimal(10,2) NOT NULL,\n  `salesperson` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`sale_id`),\n  KEY `store_id` (`store_id`),\n  KEY `product_id` (`product_id`),\n  CONSTRAINT `daily_sales_ibfk_1` FOREIGN KEY (`store_id`) REFERENCES `stores` (`store_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `daily_sales_ibfk_2` FOREIGN KEY (`product_id`) REFERENCES `products` (`product_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `store_appraisals` (\n  `appraisal_id` int(11) NOT NULL AUTO_INCREMENT,\n  `store_id` int(11) NOT NULL,\n  `appraisal_date` date NOT NULL,\n  `sales_score` decimal(5,2) NOT NULL,\n  `customer_satisfaction_score` decimal(5,2) NOT NULL,\n  `remarks` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`appraisal_id`),\n  KEY `store_id` (`store_id`),\n  CONSTRAINT `store_appraisals_ibfk_1` FOREIGN KEY (`store_id`) REFERENCES `stores` (`store_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
