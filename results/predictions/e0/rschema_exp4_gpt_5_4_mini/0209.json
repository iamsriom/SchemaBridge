  "database": "rschema_0209",
  "question": "The laboratory center manages multiple laboratories, and each laboratory has multiple experimental equipment. Each equipment has equipment number, name, model, purchase date, and status. The laboratory has laboratory number, name, and location. Equipment maintenance records need to record maintenance number, equipment number, maintenance date, maintenance personnel, and maintenance content.",
  "ddl": "-- Schema for database: rschema_0209\nCREATE TABLE `laboratories` (\n  `laboratory_id` int(11) NOT NULL AUTO_INCREMENT,\n  `laboratory_number` varchar(50) NOT NULL,\n  `laboratory_name` varchar(255) NOT NULL,\n  `location` varchar(255) NOT NULL,\n  PRIMARY KEY (`laboratory_id`),\n  UNIQUE KEY `laboratory_number` (`laboratory_number`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `equipment` (\n  `equipment_id` int(11) NOT NULL AUTO_INCREMENT,\n  `laboratory_id` int(11) NOT NULL,\n  `equipment_number` varchar(50) NOT NULL,\n  `equipment_name` varchar(255) NOT NULL,\n  `model` varchar(255) NOT NULL,\n  `purchase_date` date NOT NULL,\n  `status` varchar(50) NOT NULL,\n  PRIMARY KEY (`equipment_id`),\n  UNIQUE KEY `equipment_number` (`equipment_number`),\n  KEY `laboratory_id` (`laboratory_id`),\n  CONSTRAINT `equipment_ibfk_1` FOREIGN KEY (`laboratory_id`) REFERENCES `laboratories` (`laboratory_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `equipment_maintenance_records` (\n  `maintenance_id` int(11) NOT NULL AUTO_INCREMENT,\n  `equipment_id` int(11) NOT NULL,\n  `maintenance_date` date NOT NULL,\n  `maintenance_personnel` varchar(255) NOT NULL,\n  `maintenance_content` text NOT NULL,\n  PRIMARY KEY (`maintenance_id`),\n  KEY `equipment_id` (`equipment_id`),\n  CONSTRAINT `equipment_maintenance_records_ibfk_1` FOREIGN KEY (`equipment_id`) REFERENCES `equipment` (`equipment_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
