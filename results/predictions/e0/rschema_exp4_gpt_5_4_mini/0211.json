  "question": "Consulting Service System Business Requirement Description:\nThe Technical Consulting Department provides multiple technical consulting service projects, each of which involves multiple consultants. Consulting service projects have a Project ID, Name, Start Date, End Date, and Client Name. Consultants have a Consultant ID, Name, Date of Birth, Gender, Phone Number, and Professional Field. Consulting service records need to record the Service ID, Project ID, Consultant ID, Service Date, and Service Content.",
  "ddl": "-- Schema for database: rschema_0211\nCREATE TABLE `consulting_projects` (\n  `project_id` int(11) NOT NULL,\n  `project_name` varchar(255) NOT NULL,\n  `start_date` date NOT NULL,\n  `end_date` date NOT NULL,\n  `client_name` varchar(255) NOT NULL,\n  PRIMARY KEY (`project_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `consultants` (\n  `consultant_id` int(11) NOT NULL,\n  `consultant_name` varchar(255) NOT NULL,\n  `date_of_birth` date NOT NULL,\n  `gender` char(1) NOT NULL,\n  `phone_number` varchar(20) NOT NULL,\n  `professional_field` varchar(255) NOT NULL,\n  PRIMARY KEY (`consultant_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `consulting_service_records` (\n  `service_id` int(11) NOT NULL,\n  `project_id` int(11) NOT NULL,\n  `consultant_id` int(11) NOT NULL,\n  `service_date` date NOT NULL,\n  `service_content` text NOT NULL,\n  PRIMARY KEY (`service_id`),\n  KEY `consulting_service_records_ibfk_1` (`project_id`),\n  KEY `consulting_service_records_ibfk_2` (`consultant_id`),\n  CONSTRAINT `consulting_service_records_ibfk_1` FOREIGN KEY (`project_id`) REFERENCES `consulting_projects` (`project_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `consulting_service_records_ibfk_2` FOREIGN KEY (`consultant_id`) REFERENCES `consultants` (`consultant_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
