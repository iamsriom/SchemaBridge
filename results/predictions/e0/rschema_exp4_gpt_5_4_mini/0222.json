  "question": "The company plans to develop a recipe management system to record and manage recipes and related information.\nThe system shall support adding, modifying, and deleting recipes, recording recipe descriptions and images, and adding detailed preparation steps for each recipe.\nAt the same time, the system shall support defining and managing recipe types, such as main dishes and desserts, to facilitate categorization and retrieval.\nThe ingredient management function shall support adding, modifying, and deleting ingredients, recording ingredient descriptions and images, and associating required ingredients and their quantities with each recipe.\nThe system shall also provide query functionality, supporting querying recipes based on conditions such as type and ingredients, and viewing detailed recipe information, including steps and ingredients.",
  "ddl": "-- Schema for database: rschema_0222\nCREATE TABLE `recipe_types` (\n  `recipe_type_id` int(11) NOT NULL AUTO_INCREMENT,\n  `type_name` varchar(100) NOT NULL,\n  `type_description` varchar(500) DEFAULT NULL,\n  PRIMARY KEY (`recipe_type_id`),\n  UNIQUE KEY `type_name` (`type_name`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `ingredients` (\n  `ingredient_id` int(11) NOT NULL AUTO_INCREMENT,\n  `ingredient_name` varchar(100) NOT NULL,\n  `ingredient_description` varchar(1000) DEFAULT NULL,\n  `ingredient_image` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`ingredient_id`),\n  UNIQUE KEY `ingredient_name` (`ingredient_name`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `recipes` (\n  `recipe_id` int(11) NOT NULL AUTO_INCREMENT,\n  `recipe_type_id` int(11) NOT NULL,\n  `recipe_name` varchar(200) NOT NULL,\n  `recipe_description` varchar(2000) DEFAULT NULL,\n  `recipe_image` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`recipe_id`),\n  KEY `recipe_type_id` (`recipe_type_id`),\n  CONSTRAINT `recipes_ibfk_1` FOREIGN KEY (`recipe_type_id`) REFERENCES `recipe_types` (`recipe_type_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `recipe_steps` (\n  `step_id` int(11) NOT NULL AUTO_INCREMENT,\n  `recipe_id` int(11) NOT NULL,\n  `step_order` int(11) NOT NULL,\n  `step_description` varchar(2000) NOT NULL,\n  PRIMARY KEY (`step_id`),\n  KEY `recipe_id` (`recipe_id`),\n  CONSTRAINT `recipe_steps_ibfk_1` FOREIGN KEY (`recipe_id`) REFERENCES `recipes` (`recipe_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `recipe_ingredients` (\n  `recipe_ingredient_id` int(11) NOT NULL AUTO_INCREMENT,\n  `recipe_id` int(11) NOT NULL,\n  `ingredient_id` int(11) NOT NULL,\n  `quantity` decimal(10,2) NOT NULL,\n  `unit` varchar(50) DEFAULT NULL,\n  PRIMARY KEY (`recipe_ingredient_id`),\n  KEY `recipe_id` (`recipe_id`),\n  KEY `ingredient_id` (`ingredient_id`),\n  CONSTRAINT `recipe_ingredients_ibfk_1` FOREIGN KEY (`recipe_id`) REFERENCES `recipes` (`recipe_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `recipe_ingredients_ibfk_2` FOREIGN KEY (`ingredient_id`) REFERENCES `ingredients` (`ingredient_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
