  "database": "rschema_0230",
  "question": "\"The vehicle maintenance management system must manage customer information, mechanic information, vehicle models, maintenance tasks, and associated orders and parts concurrently. Each customer has basic information such as name and phone number; each vehicle model must have a unique name; each maintenance task must record the associated customer, vehicle model, task status, start date, and end date, and can specify the responsible mechanic. Since some maintenance tasks require the purchase or use of parts, the system should record the serial number, price, stock quantity, and supplier of the parts, and be able to place orders for the required parts, tracking the dispatch date and whether they have been delivered.\"",
  "ddl": "-- Schema for database: rschema_0230\nCREATE TABLE `customers` (\n  `customer_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `phone_number` varchar(50) NOT NULL,\n  PRIMARY KEY (`customer_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `mechanics` (\n  `mechanic_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `phone_number` varchar(50) DEFAULT NULL,\n  PRIMARY KEY (`mechanic_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `vehicle_models` (\n  `vehicle_model_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  PRIMARY KEY (`vehicle_model_id`),\n  UNIQUE KEY `uk_vehicle_models_name` (`name`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `maintenance_tasks` (\n  `maintenance_task_id` int(11) NOT NULL AUTO_INCREMENT,\n  `customer_id` int(11) NOT NULL,\n  `vehicle_model_id` int(11) NOT NULL,\n  `mechanic_id` int(11) DEFAULT NULL,\n  `status` varchar(50) NOT NULL,\n  `start_date` datetime NOT NULL,\n  `end_date` datetime DEFAULT NULL,\n  PRIMARY KEY (`maintenance_task_id`),\n  KEY `maintenance_tasks_ibfk_1` (`customer_id`),\n  KEY `maintenance_tasks_ibfk_2` (`vehicle_model_id`),\n  KEY `maintenance_tasks_ibfk_3` (`mechanic_id`),\n  CONSTRAINT `maintenance_tasks_ibfk_1` FOREIGN KEY (`customer_id`) REFERENCES `customers` (`customer_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `maintenance_tasks_ibfk_2` FOREIGN KEY (`vehicle_model_id`) REFERENCES `vehicle_models` (`vehicle_model_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `maintenance_tasks_ibfk_3` FOREIGN KEY (`mechanic_id`) REFERENCES `mechanics` (`mechanic_id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `parts` (\n  `part_id` int(11) NOT NULL AUTO_INCREMENT,\n  `serial_number` varchar(100) NOT NULL,\n  `price` decimal(10,2) NOT NULL,\n  `stock_quantity` int(11) NOT NULL,\n  `supplier` varchar(255) NOT NULL,\n  PRIMARY KEY (`part_id`),\n  UNIQUE KEY `uk_parts_serial_number` (`serial_number`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `part_orders` (\n  `part_order_id` int(11) NOT NULL AUTO_INCREMENT,\n  `maintenance_task_id` int(11) NOT NULL,\n  `part_id` int(11) NOT NULL,\n  `dispatch_date` datetime DEFAULT NULL,\n  `delivered` tinyint(1) NOT NULL DEFAULT '0',\n  PRIMARY KEY (`part_order_id`),\n  KEY `part_orders_ibfk_1` (`maintenance_task_id`),\n  KEY `part_orders_ibfk_2` (`part_id`),\n  CONSTRAINT `part_orders_ibfk_1` FOREIGN KEY (`maintenance_task_id`) REFERENCES `maintenance_tasks` (`maintenance_task_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `part_orders_ibfk_2` FOREIGN KEY (`part_id`) REFERENCES `parts` (`part_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
