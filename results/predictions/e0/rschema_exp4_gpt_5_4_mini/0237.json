  "database": "rschema_0237",
  "question": "This database is a house rental management system that can achieve the following main functions:\n\n1: Management of district and street information: You can add, delete, and modify district and street information to ensure that the geographical classification of house rental information is accurate.\n\n2: House type management: Define different house types, such as single room, whole rental, etc., so that users can choose the right house according to their needs.\n\n3: House information management: Record the detailed information of each house, including the street, type, description and price, etc., so that users can find and understand the details of the house.\n\n4: User management: Manage the user's registration information, including username, password and email, to ensure the information security and privacy of each user.\n\n5: Rental management: Record the user's rental behavior, including the rented house, price, description and rental date, to facilitate tracking of rental status and follow-up services.\n\n6: Query function: Support users to query house information according to conditions such as district, street, house type, etc., and view rental records.\n\n7: Rental record statistics: You can count the rental status of each area, street or house type to provide decision support for managers.",
  "ddl": "-- Schema for database: rschema_0237\nCREATE TABLE `district` (\n  `district_id` int(11) NOT NULL AUTO_INCREMENT,\n  `district_name` varchar(100) NOT NULL,\n  PRIMARY KEY (`district_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `street` (\n  `street_id` int(11) NOT NULL AUTO_INCREMENT,\n  `district_id` int(11) NOT NULL,\n  `street_name` varchar(100) NOT NULL,\n  PRIMARY KEY (`street_id`),\n  KEY `district_id` (`district_id`),\n  CONSTRAINT `street_ibfk_1` FOREIGN KEY (`district_id`) REFERENCES `district` (`district_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `house_type` (\n  `type_id` int(11) NOT NULL AUTO_INCREMENT,\n  `type_name` varchar(100) NOT NULL,\n  `type_description` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`type_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `user` (\n  `user_id` int(11) NOT NULL AUTO_INCREMENT,\n  `username` varchar(100) NOT NULL,\n  `password` varchar(255) NOT NULL,\n  `email` varchar(255) NOT NULL,\n  PRIMARY KEY (`user_id`),\n  UNIQUE KEY `username` (`username`),\n  UNIQUE KEY `email` (`email`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `house` (\n  `house_id` int(11) NOT NULL AUTO_INCREMENT,\n  `street_id` int(11) NOT NULL,\n  `type_id` int(11) NOT NULL,\n  `house_title` varchar(255) NOT NULL,\n  `house_description` text DEFAULT NULL,\n  `price` decimal(10,2) NOT NULL,\n  `address_detail` varchar(255) DEFAULT NULL,\n  `status` varchar(50) NOT NULL DEFAULT 'available',\n  PRIMARY KEY (`house_id`),\n  KEY `street_id` (`street_id`),\n  KEY `type_id` (`type_id`),\n  CONSTRAINT `house_ibfk_1` FOREIGN KEY (`street_id`) REFERENCES `street` (`street_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `house_ibfk_2` FOREIGN KEY (`type_id`) REFERENCES `house_type` (`type_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `rental_record` (\n  `rental_id` int(11) NOT NULL AUTO_INCREMENT,\n  `user_id` int(11) NOT NULL,\n  `house_id` int(11) NOT NULL,\n  `rental_price` decimal(10,2) NOT NULL,\n  `rental_description` varchar(255) DEFAULT NULL,\n  `rental_date` datetime NOT NULL,\n  PRIMARY KEY (`rental_id`),\n  KEY `user_id` (`user_id`),\n  KEY `house_id` (`house_id`),\n  CONSTRAINT `rental_record_ibfk_1` FOREIGN KEY (`user_id`) REFERENCES `user` (`user_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `rental_record_ibfk_2` FOREIGN KEY (`house_id`) REFERENCES `house` (`house_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
