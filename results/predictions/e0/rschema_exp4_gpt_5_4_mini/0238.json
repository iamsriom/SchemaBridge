  "question": "This is a Student Information Management System. The main functions of the system are as follows:\n1.Student Information Management: Manages basic student information such as student ID, name, gender, school, department, major, and ID number.\n2.Teacher Information Management: Manages teacher information, including teacher ID, name, gender, title, and contact number.\n3.Course Information Management: Manages course details, including course name, hours, credits, etc.\n4.Grade Management: Stores students’ performance data, including regular grades, experimental grades, mid-term grades, and final grades.\n5.Permission Management: Manages student and administrator permissions, including user ID, username, password, and role.\nEach teacher can teach multiple courses, and each course can be taught by multiple teachers.",
  "ddl": "-- Schema for database: rschema_0238\nCREATE TABLE `student` (\n  `student_id` varchar(20) NOT NULL,\n  `name` varchar(100) NOT NULL,\n  `gender` varchar(10) DEFAULT NULL,\n  `school` varchar(100) DEFAULT NULL,\n  `department` varchar(100) DEFAULT NULL,\n  `major` varchar(100) DEFAULT NULL,\n  `id_number` varchar(30) DEFAULT NULL,\n  PRIMARY KEY (`student_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `teacher` (\n  `teacher_id` varchar(20) NOT NULL,\n  `name` varchar(100) NOT NULL,\n  `gender` varchar(10) DEFAULT NULL,\n  `title` varchar(100) DEFAULT NULL,\n  `contact_number` varchar(20) DEFAULT NULL,\n  PRIMARY KEY (`teacher_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `course` (\n  `course_id` varchar(20) NOT NULL,\n  `course_name` varchar(255) NOT NULL,\n  `hours` int(11) DEFAULT NULL,\n  `credits` decimal(4,1) DEFAULT NULL,\n  PRIMARY KEY (`course_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `teacher_course` (\n  `teacher_id` varchar(20) NOT NULL,\n  `course_id` varchar(20) NOT NULL,\n  PRIMARY KEY (`teacher_id`,`course_id`),\n  KEY `teacher_course_ibfk_2` (`course_id`),\n  CONSTRAINT `teacher_course_ibfk_1` FOREIGN KEY (`teacher_id`) REFERENCES `teacher` (`teacher_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `teacher_course_ibfk_2` FOREIGN KEY (`course_id`) REFERENCES `course` (`course_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `grade` (\n  `grade_id` int(11) NOT NULL AUTO_INCREMENT,\n  `student_id` varchar(20) NOT NULL,\n  `course_id` varchar(20) NOT NULL,\n  `regular_grade` decimal(5,2) DEFAULT NULL,\n  `experimental_grade` decimal(5,2) DEFAULT NULL,\n  `midterm_grade` decimal(5,2) DEFAULT NULL,\n  `final_grade` decimal(5,2) DEFAULT NULL,\n  PRIMARY KEY (`grade_id`),\n  KEY `grade_ibfk_1` (`student_id`),\n  KEY `grade_ibfk_2` (`course_id`),\n  CONSTRAINT `grade_ibfk_1` FOREIGN KEY (`student_id`) REFERENCES `student` (`student_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `grade_ibfk_2` FOREIGN KEY (`course_id`) REFERENCES `course` (`course_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `user_account` (\n  `user_id` int(11) NOT NULL AUTO_INCREMENT,\n  `username` varchar(100) NOT NULL,\n  `password` varchar(255) NOT NULL,\n  `role` varchar(20) NOT NULL,\n  PRIMARY KEY (`user_id`),\n  UNIQUE KEY `uk_user_account_username` (`username`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
