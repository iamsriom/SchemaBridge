  "question": "The database is a naval fleet management system. Its main functions are to manage information about ships, crew members, fleets, mission execution, and supplies. The system helps the navy efficiently manage the daily operations of the fleet, including ship management, crew task scheduling, fleet resource allocation, and ship supply status. The database contains the following functions:\n\nShip Management: records basic information about ships.\nFields: Ship ID (Primary key), Name, Type, Fleet ID, Construction Date, Service Status\n\nCrew Member Management: records basic information about crew members.\nFields: Crew Member ID (Primary key), Name, Gender, Position, Fleet ID, Phone Number, Length of Service\n\nFleet Management: records basic information about fleets.\nFields: Fleet ID (Primary key), Name, Commander ID (Foreign key), Base\n\nFleet Mission Execution Management: records the status of missions executed by crew members and fleets.\nFields: Crew Member ID (Foreign key), Fleet ID (Foreign key), Execution Time, Remarks, Is Crew Member Primary Responsible\n\nShip Supply Management: records the supply status of ships.\nFields: Responsible Supply Crew Member ID (Foreign key), Ship ID (Foreign key), Supply Time, Supply Items, Supply Quantity",
  "ddl": "-- Schema for database: rschema_0240\nCREATE TABLE `fleet` (\n  `fleet_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `commander_id` int(11) DEFAULT NULL,\n  `base` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`fleet_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `ship` (\n  `ship_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `type` varchar(255) NOT NULL,\n  `fleet_id` int(11) DEFAULT NULL,\n  `construction_date` date DEFAULT NULL,\n  `service_status` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`ship_id`),\n  KEY `ship_ibfk_1` (`fleet_id`),\n  CONSTRAINT `ship_ibfk_1` FOREIGN KEY (`fleet_id`) REFERENCES `fleet` (`fleet_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `crew_member` (\n  `crew_member_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `gender` varchar(20) DEFAULT NULL,\n  `position` varchar(255) DEFAULT NULL,\n  `fleet_id` int(11) DEFAULT NULL,\n  `phone_number` varchar(30) DEFAULT NULL,\n  `length_of_service` int(11) DEFAULT NULL,\n  PRIMARY KEY (`crew_member_id`),\n  KEY `crew_member_ibfk_1` (`fleet_id`),\n  CONSTRAINT `crew_member_ibfk_1` FOREIGN KEY (`fleet_id`) REFERENCES `fleet` (`fleet_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `fleet_mission_execution` (\n  `crew_member_id` int(11) NOT NULL,\n  `fleet_id` int(11) NOT NULL,\n  `execution_time` datetime NOT NULL,\n  `remarks` varchar(500) DEFAULT NULL,\n  `is_crew_member_primary_responsible` tinyint(1) NOT NULL DEFAULT '0',\n  PRIMARY KEY (`crew_member_id`,`fleet_id`,`execution_time`),\n  KEY `fleet_mission_execution_ibfk_2` (`fleet_id`),\n  CONSTRAINT `fleet_mission_execution_ibfk_1` FOREIGN KEY (`crew_member_id`) REFERENCES `crew_member` (`crew_member_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `fleet_mission_execution_ibfk_2` FOREIGN KEY (`fleet_id`) REFERENCES `fleet` (`fleet_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `ship_supply` (\n  `responsible_supply_crew_member_id` int(11) NOT NULL,\n  `ship_id` int(11) NOT NULL,\n  `supply_time` datetime NOT NULL,\n  `supply_items` varchar(500) NOT NULL,\n  `supply_quantity` int(11) NOT NULL,\n  PRIMARY KEY (`responsible_supply_crew_member_id`,`ship_id`,`supply_time`),\n  KEY `ship_supply_ibfk_2` (`ship_id`),\n  CONSTRAINT `ship_supply_ibfk_1` FOREIGN KEY (`responsible_supply_crew_member_id`) REFERENCES `crew_member` (`crew_member_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `ship_supply_ibfk_2` FOREIGN KEY (`ship_id`) REFERENCES `ship` (`ship_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
