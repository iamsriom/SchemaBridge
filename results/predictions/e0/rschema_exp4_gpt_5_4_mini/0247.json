  "question": "The system includes the following functionalities:\n1.Registration and Login Functionality\nNew User Registration: Teachers and students can register new accounts. The system must verify the uniqueness of student ID or teacher ID.\nUser Login: After registration, users can log in to the system. The system must authenticate the user’s identity to prevent impersonation.\nUser Information: Each user has a unique user ID, username, password, student number (or teacher ID), role, registration time, and last login time.\n2.Sign-in Functionality\nStudent Sign-in: Students can sign in online. The system uses IP address and time constraints to prevent impersonation and multiple sign-ins. The system records the current sign-in status.\nTeacher Control Sign-in: Teachers can start and stop sign-in through control flags, view sign-in details. The control flag includes flag ID, teacher ID, sign-in start time, and end time.\n3.Statistics Functionality\nStudent Attendance Statistics: The system records each sign-in event and uses the total sign-in count to calculate the student’s regular performance.\n4.Class and Course Management\nClass Information: Each student’s class includes class name, major, and grade.\nCourse Information: Each course includes course name and description.\nRelationships: Each class has multiple students, and each course is taught by a teacher.",
  "ddl": "-- Schema for database: rschema_0247\nCREATE TABLE `users` (\n  `user_id` int(11) NOT NULL AUTO_INCREMENT,\n  `username` varchar(255) NOT NULL,\n  `password` varchar(255) NOT NULL,\n  `student_number` varchar(50) DEFAULT NULL,\n  `teacher_id` varchar(50) DEFAULT NULL,\n  `role` varchar(20) NOT NULL,\n  `registration_time` datetime NOT NULL,\n  `last_login_time` datetime DEFAULT NULL,\n  PRIMARY KEY (`user_id`),\n  UNIQUE KEY `uk_users_student_number` (`student_number`),\n  UNIQUE KEY `uk_users_teacher_id` (`teacher_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `classes` (\n  `class_id` int(11) NOT NULL AUTO_INCREMENT,\n  `class_name` varchar(255) NOT NULL,\n  `major` varchar(255) NOT NULL,\n  `grade` varchar(20) NOT NULL,\n  PRIMARY KEY (`class_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `teachers` (\n  `teacher_id` int(11) NOT NULL AUTO_INCREMENT,\n  `teacher_number` varchar(50) NOT NULL,\n  `teacher_name` varchar(255) NOT NULL,\n  PRIMARY KEY (`teacher_id`),\n  UNIQUE KEY `uk_teachers_teacher_number` (`teacher_number`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `students` (\n  `student_id` int(11) NOT NULL AUTO_INCREMENT,\n  `student_number` varchar(50) NOT NULL,\n  `student_name` varchar(255) NOT NULL,\n  `class_id` int(11) NOT NULL,\n  PRIMARY KEY (`student_id`),\n  UNIQUE KEY `uk_students_student_number` (`student_number`),\n  KEY `students_ibfk_1` (`class_id`),\n  CONSTRAINT `students_ibfk_1` FOREIGN KEY (`class_id`) REFERENCES `classes` (`class_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `courses` (\n  `course_id` int(11) NOT NULL AUTO_INCREMENT,\n  `course_name` varchar(255) NOT NULL,\n  `course_description` text DEFAULT NULL,\n  `teacher_id` int(11) NOT NULL,\n  PRIMARY KEY (`course_id`),\n  KEY `courses_ibfk_1` (`teacher_id`),\n  CONSTRAINT `courses_ibfk_1` FOREIGN KEY (`teacher_id`) REFERENCES `teachers` (`teacher_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `sign_in_controls` (\n  `flag_id` int(11) NOT NULL AUTO_INCREMENT,\n  `teacher_id` int(11) NOT NULL,\n  `sign_in_start_time` datetime NOT NULL,\n  `sign_in_end_time` datetime DEFAULT NULL,\n  `control_flag` varchar(20) NOT NULL,\n  PRIMARY KEY (`flag_id`),\n  KEY `sign_in_controls_ibfk_1` (`teacher_id`),\n  CONSTRAINT `sign_in_controls_ibfk_1` FOREIGN KEY (`teacher_id`) REFERENCES `teachers` (`teacher_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `sign_in_records` (\n  `record_id` int(11) NOT NULL AUTO_INCREMENT,\n  `student_id` int(11) NOT NULL,\n  `flag_id` int(11) NOT NULL,\n  `sign_in_time` datetime NOT NULL,\n  `ip_address` varchar(45) NOT NULL,\n  `sign_in_status` varchar(20) NOT NULL,\n  PRIMARY KEY (`record_id`),\n  KEY `sign_in_records_ibfk_1` (`student_id`),\n  KEY `sign_in_records_ibfk_2` (`flag_id`),\n  CONSTRAINT `sign_in_records_ibfk_1` FOREIGN KEY (`student_id`) REFERENCES `students` (`student_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `sign_in_records_ibfk_2` FOREIGN KEY (`flag_id`) REFERENCES `sign_in_controls` (`flag_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
