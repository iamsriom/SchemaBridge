  "database": "rschema_0251",
  "question": "This is a pet grooming salon management system. The shop needs to manage pet groomers, customers, and their pets' information. Groomer information includes name, specialization, years of experience, and rating. Pets need to have basic information recorded including breed, age, weight, and fur characteristics. Each grooming service needs to record the service items, service duration, pricing, and customer ratings for the groomer's service.",
  "ddl": "-- Schema for database: rschema_0251\nCREATE TABLE `groomers` (\n  `groomer_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `specialization` varchar(255) DEFAULT NULL,\n  `years_of_experience` int(11) DEFAULT NULL,\n  `rating` decimal(3,2) DEFAULT NULL,\n  PRIMARY KEY (`groomer_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `customers` (\n  `customer_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `phone` varchar(50) DEFAULT NULL,\n  `email` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`customer_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `pets` (\n  `pet_id` int(11) NOT NULL AUTO_INCREMENT,\n  `customer_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `breed` varchar(255) DEFAULT NULL,\n  `age` int(11) DEFAULT NULL,\n  `weight` decimal(10,2) DEFAULT NULL,\n  `fur_characteristics` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`pet_id`),\n  KEY `customer_id` (`customer_id`),\n  CONSTRAINT `pets_ibfk_1` FOREIGN KEY (`customer_id`) REFERENCES `customers` (`customer_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `grooming_services` (\n  `service_id` int(11) NOT NULL AUTO_INCREMENT,\n  `pet_id` int(11) NOT NULL,\n  `groomer_id` int(11) NOT NULL,\n  `service_items` varchar(255) NOT NULL,\n  `service_duration` int(11) NOT NULL,\n  `pricing` decimal(10,2) NOT NULL,\n  `customer_rating` decimal(3,2) DEFAULT NULL,\n  PRIMARY KEY (`service_id`),\n  KEY `pet_id` (`pet_id`),\n  KEY `groomer_id` (`groomer_id`),\n  CONSTRAINT `grooming_services_ibfk_1` FOREIGN KEY (`pet_id`) REFERENCES `pets` (`pet_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `grooming_services_ibfk_2` FOREIGN KEY (`groomer_id`) REFERENCES `groomers` (`groomer_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
