  "question": "The course registration system of a university is designed as follows:\nA student has information such as Student ID, Name, Date of Birth, Phone Number, Home Address, and Registration Eligibility.\nThe university offers multiple courses, each with a Course ID, Course Name, Credits, Instructor, Class Time, and Location.\nWhen a student registers for a course, the system first verifies the legality of the provided information and checks the student's degree examination results to confirm registration eligibility.\nThe degree examination result information includes Result ID, Student ID, Examination Name, Grade, and Examination Date.\nIf a student is eligible for registration, the student can select courses and proceed with registration. The registration information includes Student ID, Course ID, Registration Time, and Status.\nThe system stores the registration information in the database and associates the enrolled students with the corresponding courses.\nAfter registration is completed, the system sends a notification of successful registration to the student and sends the registered courses and student information to the academic staff for subsequent management.",
  "ddl": "-- Schema for database: rschema_0260\nCREATE TABLE `student` (\n  `student_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `date_of_birth` date DEFAULT NULL,\n  `phone_number` varchar(20) DEFAULT NULL,\n  `home_address` varchar(255) DEFAULT NULL,\n  `registration_eligibility` varchar(20) NOT NULL,\n  PRIMARY KEY (`student_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `course` (\n  `course_id` int(11) NOT NULL,\n  `course_name` varchar(255) NOT NULL,\n  `credits` int(11) NOT NULL,\n  `instructor` varchar(255) DEFAULT NULL,\n  `class_time` varchar(100) DEFAULT NULL,\n  `location` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`course_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `degree_examination_result` (\n  `result_id` int(11) NOT NULL,\n  `student_id` int(11) NOT NULL,\n  `examination_name` varchar(255) NOT NULL,\n  `grade` varchar(20) NOT NULL,\n  `examination_date` date DEFAULT NULL,\n  PRIMARY KEY (`result_id`),\n  KEY `degree_examination_result_ibfk_1` (`student_id`),\n  CONSTRAINT `degree_examination_result_ibfk_1` FOREIGN KEY (`student_id`) REFERENCES `student` (`student_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `registration` (\n  `student_id` int(11) NOT NULL,\n  `course_id` int(11) NOT NULL,\n  `registration_time` datetime NOT NULL,\n  `status` varchar(20) NOT NULL,\n  PRIMARY KEY (`student_id`,`course_id`),\n  KEY `registration_ibfk_2` (`course_id`),\n  CONSTRAINT `registration_ibfk_1` FOREIGN KEY (`student_id`) REFERENCES `student` (`student_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `registration_ibfk_2` FOREIGN KEY (`course_id`) REFERENCES `course` (`course_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
