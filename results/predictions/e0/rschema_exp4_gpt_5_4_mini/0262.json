  "question": "The supermarket management system is designed as follows:\nThe company owns multiple supermarkets, each with manager, address, and telephone information.\nEach supermarket has multiple departments, with name, manager, and contact telephone for each department.\nEach department employs multiple employees, with employee number, name, contact information, position, and salary for each employee.\nThe supermarket sells multiple products, with product number, name, model, unit price, and inventory quantity for each product.\nThe system needs to record the process of allocating products to salespersons, including allocation time, allocation quantity, and salesperson information such as salesperson number, name, contact information, etc.\nThrough this data, the system can manage the supermarket's operations, including employee management, product inventory, and allocation, to optimize business processes and improve efficiency.",
  "ddl": "-- Schema for database: rschema_0262\nCREATE TABLE `supermarket` (\n  `supermarket_id` int(11) NOT NULL AUTO_INCREMENT,\n  `supermarket_name` varchar(255) NOT NULL,\n  `manager_name` varchar(255) DEFAULT NULL,\n  `address` varchar(255) DEFAULT NULL,\n  `telephone` varchar(50) DEFAULT NULL,\n  PRIMARY KEY (`supermarket_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `department` (\n  `department_id` int(11) NOT NULL AUTO_INCREMENT,\n  `supermarket_id` int(11) NOT NULL,\n  `department_name` varchar(255) NOT NULL,\n  `manager_name` varchar(255) DEFAULT NULL,\n  `contact_telephone` varchar(50) DEFAULT NULL,\n  PRIMARY KEY (`department_id`),\n  KEY `department_ibfk_1` (`supermarket_id`),\n  CONSTRAINT `department_ibfk_1` FOREIGN KEY (`supermarket_id`) REFERENCES `supermarket` (`supermarket_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `employee` (\n  `employee_id` int(11) NOT NULL AUTO_INCREMENT,\n  `department_id` int(11) NOT NULL,\n  `employee_number` varchar(50) NOT NULL,\n  `employee_name` varchar(255) NOT NULL,\n  `contact_information` varchar(255) DEFAULT NULL,\n  `position` varchar(100) DEFAULT NULL,\n  `salary` decimal(10,2) DEFAULT NULL,\n  PRIMARY KEY (`employee_id`),\n  UNIQUE KEY `employee_number` (`employee_number`),\n  KEY `employee_ibfk_1` (`department_id`),\n  CONSTRAINT `employee_ibfk_1` FOREIGN KEY (`department_id`) REFERENCES `department` (`department_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `product` (\n  `product_id` int(11) NOT NULL AUTO_INCREMENT,\n  `product_number` varchar(50) NOT NULL,\n  `product_name` varchar(255) NOT NULL,\n  `model` varchar(255) DEFAULT NULL,\n  `unit_price` decimal(10,2) NOT NULL,\n  `inventory_quantity` int(11) NOT NULL DEFAULT 0,\n  PRIMARY KEY (`product_id`),\n  UNIQUE KEY `product_number` (`product_number`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `salesperson` (\n  `salesperson_id` int(11) NOT NULL AUTO_INCREMENT,\n  `salesperson_number` varchar(50) NOT NULL,\n  `salesperson_name` varchar(255) NOT NULL,\n  `contact_information` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`salesperson_id`),\n  UNIQUE KEY `salesperson_number` (`salesperson_number`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `product_allocation` (\n  `allocation_id` int(11) NOT NULL AUTO_INCREMENT,\n  `product_id` int(11) NOT NULL,\n  `salesperson_id` int(11) NOT NULL,\n  `allocation_time` datetime NOT NULL,\n  `allocation_quantity` int(11) NOT NULL,\n  PRIMARY KEY (`allocation_id`),\n  KEY `product_allocation_ibfk_1` (`product_id`),\n  KEY `product_allocation_ibfk_2` (`salesperson_id`),\n  CONSTRAINT `product_allocation_ibfk_1` FOREIGN KEY (`product_id`) REFERENCES `product` (`product_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `product_allocation_ibfk_2` FOREIGN KEY (`salesperson_id`) REFERENCES `salesperson` (`salesperson_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
