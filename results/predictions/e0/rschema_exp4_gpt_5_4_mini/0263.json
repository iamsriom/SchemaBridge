  "question": "Required function description: 1. Submitting homework: After verifying the student ID, the student submits the electronic homework online. The system stores the homework and sends a successful submission notification to the student, and notifies the lecturer that there is a homework submission.\n2. Downloading ungraded homework: After verifying the lecturer ID, the lecturer downloads the homework submitted by the student from the system, and the homework is displayed on the screen.\n3. Grading homework: The lecturer grades and scores each question according to the format and makes an overall evaluation.\n4. Uploading graded homework: The lecturer returns the graded homework (including scores and evaluations) to the system, and the system stores the graded homework.\n5. Recording scores and evaluations: The system records the scores and evaluations of the graded homework in the student information and notifies the student that the homework has been graded.\n6. Obtaining graded homework: According to the student ID, the student can view the graded homework, including the submitted homework, scores and evaluations.\n7. Random inspection of homework: The teaching staff selects the graded homework samples according to the teaching staff ID, gives random inspection opinions, and forms a random inspection report for the lecturer.",
  "ddl": "-- Schema for database: rschema_0263\nCREATE TABLE `students` (\n  `student_id` int(11) NOT NULL,\n  `student_name` varchar(255) DEFAULT NULL,\n  `email` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`student_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `lecturers` (\n  `lecturer_id` int(11) NOT NULL,\n  `lecturer_name` varchar(255) DEFAULT NULL,\n  `email` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`lecturer_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `teaching_staff` (\n  `staff_id` int(11) NOT NULL,\n  `staff_name` varchar(255) DEFAULT NULL,\n  `email` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`staff_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `homework_submissions` (\n  `submission_id` int(11) NOT NULL AUTO_INCREMENT,\n  `student_id` int(11) NOT NULL,\n  `lecturer_id` int(11) NOT NULL,\n  `submitted_at` datetime NOT NULL,\n  `homework_file` varchar(255) NOT NULL,\n  `submission_status` varchar(50) NOT NULL,\n  `student_notification_sent` tinyint(1) NOT NULL DEFAULT '0',\n  `lecturer_notification_sent` tinyint(1) NOT NULL DEFAULT '0',\n  PRIMARY KEY (`submission_id`),\n  KEY `homework_submissions_ibfk_1` (`student_id`),\n  KEY `homework_submissions_ibfk_2` (`lecturer_id`),\n  CONSTRAINT `homework_submissions_ibfk_1` FOREIGN KEY (`student_id`) REFERENCES `students` (`student_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `homework_submissions_ibfk_2` FOREIGN KEY (`lecturer_id`) REFERENCES `lecturers` (`lecturer_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `graded_homeworks` (\n  `graded_homework_id` int(11) NOT NULL AUTO_INCREMENT,\n  `submission_id` int(11) NOT NULL,\n  `lecturer_id` int(11) NOT NULL,\n  `graded_at` datetime NOT NULL,\n  `graded_homework_file` varchar(255) NOT NULL,\n  `overall_evaluation` text DEFAULT NULL,\n  `student_recorded` tinyint(1) NOT NULL DEFAULT '0',\n  `student_notified` tinyint(1) NOT NULL DEFAULT '0',\n  PRIMARY KEY (`graded_homework_id`),\n  KEY `graded_homeworks_ibfk_1` (`submission_id`),\n  KEY `graded_homeworks_ibfk_2` (`lecturer_id`),\n  CONSTRAINT `graded_homeworks_ibfk_1` FOREIGN KEY (`submission_id`) REFERENCES `homework_submissions` (`submission_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `graded_homeworks_ibfk_2` FOREIGN KEY (`lecturer_id`) REFERENCES `lecturers` (`lecturer_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `homework_scores` (\n  `score_id` int(11) NOT NULL AUTO_INCREMENT,\n  `graded_homework_id` int(11) NOT NULL,\n  `question_no` int(11) NOT NULL,\n  `score` decimal(5,2) NOT NULL,\n  `evaluation` text DEFAULT NULL,\n  PRIMARY KEY (`score_id`),\n  KEY `homework_scores_ibfk_1` (`graded_homework_id`),\n  CONSTRAINT `homework_scores_ibfk_1` FOREIGN KEY (`graded_homework_id`) REFERENCES `graded_homeworks` (`graded_homework_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `random_inspections` (\n  `inspection_id` int(11) NOT NULL AUTO_INCREMENT,\n  `staff_id` int(11) NOT NULL,\n  `graded_homework_id` int(11) NOT NULL,\n  `inspected_at` datetime NOT NULL,\n  `inspection_opinion` text NOT NULL,\n  `report_to_lecturer` text DEFAULT NULL,\n  PRIMARY KEY (`inspection_id`),\n  KEY `random_inspections_ibfk_1` (`staff_id`),\n  KEY `random_inspections_ibfk_2` (`graded_homework_id`),\n  CONSTRAINT `random_inspections_ibfk_1` FOREIGN KEY (`staff_id`) REFERENCES `teaching_staff` (`staff_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `random_inspections_ibfk_2` FOREIGN KEY (`graded_homework_id`) REFERENCES `graded_homeworks` (`graded_homework_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
