  "question": "The company produces chess pieces for various chess games. Each chessboard represents a production line or batch for a specific chess game, with a chessboard ID and chessboard name. Each chessboard contains multiple chess pieces, each with color and position information.\nThe company performs quality inspection on each chess piece, recording the inspection time and result. If the inspection fails, the defect type is recorded and a quality alert is generated.\nAdditionally, the company uses quality inspection models to predict and evaluate the quality status during the production process, recording the model running time and results.",
  "ddl": "-- Schema for database: rschema_0265\nCREATE TABLE `chessboard` (\n  `chessboard_id` int(11) NOT NULL AUTO_INCREMENT,\n  `chessboard_name` varchar(255) NOT NULL,\n  PRIMARY KEY (`chessboard_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `chess_piece` (\n  `piece_id` int(11) NOT NULL AUTO_INCREMENT,\n  `chessboard_id` int(11) NOT NULL,\n  `piece_color` varchar(50) NOT NULL,\n  `piece_position` varchar(50) NOT NULL,\n  PRIMARY KEY (`piece_id`),\n  KEY `chess_piece_ibfk_1` (`chessboard_id`),\n  CONSTRAINT `chess_piece_ibfk_1` FOREIGN KEY (`chessboard_id`) REFERENCES `chessboard` (`chessboard_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `quality_inspection` (\n  `inspection_id` int(11) NOT NULL AUTO_INCREMENT,\n  `piece_id` int(11) NOT NULL,\n  `inspection_time` datetime NOT NULL,\n  `inspection_result` varchar(50) NOT NULL,\n  `defect_type` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`inspection_id`),\n  KEY `quality_inspection_ibfk_1` (`piece_id`),\n  CONSTRAINT `quality_inspection_ibfk_1` FOREIGN KEY (`piece_id`) REFERENCES `chess_piece` (`piece_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `quality_alert` (\n  `alert_id` int(11) NOT NULL AUTO_INCREMENT,\n  `inspection_id` int(11) NOT NULL,\n  `alert_time` datetime NOT NULL,\n  `alert_message` varchar(255) NOT NULL,\n  PRIMARY KEY (`alert_id`),\n  KEY `quality_alert_ibfk_1` (`inspection_id`),\n  CONSTRAINT `quality_alert_ibfk_1` FOREIGN KEY (`inspection_id`) REFERENCES `quality_inspection` (`inspection_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `quality_inspection_model` (\n  `model_id` int(11) NOT NULL AUTO_INCREMENT,\n  `model_name` varchar(255) NOT NULL,\n  `run_time` datetime NOT NULL,\n  `model_result` varchar(50) NOT NULL,\n  PRIMARY KEY (`model_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
