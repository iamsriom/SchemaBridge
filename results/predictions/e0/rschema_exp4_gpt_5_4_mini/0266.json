  "question": "The pipeline company manages multiple pipelines, each identified by a pipeline ID, starting point, ending point, length, and diameter. The company employs multiple maintenance personnel, and each maintenance task must record the pipeline ID, maintenance personnel, maintenance details, and maintenance time. The system shall support real-time monitoring of pipeline maintenance tasks and performance evaluation.",
  "ddl": "-- Schema for database: rschema_0266\nCREATE TABLE `pipeline` (\n  `pipeline_id` int(11) NOT NULL,\n  `starting_point` varchar(255) NOT NULL,\n  `ending_point` varchar(255) NOT NULL,\n  `length` decimal(10,2) NOT NULL,\n  `diameter` decimal(10,2) NOT NULL,\n  PRIMARY KEY (`pipeline_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `maintenance_personnel` (\n  `personnel_id` int(11) NOT NULL,\n  `personnel_name` varchar(255) NOT NULL,\n  `phone` varchar(50) DEFAULT NULL,\n  `position_title` varchar(100) DEFAULT NULL,\n  PRIMARY KEY (`personnel_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `maintenance_task` (\n  `task_id` int(11) NOT NULL,\n  `pipeline_id` int(11) NOT NULL,\n  `personnel_id` int(11) NOT NULL,\n  `maintenance_details` text NOT NULL,\n  `maintenance_time` datetime NOT NULL,\n  `task_status` varchar(50) DEFAULT NULL,\n  PRIMARY KEY (`task_id`),\n  KEY `pipeline_id` (`pipeline_id`),\n  KEY `personnel_id` (`personnel_id`),\n  CONSTRAINT `maintenance_task_ibfk_1` FOREIGN KEY (`pipeline_id`) REFERENCES `pipeline` (`pipeline_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `maintenance_task_ibfk_2` FOREIGN KEY (`personnel_id`) REFERENCES `maintenance_personnel` (`personnel_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `maintenance_monitoring` (\n  `monitoring_id` int(11) NOT NULL,\n  `task_id` int(11) NOT NULL,\n  `monitoring_time` datetime NOT NULL,\n  `monitoring_status` varchar(50) NOT NULL,\n  `performance_score` decimal(5,2) DEFAULT NULL,\n  `remarks` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`monitoring_id`),\n  KEY `task_id` (`task_id`),\n  CONSTRAINT `maintenance_monitoring_ibfk_1` FOREIGN KEY (`task_id`) REFERENCES `maintenance_task` (`task_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
