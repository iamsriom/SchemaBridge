  "question": "The hotel has multiple restaurants, each with a name, location, and operating hours. The restaurants offer various dishes, each with a name, price, and category. Customers can make table reservations at the restaurants. Each reservation records the customer information, restaurant information, reservation time, and number of diners.",
  "ddl": "-- Schema for database: rschema_0268\nCREATE TABLE `restaurants` (\n  `restaurant_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `location` varchar(255) NOT NULL,\n  `operating_hours` varchar(255) NOT NULL,\n  PRIMARY KEY (`restaurant_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `dishes` (\n  `dish_id` int(11) NOT NULL AUTO_INCREMENT,\n  `restaurant_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `price` decimal(10,2) NOT NULL,\n  `category` varchar(255) NOT NULL,\n  PRIMARY KEY (`dish_id`),\n  KEY `dishes_ibfk_1` (`restaurant_id`),\n  CONSTRAINT `dishes_ibfk_1` FOREIGN KEY (`restaurant_id`) REFERENCES `restaurants` (`restaurant_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `customers` (\n  `customer_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `phone` varchar(50) DEFAULT NULL,\n  `email` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`customer_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `reservations` (\n  `reservation_id` int(11) NOT NULL AUTO_INCREMENT,\n  `customer_id` int(11) NOT NULL,\n  `restaurant_id` int(11) NOT NULL,\n  `reservation_time` datetime NOT NULL,\n  `number_of_diners` int(11) NOT NULL,\n  PRIMARY KEY (`reservation_id`),\n  KEY `reservations_ibfk_1` (`customer_id`),\n  KEY `reservations_ibfk_2` (`restaurant_id`),\n  CONSTRAINT `reservations_ibfk_1` FOREIGN KEY (`customer_id`) REFERENCES `customers` (`customer_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `reservations_ibfk_2` FOREIGN KEY (`restaurant_id`) REFERENCES `restaurants` (`restaurant_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
