  "database": "rschema_0270",
  "question": "Broadcast Television Company produces and broadcasts a variety of programs, encompassing news, entertainment, sports, and other content types. Each program has a unique program ID, name, type, broadcast time, and duration. To ensure the quality of the programs, the company employs multiple production staff responsible for planning, producing, and post-producing each program. Each production staff member may participate in the production of multiple programs, and multiple production staff members may be involved in the production process of each program.\n\nEach time a program production is completed, in addition to recording the participating production staff, it is also necessary to record the production time, reviewers, and review results of the program. Reviewers are responsible for examining the content of the programs to ensure compliance and quality. The system must also support querying information about the programs and their production staff, as well as the review status of each program.",
  "ddl": "-- Schema for database: rschema_0270\nCREATE TABLE `program` (\n  `program_id` int(11) NOT NULL,\n  `program_name` varchar(255) NOT NULL,\n  `program_type` varchar(100) NOT NULL,\n  `broadcast_time` datetime NOT NULL,\n  `duration_minutes` int(11) NOT NULL,\n  PRIMARY KEY (`program_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `production_staff` (\n  `staff_id` int(11) NOT NULL,\n  `staff_name` varchar(255) NOT NULL,\n  `staff_role` varchar(100) NOT NULL,\n  PRIMARY KEY (`staff_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `reviewer` (\n  `reviewer_id` int(11) NOT NULL,\n  `reviewer_name` varchar(255) NOT NULL,\n  PRIMARY KEY (`reviewer_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `program_production` (\n  `production_id` int(11) NOT NULL,\n  `program_id` int(11) NOT NULL,\n  `production_time` datetime NOT NULL,\n  `review_result` varchar(100) DEFAULT NULL,\n  PRIMARY KEY (`production_id`),\n  KEY `program_id` (`program_id`),\n  CONSTRAINT `program_production_ibfk_1` FOREIGN KEY (`program_id`) REFERENCES `program` (`program_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `program_production_staff` (\n  `production_id` int(11) NOT NULL,\n  `staff_id` int(11) NOT NULL,\n  PRIMARY KEY (`production_id`,`staff_id`),\n  KEY `staff_id` (`staff_id`),\n  CONSTRAINT `program_production_staff_ibfk_1` FOREIGN KEY (`production_id`) REFERENCES `program_production` (`production_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `program_production_staff_ibfk_2` FOREIGN KEY (`staff_id`) REFERENCES `production_staff` (`staff_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `program_review` (\n  `review_id` int(11) NOT NULL,\n  `production_id` int(11) NOT NULL,\n  `reviewer_id` int(11) NOT NULL,\n  `review_time` datetime NOT NULL,\n  `review_result` varchar(100) NOT NULL,\n  PRIMARY KEY (`review_id`),\n  KEY `production_id` (`production_id`),\n  KEY `reviewer_id` (`reviewer_id`),\n  CONSTRAINT `program_review_ibfk_1` FOREIGN KEY (`production_id`) REFERENCES `program_production` (`production_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `program_review_ibfk_2` FOREIGN KEY (`reviewer_id`) REFERENCES `reviewer` (`reviewer_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
