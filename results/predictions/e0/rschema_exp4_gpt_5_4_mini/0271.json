  "question": "The satellite transmission service company offers multiple satellite transmission services, each characterized by a service ID, name, transmission type, transmission rate, and price. The company has multiple clients, and each client can subscribe to multiple services. For every service subscription, the subscription time, end time, and operator must be recorded.",
  "ddl": "-- Schema for database: rschema_0271\nCREATE TABLE `services` (\n  `service_id` int(11) NOT NULL,\n  `service_name` varchar(255) NOT NULL,\n  `transmission_type` varchar(100) NOT NULL,\n  `transmission_rate` varchar(100) NOT NULL,\n  `price` decimal(10,2) NOT NULL,\n  PRIMARY KEY (`service_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `clients` (\n  `client_id` int(11) NOT NULL,\n  `client_name` varchar(255) NOT NULL,\n  PRIMARY KEY (`client_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `service_subscriptions` (\n  `subscription_id` int(11) NOT NULL,\n  `client_id` int(11) NOT NULL,\n  `service_id` int(11) NOT NULL,\n  `subscription_time` datetime NOT NULL,\n  `end_time` datetime DEFAULT NULL,\n  `operator` varchar(255) NOT NULL,\n  PRIMARY KEY (`subscription_id`),\n  KEY `service_subscriptions_ibfk_1` (`client_id`),\n  KEY `service_subscriptions_ibfk_2` (`service_id`),\n  CONSTRAINT `service_subscriptions_ibfk_1` FOREIGN KEY (`client_id`) REFERENCES `clients` (`client_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `service_subscriptions_ibfk_2` FOREIGN KEY (`service_id`) REFERENCES `services` (`service_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
