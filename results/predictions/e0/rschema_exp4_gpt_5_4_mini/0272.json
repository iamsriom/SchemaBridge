  "question": "The business requirements description of the animal husbandry management information system are as follows:  \n\nMultiple ranches need to be managed, each with a ranch ID, name, and address, and each ranch can manage multiple types of livestock.  \nEach type of livestock has a name, species, livestock ID, and ranch ID.  \n\nThe ranch needs to record the health status of the livestock (including recording time, health status, health status ID, and livestock ID),  \nvaccination status (including vaccination measures, vaccination time, vaccination status ID, and livestock ID),  \nfeed consumption (including consumption time, feed type, consumption amount, feed consumption ID, and livestock ID),  \nand entry/exit records (including time, entry/exit type, entry/exit record ID, and livestock ID).",
  "ddl": "-- Schema for database: rschema_0272\nCREATE TABLE `ranch` (\n  `ranch_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `address` varchar(255) NOT NULL,\n  PRIMARY KEY (`ranch_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `livestock` (\n  `livestock_id` int(11) NOT NULL AUTO_INCREMENT,\n  `ranch_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `species` varchar(255) NOT NULL,\n  PRIMARY KEY (`livestock_id`),\n  KEY `livestock_ibfk_1` (`ranch_id`),\n  CONSTRAINT `livestock_ibfk_1` FOREIGN KEY (`ranch_id`) REFERENCES `ranch` (`ranch_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `health_status` (\n  `health_status_id` int(11) NOT NULL AUTO_INCREMENT,\n  `livestock_id` int(11) NOT NULL,\n  `record_time` datetime NOT NULL,\n  `health_status` varchar(255) NOT NULL,\n  PRIMARY KEY (`health_status_id`),\n  KEY `health_status_ibfk_1` (`livestock_id`),\n  CONSTRAINT `health_status_ibfk_1` FOREIGN KEY (`livestock_id`) REFERENCES `livestock` (`livestock_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `vaccination_status` (\n  `vaccination_status_id` int(11) NOT NULL AUTO_INCREMENT,\n  `livestock_id` int(11) NOT NULL,\n  `vaccination_time` datetime NOT NULL,\n  `vaccination_measures` varchar(255) NOT NULL,\n  `vaccination_status` varchar(255) NOT NULL,\n  PRIMARY KEY (`vaccination_status_id`),\n  KEY `vaccination_status_ibfk_1` (`livestock_id`),\n  CONSTRAINT `vaccination_status_ibfk_1` FOREIGN KEY (`livestock_id`) REFERENCES `livestock` (`livestock_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `feed_consumption` (\n  `feed_consumption_id` int(11) NOT NULL AUTO_INCREMENT,\n  `livestock_id` int(11) NOT NULL,\n  `consumption_time` datetime NOT NULL,\n  `feed_type` varchar(255) NOT NULL,\n  `consumption_amount` decimal(10,2) NOT NULL,\n  PRIMARY KEY (`feed_consumption_id`),\n  KEY `feed_consumption_ibfk_1` (`livestock_id`),\n  CONSTRAINT `feed_consumption_ibfk_1` FOREIGN KEY (`livestock_id`) REFERENCES `livestock` (`livestock_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `entry_exit_record` (\n  `entry_exit_record_id` int(11) NOT NULL AUTO_INCREMENT,\n  `livestock_id` int(11) NOT NULL,\n  `record_time` datetime NOT NULL,\n  `entry_exit_type` varchar(255) NOT NULL,\n  PRIMARY KEY (`entry_exit_record_id`),\n  KEY `entry_exit_record_ibfk_1` (`livestock_id`),\n  CONSTRAINT `entry_exit_record_ibfk_1` FOREIGN KEY (`livestock_id`) REFERENCES `livestock` (`livestock_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
