  "question": "The maintenance task management system shall be utilized for managing maintenance technicians, maintenance teams, customer information, and records related to maintenance tasks. The system shall support the assignment and management of maintenance tasks, record customer information during the maintenance process, including maintenance costs, duration, results, and collect customer feedback and satisfaction levels. The system may store the following information:  \nMaintenance Technician Table: Stores personal information of maintenance technicians, including technician name, gender, phone number, position, employment date, and team ID.  \n\nManagement Maintenance Team: Stores relevant information of maintenance teams, including team name, team leader ID, team responsibilities, and total number of members.  \n\nManagement Customer: Stores personal information of customers, including customer name, phone number, and address.  \n\nManagement Maintenance Task: Records detailed information for each maintenance task, including maintenance time, maintenance duration, costs, results, customer feedback, and model and name of the maintenance product. Each maintenance task also records customer satisfaction levels and feedback resolution results.",
  "ddl": "-- Schema for database: rschema_0276\nCREATE TABLE `maintenance_team` (\n  `team_id` int(11) NOT NULL AUTO_INCREMENT,\n  `team_name` varchar(255) NOT NULL,\n  `team_leader_id` int(11) DEFAULT NULL,\n  `team_responsibilities` varchar(255) DEFAULT NULL,\n  `total_members` int(11) DEFAULT NULL,\n  PRIMARY KEY (`team_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `maintenance_technician` (\n  `technician_id` int(11) NOT NULL AUTO_INCREMENT,\n  `technician_name` varchar(255) NOT NULL,\n  `gender` varchar(20) DEFAULT NULL,\n  `phone_number` varchar(20) DEFAULT NULL,\n  `position` varchar(100) DEFAULT NULL,\n  `employment_date` date DEFAULT NULL,\n  `team_id` int(11) DEFAULT NULL,\n  PRIMARY KEY (`technician_id`),\n  KEY `maintenance_technician_ibfk_1` (`team_id`),\n  CONSTRAINT `maintenance_technician_ibfk_1` FOREIGN KEY (`team_id`) REFERENCES `maintenance_team` (`team_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `customer` (\n  `customer_id` int(11) NOT NULL AUTO_INCREMENT,\n  `customer_name` varchar(255) NOT NULL,\n  `phone_number` varchar(20) DEFAULT NULL,\n  `address` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`customer_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `maintenance_task` (\n  `task_id` int(11) NOT NULL AUTO_INCREMENT,\n  `customer_id` int(11) NOT NULL,\n  `technician_id` int(11) DEFAULT NULL,\n  `maintenance_time` datetime NOT NULL,\n  `maintenance_duration` int(11) DEFAULT NULL,\n  `maintenance_cost` decimal(10,2) DEFAULT NULL,\n  `maintenance_result` varchar(255) DEFAULT NULL,\n  `customer_feedback` varchar(255) DEFAULT NULL,\n  `product_model` varchar(255) DEFAULT NULL,\n  `product_name` varchar(255) DEFAULT NULL,\n  `customer_satisfaction_level` varchar(50) DEFAULT NULL,\n  `feedback_resolution_result` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`task_id`),\n  KEY `maintenance_task_ibfk_1` (`customer_id`),\n  KEY `maintenance_task_ibfk_2` (`technician_id`),\n  CONSTRAINT `maintenance_task_ibfk_1` FOREIGN KEY (`customer_id`) REFERENCES `customer` (`customer_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `maintenance_task_ibfk_2` FOREIGN KEY (`technician_id`) REFERENCES `maintenance_technician` (`technician_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
