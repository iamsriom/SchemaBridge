  "question": "The movie production company needs to manage multiple movie projects, and each project has multiple directors, actors, and producers. The system needs to record each project's name, type, budget, filming time, and relevant personnel information, including name, email, and phone number.",
  "ddl": "-- Schema for database: rschema_0280\nCREATE TABLE `projects` (\n  `project_id` int(11) NOT NULL AUTO_INCREMENT,\n  `project_name` varchar(255) NOT NULL,\n  `project_type` varchar(100) NOT NULL,\n  `budget` decimal(12,2) DEFAULT NULL,\n  `filming_time` varchar(100) DEFAULT NULL,\n  PRIMARY KEY (`project_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `personnel` (\n  `personnel_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `email` varchar(255) DEFAULT NULL,\n  `phone_number` varchar(50) DEFAULT NULL,\n  PRIMARY KEY (`personnel_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `project_personnel` (\n  `project_personnel_id` int(11) NOT NULL AUTO_INCREMENT,\n  `project_id` int(11) NOT NULL,\n  `personnel_id` int(11) NOT NULL,\n  `role_type` varchar(50) NOT NULL,\n  PRIMARY KEY (`project_personnel_id`),\n  KEY `project_personnel_ibfk_1` (`project_id`),\n  KEY `project_personnel_ibfk_2` (`personnel_id`),\n  CONSTRAINT `project_personnel_ibfk_1` FOREIGN KEY (`project_id`) REFERENCES `projects` (`project_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `project_personnel_ibfk_2` FOREIGN KEY (`personnel_id`) REFERENCES `personnel` (`personnel_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
