  "question": "The Cultural Arts Company needs to manage multiple exhibitions. Each exhibition has multiple curators and exhibits. The system needs to record the name, location, start time, and end time of each exhibition, as well as the information of curators and exhibits.",
  "ddl": "-- Schema for database: rschema_0281\nCREATE TABLE `exhibitions` (\n  `exhibition_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `location` varchar(255) NOT NULL,\n  `start_time` datetime NOT NULL,\n  `end_time` datetime NOT NULL,\n  PRIMARY KEY (`exhibition_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `curators` (\n  `curator_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `information` text DEFAULT NULL,\n  PRIMARY KEY (`curator_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `exhibits` (\n  `exhibit_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `information` text DEFAULT NULL,\n  PRIMARY KEY (`exhibit_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `exhibition_curators` (\n  `exhibition_id` int(11) NOT NULL,\n  `curator_id` int(11) NOT NULL,\n  PRIMARY KEY (`exhibition_id`,`curator_id`),\n  KEY `exhibition_curators_ibfk_2` (`curator_id`),\n  CONSTRAINT `exhibition_curators_ibfk_1` FOREIGN KEY (`exhibition_id`) REFERENCES `exhibitions` (`exhibition_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `exhibition_curators_ibfk_2` FOREIGN KEY (`curator_id`) REFERENCES `curators` (`curator_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `exhibition_exhibits` (\n  `exhibition_id` int(11) NOT NULL,\n  `exhibit_id` int(11) NOT NULL,\n  PRIMARY KEY (`exhibition_id`,`exhibit_id`),\n  KEY `exhibition_exhibits_ibfk_2` (`exhibit_id`),\n  CONSTRAINT `exhibition_exhibits_ibfk_1` FOREIGN KEY (`exhibition_id`) REFERENCES `exhibitions` (`exhibition_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `exhibition_exhibits_ibfk_2` FOREIGN KEY (`exhibit_id`) REFERENCES `exhibits` (`exhibit_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
