  "question": "The radio station needs to manage multiple advertisements. Each advertisement has multiple clients and multiple broadcast time slots. The system needs to record the name, content, and broadcast time of each advertisement, as well as the contact information of clients and the arrangement of time slots.",
  "ddl": "-- Schema for database: rschema_0284\nCREATE TABLE `clients` (\n  `client_id` int(11) NOT NULL AUTO_INCREMENT,\n  `client_name` varchar(255) NOT NULL,\n  `contact_info` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`client_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `advertisements` (\n  `advertisement_id` int(11) NOT NULL AUTO_INCREMENT,\n  `advertisement_name` varchar(255) NOT NULL,\n  `content` text NOT NULL,\n  `broadcast_time` datetime NOT NULL,\n  PRIMARY KEY (`advertisement_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `broadcast_time_slots` (\n  `time_slot_id` int(11) NOT NULL AUTO_INCREMENT,\n  `slot_start` datetime NOT NULL,\n  `slot_end` datetime NOT NULL,\n  `arrangement` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`time_slot_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `advertisement_clients` (\n  `advertisement_id` int(11) NOT NULL,\n  `client_id` int(11) NOT NULL,\n  PRIMARY KEY (`advertisement_id`,`client_id`),\n  KEY `advertisement_clients_ibfk_2` (`client_id`),\n  CONSTRAINT `advertisement_clients_ibfk_1` FOREIGN KEY (`advertisement_id`) REFERENCES `advertisements` (`advertisement_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `advertisement_clients_ibfk_2` FOREIGN KEY (`client_id`) REFERENCES `clients` (`client_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `advertisement_time_slots` (\n  `advertisement_id` int(11) NOT NULL,\n  `time_slot_id` int(11) NOT NULL,\n  PRIMARY KEY (`advertisement_id`,`time_slot_id`),\n  KEY `advertisement_time_slots_ibfk_2` (`time_slot_id`),\n  CONSTRAINT `advertisement_time_slots_ibfk_1` FOREIGN KEY (`advertisement_id`) REFERENCES `advertisements` (`advertisement_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `advertisement_time_slots_ibfk_2` FOREIGN KEY (`time_slot_id`) REFERENCES `broadcast_time_slots` (`time_slot_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
