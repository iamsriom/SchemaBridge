  "question": "The urban greening management department requires a system to manage multiple parks. Each park shall have Attributes including name, location, area, and responsible person. The system shall record the plant species, quantity, and growth status for each park. Each record shall include the recording time, recorder, plant species, and quantity. Additionally, the system shall track greening maintenance activities, including maintenance time, maintenance content, maintenance personnel, and maintenance costs.",
  "ddl": "-- Schema for database: rschema_0287\nCREATE TABLE `park` (\n  `park_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `location` varchar(255) NOT NULL,\n  `area` decimal(10,2) DEFAULT NULL,\n  `responsible_person` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`park_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `park_plant_record` (\n  `record_id` int(11) NOT NULL AUTO_INCREMENT,\n  `park_id` int(11) NOT NULL,\n  `recording_time` datetime NOT NULL,\n  `recorder` varchar(255) NOT NULL,\n  `plant_species` varchar(255) NOT NULL,\n  `quantity` int(11) NOT NULL,\n  `growth_status` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`record_id`),\n  KEY `park_plant_record_ibfk_1` (`park_id`),\n  CONSTRAINT `park_plant_record_ibfk_1` FOREIGN KEY (`park_id`) REFERENCES `park` (`park_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `park_maintenance` (\n  `maintenance_id` int(11) NOT NULL AUTO_INCREMENT,\n  `park_id` int(11) NOT NULL,\n  `maintenance_time` datetime NOT NULL,\n  `maintenance_content` varchar(500) NOT NULL,\n  `maintenance_personnel` varchar(255) NOT NULL,\n  `maintenance_cost` decimal(10,2) DEFAULT NULL,\n  PRIMARY KEY (`maintenance_id`),\n  KEY `park_maintenance_ibfk_1` (`park_id`),\n  CONSTRAINT `park_maintenance_ibfk_1` FOREIGN KEY (`park_id`) REFERENCES `park` (`park_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
