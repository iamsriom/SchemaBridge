  "database": "rschema_0295",
  "question": "The futures company employs multiple traders, each of whom is assigned a unique trader ID, name, hire date, and contact number. Traders execute futures transactions for clients, with each client identified by a client ID, name, ID number, and contact number. Each transaction must record the futures code, transaction type (buy, sell), transaction quantity, transaction price, and transaction time. Additionally, the futures company shall maintain records of each trader's transaction performance and the risk level of each client.",
  "ddl": "-- Schema for database: rschema_0295\nCREATE TABLE `traders` (\n  `trader_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `hire_date` date NOT NULL,\n  `contact_number` varchar(50) NOT NULL,\n  PRIMARY KEY (`trader_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `clients` (\n  `client_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `id_number` varchar(50) NOT NULL,\n  `contact_number` varchar(50) NOT NULL,\n  `risk_level` varchar(50) NOT NULL,\n  PRIMARY KEY (`client_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `futures_transactions` (\n  `transaction_id` int(11) NOT NULL,\n  `trader_id` int(11) NOT NULL,\n  `client_id` int(11) NOT NULL,\n  `futures_code` varchar(50) NOT NULL,\n  `transaction_type` varchar(10) NOT NULL,\n  `transaction_quantity` int(11) NOT NULL,\n  `transaction_price` decimal(10,2) NOT NULL,\n  `transaction_time` datetime NOT NULL,\n  PRIMARY KEY (`transaction_id`),\n  KEY `trader_id` (`trader_id`),\n  KEY `client_id` (`client_id`),\n  CONSTRAINT `futures_transactions_ibfk_1` FOREIGN KEY (`trader_id`) REFERENCES `traders` (`trader_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `futures_transactions_ibfk_2` FOREIGN KEY (`client_id`) REFERENCES `clients` (`client_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `trader_performance` (\n  `performance_id` int(11) NOT NULL,\n  `trader_id` int(11) NOT NULL,\n  `total_transactions` int(11) NOT NULL,\n  `total_volume` int(11) NOT NULL,\n  `total_profit` decimal(12,2) NOT NULL,\n  `performance_date` date NOT NULL,\n  PRIMARY KEY (`performance_id`),\n  KEY `trader_id` (`trader_id`),\n  CONSTRAINT `trader_performance_ibfk_1` FOREIGN KEY (`trader_id`) REFERENCES `traders` (`trader_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
