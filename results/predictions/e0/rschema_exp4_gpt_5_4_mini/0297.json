  "database": "rschema_0297",
  "question": "The document management system of a university needs to manage multiple types of documents. Each document type has a unique identifier and name, as well as a version number.\nEach document type can have multiple status categories, such as \"Lifecycle Status\", \"Approval Status\", etc. Each status category has a corresponding version number and multiple statuses. Each status has a sequence number indicating its position in the process.",
  "ddl": "-- Schema for database: rschema_0297\nCREATE TABLE `document_types` (\n  `document_type_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `version_number` int(11) NOT NULL,\n  PRIMARY KEY (`document_type_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `status_categories` (\n  `status_category_id` int(11) NOT NULL AUTO_INCREMENT,\n  `document_type_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `version_number` int(11) NOT NULL,\n  PRIMARY KEY (`status_category_id`),\n  KEY `status_categories_ibfk_1` (`document_type_id`),\n  CONSTRAINT `status_categories_ibfk_1` FOREIGN KEY (`document_type_id`) REFERENCES `document_types` (`document_type_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `statuses` (\n  `status_id` int(11) NOT NULL AUTO_INCREMENT,\n  `status_category_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `sequence_number` int(11) NOT NULL,\n  PRIMARY KEY (`status_id`),\n  KEY `statuses_ibfk_1` (`status_category_id`),\n  CONSTRAINT `statuses_ibfk_1` FOREIGN KEY (`status_category_id`) REFERENCES `status_categories` (`status_category_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
