  "question": "The employee management system of a company requires the following:\nThe system shall record the basic information of employees, including name, position, phone number, salary level, supervisor, and department.       \nDefine different salary levels and their corresponding salary ranges.\nMeanwhile, the system shall manage department information, such as department number, name, and location, and assign employees to the corresponding departments.",
  "ddl": "-- Schema for database: rschema_0298\nCREATE TABLE `department` (\n  `department_id` int(11) NOT NULL AUTO_INCREMENT,\n  `department_number` varchar(50) NOT NULL,\n  `department_name` varchar(255) NOT NULL,\n  `location` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`department_id`),\n  UNIQUE KEY `department_number` (`department_number`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `salary_level` (\n  `salary_level_id` int(11) NOT NULL AUTO_INCREMENT,\n  `level_name` varchar(50) NOT NULL,\n  `min_salary` decimal(10,2) NOT NULL,\n  `max_salary` decimal(10,2) NOT NULL,\n  PRIMARY KEY (`salary_level_id`),\n  UNIQUE KEY `level_name` (`level_name`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `employee` (\n  `employee_id` int(11) NOT NULL AUTO_INCREMENT,\n  `employee_name` varchar(255) NOT NULL,\n  `position` varchar(255) NOT NULL,\n  `phone_number` varchar(20) DEFAULT NULL,\n  `salary_level_id` int(11) NOT NULL,\n  `supervisor_id` int(11) DEFAULT NULL,\n  `department_id` int(11) NOT NULL,\n  PRIMARY KEY (`employee_id`),\n  KEY `salary_level_id` (`salary_level_id`),\n  KEY `supervisor_id` (`supervisor_id`),\n  KEY `department_id` (`department_id`),\n  CONSTRAINT `employee_ibfk_1` FOREIGN KEY (`salary_level_id`) REFERENCES `salary_level` (`salary_level_id`) ON DELETE RESTRICT ON UPDATE CASCADE,\n  CONSTRAINT `employee_ibfk_2` FOREIGN KEY (`supervisor_id`) REFERENCES `employee` (`employee_id`) ON DELETE SET NULL ON UPDATE CASCADE,\n  CONSTRAINT `employee_ibfk_3` FOREIGN KEY (`department_id`) REFERENCES `department` (`department_id`) ON DELETE RESTRICT ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
