  "database": "rschema_0302",
  "question": "The requirement analysis for a medical record management system is as follows: record basic information of doctors, including name, gender, telephone number, date of birth, age, department affiliation, and level. Record various medicines’ name, function, unit price, and inventory. Record basic information of patients, including name, gender, date of birth, age, phone, address, and emergency contact number; also, patient medication records need to be recorded, including Patient ID, Medicine ID, dosage, frequency of medication, precautions, and prescription time; in addition, consultation records including consultation time, diagnosis results, and treatment recommendations need to be recorded.",
  "ddl": "-- Schema for database: rschema_0302\nCREATE TABLE `doctor` (\n  `doctor_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `gender` varchar(10) NOT NULL,\n  `telephone` varchar(20) NOT NULL,\n  `date_of_birth` date NOT NULL,\n  `age` int(11) NOT NULL,\n  `department` varchar(255) NOT NULL,\n  `level` varchar(50) NOT NULL,\n  PRIMARY KEY (`doctor_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `medicine` (\n  `medicine_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `function` varchar(255) NOT NULL,\n  `unit_price` decimal(10,2) NOT NULL,\n  `inventory` int(11) NOT NULL,\n  PRIMARY KEY (`medicine_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `patient` (\n  `patient_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `gender` varchar(10) NOT NULL,\n  `date_of_birth` date NOT NULL,\n  `age` int(11) NOT NULL,\n  `phone` varchar(20) NOT NULL,\n  `address` varchar(255) NOT NULL,\n  `emergency_contact_number` varchar(20) NOT NULL,\n  PRIMARY KEY (`patient_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `patient_medication_record` (\n  `record_id` int(11) NOT NULL AUTO_INCREMENT,\n  `patient_id` int(11) NOT NULL,\n  `medicine_id` int(11) NOT NULL,\n  `dosage` varchar(255) NOT NULL,\n  `frequency` varchar(255) NOT NULL,\n  `precautions` varchar(255) DEFAULT NULL,\n  `prescription_time` datetime NOT NULL,\n  PRIMARY KEY (`record_id`),\n  KEY `patient_medication_record_ibfk_1` (`patient_id`),\n  KEY `patient_medication_record_ibfk_2` (`medicine_id`),\n  CONSTRAINT `patient_medication_record_ibfk_1` FOREIGN KEY (`patient_id`) REFERENCES `patient` (`patient_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `patient_medication_record_ibfk_2` FOREIGN KEY (`medicine_id`) REFERENCES `medicine` (`medicine_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `consultation_record` (\n  `consultation_id` int(11) NOT NULL AUTO_INCREMENT,\n  `patient_id` int(11) NOT NULL,\n  `doctor_id` int(11) NOT NULL,\n  `consultation_time` datetime NOT NULL,\n  `diagnosis_result` varchar(255) NOT NULL,\n  `treatment_recommendation` varchar(255) NOT NULL,\n  PRIMARY KEY (`consultation_id`),\n  KEY `consultation_record_ibfk_1` (`patient_id`),\n  KEY `consultation_record_ibfk_2` (`doctor_id`),\n  CONSTRAINT `consultation_record_ibfk_1` FOREIGN KEY (`patient_id`) REFERENCES `patient` (`patient_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `consultation_record_ibfk_2` FOREIGN KEY (`doctor_id`) REFERENCES `doctor` (`doctor_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
