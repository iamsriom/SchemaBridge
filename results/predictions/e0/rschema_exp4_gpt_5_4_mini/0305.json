  "database": "rschema_0305",
  "question": "The River social application needs to manage user registration, login, profiles, follow relationships, and user-published content. Each user has a unique Account ID, Name, Email, Password, Verification Status, and Account Status. The follow relationship records the follower and followee information between users, including the Follower Account ID and Followee Account ID. Additionally, users can publish posts, with each post containing a Post ID, Publisher Account ID, Content, Publish Time, and Attachment Link. The system also needs to manage user notifications, recording the Notification Type, Recipient Account ID, Related Post or User, and Notification Time. All data should maintain integrity and consistency to support key functions such as user registration, login, profile management, follow interactions, content publishing, and message notifications.",
  "ddl": "-- Schema for database: rschema_0305\nCREATE TABLE `users` (\n  `account_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `email` varchar(255) NOT NULL,\n  `password` varchar(255) NOT NULL,\n  `verification_status` varchar(50) NOT NULL,\n  `account_status` varchar(50) NOT NULL,\n  PRIMARY KEY (`account_id`),\n  UNIQUE KEY `uk_users_email` (`email`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `follows` (\n  `follower_account_id` int(11) NOT NULL,\n  `followee_account_id` int(11) NOT NULL,\n  `follow_time` datetime DEFAULT NULL,\n  PRIMARY KEY (`follower_account_id`,`followee_account_id`),\n  KEY `follows_ibfk_2` (`followee_account_id`),\n  CONSTRAINT `follows_ibfk_1` FOREIGN KEY (`follower_account_id`) REFERENCES `users` (`account_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `follows_ibfk_2` FOREIGN KEY (`followee_account_id`) REFERENCES `users` (`account_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `posts` (\n  `post_id` int(11) NOT NULL AUTO_INCREMENT,\n  `publisher_account_id` int(11) NOT NULL,\n  `content` text NOT NULL,\n  `publish_time` datetime NOT NULL,\n  `attachment_link` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`post_id`),\n  KEY `posts_ibfk_1` (`publisher_account_id`),\n  CONSTRAINT `posts_ibfk_1` FOREIGN KEY (`publisher_account_id`) REFERENCES `users` (`account_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `notifications` (\n  `notification_id` int(11) NOT NULL AUTO_INCREMENT,\n  `notification_type` varchar(100) NOT NULL,\n  `recipient_account_id` int(11) NOT NULL,\n  `related_post_id` int(11) DEFAULT NULL,\n  `related_user_id` int(11) DEFAULT NULL,\n  `notification_time` datetime NOT NULL,\n  PRIMARY KEY (`notification_id`),\n  KEY `notifications_ibfk_1` (`recipient_account_id`),\n  KEY `notifications_ibfk_2` (`related_post_id`),\n  KEY `notifications_ibfk_3` (`related_user_id`),\n  CONSTRAINT `notifications_ibfk_1` FOREIGN KEY (`recipient_account_id`) REFERENCES `users` (`account_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `notifications_ibfk_2` FOREIGN KEY (`related_post_id`) REFERENCES `posts` (`post_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `notifications_ibfk_3` FOREIGN KEY (`related_user_id`) REFERENCES `users` (`account_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
