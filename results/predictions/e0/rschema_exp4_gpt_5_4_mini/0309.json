  "database": "rschema_0309",
  "question": "\"The insurance management system is required to manage information about customers, regions, income groups, vehicle segments, and policies. A customer includes their name, email, phone number, gender, date of birth, marital status, relevant region, and income group. The system must also record various insurance Attributes of a policy such as personal injury liability insurance, collision insurance, etc., along with their premiums, and link them to the corresponding vehicle segments. When a customer purchases a policy, an insurance record is generated, including the purchase date and expiration date. The system should be capable of conducting statistical analysis on customers from different regions and income groups, and according to vehicle segments or types of policies, thereby supporting subsequent business decisions and customer services.\"",
  "ddl": "-- Schema for database: rschema_0309\nCREATE TABLE `regions` (\n  `region_id` int(11) NOT NULL AUTO_INCREMENT,\n  `region_name` varchar(255) NOT NULL,\n  PRIMARY KEY (`region_id`),\n  UNIQUE KEY `region_name` (`region_name`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `income_groups` (\n  `income_group_id` int(11) NOT NULL AUTO_INCREMENT,\n  `income_group_name` varchar(255) NOT NULL,\n  `min_income` decimal(12,2) DEFAULT NULL,\n  `max_income` decimal(12,2) DEFAULT NULL,\n  PRIMARY KEY (`income_group_id`),\n  UNIQUE KEY `income_group_name` (`income_group_name`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `vehicle_segments` (\n  `vehicle_segment_id` int(11) NOT NULL AUTO_INCREMENT,\n  `segment_name` varchar(255) NOT NULL,\n  `segment_description` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`vehicle_segment_id`),\n  UNIQUE KEY `segment_name` (`segment_name`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `customers` (\n  `customer_id` int(11) NOT NULL AUTO_INCREMENT,\n  `customer_name` varchar(255) NOT NULL,\n  `email` varchar(255) NOT NULL,\n  `phone_number` varchar(50) DEFAULT NULL,\n  `gender` char(1) DEFAULT NULL,\n  `date_of_birth` date DEFAULT NULL,\n  `marital_status` varchar(50) DEFAULT NULL,\n  `region_id` int(11) NOT NULL,\n  `income_group_id` int(11) NOT NULL,\n  PRIMARY KEY (`customer_id`),\n  UNIQUE KEY `email` (`email`),\n  KEY `region_id` (`region_id`),\n  KEY `income_group_id` (`income_group_id`),\n  CONSTRAINT `customers_ibfk_1` FOREIGN KEY (`region_id`) REFERENCES `regions` (`region_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `customers_ibfk_2` FOREIGN KEY (`income_group_id`) REFERENCES `income_groups` (`income_group_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `policy_attributes` (\n  `policy_attribute_id` int(11) NOT NULL AUTO_INCREMENT,\n  `vehicle_segment_id` int(11) NOT NULL,\n  `attribute_name` varchar(255) NOT NULL,\n  `premium_amount` decimal(12,2) NOT NULL,\n  `attribute_description` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`policy_attribute_id`),\n  KEY `vehicle_segment_id` (`vehicle_segment_id`),\n  CONSTRAINT `policy_attributes_ibfk_1` FOREIGN KEY (`vehicle_segment_id`) REFERENCES `vehicle_segments` (`vehicle_segment_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `policies` (\n  `policy_id` int(11) NOT NULL AUTO_INCREMENT,\n  `customer_id` int(11) NOT NULL,\n  `vehicle_segment_id` int(11) NOT NULL,\n  `policy_number` varchar(100) NOT NULL,\n  `purchase_date` date NOT NULL,\n  `expiration_date` date NOT NULL,\n  PRIMARY KEY (`policy_id`),\n  UNIQUE KEY `policy_number` (`policy_number`),\n  KEY `customer_id` (`customer_id`),\n  KEY `vehicle_segment_id` (`vehicle_segment_id`),\n  CONSTRAINT `policies_ibfk_1` FOREIGN KEY (`customer_id`) REFERENCES `customers` (`customer_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `policies_ibfk_2` FOREIGN KEY (`vehicle_segment_id`) REFERENCES `vehicle_segments` (`vehicle_segment_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `policy_attribute_purchases` (\n  `policy_attribute_purchase_id` int(11) NOT NULL AUTO_INCREMENT,\n  `policy_id` int(11) NOT NULL,\n  `policy_attribute_id` int(11) NOT NULL,\n  `premium_amount` decimal(12,2) NOT NULL,\n  PRIMARY KEY (`policy_attribute_purchase_id`),\n  KEY `policy_id` (`policy_id`),\n  KEY `policy_attribute_id` (`policy_attribute_id`),\n  CONSTRAINT `policy_attribute_purchases_ibfk_1` FOREIGN KEY (`policy_id`) REFERENCES `policies` (`policy_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `policy_attribute_purchases_ibfk_2` FOREIGN KEY (`policy_attribute_id`) REFERENCES `policy_attributes` (`policy_attribute_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
