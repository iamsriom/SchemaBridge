  "database": "rschema_0322",
  "question": "The enterprise management system is required to manage information regarding companies, users, employees, devices, and sites simultaneously. In the system, each company shall be recorded with its name, website address, and creation time. A company may have multiple employees; their names, positions, and salaries are to be stored and associated with their respective companies. Each employee may use multiple devices; the system shall record the name of each device and specify the employee to whom it belongs. Regarding user information, the system shall store usernames, emails, passwords, and the last login time, and link users to the sites they have created. Each site shall have a unique name and hostname and can be marked as deleted.",
  "ddl": "-- Schema for database: rschema_0322\nCREATE TABLE `company` (\n  `company_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `website_address` varchar(255) DEFAULT NULL,\n  `created_at` datetime NOT NULL,\n  PRIMARY KEY (`company_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `employee` (\n  `employee_id` int(11) NOT NULL AUTO_INCREMENT,\n  `company_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `position` varchar(255) DEFAULT NULL,\n  `salary` decimal(10,2) DEFAULT NULL,\n  PRIMARY KEY (`employee_id`),\n  KEY `employee_ibfk_1` (`company_id`),\n  CONSTRAINT `employee_ibfk_1` FOREIGN KEY (`company_id`) REFERENCES `company` (`company_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `device` (\n  `device_id` int(11) NOT NULL AUTO_INCREMENT,\n  `employee_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  PRIMARY KEY (`device_id`),\n  KEY `device_ibfk_1` (`employee_id`),\n  CONSTRAINT `device_ibfk_1` FOREIGN KEY (`employee_id`) REFERENCES `employee` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `user` (\n  `user_id` int(11) NOT NULL AUTO_INCREMENT,\n  `username` varchar(255) NOT NULL,\n  `email` varchar(255) NOT NULL,\n  `password` varchar(255) NOT NULL,\n  `last_login_time` datetime DEFAULT NULL,\n  PRIMARY KEY (`user_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `site` (\n  `site_id` int(11) NOT NULL AUTO_INCREMENT,\n  `user_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `hostname` varchar(255) NOT NULL,\n  `is_deleted` tinyint(1) NOT NULL DEFAULT '0',\n  PRIMARY KEY (`site_id`),\n  UNIQUE KEY `uniq_site_name` (`name`),\n  UNIQUE KEY `uniq_site_hostname` (`hostname`),\n  KEY `site_ibfk_1` (`user_id`),\n  CONSTRAINT `site_ibfk_1` FOREIGN KEY (`user_id`) REFERENCES `user` (`user_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
