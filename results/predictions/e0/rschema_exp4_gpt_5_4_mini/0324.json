  "database": "rschema_0324",
  "question": "The database is a geolocation system used to determine the user's geographic location information based on the IP address. Such systems are often used in websites and applications to provide services or content based on geographic location.\n\nMain functions\n\n1. Mapping of IP address to geographic location:\nDetermine the user's geographic location through the IP address (network), including information such as continent and country.\nSupport querying whether the IP address belongs to an anonymous proxy or satellite provider.\n\n2. Geographic location information query:\nProvide detailed geographic location information, such as country name, ISO code, whether it is in the European Union, etc.\nSupport quick search of geographic location information by country ISO code.\n\n3. Data management and maintenance:\nSupport importing and updating geographic location data and IP network data.\nEnsure data consistency and integrity through Foreign key relationships.",
  "ddl": "-- Schema for database: rschema_0324\nCREATE TABLE `geo_location` (\n  `geo_location_id` int(11) NOT NULL AUTO_INCREMENT,\n  `continent_name` varchar(100) DEFAULT NULL,\n  `continent_code` char(2) DEFAULT NULL,\n  `country_name` varchar(150) DEFAULT NULL,\n  `country_iso_code` char(2) NOT NULL,\n  `is_in_european_union` tinyint(1) NOT NULL DEFAULT 0,\n  `region_name` varchar(150) DEFAULT NULL,\n  `city_name` varchar(150) DEFAULT NULL,\n  `postal_code` varchar(20) DEFAULT NULL,\n  `latitude` decimal(10,6) DEFAULT NULL,\n  `longitude` decimal(10,6) DEFAULT NULL,\n  PRIMARY KEY (`geo_location_id`),\n  UNIQUE KEY `uk_geo_location_country_iso_code` (`country_iso_code`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `ip_network` (\n  `ip_network_id` int(11) NOT NULL AUTO_INCREMENT,\n  `network_cidr` varchar(43) NOT NULL,\n  `ip_version` tinyint(1) NOT NULL,\n  `geo_location_id` int(11) NOT NULL,\n  `is_anonymous_proxy` tinyint(1) NOT NULL DEFAULT 0,\n  `is_satellite_provider` tinyint(1) NOT NULL DEFAULT 0,\n  `import_batch_id` int(11) DEFAULT NULL,\n  `updated_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  PRIMARY KEY (`ip_network_id`),\n  UNIQUE KEY `uk_ip_network_network_cidr` (`network_cidr`),\n  KEY `ip_network_ibfk_1` (`geo_location_id`),\n  CONSTRAINT `ip_network_ibfk_1` FOREIGN KEY (`geo_location_id`) REFERENCES `geo_location` (`geo_location_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `data_import_batch` (\n  `import_batch_id` int(11) NOT NULL AUTO_INCREMENT,\n  `source_name` varchar(255) NOT NULL,\n  `source_version` varchar(100) DEFAULT NULL,\n  `imported_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  `status` varchar(30) NOT NULL,\n  `notes` varchar(500) DEFAULT NULL,\n  PRIMARY KEY (`import_batch_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `ip_network_import` (\n  `ip_network_import_id` int(11) NOT NULL AUTO_INCREMENT,\n  `import_batch_id` int(11) NOT NULL,\n  `ip_network_id` int(11) NOT NULL,\n  `action_type` varchar(20) NOT NULL,\n  `processed_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  PRIMARY KEY (`ip_network_import_id`),\n  KEY `ip_network_import_ibfk_1` (`import_batch_id`),\n  KEY `ip_network_import_ibfk_2` (`ip_network_id`),\n  CONSTRAINT `ip_network_import_ibfk_1` FOREIGN KEY (`import_batch_id`) REFERENCES `data_import_batch` (`import_batch_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `ip_network_import_ibfk_2` FOREIGN KEY (`ip_network_id`) REFERENCES `ip_network` (`ip_network_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
