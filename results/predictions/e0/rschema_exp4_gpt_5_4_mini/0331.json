  "database": "rschema_0331",
  "question": "In the management process of multiplayer competition events (such as card games, board games, or other competitive games), the system needs to record and track players' participation information, match progress, game results, and ranking data. The core purpose of such a system is to provide a platform to organize and manage competitions, ensuring fairness and impartiality, and to offer comprehensive data analysis and reporting functionalities, assisting players and event organizers in understanding match progress and results.\n\nMain functional requirements:  \nUser (player) management:  \nRecord basic information for each participating player, including username, contact information, and account status.  \n\nMatch management:  \nRecord basic information for all matches, including match type, start time, end time, and participating players.  \n\nMatch result recording:  \nRecord match results, possibly including each player's score, win-loss status, and ranking.  \n\nBattle record management:  \nRecord details of each specific battle within a match, involving both sides of the battle, start time, end time, and win-loss status.",
  "ddl": "-- Schema for database: rschema_0331\nCREATE TABLE `players` (\n  `player_id` int(11) NOT NULL AUTO_INCREMENT,\n  `username` varchar(255) NOT NULL,\n  `contact_info` varchar(255) DEFAULT NULL,\n  `account_status` varchar(50) NOT NULL,\n  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  `updated_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,\n  PRIMARY KEY (`player_id`),\n  UNIQUE KEY `uk_players_username` (`username`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `matches` (\n  `match_id` int(11) NOT NULL AUTO_INCREMENT,\n  `match_type` varchar(100) NOT NULL,\n  `start_time` datetime NOT NULL,\n  `end_time` datetime DEFAULT NULL,\n  `match_status` varchar(50) NOT NULL,\n  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  `updated_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,\n  PRIMARY KEY (`match_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `match_participants` (\n  `match_participant_id` int(11) NOT NULL AUTO_INCREMENT,\n  `match_id` int(11) NOT NULL,\n  `player_id` int(11) NOT NULL,\n  `joined_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  PRIMARY KEY (`match_participant_id`),\n  UNIQUE KEY `uk_match_participants_match_player` (`match_id`,`player_id`),\n  KEY `match_participants_ibfk_2` (`player_id`),\n  CONSTRAINT `match_participants_ibfk_1` FOREIGN KEY (`match_id`) REFERENCES `matches` (`match_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `match_participants_ibfk_2` FOREIGN KEY (`player_id`) REFERENCES `players` (`player_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `match_results` (\n  `match_result_id` int(11) NOT NULL AUTO_INCREMENT,\n  `match_id` int(11) NOT NULL,\n  `player_id` int(11) NOT NULL,\n  `score` decimal(10,2) NOT NULL DEFAULT '0.00',\n  `win_loss_status` varchar(20) NOT NULL,\n  `ranking` int(11) DEFAULT NULL,\n  `result_note` varchar(255) DEFAULT NULL,\n  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  PRIMARY KEY (`match_result_id`),\n  UNIQUE KEY `uk_match_results_match_player` (`match_id`,`player_id`),\n  KEY `match_results_ibfk_2` (`player_id`),\n  CONSTRAINT `match_results_ibfk_1` FOREIGN KEY (`match_id`) REFERENCES `matches` (`match_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `match_results_ibfk_2` FOREIGN KEY (`player_id`) REFERENCES `players` (`player_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `battles` (\n  `battle_id` int(11) NOT NULL AUTO_INCREMENT,\n  `match_id` int(11) NOT NULL,\n  `battle_no` int(11) NOT NULL,\n  `side_a_player_id` int(11) NOT NULL,\n  `side_b_player_id` int(11) NOT NULL,\n  `start_time` datetime NOT NULL,\n  `end_time` datetime DEFAULT NULL,\n  `win_loss_status` varchar(20) NOT NULL,\n  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  PRIMARY KEY (`battle_id`),\n  UNIQUE KEY `uk_battles_match_battle_no` (`match_id`,`battle_no`),\n  KEY `battles_ibfk_2` (`side_a_player_id`),\n  KEY `battles_ibfk_3` (`side_b_player_id`),\n  CONSTRAINT `battles_ibfk_1` FOREIGN KEY (`match_id`) REFERENCES `matches` (`match_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `battles_ibfk_2` FOREIGN KEY (`side_a_player_id`) REFERENCES `players` (`player_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `battles_ibfk_3` FOREIGN KEY (`side_b_player_id`) REFERENCES `players` (`player_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
