  "question": "Academic administration system business requirement description: The school has multiple colleges, each with a college name, college location, total number of staff, and total number of students. Each college consists of multiple students and teachers. Each student has a Student ID, name, gender, date of birth, age, telephone, registration time, and associated college ID. Each teacher has a Teacher ID, gender, name, age, contact information, title, and associated college ID. The school offers multiple courses, each with a Course ID, name, credit number, teaching Teacher ID, course summary, class hours, and classroom. Students can enroll in multiple courses, and each enrollment requires recording the Student ID, Course ID, enrollment time, and course grade.",
  "ddl": "-- Schema for database: rschema_0338\nCREATE TABLE `college` (\n  `college_id` int(11) NOT NULL AUTO_INCREMENT,\n  `college_name` varchar(255) NOT NULL,\n  `college_location` varchar(255) DEFAULT NULL,\n  `total_staff` int(11) DEFAULT NULL,\n  `total_students` int(11) DEFAULT NULL,\n  PRIMARY KEY (`college_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `student` (\n  `student_id` int(11) NOT NULL AUTO_INCREMENT,\n  `student_name` varchar(255) NOT NULL,\n  `gender` varchar(20) DEFAULT NULL,\n  `date_of_birth` date DEFAULT NULL,\n  `age` int(11) DEFAULT NULL,\n  `telephone` varchar(50) DEFAULT NULL,\n  `registration_time` datetime DEFAULT NULL,\n  `college_id` int(11) NOT NULL,\n  PRIMARY KEY (`student_id`),\n  KEY `student_ibfk_1` (`college_id`),\n  CONSTRAINT `student_ibfk_1` FOREIGN KEY (`college_id`) REFERENCES `college` (`college_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `teacher` (\n  `teacher_id` int(11) NOT NULL AUTO_INCREMENT,\n  `gender` varchar(20) DEFAULT NULL,\n  `teacher_name` varchar(255) NOT NULL,\n  `age` int(11) DEFAULT NULL,\n  `contact_information` varchar(255) DEFAULT NULL,\n  `title` varchar(255) DEFAULT NULL,\n  `college_id` int(11) NOT NULL,\n  PRIMARY KEY (`teacher_id`),\n  KEY `teacher_ibfk_1` (`college_id`),\n  CONSTRAINT `teacher_ibfk_1` FOREIGN KEY (`college_id`) REFERENCES `college` (`college_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `course` (\n  `course_id` int(11) NOT NULL AUTO_INCREMENT,\n  `course_name` varchar(255) NOT NULL,\n  `credit_number` int(11) DEFAULT NULL,\n  `teacher_id` int(11) NOT NULL,\n  `course_summary` varchar(1000) DEFAULT NULL,\n  `class_hours` int(11) DEFAULT NULL,\n  `classroom` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`course_id`),\n  KEY `course_ibfk_1` (`teacher_id`),\n  CONSTRAINT `course_ibfk_1` FOREIGN KEY (`teacher_id`) REFERENCES `teacher` (`teacher_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `enrollment` (\n  `student_id` int(11) NOT NULL,\n  `course_id` int(11) NOT NULL,\n  `enrollment_time` datetime DEFAULT NULL,\n  `course_grade` decimal(5,2) DEFAULT NULL,\n  PRIMARY KEY (`student_id`,`course_id`),\n  KEY `enrollment_ibfk_2` (`course_id`),\n  CONSTRAINT `enrollment_ibfk_1` FOREIGN KEY (`student_id`) REFERENCES `student` (`student_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `enrollment_ibfk_2` FOREIGN KEY (`course_id`) REFERENCES `course` (`course_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
