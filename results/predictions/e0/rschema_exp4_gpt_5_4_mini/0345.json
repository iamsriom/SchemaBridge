  "database": "rschema_0345",
  "question": "An education management system is required to manage information on courses, professors, students, and subjects. Each course has a code, total credits, name, and a professor as the course coordinator. Professors may be responsible for different courses and their names and email information are recorded. Subjects need to record the number of credits, subject names, possible equivalent subjects, and manage prerequisite relationships to ensure students have completed relevant prerequisites before enrolling in a subject. The system must also store each course's subjects arranged in different semesters.\n\nFor students, the system needs to record their student ID, name, email, courses taken, date of birth, credits completed, and average grade.",
  "ddl": "-- Schema for database: rschema_0345\nCREATE TABLE `professors` (\n  `professor_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `email` varchar(255) NOT NULL,\n  PRIMARY KEY (`professor_id`),\n  UNIQUE KEY `email` (`email`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `courses` (\n  `course_code` varchar(20) NOT NULL,\n  `total_credits` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `coordinator_professor_id` int(11) NOT NULL,\n  PRIMARY KEY (`course_code`),\n  KEY `coordinator_professor_id` (`coordinator_professor_id`),\n  CONSTRAINT `courses_ibfk_1` FOREIGN KEY (`coordinator_professor_id`) REFERENCES `professors` (`professor_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `students` (\n  `student_id` varchar(20) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `email` varchar(255) NOT NULL,\n  `course_code` varchar(20) NOT NULL,\n  `date_of_birth` date NOT NULL,\n  `credits_completed` int(11) NOT NULL DEFAULT '0',\n  `average_grade` decimal(5,2) DEFAULT NULL,\n  PRIMARY KEY (`student_id`),\n  KEY `course_code` (`course_code`),\n  UNIQUE KEY `email` (`email`),\n  CONSTRAINT `students_ibfk_1` FOREIGN KEY (`course_code`) REFERENCES `courses` (`course_code`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `subjects` (\n  `subject_id` int(11) NOT NULL AUTO_INCREMENT,\n  `subject_code` varchar(20) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `credits` int(11) NOT NULL,\n  PRIMARY KEY (`subject_id`),\n  UNIQUE KEY `subject_code` (`subject_code`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `subject_equivalents` (\n  `subject_id` int(11) NOT NULL,\n  `equivalent_subject_id` int(11) NOT NULL,\n  PRIMARY KEY (`subject_id`,`equivalent_subject_id`),\n  KEY `equivalent_subject_id` (`equivalent_subject_id`),\n  CONSTRAINT `subject_equivalents_ibfk_1` FOREIGN KEY (`subject_id`) REFERENCES `subjects` (`subject_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `subject_equivalents_ibfk_2` FOREIGN KEY (`equivalent_subject_id`) REFERENCES `subjects` (`subject_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `subject_prerequisites` (\n  `subject_id` int(11) NOT NULL,\n  `prerequisite_subject_id` int(11) NOT NULL,\n  PRIMARY KEY (`subject_id`,`prerequisite_subject_id`),\n  KEY `prerequisite_subject_id` (`prerequisite_subject_id`),\n  CONSTRAINT `subject_prerequisites_ibfk_1` FOREIGN KEY (`subject_id`) REFERENCES `subjects` (`subject_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `subject_prerequisites_ibfk_2` FOREIGN KEY (`prerequisite_subject_id`) REFERENCES `subjects` (`subject_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `course_subjects` (\n  `course_code` varchar(20) NOT NULL,\n  `subject_id` int(11) NOT NULL,\n  `semester_number` int(11) NOT NULL,\n  PRIMARY KEY (`course_code`,`subject_id`),\n  KEY `subject_id` (`subject_id`),\n  CONSTRAINT `course_subjects_ibfk_1` FOREIGN KEY (`course_code`) REFERENCES `courses` (`course_code`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `course_subjects_ibfk_2` FOREIGN KEY (`subject_id`) REFERENCES `subjects` (`subject_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
