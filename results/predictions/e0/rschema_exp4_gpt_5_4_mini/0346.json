  "question": "The financial management system shall record and manage various expense information. Each expense record shall contain basic fields such as description, amount, month, due date, payment date, and expense status. The system shall also support multi-dimensional associations, such as binding expenses to application centers, accounting accounts, and company accounts. Some expenses may involve external suppliers, which shall also be managed and associated in the system. Users shall be able to query or analyze expense information based on this, such as querying paid or unpaid expenses within a certain period, or viewing expense records of specific suppliers, and generate corresponding financial reports based on actual requirements.",
  "ddl": "-- Schema for database: rschema_0346\nCREATE TABLE `application_center` (\n  `application_center_id` int(11) NOT NULL AUTO_INCREMENT,\n  `center_name` varchar(255) NOT NULL,\n  `center_code` varchar(100) DEFAULT NULL,\n  `created_at` datetime DEFAULT NULL,\n  PRIMARY KEY (`application_center_id`),\n  UNIQUE KEY `uk_application_center_code` (`center_code`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `accounting_account` (\n  `accounting_account_id` int(11) NOT NULL AUTO_INCREMENT,\n  `account_name` varchar(255) NOT NULL,\n  `account_code` varchar(100) DEFAULT NULL,\n  `created_at` datetime DEFAULT NULL,\n  PRIMARY KEY (`accounting_account_id`),\n  UNIQUE KEY `uk_accounting_account_code` (`account_code`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `company_account` (\n  `company_account_id` int(11) NOT NULL AUTO_INCREMENT,\n  `company_name` varchar(255) NOT NULL,\n  `account_number` varchar(100) DEFAULT NULL,\n  `bank_name` varchar(255) DEFAULT NULL,\n  `created_at` datetime DEFAULT NULL,\n  PRIMARY KEY (`company_account_id`),\n  UNIQUE KEY `uk_company_account_number` (`account_number`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `supplier` (\n  `supplier_id` int(11) NOT NULL AUTO_INCREMENT,\n  `supplier_name` varchar(255) NOT NULL,\n  `supplier_code` varchar(100) DEFAULT NULL,\n  `contact_name` varchar(255) DEFAULT NULL,\n  `contact_phone` varchar(50) DEFAULT NULL,\n  `created_at` datetime DEFAULT NULL,\n  PRIMARY KEY (`supplier_id`),\n  UNIQUE KEY `uk_supplier_code` (`supplier_code`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `expense` (\n  `expense_id` int(11) NOT NULL AUTO_INCREMENT,\n  `description` varchar(500) NOT NULL,\n  `amount` decimal(12,2) NOT NULL,\n  `expense_month` char(6) NOT NULL,\n  `due_date` date DEFAULT NULL,\n  `payment_date` date DEFAULT NULL,\n  `expense_status` varchar(50) NOT NULL,\n  `application_center_id` int(11) DEFAULT NULL,\n  `accounting_account_id` int(11) DEFAULT NULL,\n  `company_account_id` int(11) DEFAULT NULL,\n  `supplier_id` int(11) DEFAULT NULL,\n  `created_at` datetime DEFAULT NULL,\n  `updated_at` datetime DEFAULT NULL,\n  PRIMARY KEY (`expense_id`),\n  KEY `expense_ibfk_1` (`application_center_id`),\n  KEY `expense_ibfk_2` (`accounting_account_id`),\n  KEY `expense_ibfk_3` (`company_account_id`),\n  KEY `expense_ibfk_4` (`supplier_id`),\n  CONSTRAINT `expense_ibfk_1` FOREIGN KEY (`application_center_id`) REFERENCES `application_center` (`application_center_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `expense_ibfk_2` FOREIGN KEY (`accounting_account_id`) REFERENCES `accounting_account` (`accounting_account_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `expense_ibfk_3` FOREIGN KEY (`company_account_id`) REFERENCES `company_account` (`company_account_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `expense_ibfk_4` FOREIGN KEY (`supplier_id`) REFERENCES `supplier` (`supplier_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
