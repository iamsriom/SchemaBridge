  "database": "rschema_0351",
  "question": "The access control system shall manage access permissions for different types of objects based on users or roles. Each object shall have a corresponding class and unique identifier, and may have a parent object, thereby allowing inheritance of permissions from the parent object. The system shall also record the owner of each object, including their name and contact information, and specify the authorized object in each permission entry, as well as whether to record audit logs for successful or failed access attempts.",
  "ddl": "-- Schema for database: rschema_0351\nCREATE TABLE `object_class` (\n  `class_id` int(11) NOT NULL AUTO_INCREMENT,\n  `class_name` varchar(255) NOT NULL,\n  `class_description` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`class_id`),\n  UNIQUE KEY `class_name` (`class_name`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `object_owner` (\n  `owner_id` int(11) NOT NULL AUTO_INCREMENT,\n  `owner_name` varchar(255) NOT NULL,\n  `contact_info` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`owner_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `secured_object` (\n  `object_id` int(11) NOT NULL AUTO_INCREMENT,\n  `class_id` int(11) NOT NULL,\n  `object_uid` varchar(255) NOT NULL,\n  `parent_object_id` int(11) DEFAULT NULL,\n  `owner_id` int(11) NOT NULL,\n  `object_name` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`object_id`),\n  UNIQUE KEY `class_uid` (`class_id`,`object_uid`),\n  KEY `class_id` (`class_id`),\n  KEY `parent_object_id` (`parent_object_id`),\n  KEY `owner_id` (`owner_id`),\n  CONSTRAINT `secured_object_ibfk_1` FOREIGN KEY (`class_id`) REFERENCES `object_class` (`class_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `secured_object_ibfk_2` FOREIGN KEY (`parent_object_id`) REFERENCES `secured_object` (`object_id`) ON DELETE SET NULL ON UPDATE CASCADE,\n  CONSTRAINT `secured_object_ibfk_3` FOREIGN KEY (`owner_id`) REFERENCES `object_owner` (`owner_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `access_principal` (\n  `principal_id` int(11) NOT NULL AUTO_INCREMENT,\n  `principal_type` varchar(20) NOT NULL,\n  `principal_name` varchar(255) NOT NULL,\n  PRIMARY KEY (`principal_id`),\n  UNIQUE KEY `principal_type_name` (`principal_type`,`principal_name`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `access_permission` (\n  `permission_id` int(11) NOT NULL AUTO_INCREMENT,\n  `principal_id` int(11) NOT NULL,\n  `authorized_object_id` int(11) NOT NULL,\n  `permission_name` varchar(255) NOT NULL,\n  `allow_success_audit` tinyint(1) NOT NULL DEFAULT '0',\n  `allow_failure_audit` tinyint(1) NOT NULL DEFAULT '0',\n  PRIMARY KEY (`permission_id`),\n  KEY `principal_id` (`principal_id`),\n  KEY `authorized_object_id` (`authorized_object_id`),\n  CONSTRAINT `access_permission_ibfk_1` FOREIGN KEY (`principal_id`) REFERENCES `access_principal` (`principal_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `access_permission_ibfk_2` FOREIGN KEY (`authorized_object_id`) REFERENCES `secured_object` (`object_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
