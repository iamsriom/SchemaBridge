  "question": "The database design requirements for a certain web page management system are as follows: The system needs to store additional navigation information for each page in the application, such as page name, alias, title, etc., to support page management, navigation control, permission management, and dynamic display control. Through this system, administrators can set the display order, style, redirection target, and click events of pages. The system records information about web page users, including user ID, username, email address, and other details. At the same time, the system needs to record administrator information, including ID and name. Administrators can modify page visibility, allowing pages to be dynamically shown or hidden, and can perform page grouping management and set permission management schemes. All update records will be saved to ensure the traceability of changes.",
  "ddl": "-- Schema for database: rschema_0353\nCREATE TABLE `admin_users` (\n  `admin_id` int(11) NOT NULL AUTO_INCREMENT,\n  `admin_name` varchar(255) NOT NULL,\n  PRIMARY KEY (`admin_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `page_users` (\n  `user_id` int(11) NOT NULL AUTO_INCREMENT,\n  `username` varchar(255) NOT NULL,\n  `email` varchar(255) NOT NULL,\n  `full_name` varchar(255) DEFAULT NULL,\n  `created_at` datetime DEFAULT NULL,\n  PRIMARY KEY (`user_id`),\n  UNIQUE KEY `uk_page_users_username` (`username`),\n  UNIQUE KEY `uk_page_users_email` (`email`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `page_groups` (\n  `group_id` int(11) NOT NULL AUTO_INCREMENT,\n  `group_name` varchar(255) NOT NULL,\n  `group_description` varchar(500) DEFAULT NULL,\n  `created_by_admin_id` int(11) DEFAULT NULL,\n  `created_at` datetime DEFAULT NULL,\n  PRIMARY KEY (`group_id`),\n  KEY `page_groups_ibfk_1` (`created_by_admin_id`),\n  CONSTRAINT `page_groups_ibfk_1` FOREIGN KEY (`created_by_admin_id`) REFERENCES `admin_users` (`admin_id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `permission_schemes` (\n  `scheme_id` int(11) NOT NULL AUTO_INCREMENT,\n  `scheme_name` varchar(255) NOT NULL,\n  `scheme_description` varchar(500) DEFAULT NULL,\n  `created_by_admin_id` int(11) DEFAULT NULL,\n  `created_at` datetime DEFAULT NULL,\n  PRIMARY KEY (`scheme_id`),\n  KEY `permission_schemes_ibfk_1` (`created_by_admin_id`),\n  CONSTRAINT `permission_schemes_ibfk_1` FOREIGN KEY (`created_by_admin_id`) REFERENCES `admin_users` (`admin_id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `pages` (\n  `page_id` int(11) NOT NULL AUTO_INCREMENT,\n  `page_name` varchar(255) NOT NULL,\n  `page_alias` varchar(255) DEFAULT NULL,\n  `page_title` varchar(255) DEFAULT NULL,\n  `page_description` varchar(500) DEFAULT NULL,\n  `display_order` int(11) NOT NULL DEFAULT '0',\n  `style_class` varchar(255) DEFAULT NULL,\n  `redirect_target` varchar(500) DEFAULT NULL,\n  `click_event` varchar(255) DEFAULT NULL,\n  `is_visible` tinyint(1) NOT NULL DEFAULT '1',\n  `group_id` int(11) DEFAULT NULL,\n  `scheme_id` int(11) DEFAULT NULL,\n  `created_by_admin_id` int(11) DEFAULT NULL,\n  `created_at` datetime DEFAULT NULL,\n  `updated_at` datetime DEFAULT NULL,\n  PRIMARY KEY (`page_id`),\n  KEY `pages_ibfk_1` (`group_id`),\n  KEY `pages_ibfk_2` (`scheme_id`),\n  KEY `pages_ibfk_3` (`created_by_admin_id`),\n  CONSTRAINT `pages_ibfk_1` FOREIGN KEY (`group_id`) REFERENCES `page_groups` (`group_id`) ON DELETE SET NULL ON UPDATE CASCADE,\n  CONSTRAINT `pages_ibfk_2` FOREIGN KEY (`scheme_id`) REFERENCES `permission_schemes` (`scheme_id`) ON DELETE SET NULL ON UPDATE CASCADE,\n  CONSTRAINT `pages_ibfk_3` FOREIGN KEY (`created_by_admin_id`) REFERENCES `admin_users` (`admin_id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `page_update_records` (\n  `record_id` int(11) NOT NULL AUTO_INCREMENT,\n  `page_id` int(11) NOT NULL,\n  `admin_id` int(11) NOT NULL,\n  `field_name` varchar(255) NOT NULL,\n  `old_value` varchar(1000) DEFAULT NULL,\n  `new_value` varchar(1000) DEFAULT NULL,\n  `change_reason` varchar(500) DEFAULT NULL,\n  `changed_at` datetime NOT NULL,\n  PRIMARY KEY (`record_id`),\n  KEY `page_update_records_ibfk_1` (`page_id`),\n  KEY `page_update_records_ibfk_2` (`admin_id`),\n  CONSTRAINT `page_update_records_ibfk_1` FOREIGN KEY (`page_id`) REFERENCES `pages` (`page_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `page_update_records_ibfk_2` FOREIGN KEY (`admin_id`) REFERENCES `admin_users` (`admin_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
