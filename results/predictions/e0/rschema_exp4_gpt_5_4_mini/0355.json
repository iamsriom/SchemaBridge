  "question": "Here is the required database business requirement description for a horse racing betting system: The system includes race management, recording each race's identifier, name, start time, end time, and results. The horse management section records the name of each racehorse. The system also records the bettor's phone and other identity information for easy contact. The betting management section records the amount of each bet and its corresponding race. Race result records are used to track each racehorse's number and ranking in the race, supporting subsequent statistics and analysis. The betting result management helps compare the bettor's selected horse's expected ranking with the actual outcome, thus determining whether the bet is won.",
  "ddl": "-- Schema for database: rschema_0355\nCREATE TABLE `races` (\n  `race_id` int(11) NOT NULL AUTO_INCREMENT,\n  `race_name` varchar(255) NOT NULL,\n  `start_time` datetime NOT NULL,\n  `end_time` datetime DEFAULT NULL,\n  `result_summary` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`race_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `horses` (\n  `horse_id` int(11) NOT NULL AUTO_INCREMENT,\n  `horse_name` varchar(255) NOT NULL,\n  PRIMARY KEY (`horse_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `bettors` (\n  `bettor_id` int(11) NOT NULL AUTO_INCREMENT,\n  `bettor_name` varchar(255) NOT NULL,\n  `phone` varchar(20) NOT NULL,\n  `identity_info` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`bettor_id`),\n  UNIQUE KEY `uk_bettors_phone` (`phone`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `race_results` (\n  `race_result_id` int(11) NOT NULL AUTO_INCREMENT,\n  `race_id` int(11) NOT NULL,\n  `horse_id` int(11) NOT NULL,\n  `horse_number` int(11) NOT NULL,\n  `ranking` int(11) NOT NULL,\n  PRIMARY KEY (`race_result_id`),\n  KEY `race_results_ibfk_1` (`race_id`),\n  KEY `race_results_ibfk_2` (`horse_id`),\n  CONSTRAINT `race_results_ibfk_1` FOREIGN KEY (`race_id`) REFERENCES `races` (`race_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `race_results_ibfk_2` FOREIGN KEY (`horse_id`) REFERENCES `horses` (`horse_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `bets` (\n  `bet_id` int(11) NOT NULL AUTO_INCREMENT,\n  `bettor_id` int(11) NOT NULL,\n  `race_id` int(11) NOT NULL,\n  `horse_id` int(11) NOT NULL,\n  `bet_amount` decimal(10,2) NOT NULL,\n  `expected_ranking` int(11) NOT NULL,\n  `bet_time` datetime NOT NULL,\n  PRIMARY KEY (`bet_id`),\n  KEY `bets_ibfk_1` (`bettor_id`),\n  KEY `bets_ibfk_2` (`race_id`),\n  KEY `bets_ibfk_3` (`horse_id`),\n  CONSTRAINT `bets_ibfk_1` FOREIGN KEY (`bettor_id`) REFERENCES `bettors` (`bettor_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `bets_ibfk_2` FOREIGN KEY (`race_id`) REFERENCES `races` (`race_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `bets_ibfk_3` FOREIGN KEY (`horse_id`) REFERENCES `horses` (`horse_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `bet_results` (\n  `bet_result_id` int(11) NOT NULL AUTO_INCREMENT,\n  `bet_id` int(11) NOT NULL,\n  `actual_ranking` int(11) DEFAULT NULL,\n  `is_won` tinyint(1) NOT NULL DEFAULT '0',\n  `comparison_note` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`bet_result_id`),\n  UNIQUE KEY `uk_bet_results_bet_id` (`bet_id`),\n  CONSTRAINT `bet_results_ibfk_1` FOREIGN KEY (`bet_id`) REFERENCES `bets` (`bet_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
