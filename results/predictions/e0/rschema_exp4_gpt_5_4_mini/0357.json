  "database": "rschema_0357",
  "question": "The database requirement description for an automobile rental company management system is as follows: The system manages multiple rental locations, each with name, address, telephone, and business hours information. Each location offers different categories of vehicles, including category name and rental prices during weekdays and weekends. Additionally, each location will have multiple specific vehicles, the information for these vehicles includes license plate number, brand, model, photo, and the associated location. Users can register accounts through the system, providing email, name, address, telephone, postal code, city, and can link credit card information for convenient rental payments. Users can reserve vehicles on specified dates, requiring the user's email, license plate number, reservation date, and return date during reservation. The system also manages news and featured content, posting news related to rental services and promotional activities. Through these functionalities, users can inquire about vehicles, locations, and prices, and the system also collects data on vehicle rentals to support the company's operational decisions.",
  "ddl": "-- Schema for database: rschema_0357\nCREATE TABLE `rental_location` (\n  `location_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `address` varchar(255) NOT NULL,\n  `telephone` varchar(50) NOT NULL,\n  `business_hours` varchar(255) NOT NULL,\n  PRIMARY KEY (`location_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `vehicle_category` (\n  `category_id` int(11) NOT NULL AUTO_INCREMENT,\n  `location_id` int(11) NOT NULL,\n  `category_name` varchar(255) NOT NULL,\n  `weekday_rental_price` decimal(10,2) NOT NULL,\n  `weekend_rental_price` decimal(10,2) NOT NULL,\n  PRIMARY KEY (`category_id`),\n  KEY `vehicle_category_ibfk_1` (`location_id`),\n  CONSTRAINT `vehicle_category_ibfk_1` FOREIGN KEY (`location_id`) REFERENCES `rental_location` (`location_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `vehicle` (\n  `vehicle_id` int(11) NOT NULL AUTO_INCREMENT,\n  `location_id` int(11) NOT NULL,\n  `category_id` int(11) DEFAULT NULL,\n  `license_plate_number` varchar(20) NOT NULL,\n  `brand` varchar(100) NOT NULL,\n  `model` varchar(100) NOT NULL,\n  `photo` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`vehicle_id`),\n  UNIQUE KEY `license_plate_number` (`license_plate_number`),\n  KEY `vehicle_ibfk_1` (`location_id`),\n  KEY `vehicle_ibfk_2` (`category_id`),\n  CONSTRAINT `vehicle_ibfk_1` FOREIGN KEY (`location_id`) REFERENCES `rental_location` (`location_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `vehicle_ibfk_2` FOREIGN KEY (`category_id`) REFERENCES `vehicle_category` (`category_id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `user_account` (\n  `user_id` int(11) NOT NULL AUTO_INCREMENT,\n  `email` varchar(255) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `address` varchar(255) NOT NULL,\n  `telephone` varchar(50) NOT NULL,\n  `postal_code` varchar(20) NOT NULL,\n  `city` varchar(100) NOT NULL,\n  PRIMARY KEY (`user_id`),\n  UNIQUE KEY `email` (`email`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `credit_card` (\n  `credit_card_id` int(11) NOT NULL AUTO_INCREMENT,\n  `user_id` int(11) NOT NULL,\n  `card_number` varchar(25) NOT NULL,\n  `cardholder_name` varchar(255) NOT NULL,\n  `expiry_month` char(2) NOT NULL,\n  `expiry_year` char(4) NOT NULL,\n  `billing_address` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`credit_card_id`),\n  KEY `credit_card_ibfk_1` (`user_id`),\n  CONSTRAINT `credit_card_ibfk_1` FOREIGN KEY (`user_id`) REFERENCES `user_account` (`user_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `reservation` (\n  `reservation_id` int(11) NOT NULL AUTO_INCREMENT,\n  `user_id` int(11) NOT NULL,\n  `vehicle_id` int(11) NOT NULL,\n  `reservation_date` datetime NOT NULL,\n  `return_date` datetime NOT NULL,\n  PRIMARY KEY (`reservation_id`),\n  KEY `reservation_ibfk_1` (`user_id`),\n  KEY `reservation_ibfk_2` (`vehicle_id`),\n  CONSTRAINT `reservation_ibfk_1` FOREIGN KEY (`user_id`) REFERENCES `user_account` (`user_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `reservation_ibfk_2` FOREIGN KEY (`vehicle_id`) REFERENCES `vehicle` (`vehicle_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `news_post` (\n  `news_id` int(11) NOT NULL AUTO_INCREMENT,\n  `title` varchar(255) NOT NULL,\n  `content` text NOT NULL,\n  `post_type` varchar(50) NOT NULL,\n  `published_at` datetime NOT NULL,\n  PRIMARY KEY (`news_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
