  "database": "rschema_0363",
  "question": "This is a library management system. For book management, the system maintains basic book information, including ISBN, title, author, publisher, publication date, price, number of copies available, number of copies in circulation, library location, and shelf number. For reader management, the system maintains reader information including reader ID, library card number, name, gender, age, phone, email, address, reader type, maximum borrowing limit, and loan period. For book borrowing management, the system records borrowing details including reader ID, ISBN, borrowing time, due date, actual return date, and borrowing status. For book reservation management, the system supports readers to reserve books, recording reader ID, ISBN, reservation time, reservation expiration time, and reservation status.",
  "ddl": "-- Schema for database: rschema_0363\nCREATE TABLE `books` (\n  `isbn` varchar(20) NOT NULL,\n  `title` varchar(255) NOT NULL,\n  `author` varchar(255) NOT NULL,\n  `publisher` varchar(255) DEFAULT NULL,\n  `publication_date` date DEFAULT NULL,\n  `price` decimal(10,2) DEFAULT NULL,\n  `copies_available` int(11) NOT NULL DEFAULT 0,\n  `copies_in_circulation` int(11) NOT NULL DEFAULT 0,\n  `library_location` varchar(255) DEFAULT NULL,\n  `shelf_number` varchar(50) DEFAULT NULL,\n  PRIMARY KEY (`isbn`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `readers` (\n  `reader_id` int(11) NOT NULL AUTO_INCREMENT,\n  `library_card_number` varchar(50) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `gender` varchar(10) DEFAULT NULL,\n  `age` int(11) DEFAULT NULL,\n  `phone` varchar(20) DEFAULT NULL,\n  `email` varchar(255) DEFAULT NULL,\n  `address` varchar(255) DEFAULT NULL,\n  `reader_type` varchar(50) DEFAULT NULL,\n  `max_borrow_limit` int(11) DEFAULT NULL,\n  `loan_period` int(11) DEFAULT NULL,\n  PRIMARY KEY (`reader_id`),\n  UNIQUE KEY `library_card_number` (`library_card_number`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `borrowings` (\n  `borrowing_id` int(11) NOT NULL AUTO_INCREMENT,\n  `reader_id` int(11) NOT NULL,\n  `isbn` varchar(20) NOT NULL,\n  `borrowing_time` datetime NOT NULL,\n  `due_date` datetime NOT NULL,\n  `actual_return_date` datetime DEFAULT NULL,\n  `borrowing_status` varchar(50) NOT NULL,\n  PRIMARY KEY (`borrowing_id`),\n  KEY `reader_id` (`reader_id`),\n  KEY `isbn` (`isbn`),\n  CONSTRAINT `borrowings_ibfk_1` FOREIGN KEY (`reader_id`) REFERENCES `readers` (`reader_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `borrowings_ibfk_2` FOREIGN KEY (`isbn`) REFERENCES `books` (`isbn`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `reservations` (\n  `reservation_id` int(11) NOT NULL AUTO_INCREMENT,\n  `reader_id` int(11) NOT NULL,\n  `isbn` varchar(20) NOT NULL,\n  `reservation_time` datetime NOT NULL,\n  `reservation_expiration_time` datetime NOT NULL,\n  `reservation_status` varchar(50) NOT NULL,\n  PRIMARY KEY (`reservation_id`),\n  KEY `reader_id` (`reader_id`),\n  KEY `isbn` (`isbn`),\n  CONSTRAINT `reservations_ibfk_1` FOREIGN KEY (`reader_id`) REFERENCES `readers` (`reader_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `reservations_ibfk_2` FOREIGN KEY (`isbn`) REFERENCES `books` (`isbn`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
