  "question": "Business Requirements Description:\nThis system is designed for managing user information, appointment records for medical exams (check-ups), medical institution information, institution operating hours, and operator account information. The core features include:\n1.User Management: Stores basic user information, including name, email, phone number, birth date, gender, password, address, and insurance status.\n2.Appointment Management: Users can make appointments for medical checks. Appointment records include examination description, examination document, the medical institution where the appointment is made, payment amount, creation date, appointment date, and status.\n3.Medical Institution Management: Stores basic information about medical institutions, including name, address, opening time, and closing time.\n4.Operator Management: Stores account information for operators, including username and password. Each operator belongs to a specific medical institution and can manage that institution’s appointments and user information.",
  "ddl": "-- Schema for database: rschema_0367\nCREATE TABLE `medical_institutions` (\n  `institution_id` int(11) NOT NULL AUTO_INCREMENT,\n  `institution_name` varchar(255) NOT NULL,\n  `address` varchar(255) NOT NULL,\n  `opening_time` time NOT NULL,\n  `closing_time` time NOT NULL,\n  PRIMARY KEY (`institution_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `users` (\n  `user_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `email` varchar(255) NOT NULL,\n  `phone_number` varchar(20) NOT NULL,\n  `birth_date` date NOT NULL,\n  `gender` varchar(20) NOT NULL,\n  `password` varchar(255) NOT NULL,\n  `address` varchar(255) NOT NULL,\n  `insurance_status` varchar(50) NOT NULL,\n  PRIMARY KEY (`user_id`),\n  UNIQUE KEY `email` (`email`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `operators` (\n  `operator_id` int(11) NOT NULL AUTO_INCREMENT,\n  `institution_id` int(11) NOT NULL,\n  `username` varchar(255) NOT NULL,\n  `password` varchar(255) NOT NULL,\n  PRIMARY KEY (`operator_id`),\n  UNIQUE KEY `username` (`username`),\n  KEY `institution_id` (`institution_id`),\n  CONSTRAINT `operators_ibfk_1` FOREIGN KEY (`institution_id`) REFERENCES `medical_institutions` (`institution_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `appointments` (\n  `appointment_id` int(11) NOT NULL AUTO_INCREMENT,\n  `user_id` int(11) NOT NULL,\n  `institution_id` int(11) NOT NULL,\n  `examination_description` text NOT NULL,\n  `examination_document` varchar(255) DEFAULT NULL,\n  `payment_amount` decimal(10,2) NOT NULL,\n  `created_at` datetime NOT NULL,\n  `appointment_date` datetime NOT NULL,\n  `status` varchar(50) NOT NULL,\n  PRIMARY KEY (`appointment_id`),\n  KEY `user_id` (`user_id`),\n  KEY `institution_id` (`institution_id`),\n  CONSTRAINT `appointments_ibfk_1` FOREIGN KEY (`user_id`) REFERENCES `users` (`user_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `appointments_ibfk_2` FOREIGN KEY (`institution_id`) REFERENCES `medical_institutions` (`institution_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
