  "question": "Database name: School\n\nThis database is a school management system used to record student, teacher and subject information, as well as manage and record students' test scores and subject scores.\n\nMain functions\n\n1. Student management:\nRecord students' personal information, including name, age, address and phone number.\nManage the relationship between students and subjects, and record students' scores in various subjects.\nRecord the exams students take and their scores.\n\n2. Subject management:\nRecord the name and number of class hours of each subject.\nManage the relationship between subjects and students and teachers.\n\n3. Exam management:\nRecord the date of the exam and the corresponding subject.\nManage students' exam scores.\n\n4. Teacher management:\nRecord teachers' personal information, including name, address and phone number.\nManage the subjects taught by teachers.\nRecord the guidance relationship between teachers and students.\n\n5. Grade management:\nRecord students' subject scores and test scores.\nProvide grade query and statistical functions, such as querying all grades of a student, the average grade of all students in a subject, etc.\n\n6. Relationship management:\nManage the relationship between students and subjects, students and teachers, and teachers and subjects.\nFor example, you can query which teachers teach which students in which subjects.",
  "ddl": "-- Schema for database: School\nCREATE TABLE `students` (\n  `student_id` int(11) NOT NULL AUTO_INCREMENT,\n  `student_name` varchar(255) NOT NULL,\n  `age` int(11) DEFAULT NULL,\n  `address` varchar(255) DEFAULT NULL,\n  `phone_number` varchar(20) DEFAULT NULL,\n  PRIMARY KEY (`student_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `teachers` (\n  `teacher_id` int(11) NOT NULL AUTO_INCREMENT,\n  `teacher_name` varchar(255) NOT NULL,\n  `address` varchar(255) DEFAULT NULL,\n  `phone_number` varchar(20) DEFAULT NULL,\n  PRIMARY KEY (`teacher_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `subjects` (\n  `subject_id` int(11) NOT NULL AUTO_INCREMENT,\n  `subject_name` varchar(255) NOT NULL,\n  `class_hours` int(11) NOT NULL,\n  PRIMARY KEY (`subject_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `exams` (\n  `exam_id` int(11) NOT NULL AUTO_INCREMENT,\n  `subject_id` int(11) NOT NULL,\n  `exam_date` datetime NOT NULL,\n  PRIMARY KEY (`exam_id`),\n  KEY `subject_id` (`subject_id`),\n  CONSTRAINT `exams_ibfk_1` FOREIGN KEY (`subject_id`) REFERENCES `subjects` (`subject_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `student_subjects` (\n  `student_subject_id` int(11) NOT NULL AUTO_INCREMENT,\n  `student_id` int(11) NOT NULL,\n  `subject_id` int(11) NOT NULL,\n  `subject_score` decimal(5,2) DEFAULT NULL,\n  PRIMARY KEY (`student_subject_id`),\n  UNIQUE KEY `uk_student_subject` (`student_id`,`subject_id`),\n  KEY `subject_id` (`subject_id`),\n  CONSTRAINT `student_subjects_ibfk_1` FOREIGN KEY (`student_id`) REFERENCES `students` (`student_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `student_subjects_ibfk_2` FOREIGN KEY (`subject_id`) REFERENCES `subjects` (`subject_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `student_exams` (\n  `student_exam_id` int(11) NOT NULL AUTO_INCREMENT,\n  `student_id` int(11) NOT NULL,\n  `exam_id` int(11) NOT NULL,\n  `exam_score` decimal(5,2) DEFAULT NULL,\n  PRIMARY KEY (`student_exam_id`),\n  UNIQUE KEY `uk_student_exam` (`student_id`,`exam_id`),\n  KEY `exam_id` (`exam_id`),\n  CONSTRAINT `student_exams_ibfk_1` FOREIGN KEY (`student_id`) REFERENCES `students` (`student_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `student_exams_ibfk_2` FOREIGN KEY (`exam_id`) REFERENCES `exams` (`exam_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `teacher_subjects` (\n  `teacher_subject_id` int(11) NOT NULL AUTO_INCREMENT,\n  `teacher_id` int(11) NOT NULL,\n  `subject_id` int(11) NOT NULL,\n  PRIMARY KEY (`teacher_subject_id`),\n  UNIQUE KEY `uk_teacher_subject` (`teacher_id`,`subject_id`),\n  KEY `subject_id` (`subject_id`),\n  CONSTRAINT `teacher_subjects_ibfk_1` FOREIGN KEY (`teacher_id`) REFERENCES `teachers` (`teacher_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `teacher_subjects_ibfk_2` FOREIGN KEY (`subject_id`) REFERENCES `subjects` (`subject_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `teacher_students` (\n  `teacher_student_id` int(11) NOT NULL AUTO_INCREMENT,\n  `teacher_id` int(11) NOT NULL,\n  `student_id` int(11) NOT NULL,\n  PRIMARY KEY (`teacher_student_id`),\n  UNIQUE KEY `uk_teacher_student` (`teacher_id`,`student_id`),\n  KEY `student_id` (`student_id`),\n  CONSTRAINT `teacher_students_ibfk_1` FOREIGN KEY (`teacher_id`) REFERENCES `teachers` (`teacher_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `teacher_students_ibfk_2` FOREIGN KEY (`student_id`) REFERENCES `students` (`student_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
