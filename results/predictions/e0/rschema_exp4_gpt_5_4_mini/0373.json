  "question": "Research Fund Management System Database Requirement Description: This database is a budget and fund management system in the field of laboratory services and applied sciences, designed to support the management of complex budgets and fund allocations. The system primarily records financial information related to each project or activity, including budget levels, sources of funds, amounts, objectives, and allocation ratios. By detailing every project, activity, organization, and associated funding, it ensures transparency and compliance in the use of funds. The system supports multi-level coding management to meet different levels and details of requirements and is capable of tracking the change history of projects. Through detailed management of projects, such as project codes, activity codes, objectives, and their names, the system efficiently manages fund distribution, change recording, and department management. The system also provides powerful querying capabilities, allowing management personnel to perform data analysis and report generation based on various conditions, further supporting effective project and fund management.",
  "ddl": "-- Schema for database: rschema_0373\nCREATE TABLE `department` (\n  `department_id` int(11) NOT NULL AUTO_INCREMENT,\n  `department_code` varchar(50) NOT NULL,\n  `department_name` varchar(255) NOT NULL,\n  `parent_department_id` int(11) DEFAULT NULL,\n  `created_at` datetime NOT NULL,\n  PRIMARY KEY (`department_id`),\n  UNIQUE KEY `uk_department_code` (`department_code`),\n  KEY `department_ibfk_1` (`parent_department_id`),\n  CONSTRAINT `department_ibfk_1` FOREIGN KEY (`parent_department_id`) REFERENCES `department` (`department_id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `fund_source` (\n  `fund_source_id` int(11) NOT NULL AUTO_INCREMENT,\n  `source_code` varchar(50) NOT NULL,\n  `source_name` varchar(255) NOT NULL,\n  `source_level` int(11) NOT NULL,\n  `description` varchar(500) DEFAULT NULL,\n  PRIMARY KEY (`fund_source_id`),\n  UNIQUE KEY `uk_fund_source_code` (`source_code`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `project` (\n  `project_id` int(11) NOT NULL AUTO_INCREMENT,\n  `project_code` varchar(50) NOT NULL,\n  `project_name` varchar(255) NOT NULL,\n  `objective` varchar(500) DEFAULT NULL,\n  `responsible_department_id` int(11) NOT NULL,\n  `start_date` date DEFAULT NULL,\n  `end_date` date DEFAULT NULL,\n  `status` varchar(50) NOT NULL,\n  `created_at` datetime NOT NULL,\n  PRIMARY KEY (`project_id`),\n  UNIQUE KEY `uk_project_code` (`project_code`),\n  KEY `project_ibfk_1` (`responsible_department_id`),\n  CONSTRAINT `project_ibfk_1` FOREIGN KEY (`responsible_department_id`) REFERENCES `department` (`department_id`) ON DELETE RESTRICT ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `activity` (\n  `activity_id` int(11) NOT NULL AUTO_INCREMENT,\n  `project_id` int(11) NOT NULL,\n  `activity_code` varchar(50) NOT NULL,\n  `activity_name` varchar(255) NOT NULL,\n  `objective` varchar(500) DEFAULT NULL,\n  `budget_level` int(11) NOT NULL,\n  `created_at` datetime NOT NULL,\n  PRIMARY KEY (`activity_id`),\n  UNIQUE KEY `uk_activity_code` (`activity_code`),\n  KEY `activity_ibfk_1` (`project_id`),\n  CONSTRAINT `activity_ibfk_1` FOREIGN KEY (`project_id`) REFERENCES `project` (`project_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `budget_allocation` (\n  `allocation_id` int(11) NOT NULL AUTO_INCREMENT,\n  `activity_id` int(11) NOT NULL,\n  `fund_source_id` int(11) NOT NULL,\n  `allocation_ratio` decimal(10,4) NOT NULL,\n  `allocated_amount` decimal(18,2) NOT NULL,\n  `budget_level` int(11) NOT NULL,\n  `remarks` varchar(500) DEFAULT NULL,\n  `created_at` datetime NOT NULL,\n  PRIMARY KEY (`allocation_id`),\n  KEY `budget_allocation_ibfk_1` (`activity_id`),\n  KEY `budget_allocation_ibfk_2` (`fund_source_id`),\n  CONSTRAINT `budget_allocation_ibfk_1` FOREIGN KEY (`activity_id`) REFERENCES `activity` (`activity_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `budget_allocation_ibfk_2` FOREIGN KEY (`fund_source_id`) REFERENCES `fund_source` (`fund_source_id`) ON DELETE RESTRICT ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `project_change_history` (\n  `change_id` int(11) NOT NULL AUTO_INCREMENT,\n  `project_id` int(11) NOT NULL,\n  `change_type` varchar(50) NOT NULL,\n  `change_summary` varchar(1000) NOT NULL,\n  `changed_by` varchar(255) NOT NULL,\n  `changed_at` datetime NOT NULL,\n  PRIMARY KEY (`change_id`),\n  KEY `project_change_history_ibfk_1` (`project_id`),\n  CONSTRAINT `project_change_history_ibfk_1` FOREIGN KEY (`project_id`) REFERENCES `project` (`project_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
