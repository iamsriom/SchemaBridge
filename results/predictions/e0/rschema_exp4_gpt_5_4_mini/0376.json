  "question": "Business Requirements Description:\nThis system is designed to manage customer information, repair tasks, orders, parts, suppliers, and technicians for an auto repair service. The core functionalities include:\nThe system stores basic customer information, including a unique customer ID, name, and phone number.\nThe system maintains basic information for each technician, including a unique technician ID, name, and contact address.\nThe system stores information about different car models, each with a unique model ID and name.\nEach repair task is recorded with a unique task ID, related car model ID, task status (e.g., Pending, In Progress, Completed), customer ID, technician ID, task creation date, and completion date.\nEach repair task corresponds to an order, and the system records the order ID, related task ID, order creation date, and delivery status.\nThe system maintains basic information about suppliers, including a unique supplier ID and name.\nThe system tracks parts by their unique part ID, serial number, description, price, supplier ID, and inventory quantity.\nThe system manages the relationship between parts and orders, tracking the quantity of parts required for each order and the parts used in each repair task.",
  "ddl": "-- Schema for database: rschema_0376\nCREATE TABLE `customers` (\n  `customer_id` int(11) NOT NULL AUTO_INCREMENT,\n  `customer_name` varchar(255) NOT NULL,\n  `phone_number` varchar(50) NOT NULL,\n  PRIMARY KEY (`customer_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `technicians` (\n  `technician_id` int(11) NOT NULL AUTO_INCREMENT,\n  `technician_name` varchar(255) NOT NULL,\n  `contact_address` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`technician_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `car_models` (\n  `model_id` int(11) NOT NULL AUTO_INCREMENT,\n  `model_name` varchar(255) NOT NULL,\n  PRIMARY KEY (`model_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `suppliers` (\n  `supplier_id` int(11) NOT NULL AUTO_INCREMENT,\n  `supplier_name` varchar(255) NOT NULL,\n  PRIMARY KEY (`supplier_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `parts` (\n  `part_id` int(11) NOT NULL AUTO_INCREMENT,\n  `serial_number` varchar(100) NOT NULL,\n  `description` varchar(255) DEFAULT NULL,\n  `price` decimal(10,2) NOT NULL,\n  `supplier_id` int(11) NOT NULL,\n  `inventory_quantity` int(11) NOT NULL,\n  PRIMARY KEY (`part_id`),\n  UNIQUE KEY `uk_parts_serial_number` (`serial_number`),\n  KEY `parts_ibfk_1` (`supplier_id`),\n  CONSTRAINT `parts_ibfk_1` FOREIGN KEY (`supplier_id`) REFERENCES `suppliers` (`supplier_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `repair_tasks` (\n  `task_id` int(11) NOT NULL AUTO_INCREMENT,\n  `model_id` int(11) NOT NULL,\n  `task_status` varchar(50) NOT NULL,\n  `customer_id` int(11) NOT NULL,\n  `technician_id` int(11) NOT NULL,\n  `task_creation_date` datetime NOT NULL,\n  `completion_date` datetime DEFAULT NULL,\n  PRIMARY KEY (`task_id`),\n  KEY `repair_tasks_ibfk_1` (`model_id`),\n  KEY `repair_tasks_ibfk_2` (`customer_id`),\n  KEY `repair_tasks_ibfk_3` (`technician_id`),\n  CONSTRAINT `repair_tasks_ibfk_1` FOREIGN KEY (`model_id`) REFERENCES `car_models` (`model_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `repair_tasks_ibfk_2` FOREIGN KEY (`customer_id`) REFERENCES `customers` (`customer_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `repair_tasks_ibfk_3` FOREIGN KEY (`technician_id`) REFERENCES `technicians` (`technician_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `orders` (\n  `order_id` int(11) NOT NULL AUTO_INCREMENT,\n  `task_id` int(11) NOT NULL,\n  `order_creation_date` datetime NOT NULL,\n  `delivery_status` varchar(50) NOT NULL,\n  PRIMARY KEY (`order_id`),\n  UNIQUE KEY `uk_orders_task_id` (`task_id`),\n  CONSTRAINT `orders_ibfk_1` FOREIGN KEY (`task_id`) REFERENCES `repair_tasks` (`task_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `order_parts` (\n  `order_id` int(11) NOT NULL,\n  `part_id` int(11) NOT NULL,\n  `required_quantity` int(11) NOT NULL,\n  PRIMARY KEY (`order_id`,`part_id`),\n  KEY `order_parts_ibfk_2` (`part_id`),\n  CONSTRAINT `order_parts_ibfk_1` FOREIGN KEY (`order_id`) REFERENCES `orders` (`order_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `order_parts_ibfk_2` FOREIGN KEY (`part_id`) REFERENCES `parts` (`part_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `task_parts` (\n  `task_id` int(11) NOT NULL,\n  `part_id` int(11) NOT NULL,\n  `used_quantity` int(11) NOT NULL,\n  PRIMARY KEY (`task_id`,`part_id`),\n  KEY `task_parts_ibfk_2` (`part_id`),\n  CONSTRAINT `task_parts_ibfk_1` FOREIGN KEY (`task_id`) REFERENCES `repair_tasks` (`task_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `task_parts_ibfk_2` FOREIGN KEY (`part_id`) REFERENCES `parts` (`part_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
