  "question": "A blog management system manages blog posts and their related comments. Each post has a unique identifier, title, summary, author, body content, and creation time.\nUsers can create, edit, and delete posts, with user information including User ID, name, and email address.\nThe comment feature allows users to post comments below articles, with comment information including User ID, comment content, and creation time.   \nRecord user activities on posts, including the type of operation (create, edit, and delete posts) and timestamp.",
  "ddl": "-- Schema for database: rschema_0378\nCREATE TABLE `users` (\n  `user_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `email` varchar(255) NOT NULL,\n  PRIMARY KEY (`user_id`),\n  UNIQUE KEY `uk_users_email` (`email`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `posts` (\n  `post_id` int(11) NOT NULL,\n  `title` varchar(255) NOT NULL,\n  `summary` varchar(500) DEFAULT NULL,\n  `author_id` int(11) NOT NULL,\n  `body_content` text NOT NULL,\n  `created_at` datetime NOT NULL,\n  PRIMARY KEY (`post_id`),\n  KEY `posts_ibfk_1` (`author_id`),\n  CONSTRAINT `posts_ibfk_1` FOREIGN KEY (`author_id`) REFERENCES `users` (`user_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `comments` (\n  `comment_id` int(11) NOT NULL,\n  `post_id` int(11) NOT NULL,\n  `user_id` int(11) NOT NULL,\n  `comment_content` text NOT NULL,\n  `created_at` datetime NOT NULL,\n  PRIMARY KEY (`comment_id`),\n  KEY `comments_ibfk_1` (`post_id`),\n  KEY `comments_ibfk_2` (`user_id`),\n  CONSTRAINT `comments_ibfk_1` FOREIGN KEY (`post_id`) REFERENCES `posts` (`post_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `comments_ibfk_2` FOREIGN KEY (`user_id`) REFERENCES `users` (`user_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `post_activities` (\n  `activity_id` int(11) NOT NULL,\n  `post_id` int(11) NOT NULL,\n  `user_id` int(11) NOT NULL,\n  `operation_type` varchar(20) NOT NULL,\n  `activity_timestamp` datetime NOT NULL,\n  PRIMARY KEY (`activity_id`),\n  KEY `post_activities_ibfk_1` (`post_id`),\n  KEY `post_activities_ibfk_2` (`user_id`),\n  CONSTRAINT `post_activities_ibfk_1` FOREIGN KEY (`post_id`) REFERENCES `posts` (`post_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `post_activities_ibfk_2` FOREIGN KEY (`user_id`) REFERENCES `users` (`user_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
