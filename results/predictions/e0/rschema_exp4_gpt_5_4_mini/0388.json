  "database": "rschema_0388",
  "question": "The requirements analysis of a certain enterprise management system is as follows:\n1. Employee management: including employee information, job assignment, performance appraisal, salary number, creation time, update time, etc. An employee can participate in multiple projects.\n2. Supplier management: including supplier information, supplier relationship management, creation time, update time, etc. A supplier can supply multiple projects.\n3. Project management: including project information, project progress management, creation time, update time, etc. A project contains multiple employees and can have multiple suppliers.\n4. Attendance management: including employee number, employee clock-in, attendance record, creation time, update time, etc.\n5. Salary management: including salary payment, salary calculation, creation time, update time, etc.",
  "ddl": "-- Schema for database: rschema_0388\nCREATE TABLE `employee` (\n  `employee_id` int(11) NOT NULL AUTO_INCREMENT,\n  `employee_number` varchar(50) NOT NULL,\n  `employee_name` varchar(100) NOT NULL,\n  `job_assignment` varchar(100) DEFAULT NULL,\n  `performance_appraisal` varchar(255) DEFAULT NULL,\n  `salary_number` varchar(50) DEFAULT NULL,\n  `created_at` datetime NOT NULL,\n  `updated_at` datetime NOT NULL,\n  PRIMARY KEY (`employee_id`),\n  UNIQUE KEY `uk_employee_number` (`employee_number`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `supplier` (\n  `supplier_id` int(11) NOT NULL AUTO_INCREMENT,\n  `supplier_name` varchar(150) NOT NULL,\n  `supplier_relationship_management` varchar(255) DEFAULT NULL,\n  `created_at` datetime NOT NULL,\n  `updated_at` datetime NOT NULL,\n  PRIMARY KEY (`supplier_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `project` (\n  `project_id` int(11) NOT NULL AUTO_INCREMENT,\n  `project_name` varchar(150) NOT NULL,\n  `project_progress_management` varchar(255) DEFAULT NULL,\n  `created_at` datetime NOT NULL,\n  `updated_at` datetime NOT NULL,\n  PRIMARY KEY (`project_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `employee_project` (\n  `employee_project_id` int(11) NOT NULL AUTO_INCREMENT,\n  `employee_id` int(11) NOT NULL,\n  `project_id` int(11) NOT NULL,\n  `created_at` datetime NOT NULL,\n  `updated_at` datetime NOT NULL,\n  PRIMARY KEY (`employee_project_id`),\n  KEY `employee_project_ibfk_1` (`employee_id`),\n  KEY `employee_project_ibfk_2` (`project_id`),\n  CONSTRAINT `employee_project_ibfk_1` FOREIGN KEY (`employee_id`) REFERENCES `employee` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `employee_project_ibfk_2` FOREIGN KEY (`project_id`) REFERENCES `project` (`project_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `project_supplier` (\n  `project_supplier_id` int(11) NOT NULL AUTO_INCREMENT,\n  `project_id` int(11) NOT NULL,\n  `supplier_id` int(11) NOT NULL,\n  `created_at` datetime NOT NULL,\n  `updated_at` datetime NOT NULL,\n  PRIMARY KEY (`project_supplier_id`),\n  KEY `project_supplier_ibfk_1` (`project_id`),\n  KEY `project_supplier_ibfk_2` (`supplier_id`),\n  CONSTRAINT `project_supplier_ibfk_1` FOREIGN KEY (`project_id`) REFERENCES `project` (`project_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `project_supplier_ibfk_2` FOREIGN KEY (`supplier_id`) REFERENCES `supplier` (`supplier_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `attendance` (\n  `attendance_id` int(11) NOT NULL AUTO_INCREMENT,\n  `employee_id` int(11) NOT NULL,\n  `clock_in_time` datetime NOT NULL,\n  `attendance_record` varchar(255) DEFAULT NULL,\n  `created_at` datetime NOT NULL,\n  `updated_at` datetime NOT NULL,\n  PRIMARY KEY (`attendance_id`),\n  KEY `attendance_ibfk_1` (`employee_id`),\n  CONSTRAINT `attendance_ibfk_1` FOREIGN KEY (`employee_id`) REFERENCES `employee` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `salary` (\n  `salary_id` int(11) NOT NULL AUTO_INCREMENT,\n  `employee_id` int(11) NOT NULL,\n  `salary_payment` decimal(10,2) NOT NULL,\n  `salary_calculation` varchar(255) DEFAULT NULL,\n  `created_at` datetime NOT NULL,\n  `updated_at` datetime NOT NULL,\n  PRIMARY KEY (`salary_id`),\n  KEY `salary_ibfk_1` (`employee_id`),\n  CONSTRAINT `salary_ibfk_1` FOREIGN KEY (`employee_id`) REFERENCES `employee` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
