  "database": "rschema_0389",
  "question": "The primary function of a school's academic management system is to manage Student, Teacher, Course information, as well as Student course selection status and grade records. The system includes the following functions:\n\nStudent Management: Record basic information about students, including Student Name, Gender, Age, and Phone.\n\nTeacher Management: Record basic information about teachers, including Teacher Name, Gender, Title, and Phone.\n\nCourse Management: ecord basic information about courses, including Course Credits, Class Hours, Teaching Teacher, Class Location, and Number of Students Enrolled.\n\nStudent Course Selection Management : \nRecord the course selection status of students, including Selection Time and Grades. Each student can select multiple courses, and each course can have multiple students enrolled.",
  "ddl": "-- Schema for database: rschema_0389\nCREATE TABLE `student` (\n  `student_id` int(11) NOT NULL AUTO_INCREMENT,\n  `student_name` varchar(255) NOT NULL,\n  `gender` varchar(10) DEFAULT NULL,\n  `age` int(11) DEFAULT NULL,\n  `phone` varchar(20) DEFAULT NULL,\n  PRIMARY KEY (`student_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `teacher` (\n  `teacher_id` int(11) NOT NULL AUTO_INCREMENT,\n  `teacher_name` varchar(255) NOT NULL,\n  `gender` varchar(10) DEFAULT NULL,\n  `title` varchar(100) DEFAULT NULL,\n  `phone` varchar(20) DEFAULT NULL,\n  PRIMARY KEY (`teacher_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `course` (\n  `course_id` int(11) NOT NULL AUTO_INCREMENT,\n  `course_name` varchar(255) NOT NULL,\n  `credits` decimal(4,1) DEFAULT NULL,\n  `class_hours` int(11) DEFAULT NULL,\n  `teacher_id` int(11) DEFAULT NULL,\n  `class_location` varchar(255) DEFAULT NULL,\n  `enrolled_count` int(11) DEFAULT NULL,\n  PRIMARY KEY (`course_id`),\n  KEY `course_ibfk_1` (`teacher_id`),\n  CONSTRAINT `course_ibfk_1` FOREIGN KEY (`teacher_id`) REFERENCES `teacher` (`teacher_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `student_course_selection` (\n  `selection_id` int(11) NOT NULL AUTO_INCREMENT,\n  `student_id` int(11) NOT NULL,\n  `course_id` int(11) NOT NULL,\n  `selection_time` datetime DEFAULT NULL,\n  `grade` decimal(5,2) DEFAULT NULL,\n  PRIMARY KEY (`selection_id`),\n  KEY `student_course_selection_ibfk_1` (`student_id`),\n  KEY `student_course_selection_ibfk_2` (`course_id`),\n  CONSTRAINT `student_course_selection_ibfk_1` FOREIGN KEY (`student_id`) REFERENCES `student` (`student_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `student_course_selection_ibfk_2` FOREIGN KEY (`course_id`) REFERENCES `course` (`course_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
