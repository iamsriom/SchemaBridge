  "question": "The main functions of a courier tracking system include:\n1. Consumer management: including consumer ID, address information, phone number, etc.\n2. Courier company management: including company name, arrival time, charging price, etc.\n3. Courier tracking: including courier number, recipient ID, recipient name, recipient phone number, etc.\n4. Administrator management: including administrator ID, name, login password, courier user name, etc.\n5. Query function: consumers can query courier information through the system.\n6. Partnership management: the partnership between courier companies and administrators.",
  "ddl": "-- Schema for database: rschema_0390\nCREATE TABLE `consumer` (\n  `consumer_id` int(11) NOT NULL,\n  `address` varchar(255) DEFAULT NULL,\n  `phone_number` varchar(20) DEFAULT NULL,\n  PRIMARY KEY (`consumer_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `courier_company` (\n  `company_id` int(11) NOT NULL,\n  `company_name` varchar(255) NOT NULL,\n  `arrival_time` datetime DEFAULT NULL,\n  `charging_price` decimal(10,2) DEFAULT NULL,\n  PRIMARY KEY (`company_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `administrator` (\n  `administrator_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `login_password` varchar(255) NOT NULL,\n  `courier_user_name` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`administrator_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `courier_tracking` (\n  `courier_number` varchar(50) NOT NULL,\n  `recipient_id` int(11) NOT NULL,\n  `recipient_name` varchar(255) NOT NULL,\n  `recipient_phone_number` varchar(20) DEFAULT NULL,\n  `company_id` int(11) DEFAULT NULL,\n  `consumer_id` int(11) DEFAULT NULL,\n  PRIMARY KEY (`courier_number`),\n  KEY `courier_tracking_ibfk_1` (`recipient_id`),\n  KEY `courier_tracking_ibfk_2` (`company_id`),\n  KEY `courier_tracking_ibfk_3` (`consumer_id`),\n  CONSTRAINT `courier_tracking_ibfk_1` FOREIGN KEY (`recipient_id`) REFERENCES `consumer` (`consumer_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `courier_tracking_ibfk_2` FOREIGN KEY (`company_id`) REFERENCES `courier_company` (`company_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `courier_tracking_ibfk_3` FOREIGN KEY (`consumer_id`) REFERENCES `consumer` (`consumer_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `partnership` (\n  `partnership_id` int(11) NOT NULL,\n  `company_id` int(11) NOT NULL,\n  `administrator_id` int(11) NOT NULL,\n  PRIMARY KEY (`partnership_id`),\n  KEY `partnership_ibfk_1` (`company_id`),\n  KEY `partnership_ibfk_2` (`administrator_id`),\n  CONSTRAINT `partnership_ibfk_1` FOREIGN KEY (`company_id`) REFERENCES `courier_company` (`company_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `partnership_ibfk_2` FOREIGN KEY (`administrator_id`) REFERENCES `administrator` (`administrator_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
