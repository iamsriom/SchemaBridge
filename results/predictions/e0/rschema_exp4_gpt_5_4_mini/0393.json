  "question": "The above picture depicts a hospital management system. The main functions of the system may include:\n\n1. Patient information management: including name, gender, age, contact information, etc.\n2. Diagnosis and treatment management: record the patient's diagnosis and treatment information.\n3. Ward management: manage ward information.\n4. Registration category management: manage different types of registration information.\n5. Drug management: manage drug information.\n6. Drug list management: record the patient's medication information.",
  "ddl": "-- Schema for database: rschema_0393\nCREATE TABLE `patient` (\n  `patient_id` int(11) NOT NULL AUTO_INCREMENT,\n  `patient_name` varchar(100) NOT NULL,\n  `gender` varchar(10) DEFAULT NULL,\n  `age` int(11) DEFAULT NULL,\n  `contact_info` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`patient_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `ward` (\n  `ward_id` int(11) NOT NULL AUTO_INCREMENT,\n  `ward_name` varchar(100) NOT NULL,\n  `ward_type` varchar(100) DEFAULT NULL,\n  `capacity` int(11) DEFAULT NULL,\n  `description` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`ward_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `registration_category` (\n  `category_id` int(11) NOT NULL AUTO_INCREMENT,\n  `category_name` varchar(100) NOT NULL,\n  `registration_fee` decimal(10,2) DEFAULT NULL,\n  `description` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`category_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `drug` (\n  `drug_id` int(11) NOT NULL AUTO_INCREMENT,\n  `drug_name` varchar(100) NOT NULL,\n  `drug_type` varchar(100) DEFAULT NULL,\n  `specification` varchar(100) DEFAULT NULL,\n  `unit_price` decimal(10,2) DEFAULT NULL,\n  `stock_quantity` int(11) DEFAULT NULL,\n  PRIMARY KEY (`drug_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `diagnosis_treatment` (\n  `diagnosis_id` int(11) NOT NULL AUTO_INCREMENT,\n  `patient_id` int(11) NOT NULL,\n  `ward_id` int(11) DEFAULT NULL,\n  `category_id` int(11) DEFAULT NULL,\n  `diagnosis_time` datetime NOT NULL,\n  `diagnosis_result` varchar(255) DEFAULT NULL,\n  `treatment_plan` varchar(255) DEFAULT NULL,\n  `doctor_name` varchar(100) DEFAULT NULL,\n  PRIMARY KEY (`diagnosis_id`),\n  KEY `patient_id` (`patient_id`),\n  KEY `ward_id` (`ward_id`),\n  KEY `category_id` (`category_id`),\n  CONSTRAINT `diagnosis_treatment_ibfk_1` FOREIGN KEY (`patient_id`) REFERENCES `patient` (`patient_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `diagnosis_treatment_ibfk_2` FOREIGN KEY (`ward_id`) REFERENCES `ward` (`ward_id`) ON DELETE SET NULL ON UPDATE CASCADE,\n  CONSTRAINT `diagnosis_treatment_ibfk_3` FOREIGN KEY (`category_id`) REFERENCES `registration_category` (`category_id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `drug_list` (\n  `drug_list_id` int(11) NOT NULL AUTO_INCREMENT,\n  `patient_id` int(11) NOT NULL,\n  `drug_id` int(11) NOT NULL,\n  `diagnosis_id` int(11) DEFAULT NULL,\n  `dosage` varchar(100) DEFAULT NULL,\n  `frequency` varchar(100) DEFAULT NULL,\n  `quantity` int(11) DEFAULT NULL,\n  `prescribed_at` datetime DEFAULT NULL,\n  PRIMARY KEY (`drug_list_id`),\n  KEY `patient_id` (`patient_id`),\n  KEY `drug_id` (`drug_id`),\n  KEY `diagnosis_id` (`diagnosis_id`),\n  CONSTRAINT `drug_list_ibfk_1` FOREIGN KEY (`patient_id`) REFERENCES `patient` (`patient_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `drug_list_ibfk_2` FOREIGN KEY (`drug_id`) REFERENCES `drug` (`drug_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `drug_list_ibfk_3` FOREIGN KEY (`diagnosis_id`) REFERENCES `diagnosis_treatment` (`diagnosis_id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
