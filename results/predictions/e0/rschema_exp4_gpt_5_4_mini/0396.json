  "question": "The main functions of a certain tourism information management system include:\n1. User management: including the management of user names, passwords, avatars, nicknames and other information. Users can write guides.\n2. Guide management: including the management of guide titles, categories, tags, content and other information.\n3. Hotel management: including the management of hotel names, introductions, pictures, locations and other information.\n4. Hotel management: including the management of hotel names, introductions, pictures, locations and other information.\n5. Attraction management: including the management of attraction names, introductions, pictures, addresses, opening hours, tips, days and other information.\n6. Route management: including the management of route names, content, tags, introductions and other information.",
  "ddl": "-- Schema for database: rschema_0396\nCREATE TABLE `users` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `username` varchar(255) NOT NULL,\n  `password` varchar(255) NOT NULL,\n  `avatar` varchar(255) DEFAULT NULL,\n  `nickname` varchar(255) DEFAULT NULL,\n  `created_at` datetime DEFAULT NULL,\n  `updated_at` datetime DEFAULT NULL,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uk_users_username` (`username`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `guides` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `user_id` int(11) NOT NULL,\n  `title` varchar(255) NOT NULL,\n  `category` varchar(255) DEFAULT NULL,\n  `tags` varchar(255) DEFAULT NULL,\n  `content` text DEFAULT NULL,\n  `created_at` datetime DEFAULT NULL,\n  `updated_at` datetime DEFAULT NULL,\n  PRIMARY KEY (`id`),\n  KEY `guides_ibfk_1` (`user_id`),\n  CONSTRAINT `guides_ibfk_1` FOREIGN KEY (`user_id`) REFERENCES `users` (`id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `hotels` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `introduction` text DEFAULT NULL,\n  `pictures` text DEFAULT NULL,\n  `location` varchar(255) DEFAULT NULL,\n  `created_at` datetime DEFAULT NULL,\n  `updated_at` datetime DEFAULT NULL,\n  PRIMARY KEY (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `attractions` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `introduction` text DEFAULT NULL,\n  `pictures` text DEFAULT NULL,\n  `address` varchar(255) DEFAULT NULL,\n  `opening_hours` varchar(255) DEFAULT NULL,\n  `tips` varchar(255) DEFAULT NULL,\n  `days` varchar(255) DEFAULT NULL,\n  `created_at` datetime DEFAULT NULL,\n  `updated_at` datetime DEFAULT NULL,\n  PRIMARY KEY (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `routes` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `content` text DEFAULT NULL,\n  `tags` varchar(255) DEFAULT NULL,\n  `introduction` text DEFAULT NULL,\n  `created_at` datetime DEFAULT NULL,\n  `updated_at` datetime DEFAULT NULL,\n  PRIMARY KEY (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
