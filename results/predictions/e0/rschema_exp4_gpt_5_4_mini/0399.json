  "question": "Business Requirement Description:\nThe following describes a programming learning and project management system. The main functionalities of the system may include:\n1.User Management: Users can register, log in, and modify personal information. Each user has a User ID, Username, Password, Email, Registration Time, and Personal Information.\n2.Code Management: Users can upload, edit, and view code. The code includes Code ID, Code Content, Upload Time, and Problem ID.\n3.Problem Management: The system provides programming problems, including Problem ID, Problem Name, Problem Description, Difficulty Level, and Creation Time. Users can view and submit answers.\n4.Project Management: Each project includes Project ID, Project Name, Project Description, and Creation Time. Users can create, edit, and view projects.\n5.Sign-In Functionality: Records the sign-in status of each user, including Sign-In ID, User ID, Sign-In Time, and Sign-In Date. Users can sign in daily, and the system records the sign-in information.\nThere is a many-to-many relationship between Users and Codes, Users and Problems, and Users and Projects. The User table has a one-to-many relationship with the Sign-In table.",
  "ddl": "-- Schema for database: rschema_0399\nCREATE TABLE `users` (\n  `user_id` int(11) NOT NULL AUTO_INCREMENT,\n  `username` varchar(255) NOT NULL,\n  `password` varchar(255) NOT NULL,\n  `email` varchar(255) NOT NULL,\n  `registration_time` datetime NOT NULL,\n  `personal_information` text DEFAULT NULL,\n  PRIMARY KEY (`user_id`),\n  UNIQUE KEY `uk_users_username` (`username`),\n  UNIQUE KEY `uk_users_email` (`email`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `problems` (\n  `problem_id` int(11) NOT NULL AUTO_INCREMENT,\n  `problem_name` varchar(255) NOT NULL,\n  `problem_description` text NOT NULL,\n  `difficulty_level` varchar(50) NOT NULL,\n  `creation_time` datetime NOT NULL,\n  PRIMARY KEY (`problem_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `projects` (\n  `project_id` int(11) NOT NULL AUTO_INCREMENT,\n  `project_name` varchar(255) NOT NULL,\n  `project_description` text NOT NULL,\n  `creation_time` datetime NOT NULL,\n  PRIMARY KEY (`project_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `codes` (\n  `code_id` int(11) NOT NULL AUTO_INCREMENT,\n  `code_content` longtext NOT NULL,\n  `upload_time` datetime NOT NULL,\n  `problem_id` int(11) NOT NULL,\n  PRIMARY KEY (`code_id`),\n  KEY `idx_codes_problem_id` (`problem_id`),\n  CONSTRAINT `codes_ibfk_1` FOREIGN KEY (`problem_id`) REFERENCES `problems` (`problem_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `sign_ins` (\n  `sign_in_id` int(11) NOT NULL AUTO_INCREMENT,\n  `user_id` int(11) NOT NULL,\n  `sign_in_time` datetime NOT NULL,\n  `sign_in_date` date NOT NULL,\n  PRIMARY KEY (`sign_in_id`),\n  KEY `idx_sign_ins_user_id` (`user_id`),\n  CONSTRAINT `sign_ins_ibfk_1` FOREIGN KEY (`user_id`) REFERENCES `users` (`user_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `user_codes` (\n  `user_id` int(11) NOT NULL,\n  `code_id` int(11) NOT NULL,\n  PRIMARY KEY (`user_id`,`code_id`),\n  KEY `idx_user_codes_code_id` (`code_id`),\n  CONSTRAINT `user_codes_ibfk_1` FOREIGN KEY (`user_id`) REFERENCES `users` (`user_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `user_codes_ibfk_2` FOREIGN KEY (`code_id`) REFERENCES `codes` (`code_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `user_problems` (\n  `user_id` int(11) NOT NULL,\n  `problem_id` int(11) NOT NULL,\n  PRIMARY KEY (`user_id`,`problem_id`),\n  KEY `idx_user_problems_problem_id` (`problem_id`),\n  CONSTRAINT `user_problems_ibfk_1` FOREIGN KEY (`user_id`) REFERENCES `users` (`user_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `user_problems_ibfk_2` FOREIGN KEY (`problem_id`) REFERENCES `problems` (`problem_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `user_projects` (\n  `user_id` int(11) NOT NULL,\n  `project_id` int(11) NOT NULL,\n  PRIMARY KEY (`user_id`,`project_id`),\n  KEY `idx_user_projects_project_id` (`project_id`),\n  CONSTRAINT `user_projects_ibfk_1` FOREIGN KEY (`user_id`) REFERENCES `users` (`user_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `user_projects_ibfk_2` FOREIGN KEY (`project_id`) REFERENCES `projects` (`project_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
