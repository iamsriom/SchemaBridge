  "question": "The school's student and teacher information management system database requirements are described below:\n\nThe student and teacher information management system includes student management, teacher management, class management, and department management modules. The system records basic student information, including Student ID, Name, Gender, Grade, Department, Home Address, Date of Birth, and Enrollment Time; class information includes Class ID, Class Name, Grade, Major, and Head Teacher; department information includes Department ID, Department Name, Department Size, and Subordinate Majors. Each class can correspond to multiple students, while each department manages multiple classes and majors to ensure clear internal structure and efficient management within the department. Teacher management includes personal information such as Teacher ID, Name, Gender, Grade, Department, Home Address, Date of Birth, and Entry Time.",
  "ddl": "-- Schema for database: rschema_0401\nCREATE TABLE `department` (\n  `department_id` int(11) NOT NULL,\n  `department_name` varchar(255) NOT NULL,\n  `department_size` int(11) DEFAULT NULL,\n  `subordinate_majors` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`department_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `teacher` (\n  `teacher_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `gender` varchar(20) DEFAULT NULL,\n  `grade` varchar(50) DEFAULT NULL,\n  `department_id` int(11) DEFAULT NULL,\n  `home_address` varchar(255) DEFAULT NULL,\n  `date_of_birth` date DEFAULT NULL,\n  `entry_time` datetime DEFAULT NULL,\n  PRIMARY KEY (`teacher_id`),\n  KEY `teacher_ibfk_1` (`department_id`),\n  CONSTRAINT `teacher_ibfk_1` FOREIGN KEY (`department_id`) REFERENCES `department` (`department_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `class` (\n  `class_id` int(11) NOT NULL,\n  `class_name` varchar(255) NOT NULL,\n  `grade` varchar(50) DEFAULT NULL,\n  `major` varchar(255) DEFAULT NULL,\n  `head_teacher_id` int(11) DEFAULT NULL,\n  `department_id` int(11) DEFAULT NULL,\n  PRIMARY KEY (`class_id`),\n  KEY `class_ibfk_1` (`head_teacher_id`),\n  KEY `class_ibfk_2` (`department_id`),\n  CONSTRAINT `class_ibfk_1` FOREIGN KEY (`head_teacher_id`) REFERENCES `teacher` (`teacher_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `class_ibfk_2` FOREIGN KEY (`department_id`) REFERENCES `department` (`department_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `student` (\n  `student_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `gender` varchar(20) DEFAULT NULL,\n  `grade` varchar(50) DEFAULT NULL,\n  `department_id` int(11) DEFAULT NULL,\n  `class_id` int(11) DEFAULT NULL,\n  `home_address` varchar(255) DEFAULT NULL,\n  `date_of_birth` date DEFAULT NULL,\n  `enrollment_time` datetime DEFAULT NULL,\n  PRIMARY KEY (`student_id`),\n  KEY `student_ibfk_1` (`department_id`),\n  KEY `student_ibfk_2` (`class_id`),\n  CONSTRAINT `student_ibfk_1` FOREIGN KEY (`department_id`) REFERENCES `department` (`department_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `student_ibfk_2` FOREIGN KEY (`class_id`) REFERENCES `class` (`class_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
