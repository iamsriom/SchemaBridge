  "question": "The diagram depicts a vehicle management system. The main functions of the system may include:\n\n1. User management: including adding, modifying, deleting and querying user information.\n2. Vehicle information management: including adding, modifying, deleting and querying vehicle information.\n3. Vehicle maintenance management: including adding, modifying, deleting and querying maintenance records.\n4. Vehicle departure management: including adding, modifying, deleting and querying departure records.\n5. Vehicle maintenance application management: including submitting, reviewing and querying maintenance applications.\n6. Vehicle repair shop management: including adding, modifying, deleting and querying repair shop information.\n7. Announcement information management: including publishing, modifying, deleting and querying announcements.\n8. Token information management: including token generation, verification and expiration processing.\n\nThe corresponding database model is as follows:\n\n1. User information table: including fields such as user ID, user name, password, role, etc.\n\n2. Vehicle information table: including fields such as vehicle ID, vehicle name, vehicle photo, vehicle status, vehicle category, etc.\n3. Vehicle maintenance table: including fields such as maintenance ID, vehicle ID, maintenance time, maintenance details, whether to review, review reply, etc.\n4. Vehicle departure table: including fields such as departure ID, vehicle ID, departure time, departure notes, etc.\n5. Vehicle maintenance application form: including fields such as application ID, vehicle ID, application time, application reason, whether to review, review reply, etc.\n6. Repair shop information table: including fields such as repair shop ID, shop name, contact person, contact number, etc.\n7. Announcement information table: including fields such as announcement ID, title, content, creation time, etc.\n8. Token information table: including fields such as tokenID, token value, creation time, expiration time, etc.",
  "ddl": "-- Schema for database: rschema_0410\nCREATE TABLE `user_info` (\n  `user_id` int(11) NOT NULL AUTO_INCREMENT,\n  `user_name` varchar(255) NOT NULL,\n  `password` varchar(255) NOT NULL,\n  `role` varchar(100) NOT NULL,\n  `created_at` datetime DEFAULT NULL,\n  PRIMARY KEY (`user_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `vehicle_info` (\n  `vehicle_id` int(11) NOT NULL AUTO_INCREMENT,\n  `vehicle_name` varchar(255) NOT NULL,\n  `vehicle_photo` varchar(255) DEFAULT NULL,\n  `vehicle_status` varchar(100) DEFAULT NULL,\n  `vehicle_category` varchar(100) DEFAULT NULL,\n  `created_at` datetime DEFAULT NULL,\n  PRIMARY KEY (`vehicle_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `vehicle_maintenance` (\n  `maintenance_id` int(11) NOT NULL AUTO_INCREMENT,\n  `vehicle_id` int(11) NOT NULL,\n  `maintenance_time` datetime NOT NULL,\n  `maintenance_details` text DEFAULT NULL,\n  `is_reviewed` varchar(10) DEFAULT NULL,\n  `review_reply` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`maintenance_id`),\n  KEY `vehicle_maintenance_ibfk_1` (`vehicle_id`),\n  CONSTRAINT `vehicle_maintenance_ibfk_1` FOREIGN KEY (`vehicle_id`) REFERENCES `vehicle_info` (`vehicle_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `vehicle_departure` (\n  `departure_id` int(11) NOT NULL AUTO_INCREMENT,\n  `vehicle_id` int(11) NOT NULL,\n  `departure_time` datetime NOT NULL,\n  `departure_notes` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`departure_id`),\n  KEY `vehicle_departure_ibfk_1` (`vehicle_id`),\n  CONSTRAINT `vehicle_departure_ibfk_1` FOREIGN KEY (`vehicle_id`) REFERENCES `vehicle_info` (`vehicle_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `vehicle_maintenance_application` (\n  `application_id` int(11) NOT NULL AUTO_INCREMENT,\n  `vehicle_id` int(11) NOT NULL,\n  `application_time` datetime NOT NULL,\n  `application_reason` text DEFAULT NULL,\n  `is_reviewed` varchar(10) DEFAULT NULL,\n  `review_reply` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`application_id`),\n  KEY `vehicle_maintenance_application_ibfk_1` (`vehicle_id`),\n  CONSTRAINT `vehicle_maintenance_application_ibfk_1` FOREIGN KEY (`vehicle_id`) REFERENCES `vehicle_info` (`vehicle_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `repair_shop_info` (\n  `repair_shop_id` int(11) NOT NULL AUTO_INCREMENT,\n  `shop_name` varchar(255) NOT NULL,\n  `contact_person` varchar(100) DEFAULT NULL,\n  `contact_number` varchar(50) DEFAULT NULL,\n  `address` varchar(255) DEFAULT NULL,\n  `created_at` datetime DEFAULT NULL,\n  PRIMARY KEY (`repair_shop_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `announcement_info` (\n  `announcement_id` int(11) NOT NULL AUTO_INCREMENT,\n  `title` varchar(255) NOT NULL,\n  `content` text DEFAULT NULL,\n  `created_at` datetime DEFAULT NULL,\n  PRIMARY KEY (`announcement_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `token_info` (\n  `token_id` int(11) NOT NULL AUTO_INCREMENT,\n  `token_value` varchar(512) NOT NULL,\n  `created_at` datetime NOT NULL,\n  `expires_at` datetime NOT NULL,\n  PRIMARY KEY (`token_id`),\n  UNIQUE KEY `token_info_token_value_uindex` (`token_value`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
