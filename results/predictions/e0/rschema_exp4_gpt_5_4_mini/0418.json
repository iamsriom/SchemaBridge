  "database": "rschema_0418",
  "question": "The functional requirements of a personal financial management system are as follows: The system shall manage user basic information, including the user's name, gender, age, contact information, address, email, login name, password, user type, status, security question, and answer. The system shall also record user income and expense information, including the user, name of income or expense, amount, type, remark, time, and status, with each record linked to a specific user and type. The system shall manage type information, including the type name and status. Additionally, the system shall publish announcement information, including the title, content, publication time, and status. Users shall be able to query and manage their financial information based on their needs and view announcements published by the system.",
  "ddl": "-- Schema for database: rschema_0418\nCREATE TABLE `user_info` (\n  `user_id` int(11) NOT NULL AUTO_INCREMENT,\n  `user_name` varchar(100) NOT NULL,\n  `gender` varchar(10) DEFAULT NULL,\n  `age` int(11) DEFAULT NULL,\n  `contact_info` varchar(255) DEFAULT NULL,\n  `address` varchar(255) DEFAULT NULL,\n  `email` varchar(255) DEFAULT NULL,\n  `login_name` varchar(100) NOT NULL,\n  `password` varchar(255) NOT NULL,\n  `user_type` varchar(50) DEFAULT NULL,\n  `status` varchar(20) DEFAULT NULL,\n  `security_question` varchar(255) DEFAULT NULL,\n  `security_answer` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`user_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `type_info` (\n  `type_id` int(11) NOT NULL AUTO_INCREMENT,\n  `type_name` varchar(100) NOT NULL,\n  `status` varchar(20) DEFAULT NULL,\n  PRIMARY KEY (`type_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `financial_record` (\n  `record_id` int(11) NOT NULL AUTO_INCREMENT,\n  `user_id` int(11) NOT NULL,\n  `record_name` varchar(255) NOT NULL,\n  `amount` decimal(10,2) NOT NULL,\n  `type_id` int(11) NOT NULL,\n  `remark` varchar(500) DEFAULT NULL,\n  `record_time` datetime NOT NULL,\n  `status` varchar(20) DEFAULT NULL,\n  PRIMARY KEY (`record_id`),\n  KEY `financial_record_ibfk_1` (`user_id`),\n  KEY `financial_record_ibfk_2` (`type_id`),\n  CONSTRAINT `financial_record_ibfk_1` FOREIGN KEY (`user_id`) REFERENCES `user_info` (`user_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `financial_record_ibfk_2` FOREIGN KEY (`type_id`) REFERENCES `type_info` (`type_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `announcement_info` (\n  `announcement_id` int(11) NOT NULL AUTO_INCREMENT,\n  `title` varchar(255) NOT NULL,\n  `content` text NOT NULL,\n  `publish_time` datetime NOT NULL,\n  `status` varchar(20) DEFAULT NULL,\n  PRIMARY KEY (`announcement_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
