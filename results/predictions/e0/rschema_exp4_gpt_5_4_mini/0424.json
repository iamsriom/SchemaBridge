  "question": "This is a comprehensive system management platform. For user management, the system maintains basic user information including user ID, username, password, phone number, and email, while recording user status information including account status, last login time, and login IP. For system management, the platform maintains basic system information including system ID, system name, system domain, and access time, records system configuration information including callback URL, secret key, and token validity period, and manages system status including whether enabled and whether approval is required. For login records, the system maintains basic login information including user ID, system ID, login time, and login IP, records session information including token and expiration time, and manages login status including validity and logout time. For system authorization relationships, the platform maintains authorization information including user ID, system ID, and authorization time, and manages authorization status including whether effective and expiration time.",
  "ddl": "-- Schema for database: rschema_0424\nCREATE TABLE `users` (\n  `user_id` int(11) NOT NULL AUTO_INCREMENT,\n  `username` varchar(255) NOT NULL,\n  `password` varchar(255) NOT NULL,\n  `phone_number` varchar(20) DEFAULT NULL,\n  `email` varchar(255) DEFAULT NULL,\n  `account_status` varchar(50) DEFAULT NULL,\n  `last_login_time` datetime DEFAULT NULL,\n  `login_ip` varchar(45) DEFAULT NULL,\n  PRIMARY KEY (`user_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `systems` (\n  `system_id` int(11) NOT NULL AUTO_INCREMENT,\n  `system_name` varchar(255) NOT NULL,\n  `system_domain` varchar(255) NOT NULL,\n  `access_time` datetime DEFAULT NULL,\n  `callback_url` varchar(500) DEFAULT NULL,\n  `secret_key` varchar(255) DEFAULT NULL,\n  `token_validity_period` int(11) DEFAULT NULL,\n  `is_enabled` tinyint(1) DEFAULT NULL,\n  `requires_approval` tinyint(1) DEFAULT NULL,\n  PRIMARY KEY (`system_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `login_records` (\n  `login_record_id` int(11) NOT NULL AUTO_INCREMENT,\n  `user_id` int(11) NOT NULL,\n  `system_id` int(11) NOT NULL,\n  `login_time` datetime NOT NULL,\n  `login_ip` varchar(45) DEFAULT NULL,\n  `token` varchar(500) DEFAULT NULL,\n  `expiration_time` datetime DEFAULT NULL,\n  `is_valid` tinyint(1) DEFAULT NULL,\n  `logout_time` datetime DEFAULT NULL,\n  PRIMARY KEY (`login_record_id`),\n  KEY `login_records_ibfk_1` (`user_id`),\n  KEY `login_records_ibfk_2` (`system_id`),\n  CONSTRAINT `login_records_ibfk_1` FOREIGN KEY (`user_id`) REFERENCES `users` (`user_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `login_records_ibfk_2` FOREIGN KEY (`system_id`) REFERENCES `systems` (`system_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `system_authorizations` (\n  `authorization_id` int(11) NOT NULL AUTO_INCREMENT,\n  `user_id` int(11) NOT NULL,\n  `system_id` int(11) NOT NULL,\n  `authorization_time` datetime NOT NULL,\n  `is_effective` tinyint(1) DEFAULT NULL,\n  `expiration_time` datetime DEFAULT NULL,\n  PRIMARY KEY (`authorization_id`),\n  KEY `system_authorizations_ibfk_1` (`user_id`),\n  KEY `system_authorizations_ibfk_2` (`system_id`),\n  CONSTRAINT `system_authorizations_ibfk_1` FOREIGN KEY (`user_id`) REFERENCES `users` (`user_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `system_authorizations_ibfk_2` FOREIGN KEY (`system_id`) REFERENCES `systems` (`system_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
