  "database": "rschema_0426",
  "question": "The mini-program shall allow users to register or log in via WeChat authorization. The system shall store each user's account information (such as account number, password, nickname, bio, etc.) and related authorization information, enabling users to view some attraction information after logging in, including attraction name, pictures, reference prices, and text descriptions. Users shall be able to bookmark attractions they are interested in and submit reservation information, recording the reservation time, ticket purchase time, number of tickets purchased, etc., for later viewing or modification. Users shall also be able to submit brief comments for attractions, including comment time, comment content, comment status, etc., which shall be displayed on the front-end only after back-end review.",
  "ddl": "-- Schema for database: rschema_0426\nCREATE TABLE `user_account` (\n  `user_id` int(11) NOT NULL AUTO_INCREMENT,\n  `account_number` varchar(100) NOT NULL,\n  `password` varchar(255) NOT NULL,\n  `nickname` varchar(100) DEFAULT NULL,\n  `bio` varchar(500) DEFAULT NULL,\n  `wechat_openid` varchar(100) DEFAULT NULL,\n  `wechat_unionid` varchar(100) DEFAULT NULL,\n  `avatar_url` varchar(255) DEFAULT NULL,\n  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  `updated_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,\n  PRIMARY KEY (`user_id`),\n  UNIQUE KEY `uk_user_account_number` (`account_number`),\n  UNIQUE KEY `uk_user_wechat_openid` (`wechat_openid`),\n  UNIQUE KEY `uk_user_wechat_unionid` (`wechat_unionid`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `attraction` (\n  `attraction_id` int(11) NOT NULL AUTO_INCREMENT,\n  `attraction_name` varchar(255) NOT NULL,\n  `picture_url` varchar(255) DEFAULT NULL,\n  `reference_price` decimal(10,2) DEFAULT NULL,\n  `description` text DEFAULT NULL,\n  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  `updated_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,\n  PRIMARY KEY (`attraction_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `user_bookmark` (\n  `bookmark_id` int(11) NOT NULL AUTO_INCREMENT,\n  `user_id` int(11) NOT NULL,\n  `attraction_id` int(11) NOT NULL,\n  `bookmarked_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  PRIMARY KEY (`bookmark_id`),\n  UNIQUE KEY `uk_user_bookmark` (`user_id`,`attraction_id`),\n  KEY `user_bookmark_ibfk_2` (`attraction_id`),\n  CONSTRAINT `user_bookmark_ibfk_1` FOREIGN KEY (`user_id`) REFERENCES `user_account` (`user_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `user_bookmark_ibfk_2` FOREIGN KEY (`attraction_id`) REFERENCES `attraction` (`attraction_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `reservation` (\n  `reservation_id` int(11) NOT NULL AUTO_INCREMENT,\n  `user_id` int(11) NOT NULL,\n  `attraction_id` int(11) NOT NULL,\n  `reservation_time` datetime NOT NULL,\n  `ticket_purchase_time` datetime DEFAULT NULL,\n  `ticket_count` int(11) NOT NULL DEFAULT 1,\n  `reservation_status` varchar(50) DEFAULT NULL,\n  `remark` varchar(500) DEFAULT NULL,\n  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  `updated_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,\n  PRIMARY KEY (`reservation_id`),\n  KEY `reservation_ibfk_1` (`user_id`),\n  KEY `reservation_ibfk_2` (`attraction_id`),\n  CONSTRAINT `reservation_ibfk_1` FOREIGN KEY (`user_id`) REFERENCES `user_account` (`user_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `reservation_ibfk_2` FOREIGN KEY (`attraction_id`) REFERENCES `attraction` (`attraction_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `attraction_comment` (\n  `comment_id` int(11) NOT NULL AUTO_INCREMENT,\n  `user_id` int(11) NOT NULL,\n  `attraction_id` int(11) NOT NULL,\n  `comment_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  `comment_content` varchar(1000) NOT NULL,\n  `comment_status` varchar(20) NOT NULL DEFAULT 'pending',\n  `reviewed_at` datetime DEFAULT NULL,\n  `review_note` varchar(500) DEFAULT NULL,\n  PRIMARY KEY (`comment_id`),\n  KEY `attraction_comment_ibfk_1` (`user_id`),\n  KEY `attraction_comment_ibfk_2` (`attraction_id`),\n  CONSTRAINT `attraction_comment_ibfk_1` FOREIGN KEY (`user_id`) REFERENCES `user_account` (`user_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `attraction_comment_ibfk_2` FOREIGN KEY (`attraction_id`) REFERENCES `attraction` (`attraction_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
