  "question": "Course Selection System primarily targets students and teachers, providing functions such as course selection, viewing course information, managing student and teacher information, etc. The specific requirements are as follows:\n1.Student Information Management: Students need to register and log into the system, providing their student ID, name, gender, department, age, enrollment date, major, and login password. Students can view their personal information.\n2.Teacher Information Management: Teachers need to register and log into the system, providing their employee ID, name, gender, password, title, department, and course ID. Teachers can view their personal information.\n3.Course Information Management: The system should contain a course table, recording course ID, course name, prerequisite course ID, and credits. Both students and teachers can view course information.\n4.Course Selection: After logging in, students can select courses, recording their student ID, course ID, and grades. Students can view their course selection status.\n5.Teaching Information Management: Teachers can record the course ID they teach, the teaching location, and the class time. Students can view the teaching information of teachers.\n6.Student Timetable Management: The system should record the student’s ID, selected course IDs, class times, and locations to generate a student timetable. Students can view their timetable.",
  "ddl": "-- Schema for database: rschema_0427\nCREATE TABLE `student_info` (\n  `student_id` varchar(20) NOT NULL,\n  `student_name` varchar(100) NOT NULL,\n  `gender` varchar(10) DEFAULT NULL,\n  `department` varchar(100) DEFAULT NULL,\n  `age` int(11) DEFAULT NULL,\n  `enrollment_date` date DEFAULT NULL,\n  `major` varchar(100) DEFAULT NULL,\n  `login_password` varchar(255) NOT NULL,\n  PRIMARY KEY (`student_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `teacher_info` (\n  `employee_id` varchar(20) NOT NULL,\n  `teacher_name` varchar(100) NOT NULL,\n  `gender` varchar(10) DEFAULT NULL,\n  `login_password` varchar(255) NOT NULL,\n  `title` varchar(100) DEFAULT NULL,\n  `department` varchar(100) DEFAULT NULL,\n  `course_id` varchar(20) DEFAULT NULL,\n  PRIMARY KEY (`employee_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `course_info` (\n  `course_id` varchar(20) NOT NULL,\n  `course_name` varchar(200) NOT NULL,\n  `prerequisite_course_id` varchar(20) DEFAULT NULL,\n  `credits` decimal(4,1) NOT NULL,\n  PRIMARY KEY (`course_id`),\n  KEY `course_info_ibfk_1` (`prerequisite_course_id`),\n  CONSTRAINT `course_info_ibfk_1` FOREIGN KEY (`prerequisite_course_id`) REFERENCES `course_info` (`course_id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `course_selection` (\n  `selection_id` int(11) NOT NULL AUTO_INCREMENT,\n  `student_id` varchar(20) NOT NULL,\n  `course_id` varchar(20) NOT NULL,\n  `grade` decimal(5,2) DEFAULT NULL,\n  PRIMARY KEY (`selection_id`),\n  UNIQUE KEY `course_selection_uni_1` (`student_id`,`course_id`),\n  KEY `course_selection_ibfk_1` (`student_id`),\n  KEY `course_selection_ibfk_2` (`course_id`),\n  CONSTRAINT `course_selection_ibfk_1` FOREIGN KEY (`student_id`) REFERENCES `student_info` (`student_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `course_selection_ibfk_2` FOREIGN KEY (`course_id`) REFERENCES `course_info` (`course_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `teaching_info` (\n  `teaching_id` int(11) NOT NULL AUTO_INCREMENT,\n  `employee_id` varchar(20) NOT NULL,\n  `course_id` varchar(20) NOT NULL,\n  `teaching_location` varchar(255) NOT NULL,\n  `class_time` varchar(100) NOT NULL,\n  PRIMARY KEY (`teaching_id`),\n  KEY `teaching_info_ibfk_1` (`employee_id`),\n  KEY `teaching_info_ibfk_2` (`course_id`),\n  CONSTRAINT `teaching_info_ibfk_1` FOREIGN KEY (`employee_id`) REFERENCES `teacher_info` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `teaching_info_ibfk_2` FOREIGN KEY (`course_id`) REFERENCES `course_info` (`course_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `student_timetable` (\n  `timetable_id` int(11) NOT NULL AUTO_INCREMENT,\n  `student_id` varchar(20) NOT NULL,\n  `course_id` varchar(20) NOT NULL,\n  `class_time` varchar(100) NOT NULL,\n  `location` varchar(255) NOT NULL,\n  PRIMARY KEY (`timetable_id`),\n  UNIQUE KEY `student_timetable_uni_1` (`student_id`,`course_id`,`class_time`,`location`),\n  KEY `student_timetable_ibfk_1` (`student_id`),\n  KEY `student_timetable_ibfk_2` (`course_id`),\n  CONSTRAINT `student_timetable_ibfk_1` FOREIGN KEY (`student_id`) REFERENCES `student_info` (`student_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `student_timetable_ibfk_2` FOREIGN KEY (`course_id`) REFERENCES `course_info` (`course_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
