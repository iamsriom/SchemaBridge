  "database": "rschema_0428",
  "question": "The school information management system shall record and manage common operations for administrators, teachers, and regular users respectively. The system shall store basic information of users with different identities, and allow administrators or teachers to maintain dormitories, courses, and grades. It shall also enable regular users to view their own grades and submit dormitory repair requests.",
  "ddl": "-- Schema for database: rschema_0428\nCREATE TABLE `users` (\n  `user_id` int(11) NOT NULL AUTO_INCREMENT,\n  `username` varchar(100) NOT NULL,\n  `password` varchar(255) NOT NULL,\n  `real_name` varchar(100) NOT NULL,\n  `identity_type` varchar(20) NOT NULL,\n  `phone` varchar(20) DEFAULT NULL,\n  `email` varchar(100) DEFAULT NULL,\n  `created_at` datetime NOT NULL,\n  PRIMARY KEY (`user_id`),\n  UNIQUE KEY `uk_users_username` (`username`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `dormitories` (\n  `dormitory_id` int(11) NOT NULL AUTO_INCREMENT,\n  `dormitory_name` varchar(100) NOT NULL,\n  `building_name` varchar(100) DEFAULT NULL,\n  `room_number` varchar(50) NOT NULL,\n  `capacity` int(11) NOT NULL,\n  `current_occupancy` int(11) NOT NULL DEFAULT 0,\n  `manager_user_id` int(11) DEFAULT NULL,\n  `created_at` datetime NOT NULL,\n  PRIMARY KEY (`dormitory_id`),\n  KEY `dormitories_ibfk_1` (`manager_user_id`),\n  CONSTRAINT `dormitories_ibfk_1` FOREIGN KEY (`manager_user_id`) REFERENCES `users` (`user_id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `courses` (\n  `course_id` int(11) NOT NULL AUTO_INCREMENT,\n  `course_code` varchar(50) NOT NULL,\n  `course_name` varchar(100) NOT NULL,\n  `course_description` varchar(500) DEFAULT NULL,\n  `teacher_user_id` int(11) DEFAULT NULL,\n  `credit` decimal(4,1) NOT NULL,\n  `created_at` datetime NOT NULL,\n  PRIMARY KEY (`course_id`),\n  UNIQUE KEY `uk_courses_course_code` (`course_code`),\n  KEY `courses_ibfk_1` (`teacher_user_id`),\n  CONSTRAINT `courses_ibfk_1` FOREIGN KEY (`teacher_user_id`) REFERENCES `users` (`user_id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `grades` (\n  `grade_id` int(11) NOT NULL AUTO_INCREMENT,\n  `student_user_id` int(11) NOT NULL,\n  `course_id` int(11) NOT NULL,\n  `score` decimal(5,2) NOT NULL,\n  `grade_level` varchar(20) DEFAULT NULL,\n  `remark` varchar(255) DEFAULT NULL,\n  `recorded_by` int(11) DEFAULT NULL,\n  `recorded_at` datetime NOT NULL,\n  PRIMARY KEY (`grade_id`),\n  KEY `grades_ibfk_1` (`student_user_id`),\n  KEY `grades_ibfk_2` (`course_id`),\n  KEY `grades_ibfk_3` (`recorded_by`),\n  CONSTRAINT `grades_ibfk_1` FOREIGN KEY (`student_user_id`) REFERENCES `users` (`user_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `grades_ibfk_2` FOREIGN KEY (`course_id`) REFERENCES `courses` (`course_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `grades_ibfk_3` FOREIGN KEY (`recorded_by`) REFERENCES `users` (`user_id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `dormitory_repair_requests` (\n  `request_id` int(11) NOT NULL AUTO_INCREMENT,\n  `student_user_id` int(11) NOT NULL,\n  `dormitory_id` int(11) NOT NULL,\n  `request_title` varchar(100) NOT NULL,\n  `request_content` varchar(1000) NOT NULL,\n  `status` varchar(20) NOT NULL DEFAULT 'pending',\n  `submitted_at` datetime NOT NULL,\n  `handled_by` int(11) DEFAULT NULL,\n  `handled_at` datetime DEFAULT NULL,\n  PRIMARY KEY (`request_id`),\n  KEY `dormitory_repair_requests_ibfk_1` (`student_user_id`),\n  KEY `dormitory_repair_requests_ibfk_2` (`dormitory_id`),\n  KEY `dormitory_repair_requests_ibfk_3` (`handled_by`),\n  CONSTRAINT `dormitory_repair_requests_ibfk_1` FOREIGN KEY (`student_user_id`) REFERENCES `users` (`user_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `dormitory_repair_requests_ibfk_2` FOREIGN KEY (`dormitory_id`) REFERENCES `dormitories` (`dormitory_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `dormitory_repair_requests_ibfk_3` FOREIGN KEY (`handled_by`) REFERENCES `users` (`user_id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
