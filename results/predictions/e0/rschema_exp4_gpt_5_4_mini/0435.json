  "database": "rschema_0435",
  "question": "This is a space exploration mission management system. For probe management, the system records basic probe information including probe ID, name, weight, launch date, and service life, maintains the scientific instrument configuration carried by the probe, and tracks the probe's operational status and remaining fuel.\n\nFor celestial target management, the system records basic information about observed celestial bodies, including celestial body ID, name, type (planet/asteroid/comet etc.), maintains orbital parameters and physical characteristics, while recording existing observational data (observation time, observation data, observation results, observation accuracy, etc.) and research value.\n\nFor scientific instrument management, the system records basic instrument information including instrument ID, name, weight, power consumption, accuracy, etc., and maintains instrument operating parameters and calibration data.\n\nFor exploration mission management, the system records the probe's flight trajectory and target celestial bodies, records mission execution status and scientific data acquisition status, while maintaining mission priority and resource allocation.",
  "ddl": "-- Schema for database: rschema_0435\nCREATE TABLE `probe` (\n  `probe_id` int(11) NOT NULL,\n  `probe_name` varchar(255) NOT NULL,\n  `weight` decimal(10,2) DEFAULT NULL,\n  `launch_date` date DEFAULT NULL,\n  `service_life` int(11) DEFAULT NULL,\n  `operational_status` varchar(100) DEFAULT NULL,\n  `remaining_fuel` decimal(10,2) DEFAULT NULL,\n  PRIMARY KEY (`probe_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `scientific_instrument` (\n  `instrument_id` int(11) NOT NULL,\n  `instrument_name` varchar(255) NOT NULL,\n  `weight` decimal(10,2) DEFAULT NULL,\n  `power_consumption` decimal(10,2) DEFAULT NULL,\n  `accuracy` decimal(10,4) DEFAULT NULL,\n  `operating_parameters` text DEFAULT NULL,\n  `calibration_data` text DEFAULT NULL,\n  PRIMARY KEY (`instrument_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `probe_instrument` (\n  `probe_id` int(11) NOT NULL,\n  `instrument_id` int(11) NOT NULL,\n  `configuration_notes` varchar(500) DEFAULT NULL,\n  PRIMARY KEY (`probe_id`,`instrument_id`),\n  CONSTRAINT `probe_instrument_ibfk_1` FOREIGN KEY (`probe_id`) REFERENCES `probe` (`probe_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `probe_instrument_ibfk_2` FOREIGN KEY (`instrument_id`) REFERENCES `scientific_instrument` (`instrument_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `celestial_body` (\n  `celestial_body_id` int(11) NOT NULL,\n  `celestial_body_name` varchar(255) NOT NULL,\n  `celestial_body_type` varchar(100) NOT NULL,\n  `orbital_parameters` text DEFAULT NULL,\n  `physical_characteristics` text DEFAULT NULL,\n  `research_value` text DEFAULT NULL,\n  PRIMARY KEY (`celestial_body_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `observation` (\n  `observation_id` int(11) NOT NULL,\n  `celestial_body_id` int(11) NOT NULL,\n  `observation_time` datetime NOT NULL,\n  `observation_data` text DEFAULT NULL,\n  `observation_results` text DEFAULT NULL,\n  `observation_accuracy` decimal(10,4) DEFAULT NULL,\n  PRIMARY KEY (`observation_id`),\n  KEY `observation_ibfk_1` (`celestial_body_id`),\n  CONSTRAINT `observation_ibfk_1` FOREIGN KEY (`celestial_body_id`) REFERENCES `celestial_body` (`celestial_body_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `exploration_mission` (\n  `mission_id` int(11) NOT NULL,\n  `probe_id` int(11) NOT NULL,\n  `mission_name` varchar(255) NOT NULL,\n  `flight_trajectory` text DEFAULT NULL,\n  `mission_execution_status` varchar(100) DEFAULT NULL,\n  `scientific_data_acquisition_status` varchar(100) DEFAULT NULL,\n  `mission_priority` int(11) DEFAULT NULL,\n  `resource_allocation` text DEFAULT NULL,\n  PRIMARY KEY (`mission_id`),\n  KEY `exploration_mission_ibfk_1` (`probe_id`),\n  CONSTRAINT `exploration_mission_ibfk_1` FOREIGN KEY (`probe_id`) REFERENCES `probe` (`probe_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `mission_target` (\n  `mission_id` int(11) NOT NULL,\n  `celestial_body_id` int(11) NOT NULL,\n  PRIMARY KEY (`mission_id`,`celestial_body_id`),\n  CONSTRAINT `mission_target_ibfk_1` FOREIGN KEY (`mission_id`) REFERENCES `exploration_mission` (`mission_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `mission_target_ibfk_2` FOREIGN KEY (`celestial_body_id`) REFERENCES `celestial_body` (`celestial_body_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
