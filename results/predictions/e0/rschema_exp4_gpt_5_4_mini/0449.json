  "database": "rschema_0449",
  "question": "The main functions of a company's human resources and training management information system include:\n1. Employee information management: Each company employee has a unique employee number, which also includes employee name, employee gender, employee date of birth, department, employee entry date, employee resignation date, employee position, employee contact information, employee email address, and employee status.\n2. Position information management: Each position has a unique position number, which also includes information such as position name, position responsibilities, and position requirements.\n3. Training information management: Each training has a unique training number, and also records information such as training time, training location, training content, and trainer.\n4. Department information management: Each department has a unique department number, which also includes department name, department function, department planning, and other content.\n5. Employee position change management: Record employee position changes, using employee number and position number as identifiers, and record the change date and reason for the change.",
  "ddl": "-- Schema for database: rschema_0449\nCREATE TABLE `department` (\n  `department_no` varchar(20) NOT NULL,\n  `department_name` varchar(255) NOT NULL,\n  `department_function` varchar(255) DEFAULT NULL,\n  `department_planning` varchar(255) DEFAULT NULL,\n  `other_content` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`department_no`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `position` (\n  `position_no` varchar(20) NOT NULL,\n  `position_name` varchar(255) NOT NULL,\n  `position_responsibilities` varchar(255) DEFAULT NULL,\n  `position_requirements` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`position_no`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `employee` (\n  `employee_no` varchar(20) NOT NULL,\n  `employee_name` varchar(255) NOT NULL,\n  `employee_gender` varchar(10) DEFAULT NULL,\n  `employee_birth_date` date DEFAULT NULL,\n  `department_no` varchar(20) DEFAULT NULL,\n  `employee_entry_date` date DEFAULT NULL,\n  `employee_resignation_date` date DEFAULT NULL,\n  `position_no` varchar(20) DEFAULT NULL,\n  `employee_contact_info` varchar(255) DEFAULT NULL,\n  `employee_email` varchar(255) DEFAULT NULL,\n  `employee_status` varchar(50) DEFAULT NULL,\n  PRIMARY KEY (`employee_no`),\n  KEY `employee_ibfk_1` (`department_no`),\n  KEY `employee_ibfk_2` (`position_no`),\n  CONSTRAINT `employee_ibfk_1` FOREIGN KEY (`department_no`) REFERENCES `department` (`department_no`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `employee_ibfk_2` FOREIGN KEY (`position_no`) REFERENCES `position` (`position_no`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `training` (\n  `training_no` varchar(20) NOT NULL,\n  `training_time` datetime DEFAULT NULL,\n  `training_location` varchar(255) DEFAULT NULL,\n  `training_content` varchar(255) DEFAULT NULL,\n  `trainer` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`training_no`) \n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `employee_position_change` (\n  `employee_no` varchar(20) NOT NULL,\n  `position_no` varchar(20) NOT NULL,\n  `change_date` date NOT NULL,\n  `change_reason` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`employee_no`,`position_no`,`change_date`),\n  KEY `employee_position_change_ibfk_1` (`employee_no`),\n  KEY `employee_position_change_ibfk_2` (`position_no`),\n  CONSTRAINT `employee_position_change_ibfk_1` FOREIGN KEY (`employee_no`) REFERENCES `employee` (`employee_no`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `employee_position_change_ibfk_2` FOREIGN KEY (`position_no`) REFERENCES `position` (`position_no`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
