  "database": "rschema_0457",
  "question": "This is a product distribution center information management system. It records supermarket information including name, address, and contact information; records product information including name, inventory quantity, and last update date; records supplier information including name, address, and contact information.For supply request management, the system records each supply request submitted by chain supermarkets, including unique request ID, chain supermarket ID, product ID, requested quantity and request date. When receiving a supply request, the system checks product inventory - if inventory is sufficient, it generates a delivery notification including notification ID, corresponding request ID and delivery date; if inventory is insufficient, it generates a stock-out notification including notification ID, corresponding request ID and stock-out date. For procurement management, when the procurement department receives a stock-out notification, they proceed with product procurement, with each purchase recorded in a procurement list, including unique list ID, product ID, supplier ID, purchase quantity and purchase date.",
  "ddl": "-- Schema for database: rschema_0457\nCREATE TABLE `supermarket` (\n  `supermarket_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `address` varchar(255) DEFAULT NULL,\n  `contact_info` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`supermarket_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `product` (\n  `product_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `inventory_quantity` int(11) NOT NULL,\n  `last_update_date` datetime NOT NULL,\n  PRIMARY KEY (`product_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `supplier` (\n  `supplier_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `address` varchar(255) DEFAULT NULL,\n  `contact_info` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`supplier_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `supply_request` (\n  `request_id` int(11) NOT NULL AUTO_INCREMENT,\n  `supermarket_id` int(11) NOT NULL,\n  `product_id` int(11) NOT NULL,\n  `requested_quantity` int(11) NOT NULL,\n  `request_date` datetime NOT NULL,\n  PRIMARY KEY (`request_id`),\n  KEY `supply_request_ibfk_1` (`supermarket_id`),\n  KEY `supply_request_ibfk_2` (`product_id`),\n  CONSTRAINT `supply_request_ibfk_1` FOREIGN KEY (`supermarket_id`) REFERENCES `supermarket` (`supermarket_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `supply_request_ibfk_2` FOREIGN KEY (`product_id`) REFERENCES `product` (`product_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `delivery_notification` (\n  `notification_id` int(11) NOT NULL AUTO_INCREMENT,\n  `request_id` int(11) NOT NULL,\n  `delivery_date` datetime NOT NULL,\n  PRIMARY KEY (`notification_id`),\n  KEY `delivery_notification_ibfk_1` (`request_id`),\n  CONSTRAINT `delivery_notification_ibfk_1` FOREIGN KEY (`request_id`) REFERENCES `supply_request` (`request_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `stock_out_notification` (\n  `notification_id` int(11) NOT NULL AUTO_INCREMENT,\n  `request_id` int(11) NOT NULL,\n  `stock_out_date` datetime NOT NULL,\n  PRIMARY KEY (`notification_id`),\n  KEY `stock_out_notification_ibfk_1` (`request_id`),\n  CONSTRAINT `stock_out_notification_ibfk_1` FOREIGN KEY (`request_id`) REFERENCES `supply_request` (`request_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `procurement_list` (\n  `list_id` int(11) NOT NULL AUTO_INCREMENT,\n  `product_id` int(11) NOT NULL,\n  `supplier_id` int(11) NOT NULL,\n  `purchase_quantity` int(11) NOT NULL,\n  `purchase_date` datetime NOT NULL,\n  PRIMARY KEY (`list_id`),\n  KEY `procurement_list_ibfk_1` (`product_id`),\n  KEY `procurement_list_ibfk_2` (`supplier_id`),\n  CONSTRAINT `procurement_list_ibfk_1` FOREIGN KEY (`product_id`) REFERENCES `product` (`product_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `procurement_list_ibfk_2` FOREIGN KEY (`supplier_id`) REFERENCES `supplier` (`supplier_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
