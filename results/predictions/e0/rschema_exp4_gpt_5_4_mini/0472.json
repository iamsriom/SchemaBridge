  "database": "rschema_0472",
  "question": "This is an online homework grading system. For student management, the system records basic information for each student, including unique student ID, name, class, phone number and email. For instructor management, the system records basic information for each instructor, including unique instructor ID, name, courses taught, phone number and email. For homework management, students can submit electronic homework online, and the system records basic information for each homework submission, including unique homework ID, homework content, submission time and grading status. After successful submission, the system notifies both the student and instructor. Instructors can download ungraded homework, score each question and provide overall feedback, then upload the graded homework back to the system. The system records grading information (scores and feedback), grading time and notifies students when their homework has been graded. Students can view their submitted homework, scores and feedback.",
  "ddl": "-- Schema for database: rschema_0472\nCREATE TABLE `students` (\n  `student_id` int(11) NOT NULL,\n  `student_name` varchar(255) NOT NULL,\n  `class_name` varchar(255) NOT NULL,\n  `phone_number` varchar(20) DEFAULT NULL,\n  `email` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`student_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `instructors` (\n  `instructor_id` int(11) NOT NULL,\n  `instructor_name` varchar(255) NOT NULL,\n  `courses_taught` varchar(255) DEFAULT NULL,\n  `phone_number` varchar(20) DEFAULT NULL,\n  `email` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`instructor_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `homework_submissions` (\n  `homework_id` int(11) NOT NULL,\n  `student_id` int(11) NOT NULL,\n  `instructor_id` int(11) DEFAULT NULL,\n  `homework_content` text NOT NULL,\n  `submission_time` datetime NOT NULL,\n  `grading_status` varchar(20) NOT NULL,\n  `graded_time` datetime DEFAULT NULL,\n  `overall_feedback` text DEFAULT NULL,\n  PRIMARY KEY (`homework_id`),\n  KEY `homework_submissions_ibfk_1` (`student_id`),\n  KEY `homework_submissions_ibfk_2` (`instructor_id`),\n  CONSTRAINT `homework_submissions_ibfk_1` FOREIGN KEY (`student_id`) REFERENCES `students` (`student_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `homework_submissions_ibfk_2` FOREIGN KEY (`instructor_id`) REFERENCES `instructors` (`instructor_id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `homework_grades` (\n  `grade_id` int(11) NOT NULL,\n  `homework_id` int(11) NOT NULL,\n  `question_number` int(11) NOT NULL,\n  `score` decimal(5,2) NOT NULL,\n  `feedback` text DEFAULT NULL,\n  `grading_time` datetime NOT NULL,\n  PRIMARY KEY (`grade_id`),\n  KEY `homework_grades_ibfk_1` (`homework_id`),\n  CONSTRAINT `homework_grades_ibfk_1` FOREIGN KEY (`homework_id`) REFERENCES `homework_submissions` (`homework_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
