  "question": "Business Requirements Description:\n1.Supermarket Information Management:\nEach supermarket has a unique name, address, manager, and contact number. Each supermarket has only one manager.\n2.Department Management:\nEach supermarket has multiple departments. Each department has a unique name, department manager, and contact number. Each department has only one manager and multiple employees. Each employee belongs to only one department.\n3.Employee Management:\nEach employee has a unique employee ID, name, contact information, position, and salary. Positions include manager, department manager, salesperson, etc.\n4.Product Management:\nEach product has a unique product ID, name, model, unit price, and quantity. Salespeople can be responsible for the distribution of multiple products in the supermarket, and a product can be assigned to multiple salespeople.",
  "ddl": "-- Schema for database: rschema_0475\nCREATE TABLE `supermarket` (\n  `supermarket_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `address` varchar(255) NOT NULL,\n  `manager_employee_id` int(11) NOT NULL,\n  `contact_number` varchar(50) NOT NULL,\n  PRIMARY KEY (`supermarket_id`),\n  UNIQUE KEY `uk_supermarket_name` (`name`),\n  UNIQUE KEY `uk_supermarket_manager_employee_id` (`manager_employee_id`),\n  CONSTRAINT `supermarket_ibfk_1` FOREIGN KEY (`manager_employee_id`) REFERENCES `employee` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `department` (\n  `department_id` int(11) NOT NULL AUTO_INCREMENT,\n  `supermarket_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `manager_employee_id` int(11) NOT NULL,\n  `contact_number` varchar(50) NOT NULL,\n  PRIMARY KEY (`department_id`),\n  UNIQUE KEY `uk_department_name` (`name`),\n  UNIQUE KEY `uk_department_manager_employee_id` (`manager_employee_id`),\n  KEY `department_ibfk_1` (`supermarket_id`),\n  CONSTRAINT `department_ibfk_1` FOREIGN KEY (`supermarket_id`) REFERENCES `supermarket` (`supermarket_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `department_ibfk_2` FOREIGN KEY (`manager_employee_id`) REFERENCES `employee` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `employee` (\n  `employee_id` int(11) NOT NULL AUTO_INCREMENT,\n  `department_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `contact_info` varchar(255) DEFAULT NULL,\n  `position` varchar(100) NOT NULL,\n  `salary` decimal(10,2) NOT NULL,\n  PRIMARY KEY (`employee_id`),\n  KEY `employee_ibfk_1` (`department_id`),\n  CONSTRAINT `employee_ibfk_1` FOREIGN KEY (`department_id`) REFERENCES `department` (`department_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `product` (\n  `product_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `model` varchar(255) NOT NULL,\n  `unit_price` decimal(10,2) NOT NULL,\n  `quantity` int(11) NOT NULL,\n  PRIMARY KEY (`product_id`),\n  UNIQUE KEY `uk_product_name_model` (`name`,`model`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `salesperson_product` (\n  `salesperson_id` int(11) NOT NULL,\n  `product_id` int(11) NOT NULL,\n  PRIMARY KEY (`salesperson_id`,`product_id`),\n  KEY `salesperson_product_ibfk_2` (`product_id`),\n  CONSTRAINT `salesperson_product_ibfk_1` FOREIGN KEY (`salesperson_id`) REFERENCES `employee` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `salesperson_product_ibfk_2` FOREIGN KEY (`product_id`) REFERENCES `product` (`product_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
