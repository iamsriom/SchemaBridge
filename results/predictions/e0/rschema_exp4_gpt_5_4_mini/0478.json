  "question": "Business Requirements Description for the Shared Bicycle Management System:\nThe shared bicycle company manages multiple users, each with a user ID, phone number, name, credit, and status.\nThe company manages multiple bicycles, each with a bicycle ID, location, status, and unlock code.\nThe company records multiple trips, each trip requiring the recording of user and bicycle usage information, including bicycle number, start time, end time, cost, and payment status.\nThe company manages multiple fault records, each fault involving the user number who encountered the fault, bicycle number, fault description, and reporting time.\nThe company also manages billing rules, each rule including the billing method, unit price, and minimum fee.",
  "ddl": "-- Schema for database: rschema_0478\nCREATE TABLE `users` (\n  `user_id` int(11) NOT NULL,\n  `phone_number` varchar(20) NOT NULL,\n  `name` varchar(100) NOT NULL,\n  `credit` int(11) NOT NULL DEFAULT 0,\n  `status` varchar(20) NOT NULL,\n  PRIMARY KEY (`user_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `bicycles` (\n  `bicycle_id` int(11) NOT NULL,\n  `location` varchar(255) DEFAULT NULL,\n  `status` varchar(20) NOT NULL,\n  `unlock_code` varchar(50) NOT NULL,\n  PRIMARY KEY (`bicycle_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `billing_rules` (\n  `rule_id` int(11) NOT NULL,\n  `billing_method` varchar(100) NOT NULL,\n  `unit_price` decimal(10,2) NOT NULL,\n  `minimum_fee` decimal(10,2) NOT NULL,\n  PRIMARY KEY (`rule_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `trips` (\n  `trip_id` int(11) NOT NULL,\n  `user_id` int(11) NOT NULL,\n  `bicycle_id` int(11) NOT NULL,\n  `start_time` datetime NOT NULL,\n  `end_time` datetime DEFAULT NULL,\n  `cost` decimal(10,2) NOT NULL DEFAULT 0.00,\n  `payment_status` varchar(20) NOT NULL,\n  PRIMARY KEY (`trip_id`),\n  KEY `trips_ibfk_1` (`user_id`),\n  KEY `trips_ibfk_2` (`bicycle_id`),\n  CONSTRAINT `trips_ibfk_1` FOREIGN KEY (`user_id`) REFERENCES `users` (`user_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `trips_ibfk_2` FOREIGN KEY (`bicycle_id`) REFERENCES `bicycles` (`bicycle_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `fault_records` (\n  `fault_id` int(11) NOT NULL,\n  `user_id` int(11) NOT NULL,\n  `bicycle_id` int(11) NOT NULL,\n  `fault_description` varchar(500) NOT NULL,\n  `reporting_time` datetime NOT NULL,\n  PRIMARY KEY (`fault_id`),\n  KEY `fault_records_ibfk_1` (`user_id`),\n  KEY `fault_records_ibfk_2` (`bicycle_id`),\n  CONSTRAINT `fault_records_ibfk_1` FOREIGN KEY (`user_id`) REFERENCES `users` (`user_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `fault_records_ibfk_2` FOREIGN KEY (`bicycle_id`) REFERENCES `bicycles` (`bicycle_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
