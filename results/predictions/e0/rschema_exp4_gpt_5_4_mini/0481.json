  "database": "rschema_0481",
  "question": "This is an agricultural crop monitoring system used to track and manage crop, environmental, and sensor data based on pre-defined monitoring and processing rules.\nBusiness Requirements Description:\n1.Information Maintenance:\nAgricultural experts maintain the monitoring rules for crops, environments, and other monitoring data. The system records the crop ID, crop name, and crop type.\n2.Data Collection:\nThe system collects continuous monitoring data from sensors, which includes sensor ID, temperature, rainfall, light intensity, and sensor location. After parsing, the system records the data type, collection time, and data value.\n3.Data Processing:\nReal-time monitoring data is analyzed according to the monitoring rules, and the analysis results are visualized and stored. Historical monitoring data is statistically processed and predicted, with the prediction results also visualized and stored.",
  "ddl": "-- Schema for database: rschema_0481\nCREATE TABLE `crop` (\n  `crop_id` int(11) NOT NULL AUTO_INCREMENT,\n  `crop_name` varchar(255) NOT NULL,\n  `crop_type` varchar(255) NOT NULL,\n  PRIMARY KEY (`crop_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `monitoring_rule` (\n  `rule_id` int(11) NOT NULL AUTO_INCREMENT,\n  `rule_name` varchar(255) NOT NULL,\n  `rule_type` varchar(50) NOT NULL,\n  `crop_id` int(11) DEFAULT NULL,\n  `environment_type` varchar(100) DEFAULT NULL,\n  `data_type` varchar(100) DEFAULT NULL,\n  `rule_content` text NOT NULL,\n  `created_at` datetime NOT NULL,\n  PRIMARY KEY (`rule_id`),\n  KEY `monitoring_rule_ibfk_1` (`crop_id`),\n  CONSTRAINT `monitoring_rule_ibfk_1` FOREIGN KEY (`crop_id`) REFERENCES `crop` (`crop_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `sensor` (\n  `sensor_id` int(11) NOT NULL AUTO_INCREMENT,\n  `temperature` decimal(10,2) DEFAULT NULL,\n  `rainfall` decimal(10,2) DEFAULT NULL,\n  `light_intensity` decimal(10,2) DEFAULT NULL,\n  `sensor_location` varchar(255) NOT NULL,\n  PRIMARY KEY (`sensor_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `sensor_data` (\n  `data_id` int(11) NOT NULL AUTO_INCREMENT,\n  `sensor_id` int(11) NOT NULL,\n  `data_type` varchar(100) NOT NULL,\n  `collection_time` datetime NOT NULL,\n  `data_value` decimal(18,4) NOT NULL,\n  PRIMARY KEY (`data_id`),\n  KEY `sensor_data_ibfk_1` (`sensor_id`),\n  CONSTRAINT `sensor_data_ibfk_1` FOREIGN KEY (`sensor_id`) REFERENCES `sensor` (`sensor_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `real_time_analysis_result` (\n  `result_id` int(11) NOT NULL AUTO_INCREMENT,\n  `data_id` int(11) NOT NULL,\n  `rule_id` int(11) NOT NULL,\n  `analysis_time` datetime NOT NULL,\n  `analysis_result` text NOT NULL,\n  `visualization_data` text DEFAULT NULL,\n  PRIMARY KEY (`result_id`),\n  KEY `real_time_analysis_result_ibfk_1` (`data_id`),\n  KEY `real_time_analysis_result_ibfk_2` (`rule_id`),\n  CONSTRAINT `real_time_analysis_result_ibfk_1` FOREIGN KEY (`data_id`) REFERENCES `sensor_data` (`data_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `real_time_analysis_result_ibfk_2` FOREIGN KEY (`rule_id`) REFERENCES `monitoring_rule` (`rule_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `historical_prediction_result` (\n  `prediction_id` int(11) NOT NULL AUTO_INCREMENT,\n  `sensor_id` int(11) NOT NULL,\n  `rule_id` int(11) DEFAULT NULL,\n  `statistical_period` varchar(100) NOT NULL,\n  `prediction_time` datetime NOT NULL,\n  `prediction_result` text NOT NULL,\n  `visualization_data` text DEFAULT NULL,\n  PRIMARY KEY (`prediction_id`),\n  KEY `historical_prediction_result_ibfk_1` (`sensor_id`),\n  KEY `historical_prediction_result_ibfk_2` (`rule_id`),\n  CONSTRAINT `historical_prediction_result_ibfk_1` FOREIGN KEY (`sensor_id`) REFERENCES `sensor` (`sensor_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `historical_prediction_result_ibfk_2` FOREIGN KEY (`rule_id`) REFERENCES `monitoring_rule` (`rule_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
