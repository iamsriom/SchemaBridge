  "question": "The Agricultural Supply Chain Management System needs to manage multiple suppliers and customers.\nEach supplier has a Supplier ID, name, address, contact information, and can supply multiple products.\nEach customer has a Customer ID, name, address, contact information, and can purchase multiple products.\nEach product has a Product ID, product name, and unit price.\nRecord the products that a supplier can supply.\nRecord each purchase, including the purchase date, Supplier ID, Customer ID, Product ID, and quantity.",
  "ddl": "-- Schema for database: rschema_0484\nCREATE TABLE `suppliers` (\n  `supplier_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `address` varchar(255) DEFAULT NULL,\n  `contact_information` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`supplier_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `customers` (\n  `customer_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `address` varchar(255) DEFAULT NULL,\n  `contact_information` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`customer_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `products` (\n  `product_id` int(11) NOT NULL,\n  `product_name` varchar(255) NOT NULL,\n  `unit_price` decimal(10,2) NOT NULL,\n  PRIMARY KEY (`product_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `supplier_products` (\n  `supplier_id` int(11) NOT NULL,\n  `product_id` int(11) NOT NULL,\n  PRIMARY KEY (`supplier_id`,`product_id`),\n  KEY `supplier_products_ibfk_2` (`product_id`),\n  CONSTRAINT `supplier_products_ibfk_1` FOREIGN KEY (`supplier_id`) REFERENCES `suppliers` (`supplier_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `supplier_products_ibfk_2` FOREIGN KEY (`product_id`) REFERENCES `products` (`product_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `purchases` (\n  `purchase_id` int(11) NOT NULL AUTO_INCREMENT,\n  `purchase_date` datetime NOT NULL,\n  `supplier_id` int(11) NOT NULL,\n  `customer_id` int(11) NOT NULL,\n  `product_id` int(11) NOT NULL,\n  `quantity` int(11) NOT NULL,\n  PRIMARY KEY (`purchase_id`),\n  KEY `purchases_ibfk_1` (`supplier_id`),\n  KEY `purchases_ibfk_2` (`customer_id`),\n  KEY `purchases_ibfk_3` (`product_id`),\n  CONSTRAINT `purchases_ibfk_1` FOREIGN KEY (`supplier_id`) REFERENCES `suppliers` (`supplier_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `purchases_ibfk_2` FOREIGN KEY (`customer_id`) REFERENCES `customers` (`customer_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `purchases_ibfk_3` FOREIGN KEY (`product_id`) REFERENCES `products` (`product_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
