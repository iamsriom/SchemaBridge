  "question": "This database is an internal employee management system for an enterprise\n\nMain functions\n\n1. Department management:\nAdd, delete, and modify department information\nQuery department list\n\n2. Position management:\nAdd, delete, and modify position information, including position name and salary\nQuery position list, which can be filtered by department\n\n3. Employee management:\nAdd, delete, and modify employee information, including name, position, and superior manager\nQuery employee list, which can be filtered by department, position, or superior manager\nGenerate employee hierarchy chart, showing each employee's direct superiors and subordinates\nCalculate employee total salary, by department or position\n\n4. Management relationship:\nManage the superior-subordinate relationship between employees\nQuery a certain employee's direct subordinates or direct superiors\n\n5. Report generation:\nGenerate salary report for department and position\nGenerate detailed information report for employees",
  "ddl": "-- Schema for database: rschema_0492\nCREATE TABLE `department` (\n  `department_id` int(11) NOT NULL AUTO_INCREMENT,\n  `department_name` varchar(255) NOT NULL,\n  `department_description` varchar(500) DEFAULT NULL,\n  PRIMARY KEY (`department_id`),\n  UNIQUE KEY `department_name` (`department_name`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `position` (\n  `position_id` int(11) NOT NULL AUTO_INCREMENT,\n  `department_id` int(11) NOT NULL,\n  `position_name` varchar(255) NOT NULL,\n  `salary` decimal(10,2) NOT NULL,\n  `position_description` varchar(500) DEFAULT NULL,\n  PRIMARY KEY (`position_id`),\n  KEY `department_id` (`department_id`),\n  CONSTRAINT `position_ibfk_1` FOREIGN KEY (`department_id`) REFERENCES `department` (`department_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `employee` (\n  `employee_id` int(11) NOT NULL AUTO_INCREMENT,\n  `employee_name` varchar(255) NOT NULL,\n  `department_id` int(11) NOT NULL,\n  `position_id` int(11) NOT NULL,\n  `hire_date` date DEFAULT NULL,\n  `email` varchar(255) DEFAULT NULL,\n  `phone` varchar(50) DEFAULT NULL,\n  `status` varchar(50) DEFAULT NULL,\n  PRIMARY KEY (`employee_id`),\n  KEY `department_id` (`department_id`),\n  KEY `position_id` (`position_id`),\n  CONSTRAINT `employee_ibfk_1` FOREIGN KEY (`department_id`) REFERENCES `department` (`department_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `employee_ibfk_2` FOREIGN KEY (`position_id`) REFERENCES `position` (`position_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `employee_relationship` (\n  `relationship_id` int(11) NOT NULL AUTO_INCREMENT,\n  `employee_id` int(11) NOT NULL,\n  `superior_employee_id` int(11) NOT NULL,\n  `relationship_type` varchar(50) NOT NULL DEFAULT 'direct',\n  PRIMARY KEY (`relationship_id`),\n  UNIQUE KEY `uk_employee_superior` (`employee_id`,`superior_employee_id`),\n  KEY `superior_employee_id` (`superior_employee_id`),\n  CONSTRAINT `employee_relationship_ibfk_1` FOREIGN KEY (`employee_id`) REFERENCES `employee` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `employee_relationship_ibfk_2` FOREIGN KEY (`superior_employee_id`) REFERENCES `employee` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
