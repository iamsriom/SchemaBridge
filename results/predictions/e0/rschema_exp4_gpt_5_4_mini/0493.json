  "question": "The business management system is described as follows:\nThe system manages multiple enterprises, with enterprise information including name and creation time.\nEach enterprise has multiple employees, with employee information including name, email, password, identification number, role, creation time, and update time.\nEach role has different hourly wages, daily working hours, and lunchtime.\nEach employee has multiple attendance records, with attendance record information including check-in time, remarks, and check-in location.\nAdditionally, employees can create to-do items, with to-do item information including task description, completion status, creation time, and update time.",
  "ddl": "-- Schema for database: rschema_0493\nCREATE TABLE `enterprise` (\n  `enterprise_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `created_at` datetime NOT NULL,\n  PRIMARY KEY (`enterprise_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `role` (\n  `role_id` int(11) NOT NULL AUTO_INCREMENT,\n  `role_name` varchar(255) NOT NULL,\n  `hourly_wage` decimal(10,2) NOT NULL,\n  `daily_working_hours` decimal(5,2) NOT NULL,\n  `lunch_time` time NOT NULL,\n  PRIMARY KEY (`role_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `employee` (\n  `employee_id` int(11) NOT NULL AUTO_INCREMENT,\n  `enterprise_id` int(11) NOT NULL,\n  `role_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `email` varchar(255) NOT NULL,\n  `password` varchar(255) NOT NULL,\n  `identification_number` varchar(50) NOT NULL,\n  `created_at` datetime NOT NULL,\n  `updated_at` datetime NOT NULL,\n  PRIMARY KEY (`employee_id`),\n  UNIQUE KEY `uk_employee_email` (`email`),\n  UNIQUE KEY `uk_employee_identification_number` (`identification_number`),\n  KEY `employee_ibfk_1` (`enterprise_id`),\n  KEY `employee_ibfk_2` (`role_id`),\n  CONSTRAINT `employee_ibfk_1` FOREIGN KEY (`enterprise_id`) REFERENCES `enterprise` (`enterprise_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `employee_ibfk_2` FOREIGN KEY (`role_id`) REFERENCES `role` (`role_id`) ON DELETE RESTRICT ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `attendance_record` (\n  `attendance_record_id` int(11) NOT NULL AUTO_INCREMENT,\n  `employee_id` int(11) NOT NULL,\n  `check_in_time` datetime NOT NULL,\n  `remarks` varchar(255) DEFAULT NULL,\n  `check_in_location` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`attendance_record_id`),\n  KEY `attendance_record_ibfk_1` (`employee_id`),\n  CONSTRAINT `attendance_record_ibfk_1` FOREIGN KEY (`employee_id`) REFERENCES `employee` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `todo_item` (\n  `todo_item_id` int(11) NOT NULL AUTO_INCREMENT,\n  `employee_id` int(11) NOT NULL,\n  `task_description` varchar(255) NOT NULL,\n  `completion_status` tinyint(1) NOT NULL DEFAULT '0',\n  `created_at` datetime NOT NULL,\n  `updated_at` datetime NOT NULL,\n  PRIMARY KEY (`todo_item_id`),\n  KEY `todo_item_ibfk_1` (`employee_id`),\n  CONSTRAINT `todo_item_ibfk_1` FOREIGN KEY (`employee_id`) REFERENCES `employee` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
