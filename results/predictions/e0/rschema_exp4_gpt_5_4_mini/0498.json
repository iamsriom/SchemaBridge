  "question": "System Description\nDescribes a school management system\n\nMain functions of the system\n1: Student management: including basic information of students (such as student ID, name, gender, age) and accommodation information (such as dormitory number, building number, number of people, administrator)\n2: Class management: including basic information of classes (such as class number) and classroom information\n3: Sports team management: including basic information of sports teams (such as team name, activity time, coach, activity venue)\n4: School management: including basic information of schools (such as school name) and information of sports teams",
  "ddl": "-- Schema for database: rschema_0498\nCREATE TABLE `school` (\n  `school_id` int(11) NOT NULL AUTO_INCREMENT,\n  `school_name` varchar(255) NOT NULL,\n  PRIMARY KEY (`school_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `classroom` (\n  `classroom_id` int(11) NOT NULL AUTO_INCREMENT,\n  `classroom_number` varchar(50) NOT NULL,\n  `building_number` varchar(50) DEFAULT NULL,\n  `capacity` int(11) DEFAULT NULL,\n  PRIMARY KEY (`classroom_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `class_info` (\n  `class_id` int(11) NOT NULL AUTO_INCREMENT,\n  `class_number` varchar(50) NOT NULL,\n  `classroom_id` int(11) DEFAULT NULL,\n  PRIMARY KEY (`class_id`),\n  KEY `class_info_ibfk_1` (`classroom_id`),\n  CONSTRAINT `class_info_ibfk_1` FOREIGN KEY (`classroom_id`) REFERENCES `classroom` (`classroom_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `sports_team` (\n  `team_id` int(11) NOT NULL AUTO_INCREMENT,\n  `team_name` varchar(255) NOT NULL,\n  `activity_time` datetime DEFAULT NULL,\n  `coach` varchar(255) DEFAULT NULL,\n  `activity_venue` varchar(255) DEFAULT NULL,\n  `school_id` int(11) DEFAULT NULL,\n  PRIMARY KEY (`team_id`),\n  KEY `sports_team_ibfk_1` (`school_id`),\n  CONSTRAINT `sports_team_ibfk_1` FOREIGN KEY (`school_id`) REFERENCES `school` (`school_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `student` (\n  `student_id` int(11) NOT NULL AUTO_INCREMENT,\n  `student_number` varchar(50) NOT NULL,\n  `student_name` varchar(255) NOT NULL,\n  `gender` varchar(10) DEFAULT NULL,\n  `age` int(11) DEFAULT NULL,\n  `dormitory_number` varchar(50) DEFAULT NULL,\n  `building_number` varchar(50) DEFAULT NULL,\n  `people_count` int(11) DEFAULT NULL,\n  `administrator` varchar(255) DEFAULT NULL,\n  `class_id` int(11) DEFAULT NULL,\n  PRIMARY KEY (`student_id`),\n  KEY `student_ibfk_1` (`class_id`),\n  CONSTRAINT `student_ibfk_1` FOREIGN KEY (`class_id`) REFERENCES `class_info` (`class_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
