  "database": "rschema_0499",
  "question": "This is a student management system. The system manages student information (student ID, name, gender, age, etc.), class information (class name, major, classroom, etc.), sports team information (team name, activity time, coach, etc.), and dormitory information (dormitory number, building number, administrator, number of residents, etc.). The system also maintains the relationships between students and classes, students and sports teams, and students and dormitories.",
  "ddl": "-- Schema for database: rschema_0499\nCREATE TABLE `classes` (\n  `class_id` int(11) NOT NULL AUTO_INCREMENT,\n  `class_name` varchar(255) NOT NULL,\n  `major` varchar(255) DEFAULT NULL,\n  `classroom` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`class_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `dormitories` (\n  `dormitory_id` int(11) NOT NULL AUTO_INCREMENT,\n  `dormitory_number` varchar(50) NOT NULL,\n  `building_number` varchar(50) DEFAULT NULL,\n  `administrator` varchar(255) DEFAULT NULL,\n  `resident_count` int(11) DEFAULT NULL,\n  PRIMARY KEY (`dormitory_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `sports_teams` (\n  `team_id` int(11) NOT NULL AUTO_INCREMENT,\n  `team_name` varchar(255) NOT NULL,\n  `activity_time` varchar(255) DEFAULT NULL,\n  `coach` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`team_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `students` (\n  `student_id` int(11) NOT NULL AUTO_INCREMENT,\n  `student_number` varchar(50) NOT NULL,\n  `student_name` varchar(255) NOT NULL,\n  `gender` varchar(10) DEFAULT NULL,\n  `age` int(11) DEFAULT NULL,\n  PRIMARY KEY (`student_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `student_classes` (\n  `student_class_id` int(11) NOT NULL AUTO_INCREMENT,\n  `student_id` int(11) NOT NULL,\n  `class_id` int(11) NOT NULL,\n  PRIMARY KEY (`student_class_id`),\n  KEY `student_classes_ibfk_1` (`student_id`),\n  KEY `student_classes_ibfk_2` (`class_id`),\n  CONSTRAINT `student_classes_ibfk_1` FOREIGN KEY (`student_id`) REFERENCES `students` (`student_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `student_classes_ibfk_2` FOREIGN KEY (`class_id`) REFERENCES `classes` (`class_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `student_sports_teams` (\n  `student_sports_team_id` int(11) NOT NULL AUTO_INCREMENT,\n  `student_id` int(11) NOT NULL,\n  `team_id` int(11) NOT NULL,\n  PRIMARY KEY (`student_sports_team_id`),\n  KEY `student_sports_teams_ibfk_1` (`student_id`),\n  KEY `student_sports_teams_ibfk_2` (`team_id`),\n  CONSTRAINT `student_sports_teams_ibfk_1` FOREIGN KEY (`student_id`) REFERENCES `students` (`student_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `student_sports_teams_ibfk_2` FOREIGN KEY (`team_id`) REFERENCES `sports_teams` (`team_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `student_dormitories` (\n  `student_dormitory_id` int(11) NOT NULL AUTO_INCREMENT,\n  `student_id` int(11) NOT NULL,\n  `dormitory_id` int(11) NOT NULL,\n  PRIMARY KEY (`student_dormitory_id`),\n  KEY `student_dormitories_ibfk_1` (`student_id`),\n  KEY `student_dormitories_ibfk_2` (`dormitory_id`),\n  CONSTRAINT `student_dormitories_ibfk_1` FOREIGN KEY (`student_id`) REFERENCES `students` (`student_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `student_dormitories_ibfk_2` FOREIGN KEY (`dormitory_id`) REFERENCES `dormitories` (`dormitory_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
