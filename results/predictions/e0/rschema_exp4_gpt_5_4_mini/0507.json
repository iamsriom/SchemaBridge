  "question": "The website content system shall record each user's account information (including username, password, role, etc.) and ensure secure access by generating and validating tokens after login or registration. For the content to be managed, the system shall separately store basic information (such as title, type, creation and update time, etc.), text and image content (text, image links, etc.), and video content (video link, thumbnail, video duration, play count, etc.) to enable flexible composition and display. When performing data analysis, the system shall store user video play counts during different time periods to facilitate statistics, recommendations, or adjustments to placement strategies.",
  "ddl": "-- Schema for database: rschema_0507\nCREATE TABLE `user_account` (\n  `user_id` int(11) NOT NULL AUTO_INCREMENT,\n  `username` varchar(100) NOT NULL,\n  `password` varchar(255) NOT NULL,\n  `role` varchar(50) NOT NULL,\n  `created_at` datetime NOT NULL,\n  `updated_at` datetime NOT NULL,\n  PRIMARY KEY (`user_id`),\n  UNIQUE KEY `uk_user_account_username` (`username`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `auth_token` (\n  `token_id` int(11) NOT NULL AUTO_INCREMENT,\n  `user_id` int(11) NOT NULL,\n  `token` varchar(255) NOT NULL,\n  `issued_at` datetime NOT NULL,\n  `expires_at` datetime NOT NULL,\n  `is_valid` tinyint(1) NOT NULL DEFAULT '1',\n  PRIMARY KEY (`token_id`),\n  UNIQUE KEY `uk_auth_token_token` (`token`),\n  KEY `auth_token_ibfk_1` (`user_id`),\n  CONSTRAINT `auth_token_ibfk_1` FOREIGN KEY (`user_id`) REFERENCES `user_account` (`user_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `content_basic` (\n  `content_id` int(11) NOT NULL AUTO_INCREMENT,\n  `title` varchar(255) NOT NULL,\n  `content_type` varchar(50) NOT NULL,\n  `created_at` datetime NOT NULL,\n  `updated_at` datetime NOT NULL,\n  PRIMARY KEY (`content_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `content_text_image` (\n  `content_id` int(11) NOT NULL,\n  `text_content` text DEFAULT NULL,\n  `image_url` varchar(500) DEFAULT NULL,\n  PRIMARY KEY (`content_id`),\n  CONSTRAINT `content_text_image_ibfk_1` FOREIGN KEY (`content_id`) REFERENCES `content_basic` (`content_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `content_video` (\n  `content_id` int(11) NOT NULL,\n  `video_url` varchar(500) DEFAULT NULL,\n  `thumbnail_url` varchar(500) DEFAULT NULL,\n  `video_duration` int(11) DEFAULT NULL,\n  `play_count` int(11) NOT NULL DEFAULT '0',\n  PRIMARY KEY (`content_id`),\n  CONSTRAINT `content_video_ibfk_1` FOREIGN KEY (`content_id`) REFERENCES `content_basic` (`content_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `user_video_play_stats` (\n  `stat_id` int(11) NOT NULL AUTO_INCREMENT,\n  `user_id` int(11) NOT NULL,\n  `content_id` int(11) NOT NULL,\n  `period_start` datetime NOT NULL,\n  `period_end` datetime NOT NULL,\n  `play_count` int(11) NOT NULL DEFAULT '0',\n  PRIMARY KEY (`stat_id`),\n  KEY `user_video_play_stats_ibfk_1` (`user_id`),\n  KEY `user_video_play_stats_ibfk_2` (`content_id`),\n  CONSTRAINT `user_video_play_stats_ibfk_1` FOREIGN KEY (`user_id`) REFERENCES `user_account` (`user_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `user_video_play_stats_ibfk_2` FOREIGN KEY (`content_id`) REFERENCES `content_basic` (`content_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
