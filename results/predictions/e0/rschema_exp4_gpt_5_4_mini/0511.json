  "question": "System name: Community property fee management system\n\nDemand function description:\n1. Owner management:\nAdd owner record: record the basic information of the owner, including owner number, name, room number, house area, work unit, contact number, etc.\nQuery owner information: query the owner's information according to the room number.\n\n2. Department management:\nAdd department record: record the basic information of the department, including department number, department name, department head, department phone number, etc.\nQuery department information: query department information according to department number.\n\n3. Employee management:\nAdd employee record: record the basic information of employees, including employee number, name, date of birth, gender, address, contact number, department number, position and password, etc.\nQuery employee information: query employee information according to employee number.\nPermission management: employees can have different permissions according to their positions. Employees with the position of \"Manager\" can change the information of employees in this department, and employees with the position of \"Charge\" can only perform charging operations.\n\n4. Charge management:\nRecord charge information: including room number, owner number, charge date, charge type, quantity, charge amount, employee number, etc.\nGenerate charge slip: Generate charge slip based on charge information and record charge status.",
  "ddl": "-- Schema for database: rschema_0511\nCREATE TABLE `department` (\n  `department_id` int(11) NOT NULL AUTO_INCREMENT,\n  `department_name` varchar(100) NOT NULL,\n  `department_head` varchar(100) DEFAULT NULL,\n  `department_phone` varchar(20) DEFAULT NULL,\n  PRIMARY KEY (`department_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `employee` (\n  `employee_id` int(11) NOT NULL AUTO_INCREMENT,\n  `employee_no` varchar(50) NOT NULL,\n  `employee_name` varchar(100) NOT NULL,\n  `date_of_birth` date DEFAULT NULL,\n  `gender` varchar(10) DEFAULT NULL,\n  `address` varchar(255) DEFAULT NULL,\n  `contact_number` varchar(20) DEFAULT NULL,\n  `department_id` int(11) NOT NULL,\n  `position` varchar(50) NOT NULL,\n  `password` varchar(255) NOT NULL,\n  PRIMARY KEY (`employee_id`),\n  UNIQUE KEY `uk_employee_no` (`employee_no`),\n  KEY `employee_ibfk_1` (`department_id`),\n  CONSTRAINT `employee_ibfk_1` FOREIGN KEY (`department_id`) REFERENCES `department` (`department_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `owner` (\n  `owner_id` int(11) NOT NULL AUTO_INCREMENT,\n  `owner_no` varchar(50) NOT NULL,\n  `owner_name` varchar(100) NOT NULL,\n  `room_no` varchar(50) NOT NULL,\n  `house_area` decimal(10,2) DEFAULT NULL,\n  `work_unit` varchar(255) DEFAULT NULL,\n  `contact_number` varchar(20) DEFAULT NULL,\n  PRIMARY KEY (`owner_id`),\n  UNIQUE KEY `uk_owner_no` (`owner_no`),\n  UNIQUE KEY `uk_owner_room_no` (`room_no`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `charge_record` (\n  `charge_id` int(11) NOT NULL AUTO_INCREMENT,\n  `room_no` varchar(50) NOT NULL,\n  `owner_no` varchar(50) NOT NULL,\n  `charge_date` datetime NOT NULL,\n  `charge_type` varchar(100) NOT NULL,\n  `quantity` decimal(10,2) DEFAULT NULL,\n  `charge_amount` decimal(10,2) NOT NULL,\n  `employee_no` varchar(50) NOT NULL,\n  `charge_status` varchar(20) NOT NULL DEFAULT 'unpaid',\n  PRIMARY KEY (`charge_id`),\n  KEY `charge_record_ibfk_1` (`owner_no`),\n  KEY `charge_record_ibfk_2` (`employee_no`),\n  CONSTRAINT `charge_record_ibfk_1` FOREIGN KEY (`owner_no`) REFERENCES `owner` (`owner_no`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `charge_record_ibfk_2` FOREIGN KEY (`employee_no`) REFERENCES `employee` (`employee_no`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
