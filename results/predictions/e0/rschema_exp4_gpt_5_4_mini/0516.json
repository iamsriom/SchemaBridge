  "question": "Business Requirements:\n1.Customer: Each customer needs to record basic information, including Customer ID, Name, Phone, and Address.\n2.Sales Order: Each customer can have multiple sales orders. Each sales order contains Order ID, Customer ID, Pizza ID, Quantity, Expected Delivery Date, and Order Status.\n3.Pizza: Each type of pizza needs to record Pizza ID, Flavor, Ingredients, and Stock. Pizza ID is the Primary key used to uniquely identify each pizza.\n4.Production Plan: A production plan is generated based on sales orders. Each production plan records Order ID, Pizza ID, Production Sequence, and Production Quantity.\n5.Income/Expenditure: Records each income or expenditure. The record includes Record ID, Type (Income or Expenditure), Amount, Time, Description, and the related Pizza ID. Each income/expenditure record can be associated with multiple pizzas, for tracking and analyzing financial data related to pizzas.\n6.Delivery Content: Records the delivery information for each order, including Record ID, Order ID, Delivery Time, and Delivery Status. Each delivery record is associated with a sales order and records the delivery details.",
  "ddl": "-- Schema for database: rschema_0516\nCREATE TABLE `customer` (\n  `customer_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `phone` varchar(50) DEFAULT NULL,\n  `address` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`customer_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `pizza` (\n  `pizza_id` int(11) NOT NULL,\n  `flavor` varchar(255) NOT NULL,\n  `ingredients` varchar(500) DEFAULT NULL,\n  `stock` int(11) NOT NULL DEFAULT 0,\n  PRIMARY KEY (`pizza_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `sales_order` (\n  `order_id` int(11) NOT NULL,\n  `customer_id` int(11) NOT NULL,\n  `pizza_id` int(11) NOT NULL,\n  `quantity` int(11) NOT NULL,\n  `expected_delivery_date` datetime DEFAULT NULL,\n  `order_status` varchar(50) NOT NULL,\n  PRIMARY KEY (`order_id`),\n  KEY `sales_order_ibfk_1` (`customer_id`),\n  KEY `sales_order_ibfk_2` (`pizza_id`),\n  CONSTRAINT `sales_order_ibfk_1` FOREIGN KEY (`customer_id`) REFERENCES `customer` (`customer_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `sales_order_ibfk_2` FOREIGN KEY (`pizza_id`) REFERENCES `pizza` (`pizza_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `production_plan` (\n  `order_id` int(11) NOT NULL,\n  `pizza_id` int(11) NOT NULL,\n  `production_sequence` int(11) NOT NULL,\n  `production_quantity` int(11) NOT NULL,\n  PRIMARY KEY (`order_id`, `pizza_id`, `production_sequence`),\n  KEY `production_plan_ibfk_1` (`order_id`),\n  KEY `production_plan_ibfk_2` (`pizza_id`),\n  CONSTRAINT `production_plan_ibfk_1` FOREIGN KEY (`order_id`) REFERENCES `sales_order` (`order_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `production_plan_ibfk_2` FOREIGN KEY (`pizza_id`) REFERENCES `pizza` (`pizza_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `income_expenditure` (\n  `record_id` int(11) NOT NULL,\n  `type` varchar(20) NOT NULL,\n  `amount` decimal(10,2) NOT NULL,\n  `time` datetime NOT NULL,\n  `description` varchar(500) DEFAULT NULL,\n  `pizza_id` int(11) NOT NULL,\n  PRIMARY KEY (`record_id`),\n  KEY `income_expenditure_ibfk_1` (`pizza_id`),\n  CONSTRAINT `income_expenditure_ibfk_1` FOREIGN KEY (`pizza_id`) REFERENCES `pizza` (`pizza_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `income_expenditure_pizza` (\n  `record_id` int(11) NOT NULL,\n  `pizza_id` int(11) NOT NULL,\n  PRIMARY KEY (`record_id`, `pizza_id`),\n  KEY `income_expenditure_pizza_ibfk_1` (`record_id`),\n  KEY `income_expenditure_pizza_ibfk_2` (`pizza_id`),\n  CONSTRAINT `income_expenditure_pizza_ibfk_1` FOREIGN KEY (`record_id`) REFERENCES `income_expenditure` (`record_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `income_expenditure_pizza_ibfk_2` FOREIGN KEY (`pizza_id`) REFERENCES `pizza` (`pizza_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `delivery_content` (\n  `record_id` int(11) NOT NULL,\n  `order_id` int(11) NOT NULL,\n  `delivery_time` datetime DEFAULT NULL,\n  `delivery_status` varchar(50) NOT NULL,\n  PRIMARY KEY (`record_id`),\n  KEY `delivery_content_ibfk_1` (`order_id`),\n  CONSTRAINT `delivery_content_ibfk_1` FOREIGN KEY (`order_id`) REFERENCES `sales_order` (`order_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
