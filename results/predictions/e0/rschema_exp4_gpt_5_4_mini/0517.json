  "database": "rschema_0517",
  "question": "This is a supermarket management system. For supermarket management, the system records basic information for each supermarket, including unique supermarket name, manager, address and phone number. For department management, each supermarket has multiple departments, and the system records basic information for each department, including unique department name and manager, with each department responsible for managing its own employees. For employee management, the system records basic information for each employee, including unique employee ID, name, position, contact information and salary, with each employee belonging to only one department. For product management, the system records basic information for each product, including unique product ID, product name, model, unit price and quantity. Sales representatives are responsible for the allocation of multiple products, and the system records the time and quantity of each allocation.",
  "ddl": "-- Schema for database: rschema_0517\nCREATE TABLE `supermarket` (\n  `supermarket_id` int(11) NOT NULL AUTO_INCREMENT,\n  `supermarket_name` varchar(255) NOT NULL,\n  `manager` varchar(255) NOT NULL,\n  `address` varchar(255) NOT NULL,\n  `phone_number` varchar(20) NOT NULL,\n  PRIMARY KEY (`supermarket_id`),\n  UNIQUE KEY `uk_supermarket_name` (`supermarket_name`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `department` (\n  `department_id` int(11) NOT NULL AUTO_INCREMENT,\n  `supermarket_id` int(11) NOT NULL,\n  `department_name` varchar(255) NOT NULL,\n  `manager` varchar(255) NOT NULL,\n  PRIMARY KEY (`department_id`),\n  UNIQUE KEY `uk_department_name` (`department_name`),\n  KEY `department_ibfk_1` (`supermarket_id`),\n  CONSTRAINT `department_ibfk_1` FOREIGN KEY (`supermarket_id`) REFERENCES `supermarket` (`supermarket_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `employee` (\n  `employee_id` varchar(50) NOT NULL,\n  `department_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `position` varchar(255) NOT NULL,\n  `contact_information` varchar(255) DEFAULT NULL,\n  `salary` decimal(10,2) NOT NULL,\n  PRIMARY KEY (`employee_id`),\n  KEY `employee_ibfk_1` (`department_id`),\n  CONSTRAINT `employee_ibfk_1` FOREIGN KEY (`department_id`) REFERENCES `department` (`department_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `product` (\n  `product_id` varchar(50) NOT NULL,\n  `product_name` varchar(255) NOT NULL,\n  `model` varchar(255) DEFAULT NULL,\n  `unit_price` decimal(10,2) NOT NULL,\n  `quantity` int(11) NOT NULL,\n  PRIMARY KEY (`product_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `sales_allocation` (\n  `allocation_id` int(11) NOT NULL AUTO_INCREMENT,\n  `employee_id` varchar(50) NOT NULL,\n  `product_id` varchar(50) NOT NULL,\n  `allocation_time` datetime NOT NULL,\n  `quantity` int(11) NOT NULL,\n  PRIMARY KEY (`allocation_id`),\n  KEY `sales_allocation_ibfk_1` (`employee_id`),\n  KEY `sales_allocation_ibfk_2` (`product_id`),\n  CONSTRAINT `sales_allocation_ibfk_1` FOREIGN KEY (`employee_id`) REFERENCES `employee` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `sales_allocation_ibfk_2` FOREIGN KEY (`product_id`) REFERENCES `product` (`product_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
