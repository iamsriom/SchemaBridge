  "database": "rschema_0518",
  "question": "Business Requirements:\n1.Maze: Each maze needs to record its basic information, including Maze ID, Maze Name, and Maze File Path.\n2.Robot: Each robot needs to record its basic information, including Robot ID, Robot Type, Current Position, Timer Status, and Maze ID. Robot ID is the unique identifier for each robot, and Maze ID is a Foreign key pointing to the Maze ID in the Maze table.\n3.Forward Sensor: Each forward sensor needs to record its basic information, including Sensor ID, Robot ID, Left Status, Right Status, and Front Status.\n4.Proximity Sensor: Each proximity sensor needs to record its basic information, including Sensor ID, Robot ID, Coin Status, and Ghost Status.\n5.Timer: Each timer needs to record its basic information, including Timer ID, Robot ID, Timer Event Description, and Timer Event Time.\n6.User: Each user needs to record their basic information, including User ID, Name, and Contact Information.\n7.User Robot Operation: Each user can perform operations on a robot. This operation records User ID, Operation Type, Operation Time, and Robot ID.",
  "ddl": "-- Schema for database: rschema_0518\nCREATE TABLE `maze` (\n  `maze_id` int(11) NOT NULL,\n  `maze_name` varchar(255) NOT NULL,\n  `maze_file_path` varchar(255) NOT NULL,\n  PRIMARY KEY (`maze_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `robot` (\n  `robot_id` int(11) NOT NULL,\n  `robot_type` varchar(255) NOT NULL,\n  `current_position` varchar(255) NOT NULL,\n  `timer_status` varchar(255) NOT NULL,\n  `maze_id` int(11) NOT NULL,\n  PRIMARY KEY (`robot_id`),\n  KEY `robot_ibfk_1` (`maze_id`),\n  CONSTRAINT `robot_ibfk_1` FOREIGN KEY (`maze_id`) REFERENCES `maze` (`maze_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `forward_sensor` (\n  `sensor_id` int(11) NOT NULL,\n  `robot_id` int(11) NOT NULL,\n  `left_status` varchar(255) NOT NULL,\n  `right_status` varchar(255) NOT NULL,\n  `front_status` varchar(255) NOT NULL,\n  PRIMARY KEY (`sensor_id`),\n  KEY `forward_sensor_ibfk_1` (`robot_id`),\n  CONSTRAINT `forward_sensor_ibfk_1` FOREIGN KEY (`robot_id`) REFERENCES `robot` (`robot_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `proximity_sensor` (\n  `sensor_id` int(11) NOT NULL,\n  `robot_id` int(11) NOT NULL,\n  `coin_status` varchar(255) NOT NULL,\n  `ghost_status` varchar(255) NOT NULL,\n  PRIMARY KEY (`sensor_id`),\n  KEY `proximity_sensor_ibfk_1` (`robot_id`),\n  CONSTRAINT `proximity_sensor_ibfk_1` FOREIGN KEY (`robot_id`) REFERENCES `robot` (`robot_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `timer` (\n  `timer_id` int(11) NOT NULL,\n  `robot_id` int(11) NOT NULL,\n  `timer_event_description` varchar(255) NOT NULL,\n  `timer_event_time` datetime NOT NULL,\n  PRIMARY KEY (`timer_id`),\n  KEY `timer_ibfk_1` (`robot_id`),\n  CONSTRAINT `timer_ibfk_1` FOREIGN KEY (`robot_id`) REFERENCES `robot` (`robot_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `user` (\n  `user_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `contact_information` varchar(255) NOT NULL,\n  PRIMARY KEY (`user_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `user_robot_operation` (\n  `user_id` int(11) NOT NULL,\n  `operation_type` varchar(255) NOT NULL,\n  `operation_time` datetime NOT NULL,\n  `robot_id` int(11) NOT NULL,\n  KEY `user_robot_operation_ibfk_1` (`user_id`),\n  KEY `user_robot_operation_ibfk_2` (`robot_id`),\n  CONSTRAINT `user_robot_operation_ibfk_1` FOREIGN KEY (`user_id`) REFERENCES `user` (`user_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `user_robot_operation_ibfk_2` FOREIGN KEY (`robot_id`) REFERENCES `robot` (`robot_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
