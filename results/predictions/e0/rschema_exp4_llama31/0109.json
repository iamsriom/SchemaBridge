  "database": "rschema_0109",
  "question": "The membership management system shall record each member's country code, name (with optional pronunciation), and company name, allowing the option to set whether this information is publicly accessible. To expedite the retrieval of certain member information, these details shall be cached in a data cache table. The system shall also manage multiple address entries for each member, with each address containing detailed information such as country, postal code, specific address, and telephone number.",
  "ddl": "-- Schema for database: rschema_0109\nCREATE TABLE `members` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `country_code` char(3) NOT NULL,\n  `name` varchar(255) DEFAULT NULL,\n  `pronunciation` varchar(255) DEFAULT NULL,\n  `company_name` varchar(255) DEFAULT NULL,\n  `publicly_accessible` tinyint(1) NOT NULL DEFAULT 0,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `name_unique` (`name`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `member_addresses` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `member_id` int(11) NOT NULL,\n  `country` char(3) NOT NULL,\n  `postal_code` char(10) NOT NULL,\n  `address` varchar(255) NOT NULL,\n  `telephone_number` char(20) NOT NULL,\n  PRIMARY KEY (`id`),\n  KEY `member_id_foreign` (`member_id`),\n  CONSTRAINT `member_id_foreign` FOREIGN KEY (`member_id`) REFERENCES `members` (`id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `data_cache` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `member_id` int(11) NOT NULL,\n  `country_code` char(3) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  PRIMARY KEY (`id`),\n  KEY `member_id_foreign_1` (`member_id`),\n  CONSTRAINT `member_id_foreign_1` FOREIGN KEY (`member_id`) REFERENCES `members` (`id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
