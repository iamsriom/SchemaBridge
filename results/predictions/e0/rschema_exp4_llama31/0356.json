  "question": "Business Requirements Description:\nThis system is designed for managing work items, with the following core functionalities:\nStores the Attributes for each work item, including Attributes name, Attributes value, and link status.\nRecords the work item’s ID, name, description, creation date, update date, and other relevant information.\nTracks the link status of work items, which can be used to record the current status or related information about the work item.",
  "ddl": "-- Schema for database: rschema_0356\nCREATE TABLE `work_items` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `description` text,\n  `creation_date` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  `update_date` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,\n  PRIMARY KEY (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `attributes` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `work_item_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `value` varchar(255) NOT NULL,\n  `link_status` tinyint(1) NOT NULL DEFAULT 0,\n  PRIMARY KEY (`id`),\n  KEY `work_item_id` (`work_item_id`),\n  CONSTRAINT `attributes_ibfk_1` FOREIGN KEY (`work_item_id`) REFERENCES `work_items` (`id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `link_status` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `work_item_id` int(11) NOT NULL,\n  `status` varchar(255) NOT NULL,\n  PRIMARY KEY (`id`),\n  KEY `work_item_id` (`work_item_id`),\n  CONSTRAINT `link_status_ibfk_1` FOREIGN KEY (`work_item_id`) REFERENCES `work_items` (`id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
