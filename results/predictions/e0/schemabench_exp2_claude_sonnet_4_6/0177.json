  "question": "Background / Context\n\nThe project entails the development of a relational database system focused on managing employee data, departmental structures, job titles, and salary history within an organization. This database provides a robust and scalable solution for efficiently storing, querying, and updating both historical and current information relevant to employees and their roles across various departments.\n\nObjectives\n\nThe primary objective is to implement a database system that centralizes employee information, including department assignments, managerial roles, salaries, and job titles. The system aims to ensure data integrity, support historical data tracking, and facilitate easy retrieval of employee-related data for reporting and decision-making purposes.\n\nStakeholders & Users\n\n- Stakeholders: Human Resources, Management, IT Department\n- Users: HR Personnel, Department Managers, System Administrators\n\nFunctional Descriptions\n\n1. Employee Management: \n   - Store personal and employment-related information, including birth date, hire date, and gender.\n   - Maintain a unique identifier for each employee.\n\n2. Department Management: \n   - Define structures and store information about departments, including department numbers and names.\n\n3. Role and Salary Management:\n   - Track job titles and their duration for each employee.\n   - Manage salary information with historical records of salary changes over time.\n\n4. Departmental Association:\n   - Record and manage employee assignments to departments.\n   - Track managerial roles within departments, with clarity on tenure.\n\n5. Data Referencing and Integrity:\n   - Ensure data consistency through the use of foreign key relationships between tables.\n\nNon-Functional Descriptions\n\n- Scalability: The system should accommodate growth in employee count and departmental complexity.\n- Performance: Optimize for efficient querying and data retrieval.\n- Security: Implement measures to protect sensitive employee data and ensure compliance with data protection regulations.\n- Reliability: Ensure data accuracy and system availability with minimal downtime.",
  "ddl": "-- Schema for database: schemabench_0177\n\nCREATE TABLE `employees` (\n  `emp_no` int(11) NOT NULL,\n  `birth_date` date NOT NULL,\n  `first_name` varchar(14) NOT NULL,\n  `last_name` varchar(16) NOT NULL,\n  `gender` char(1) NOT NULL,\n  `hire_date` date NOT NULL,\n  PRIMARY KEY (`emp_no`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `departments` (\n  `dept_no` char(4) NOT NULL,\n  `dept_name` varchar(40) NOT NULL,\n  PRIMARY KEY (`dept_no`),\n  UNIQUE KEY `dept_name` (`dept_name`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `dept_emp` (\n  `emp_no` int(11) NOT NULL,\n  `dept_no` char(4) NOT NULL,\n  `from_date` date NOT NULL,\n  `to_date` date NOT NULL,\n  PRIMARY KEY (`emp_no`, `dept_no`),\n  CONSTRAINT `dept_emp_ibfk_1` FOREIGN KEY (`emp_no`) REFERENCES `employees` (`emp_no`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `dept_emp_ibfk_2` FOREIGN KEY (`dept_no`) REFERENCES `departments` (`dept_no`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `dept_manager` (\n  `emp_no` int(11) NOT NULL,\n  `dept_no` char(4) NOT NULL,\n  `from_date` date NOT NULL,\n  `to_date` date NOT NULL,\n  PRIMARY KEY (`emp_no`, `dept_no`),\n  CONSTRAINT `dept_manager_ibfk_1` FOREIGN KEY (`emp_no`) REFERENCES `employees` (`emp_no`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `dept_manager_ibfk_2` FOREIGN KEY (`dept_no`) REFERENCES `departments` (`dept_no`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `titles` (\n  `emp_no` int(11) NOT NULL,\n  `title` varchar(50) NOT NULL,\n  `from_date` date NOT NULL,\n  `to_date` date DEFAULT NULL,\n  PRIMARY KEY (`emp_no`, `title`, `from_date`),\n  CONSTRAINT `titles_ibfk_1` FOREIGN KEY (`emp_no`) REFERENCES `employees` (`emp_no`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `salaries` (\n  `emp_no` int(11) NOT NULL,\n  `salary` int(11) NOT NULL,\n  `from_date` date NOT NULL,\n  `to_date` date NOT NULL,\n  PRIMARY KEY (`emp_no`, `from_date`),\n  CONSTRAINT `salaries_ibfk_1` FOREIGN KEY (`emp_no`) REFERENCES `employees` (`emp_no`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
