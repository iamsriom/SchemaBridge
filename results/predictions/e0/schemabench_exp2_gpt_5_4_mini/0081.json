  "question": "1. Background / Context\n\nLaravel Jetstream is an application starter kit for Laravel 8, designed to quickly scaffold new applications with aesthetically pleasing frontend interfaces using Tailwind CSS. It provides a robust foundation for building modern applications by integrating essential features such as authentication, session management, and API support.\n\n 2. Objectives\n\nThe primary objective of Laravel Jetstream is to offer developers a convenient starting point for Laravel applications with pre-built features, ensuring a streamlined development process. By utilizing either Livewire or Inertia.js for frontend scaffolding, Jetstream aims to boost productivity and maintain flexibility in application development.\n\n 3. Stakeholders & Users\n\n- Developers: Primary users who will use Jetstream to kickstart Laravel application development.\n- End Users: Indirect beneficiaries who will interact with applications developed using Jetstream.\n- Administrators: Users managing team settings and application configurations.\n\n 4. Functional Descriptions\n\n- Authentication: Provides user login, registration, and email verification.\n- Two-Factor Authentication: Ensures enhanced security for user accounts.\n- Session Management: Manages user sessions efficiently across devices.\n- API Support: Facilitated by Laravel Sanctum for easy integration and management of APIs.\n- Team Management: Optional functionality allowing users to collaborate as teams.\n- Frontend Options: Choice between Livewire and Inertia.js for interacting with the application.\n\n 5. Non-Functional Descriptions\n\n- Design and Usability: Utilizes Tailwind CSS to ensure a consistent and visually appealing user interface.\n- Performance: Optimized to handle common application requirements efficiently.\n- Scalability: Facilitates smooth scaling of applications as user demands grow.\n- Security: Integrates secure authentication processes and token management.",
  "ddl": "-- Schema for database: schemabench_0081\nCREATE TABLE `users` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `email` varchar(255) NOT NULL,\n  `email_verified_at` datetime DEFAULT NULL,\n  `password` varchar(255) NOT NULL,\n  `two_factor_secret` text DEFAULT NULL,\n  `two_factor_recovery_codes` text DEFAULT NULL,\n  `remember_token` varchar(100) DEFAULT NULL,\n  `current_team_id` int(11) DEFAULT NULL,\n  `profile_photo_path` varchar(2048) DEFAULT NULL,\n  `created_at` datetime DEFAULT NULL,\n  `updated_at` datetime DEFAULT NULL,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `users_email_unique` (`email`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `teams` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `user_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `personal_team` tinyint(1) NOT NULL DEFAULT '0',\n  `created_at` datetime DEFAULT NULL,\n  `updated_at` datetime DEFAULT NULL,\n  PRIMARY KEY (`id`),\n  KEY `teams_user_id_index` (`user_id`),\n  CONSTRAINT `teams_ibfk_1` FOREIGN KEY (`user_id`) REFERENCES `users` (`id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `team_user` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `team_id` int(11) NOT NULL,\n  `user_id` int(11) NOT NULL,\n  `role` varchar(255) DEFAULT NULL,\n  `created_at` datetime DEFAULT NULL,\n  `updated_at` datetime DEFAULT NULL,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `team_user_team_id_user_id_unique` (`team_id`,`user_id`),\n  KEY `team_user_user_id_index` (`user_id`),\n  CONSTRAINT `team_user_ibfk_1` FOREIGN KEY (`team_id`) REFERENCES `teams` (`id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `team_user_ibfk_2` FOREIGN KEY (`user_id`) REFERENCES `users` (`id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `team_invitations` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `team_id` int(11) NOT NULL,\n  `email` varchar(255) NOT NULL,\n  `role` varchar(255) DEFAULT NULL,\n  `created_at` datetime DEFAULT NULL,\n  `updated_at` datetime DEFAULT NULL,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `team_invitations_team_id_email_unique` (`team_id`,`email`),\n  KEY `team_invitations_team_id_index` (`team_id`),\n  CONSTRAINT `team_invitations_ibfk_1` FOREIGN KEY (`team_id`) REFERENCES `teams` (`id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `personal_access_tokens` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `tokenable_type` varchar(255) NOT NULL,\n  `tokenable_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `token` varchar(64) NOT NULL,\n  `abilities` text DEFAULT NULL,\n  `last_used_at` datetime DEFAULT NULL,\n  `created_at` datetime DEFAULT NULL,\n  `updated_at` datetime DEFAULT NULL,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `personal_access_tokens_token_unique` (`token`),\n  KEY `personal_access_tokens_tokenable_type_tokenable_id_index` (`tokenable_type`,`tokenable_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
