  "question": "Background / Context\n\nThe project involves developing a credit management system to handle charges, payments, and statements for members associated with corporations. The system interacts with various entities such as members, providers, corporations, and regions to maintain comprehensive financial records.\n\nObjectives\n\n- To provide a centralized platform for managing financial interactions including charges, payments, and statements.\n- To ensure the accurate and efficient processing of financial activities.\n- To support automated reporting of member financial statuses.\n\nStakeholders & Users\n\n- Members: Individuals who receive financial services and have accounts in the system.\n- Providers: Entities offering services to members and receiving payments.\n- Corporations: Companies to which members may belong.\n- Administrators: Personnel managing system operations and ensuring data integrity.\n\nFunctional Descriptions\n\n- Members can have charges recorded by providers across various categories.\n- Payments can be processed against member accounts, reducing outstanding balances.\n- Statements can be generated for members detailing charges and payments.\n- The system maintains a directory of providers, members, and corporations for reference in transactions.\n- Each financial transaction is associated with a unique statement for record-keeping.\n- Functional integration with database tables such as `category`, `charge`, `corporation`, `member`, `payment`, `provider`, `region`, and `statement` to track all financial activities.\n\nNon-Functional Descriptions\n\n- The system should ensure data consistency and integrity through proper use of foreign keys and constraints.\n- It must support secure and reliable operations with appropriate error handling for cascading deletes and updates.\n- The platform should be scalable to accommodate potential growth in the number of transactions and users.\n- It should provide timely and accurate financial reports to stakeholders.",
  "ddl": "-- Schema for database: schemabench_0103\nCREATE TABLE `region` (\n  `region_id` int(11) NOT NULL AUTO_INCREMENT,\n  `region_name` varchar(255) NOT NULL,\n  PRIMARY KEY (`region_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `corporation` (\n  `corporation_id` int(11) NOT NULL AUTO_INCREMENT,\n  `corporation_name` varchar(255) NOT NULL,\n  `region_id` int(11) DEFAULT NULL,\n  PRIMARY KEY (`corporation_id`),\n  KEY `corporation_ibfk_1` (`region_id`),\n  CONSTRAINT `corporation_ibfk_1` FOREIGN KEY (`region_id`) REFERENCES `region` (`region_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `member` (\n  `member_id` int(11) NOT NULL AUTO_INCREMENT,\n  `member_name` varchar(255) NOT NULL,\n  `corporation_id` int(11) DEFAULT NULL,\n  `region_id` int(11) DEFAULT NULL,\n  PRIMARY KEY (`member_id`),\n  KEY `member_ibfk_1` (`corporation_id`),\n  KEY `member_ibfk_2` (`region_id`),\n  CONSTRAINT `member_ibfk_1` FOREIGN KEY (`corporation_id`) REFERENCES `corporation` (`corporation_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `member_ibfk_2` FOREIGN KEY (`region_id`) REFERENCES `region` (`region_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `provider` (\n  `provider_id` int(11) NOT NULL AUTO_INCREMENT,\n  `provider_name` varchar(255) NOT NULL,\n  `region_id` int(11) DEFAULT NULL,\n  PRIMARY KEY (`provider_id`),\n  KEY `provider_ibfk_1` (`region_id`),\n  CONSTRAINT `provider_ibfk_1` FOREIGN KEY (`region_id`) REFERENCES `region` (`region_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `category` (\n  `category_id` int(11) NOT NULL AUTO_INCREMENT,\n  `category_name` varchar(255) NOT NULL,\n  PRIMARY KEY (`category_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `statement` (\n  `statement_id` int(11) NOT NULL AUTO_INCREMENT,\n  `member_id` int(11) NOT NULL,\n  `statement_date` datetime NOT NULL,\n  `statement_total` decimal(10,2) NOT NULL DEFAULT '0.00',\n  PRIMARY KEY (`statement_id`),\n  KEY `statement_ibfk_1` (`member_id`),\n  CONSTRAINT `statement_ibfk_1` FOREIGN KEY (`member_id`) REFERENCES `member` (`member_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `charge` (\n  `charge_id` int(11) NOT NULL AUTO_INCREMENT,\n  `statement_id` int(11) NOT NULL,\n  `member_id` int(11) NOT NULL,\n  `provider_id` int(11) NOT NULL,\n  `category_id` int(11) NOT NULL,\n  `charge_date` datetime NOT NULL,\n  `charge_amount` decimal(10,2) NOT NULL,\n  `charge_description` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`charge_id`),\n  KEY `charge_ibfk_1` (`statement_id`),\n  KEY `charge_ibfk_2` (`member_id`),\n  KEY `charge_ibfk_3` (`provider_id`),\n  KEY `charge_ibfk_4` (`category_id`),\n  CONSTRAINT `charge_ibfk_1` FOREIGN KEY (`statement_id`) REFERENCES `statement` (`statement_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `charge_ibfk_2` FOREIGN KEY (`member_id`) REFERENCES `member` (`member_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `charge_ibfk_3` FOREIGN KEY (`provider_id`) REFERENCES `provider` (`provider_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `charge_ibfk_4` FOREIGN KEY (`category_id`) REFERENCES `category` (`category_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `payment` (\n  `payment_id` int(11) NOT NULL AUTO_INCREMENT,\n  `statement_id` int(11) NOT NULL,\n  `member_id` int(11) NOT NULL,\n  `provider_id` int(11) DEFAULT NULL,\n  `payment_date` datetime NOT NULL,\n  `payment_amount` decimal(10,2) NOT NULL,\n  `payment_description` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`payment_id`),\n  KEY `payment_ibfk_1` (`statement_id`),\n  KEY `payment_ibfk_2` (`member_id`),\n  KEY `payment_ibfk_3` (`provider_id`),\n  CONSTRAINT `payment_ibfk_1` FOREIGN KEY (`statement_id`) REFERENCES `statement` (`statement_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `payment_ibfk_2` FOREIGN KEY (`member_id`) REFERENCES `member` (`member_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `payment_ibfk_3` FOREIGN KEY (`provider_id`) REFERENCES `provider` (`provider_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
