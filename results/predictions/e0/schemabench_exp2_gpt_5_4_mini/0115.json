  "question": "Background / Context\n\nThe project involves creating a system to manage and analyze metadata for Bulgarian court decisions. This system will store, link, and update legal documents and associated data within a structured database to facilitate efficient querying and reporting.\n\n Objectives\n\nThe main objective is to develop a robust database system to manage metadata related to Bulgarian court decisions. The system should allow for efficient storage, retrieval, and linking of legal act information, including relationships between court decisions and involved parties.\n\n Stakeholders & Users\n\n- Legal Professionals: Judges, lawyers, and court clerks who require access to detailed court decision data.\n- Database Administrators: Personnel responsible for managing and maintaining the database.\n- Researchers/Analysts: Individuals analyzing legal trends and outcomes from the Bulgarian court system.\n\n Functional Descriptions\n\n1. Legal Act Management: Ability to store detailed information about legal acts including court names, case numbers, judges, and decision dates.\n\n2. Linking Mechanism: Functionality to link related legal acts to each other and to involved parties using `legalact_link` and `legalact_people` tables.\n\n3. Metadata Updates: Automatic updates of metadata timestamps to reflect the latest changes in the legal acts.\n\n4. Data Integrity: Ensuring data consistency by defining foreign key constraints between legal acts, linked acts, and associated people.\n\n5. Scrape Fix Log: Management of a log that records fixes and contributions made to legal act entries by contributors, supported by the `scrapefix` table.\n\n Non-Functional Descriptions\n\n1. Performance: The system must efficiently handle queries and updates to ensure minimal delay in data retrieval.\n\n2. Scalability: Designed to support increasing data loads as more legal acts are recorded over time.\n\n3. Security: Implement data protection mechanisms, especially concerning sensitive legal information.\n\n4. Data Consistency: Maintain the integrity of relationships between entities, ensuring all references are valid and updated across related records.",
  "ddl": "-- Schema for database: schemabench_0115\nCREATE TABLE `legalact` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `court_name` varchar(255) NOT NULL,\n  `case_number` varchar(100) NOT NULL,\n  `decision_date` date DEFAULT NULL,\n  `title` varchar(255) DEFAULT NULL,\n  `summary` text DEFAULT NULL,\n  `source_url` varchar(500) DEFAULT NULL,\n  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  `updated_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,\n  PRIMARY KEY (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `person` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `full_name` varchar(255) NOT NULL,\n  `role` varchar(100) DEFAULT NULL,\n  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  `updated_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,\n  PRIMARY KEY (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `legalact_link` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `legalact_id` int(11) NOT NULL,\n  `linked_legalact_id` int(11) NOT NULL,\n  `link_type` varchar(100) DEFAULT NULL,\n  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  PRIMARY KEY (`id`),\n  KEY `legalact_id` (`legalact_id`),\n  KEY `linked_legalact_id` (`linked_legalact_id`),\n  CONSTRAINT `legalact_link_ibfk_1` FOREIGN KEY (`legalact_id`) REFERENCES `legalact` (`id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `legalact_link_ibfk_2` FOREIGN KEY (`linked_legalact_id`) REFERENCES `legalact` (`id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `legalact_people` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `legalact_id` int(11) NOT NULL,\n  `person_id` int(11) NOT NULL,\n  `relationship_type` varchar(100) DEFAULT NULL,\n  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  PRIMARY KEY (`id`),\n  KEY `legalact_id` (`legalact_id`),\n  KEY `person_id` (`person_id`),\n  CONSTRAINT `legalact_people_ibfk_1` FOREIGN KEY (`legalact_id`) REFERENCES `legalact` (`id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `legalact_people_ibfk_2` FOREIGN KEY (`person_id`) REFERENCES `person` (`id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `scrapefix` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `legalact_id` int(11) NOT NULL,\n  `contributor_name` varchar(255) NOT NULL,\n  `fix_description` text NOT NULL,\n  `fixed_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  PRIMARY KEY (`id`),\n  KEY `legalact_id` (`legalact_id`),\n  CONSTRAINT `scrapefix_ibfk_1` FOREIGN KEY (`legalact_id`) REFERENCES `legalact` (`id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
