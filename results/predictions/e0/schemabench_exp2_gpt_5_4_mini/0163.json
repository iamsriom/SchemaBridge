  "question": "1) Background / Context:\nThe project involves the development of a system to manage athletic events efficiently. This system is centered around the collaboration between customers, employees, and the facilities where events take place. It focuses on ensuring streamlined event planning and resource allocation.\n\n2) Objectives:\n- Facilitate the request and management of athletic events.\n- Enable efficient coordination of event plans and associated resources.\n- Ensure accurate record-keeping for customers, facilities, and event details.\n\n3) Stakeholders & Users:\n- Customers: Individuals or organizations that request events.\n- Employees: Staff responsible for managing event plans.\n- Facility Managers: Personnel overseeing venue availability and assignment.\n\n4) Functional Descriptions:\n- Customer Management: Store and maintain customer details, allowing them to request events.\n- Event Request Processing: Allow customers to submit event requests, specifying desired dates, costs, and audience size. Requests must be approved, pending, or denied.\n- Employee Management: Keep track of employees who manage event plans.\n- Event Planning: Develop detailed event plans including timeline and assigned resources. Each plan is managed by an employee and linked to an event request.\n- Resource Allocation: Assign resources such as equipment to event plans, ensuring availability and proper cost management.\n- Location and Facility Management: Manage facility locations and link them to event plans, ensuring proper tracking and availability.\n\n5) Non-Functional Descriptions:\n- Data Integrity: Maintain accuracy and consistency across tables, with constraints to ensure valid statuses, audience estimates, and resource rates.\n- Security: Ensure that data access is controlled and restricted to authorized users.\n- Scalability: Support a growing number of event requests and plans without degradation in performance.\n- Usability: Provide an intuitive interface for customers to request events and employees to manage plans efficiently.",
  "ddl": "-- Schema for database: schemabench_0163\nCREATE TABLE `customers` (\n  `customer_id` int(11) NOT NULL AUTO_INCREMENT,\n  `customer_name` varchar(255) NOT NULL,\n  `customer_type` varchar(100) DEFAULT NULL,\n  `phone` varchar(50) DEFAULT NULL,\n  `email` varchar(255) DEFAULT NULL,\n  `address` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`customer_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `employees` (\n  `employee_id` int(11) NOT NULL AUTO_INCREMENT,\n  `employee_name` varchar(255) NOT NULL,\n  `job_title` varchar(100) DEFAULT NULL,\n  `phone` varchar(50) DEFAULT NULL,\n  `email` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`employee_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `facilities` (\n  `facility_id` int(11) NOT NULL AUTO_INCREMENT,\n  `facility_name` varchar(255) NOT NULL,\n  `location` varchar(255) NOT NULL,\n  `capacity` int(11) DEFAULT NULL,\n  `manager_name` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`facility_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `event_requests` (\n  `event_request_id` int(11) NOT NULL AUTO_INCREMENT,\n  `customer_id` int(11) NOT NULL,\n  `requested_date` date NOT NULL,\n  `estimated_cost` decimal(10,2) NOT NULL,\n  `audience_size` int(11) NOT NULL,\n  `status` varchar(20) NOT NULL DEFAULT 'pending',\n  `request_notes` varchar(500) DEFAULT NULL,\n  PRIMARY KEY (`event_request_id`),\n  KEY `customer_id` (`customer_id`),\n  CONSTRAINT `event_requests_ibfk_1` FOREIGN KEY (`customer_id`) REFERENCES `customers` (`customer_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `event_plans` (\n  `event_plan_id` int(11) NOT NULL AUTO_INCREMENT,\n  `event_request_id` int(11) NOT NULL,\n  `employee_id` int(11) NOT NULL,\n  `facility_id` int(11) NOT NULL,\n  `plan_name` varchar(255) NOT NULL,\n  `timeline` text DEFAULT NULL,\n  `planned_start` datetime DEFAULT NULL,\n  `planned_end` datetime DEFAULT NULL,\n  `plan_status` varchar(20) NOT NULL DEFAULT 'draft',\n  PRIMARY KEY (`event_plan_id`),\n  KEY `event_request_id` (`event_request_id`),\n  KEY `employee_id` (`employee_id`),\n  KEY `facility_id` (`facility_id`),\n  CONSTRAINT `event_plans_ibfk_1` FOREIGN KEY (`event_request_id`) REFERENCES `event_requests` (`event_request_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `event_plans_ibfk_2` FOREIGN KEY (`employee_id`) REFERENCES `employees` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `event_plans_ibfk_3` FOREIGN KEY (`facility_id`) REFERENCES `facilities` (`facility_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `resources` (\n  `resource_id` int(11) NOT NULL AUTO_INCREMENT,\n  `resource_name` varchar(255) NOT NULL,\n  `resource_type` varchar(100) NOT NULL,\n  `unit_rate` decimal(10,2) NOT NULL,\n  `available_quantity` int(11) NOT NULL,\n  PRIMARY KEY (`resource_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `event_plan_resources` (\n  `event_plan_resource_id` int(11) NOT NULL AUTO_INCREMENT,\n  `event_plan_id` int(11) NOT NULL,\n  `resource_id` int(11) NOT NULL,\n  `quantity` int(11) NOT NULL,\n  `rate` decimal(10,2) NOT NULL,\n  PRIMARY KEY (`event_plan_resource_id`),\n  KEY `event_plan_id` (`event_plan_id`),\n  KEY `resource_id` (`resource_id`),\n  CONSTRAINT `event_plan_resources_ibfk_1` FOREIGN KEY (`event_plan_id`) REFERENCES `event_plans` (`event_plan_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `event_plan_resources_ibfk_2` FOREIGN KEY (`resource_id`) REFERENCES `resources` (`resource_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
