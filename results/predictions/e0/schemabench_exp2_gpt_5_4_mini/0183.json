  "question": "Background / Context\n\nThe project involves developing a database and application system for a record store. This system is designed to facilitate store employees in efficiently locating and managing the records customers are interested in purchasing. The system will store and manage data related to records, artists, songs, genres, and inventory across various store locations.\n\nObjectives\n\n1. Provide a reliable database system to store detailed information about albums, songs, artists, and genres.\n2. Enable employees to easily search and retrieve information to assist customers.\n3. Maintain an accurate and up-to-date inventory of albums available at each store location.\n\nStakeholders & Users\n\n- Store Employees: Primary users who will interact with the system to assist customers and manage inventory.\n- Store Managers: Oversee operations and ensure the inventory is accurate and sufficient.\n- Developers: Responsible for developing and maintaining the system.\n\nFunctional Descriptions\n\n1. Employee Management:\n   - Manage employee records and associate them with specific store locations.\n   \n2. Album and Song Management:\n   - Store detailed information about albums, their release dates, and pricing.\n   - Manage songs, including titles, duration, lyrics, and associated albums.\n   \n3. Genre Management:\n   - Maintain a list of genres and associate them with songs.\n   \n4. Artist Management:\n   - Record details about artists, including stage names, solo/band status, and group memberships.\n   \n5. Inventory Management:\n   - Track the availability of albums at different store locations to ensure stock is maintained.\n\n6. Location Management:\n   - Manage records of store locations with contact information and addresses.\n\nNon-Functional Descriptions\n\n1. Performance:\n   - The system should efficiently handle data operations for multiple locations without user-perceptible delay.\n\n2. Scalability:\n   - Capable of scaling to accommodate additional locations and a growing number of records.\n\n3. Reliability:\n   - Ensure accurate data entry, storage, and retrieval to minimize errors and redundancy.\n\n4. Security:\n   - Protect sensitive information related to employees, inventory, and transactions.",
  "ddl": "-- Schema for database: schemabench_0183\nCREATE TABLE `store_location` (\n  `store_location_id` int(11) NOT NULL AUTO_INCREMENT,\n  `location_name` varchar(255) NOT NULL,\n  `address_line1` varchar(255) NOT NULL,\n  `address_line2` varchar(255) DEFAULT NULL,\n  `city` varchar(100) NOT NULL,\n  `state_province` varchar(100) NOT NULL,\n  `postal_code` varchar(20) NOT NULL,\n  `country` varchar(100) NOT NULL,\n  `phone_number` varchar(25) DEFAULT NULL,\n  PRIMARY KEY (`store_location_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `employee` (\n  `employee_id` int(11) NOT NULL AUTO_INCREMENT,\n  `store_location_id` int(11) NOT NULL,\n  `first_name` varchar(100) NOT NULL,\n  `last_name` varchar(100) NOT NULL,\n  `job_title` varchar(100) NOT NULL,\n  `email` varchar(255) DEFAULT NULL,\n  `phone_number` varchar(25) DEFAULT NULL,\n  `hire_date` date NOT NULL,\n  PRIMARY KEY (`employee_id`),\n  KEY `employee_ibfk_1` (`store_location_id`),\n  CONSTRAINT `employee_ibfk_1` FOREIGN KEY (`store_location_id`) REFERENCES `store_location` (`store_location_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `album` (\n  `album_id` int(11) NOT NULL AUTO_INCREMENT,\n  `album_title` varchar(255) NOT NULL,\n  `release_date` date DEFAULT NULL,\n  `price` decimal(10,2) NOT NULL,\n  PRIMARY KEY (`album_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `song` (\n  `song_id` int(11) NOT NULL AUTO_INCREMENT,\n  `album_id` int(11) NOT NULL,\n  `song_title` varchar(255) NOT NULL,\n  `duration_seconds` int(11) NOT NULL,\n  `lyrics` text DEFAULT NULL,\n  PRIMARY KEY (`song_id`),\n  KEY `song_ibfk_1` (`album_id`),\n  CONSTRAINT `song_ibfk_1` FOREIGN KEY (`album_id`) REFERENCES `album` (`album_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `genre` (\n  `genre_id` int(11) NOT NULL AUTO_INCREMENT,\n  `genre_name` varchar(100) NOT NULL,\n  PRIMARY KEY (`genre_id`),\n  UNIQUE KEY `genre_name` (`genre_name`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `song_genre` (\n  `song_id` int(11) NOT NULL,\n  `genre_id` int(11) NOT NULL,\n  PRIMARY KEY (`song_id`,`genre_id`),\n  KEY `song_genre_ibfk_2` (`genre_id`),\n  CONSTRAINT `song_genre_ibfk_1` FOREIGN KEY (`song_id`) REFERENCES `song` (`song_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `song_genre_ibfk_2` FOREIGN KEY (`genre_id`) REFERENCES `genre` (`genre_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `artist` (\n  `artist_id` int(11) NOT NULL AUTO_INCREMENT,\n  `stage_name` varchar(255) NOT NULL,\n  `is_solo_artist` tinyint(1) NOT NULL,\n  `group_name` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`artist_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `album_artist` (\n  `album_id` int(11) NOT NULL,\n  `artist_id` int(11) NOT NULL,\n  PRIMARY KEY (`album_id`,`artist_id`),\n  KEY `album_artist_ibfk_2` (`artist_id`),\n  CONSTRAINT `album_artist_ibfk_1` FOREIGN KEY (`album_id`) REFERENCES `album` (`album_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `album_artist_ibfk_2` FOREIGN KEY (`artist_id`) REFERENCES `artist` (`artist_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `inventory` (\n  `store_location_id` int(11) NOT NULL,\n  `album_id` int(11) NOT NULL,\n  `quantity_on_hand` int(11) NOT NULL,\n  PRIMARY KEY (`store_location_id`,`album_id`),\n  KEY `inventory_ibfk_2` (`album_id`),\n  CONSTRAINT `inventory_ibfk_1` FOREIGN KEY (`store_location_id`) REFERENCES `store_location` (`store_location_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `inventory_ibfk_2` FOREIGN KEY (`album_id`) REFERENCES `album` (`album_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
