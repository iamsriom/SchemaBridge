  "question": "Background / Context\n\nThe project involves creating an `EmployeeManagementSystem`, a comprehensive database solution to manage employee records efficiently. This system supports an organizational structure that includes departments and positions, with details on employee roles and management hierarchies.\n\nObjectives\n\n- Develop a database to maintain structured employee data.\n- Enable linkages between employees, departments, and positions.\n- Facilitate management tracking and hierarchical relationships.\n\nStakeholders & Users\n\n- Administrators: Responsible for entering and updating employee, department, and position data.\n- HR Personnel: Utilize the system to retrieve and manage employee records.\n- Managers: Access department and management hierarchy information.\n\nFunctional Descriptions\n\n1. Employee Management:\n   - Store and manage details of each employee including first name, last name, email, phone number, address, birth date, salary, and hire date.\n   - Assign employees to specific departments and positions.\n\n2. Department & Position Management:\n   - Maintain department information such as department ID, name, manager, location, and description.\n   - Record various positions with attributes including position ID, name, description, and salary range.\n\n3. Relationships & Hierarchies:\n   - Link employees to their respective departments and positions.\n   - Track the historical allocation of employees to departments over time.\n   - Manage employee-manager relationships to reflect reporting lines.\n\nNon-Functional Descriptions\n\n- The database must ensure data integrity and enforce referential constraints.\n- It should provide easy scalability to accommodate organizational growth.\n- Designed with robust security to protect sensitive employee information.",
  "ddl": "-- Schema for database: schemabench_0202\nCREATE TABLE `departments` (\n  `department_id` int(11) NOT NULL AUTO_INCREMENT,\n  `department_name` varchar(255) NOT NULL,\n  `manager_employee_id` int(11) DEFAULT NULL,\n  `location` varchar(255) DEFAULT NULL,\n  `description` text DEFAULT NULL,\n  PRIMARY KEY (`department_id`),\n  KEY `departments_ibfk_1` (`manager_employee_id`),\n  CONSTRAINT `departments_ibfk_1` FOREIGN KEY (`manager_employee_id`) REFERENCES `employees` (`employee_id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `positions` (\n  `position_id` int(11) NOT NULL AUTO_INCREMENT,\n  `position_name` varchar(255) NOT NULL,\n  `description` text DEFAULT NULL,\n  `min_salary` decimal(10,2) DEFAULT NULL,\n  `max_salary` decimal(10,2) DEFAULT NULL,\n  PRIMARY KEY (`position_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `employees` (\n  `employee_id` int(11) NOT NULL AUTO_INCREMENT,\n  `first_name` varchar(100) NOT NULL,\n  `last_name` varchar(100) NOT NULL,\n  `email` varchar(255) NOT NULL,\n  `phone_number` varchar(50) DEFAULT NULL,\n  `address` varchar(255) DEFAULT NULL,\n  `birth_date` date DEFAULT NULL,\n  `salary` decimal(10,2) DEFAULT NULL,\n  `hire_date` date NOT NULL,\n  `department_id` int(11) DEFAULT NULL,\n  `position_id` int(11) DEFAULT NULL,\n  `manager_employee_id` int(11) DEFAULT NULL,\n  PRIMARY KEY (`employee_id`),\n  UNIQUE KEY `email` (`email`),\n  KEY `employees_ibfk_1` (`department_id`),\n  KEY `employees_ibfk_2` (`position_id`),\n  KEY `employees_ibfk_3` (`manager_employee_id`),\n  CONSTRAINT `employees_ibfk_1` FOREIGN KEY (`department_id`) REFERENCES `departments` (`department_id`) ON DELETE SET NULL ON UPDATE CASCADE,\n  CONSTRAINT `employees_ibfk_2` FOREIGN KEY (`position_id`) REFERENCES `positions` (`position_id`) ON DELETE SET NULL ON UPDATE CASCADE,\n  CONSTRAINT `employees_ibfk_3` FOREIGN KEY (`manager_employee_id`) REFERENCES `employees` (`employee_id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `employee_department_history` (\n  `history_id` int(11) NOT NULL AUTO_INCREMENT,\n  `employee_id` int(11) NOT NULL,\n  `department_id` int(11) NOT NULL,\n  `start_date` date NOT NULL,\n  `end_date` date DEFAULT NULL,\n  PRIMARY KEY (`history_id`),\n  KEY `employee_department_history_ibfk_1` (`employee_id`),\n  KEY `employee_department_history_ibfk_2` (`department_id`),\n  CONSTRAINT `employee_department_history_ibfk_1` FOREIGN KEY (`employee_id`) REFERENCES `employees` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `employee_department_history_ibfk_2` FOREIGN KEY (`department_id`) REFERENCES `departments` (`department_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
