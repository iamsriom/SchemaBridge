  "question": "Background / Context\n\nScrallWall is a mobile application integrating geolocation, user-generated content, and open city data to promote urban exploration and community-driven beautification. The application enables users to share and discover street art through a collaborative platform that allows for community engagement and management of urban artifacts.\n\nObjectives\n\nThe primary objective of ScrallWall is to empower local communities to take charge of their aesthetic environment by facilitating discovery and sharing of street art, encouraging community feedback, and coordinating with city authorities for artifact management. \n\nStakeholders & Users\n\n- Users: Individuals interested in urban art, community members, tourists, and street art enthusiasts.\n- Community: Local residents and neighborhoods who can vote on artifacts.\n- City Authorities: Municipal bodies informed of artifacts needing removal based on community reports.\n\nFunctional Descriptions\n\n1. Geotagging and Sharing:\n   - Users can upload and geotag pictures of street art.\n   - Artifacts are displayed on a map for ease of discovery.\n\n2. Community Voting:\n   - Users can vote on whether a piece of street art is beneficial to the community.\n   - Artifacts receiving negative votes are flagged for city review.\n\n3. Artifact Discovery:\n   - Browse artifacts by location and tags through an interactive map interface.\n\n4. Notification to City:\n   - Automatic notification to city authorities if an art piece is reported by the community.\n\nNon-Functional Descriptions\n\n- Scalability: The system should handle a significant amount of geotagged data and simultaneous users smoothly.\n- Usability: The interface should be intuitive for both casual users and active community participants.\n- Security: Safeguard user data and ensure reliable reporting to city authorities.\n- Interoperability: Seamlessly interact with city APIs and databases for real-time updates and reports.",
  "ddl": "-- Schema for database: schemabench_0229\nCREATE TABLE `users` (\n  `user_id` int(11) NOT NULL AUTO_INCREMENT,\n  `username` varchar(255) NOT NULL,\n  `email` varchar(255) NOT NULL,\n  `password_hash` varchar(255) NOT NULL,\n  `created_at` datetime NOT NULL,\n  PRIMARY KEY (`user_id`),\n  UNIQUE KEY `uk_users_username` (`username`),\n  UNIQUE KEY `uk_users_email` (`email`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `artifacts` (\n  `artifact_id` int(11) NOT NULL AUTO_INCREMENT,\n  `user_id` int(11) NOT NULL,\n  `title` varchar(255) NOT NULL,\n  `description` text DEFAULT NULL,\n  `image_url` varchar(512) NOT NULL,\n  `latitude` decimal(10,7) NOT NULL,\n  `longitude` decimal(10,7) NOT NULL,\n  `created_at` datetime NOT NULL,\n  `status` varchar(50) NOT NULL DEFAULT 'active',\n  PRIMARY KEY (`artifact_id`),\n  KEY `artifact_user_id_idx` (`user_id`),\n  CONSTRAINT `artifacts_ibfk_1` FOREIGN KEY (`user_id`) REFERENCES `users` (`user_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `tags` (\n  `tag_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(100) NOT NULL,\n  PRIMARY KEY (`tag_id`),\n  UNIQUE KEY `uk_tags_name` (`name`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `artifact_tags` (\n  `artifact_id` int(11) NOT NULL,\n  `tag_id` int(11) NOT NULL,\n  PRIMARY KEY (`artifact_id`,`tag_id`),\n  KEY `artifact_tags_tag_id_idx` (`tag_id`),\n  CONSTRAINT `artifact_tags_ibfk_1` FOREIGN KEY (`artifact_id`) REFERENCES `artifacts` (`artifact_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `artifact_tags_ibfk_2` FOREIGN KEY (`tag_id`) REFERENCES `tags` (`tag_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `votes` (\n  `vote_id` int(11) NOT NULL AUTO_INCREMENT,\n  `artifact_id` int(11) NOT NULL,\n  `user_id` int(11) NOT NULL,\n  `vote_value` tinyint(4) NOT NULL,\n  `created_at` datetime NOT NULL,\n  PRIMARY KEY (`vote_id`),\n  UNIQUE KEY `uk_votes_artifact_user` (`artifact_id`,`user_id`),\n  KEY `votes_user_id_idx` (`user_id`),\n  CONSTRAINT `votes_ibfk_1` FOREIGN KEY (`artifact_id`) REFERENCES `artifacts` (`artifact_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `votes_ibfk_2` FOREIGN KEY (`user_id`) REFERENCES `users` (`user_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `city_notifications` (\n  `notification_id` int(11) NOT NULL AUTO_INCREMENT,\n  `artifact_id` int(11) NOT NULL,\n  `sent_at` datetime NOT NULL,\n  `status` varchar(50) NOT NULL DEFAULT 'pending',\n  `city_reference` varchar(255) DEFAULT NULL,\n  `response_message` text DEFAULT NULL,\n  PRIMARY KEY (`notification_id`),\n  KEY `city_notifications_artifact_id_idx` (`artifact_id`),\n  CONSTRAINT `city_notifications_ibfk_1` FOREIGN KEY (`artifact_id`) REFERENCES `artifacts` (`artifact_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
