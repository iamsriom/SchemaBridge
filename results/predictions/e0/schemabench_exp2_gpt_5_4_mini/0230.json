  "question": "Background / Context  \nThe project involves developing a simulation application for a FIFA World Cup score and fixtures database. The system aims to represent players, teams, matches, and stadiums through a structured database, using SQLite as the backend.\n\nObjectives  \nThe primary objective is to create a reliable and efficient database system to simulate the essential elements of a World Cup event. This includes managing player information, team details, match fixtures, and stadium data to support tournament operations and analytics.\n\nStakeholders & Users  \n- Stakeholders: Soccer tournament organizers, analysts, and developers maintaining the database.\n- Primary Users: Data analysts, developers, soccer statisticians, and sports journalists requiring accurate and timely simulation data.\n\nFunctional Descriptions  \n1. Player Management: Track player details, including identification, name, age, team affiliation, team number, and injury status.\n2. Team Management: Manage team information, including the number of players, manager, and team captain.\n3. Match Management: Record match details such as participating teams, venue, officiating crew, match scores, and key players (e.g., man of the match, team captains).\n4. Stadium Management: Maintain stadium information, including capacity and current condition.\n\nNon-Functional Descriptions  \n- The database should ensure data integrity and reliability for all stored information.\n- The system must provide quick query responses to handle large data sets efficiently.\n- Scalability should be considered to accommodate potential expansion or increased data volume.",
  "ddl": "-- Schema for database: schemabench_0230\nCREATE TABLE `teams` (\n  `team_id` int(11) NOT NULL AUTO_INCREMENT,\n  `team_name` varchar(255) NOT NULL,\n  `number_of_players` int(11) NOT NULL,\n  `manager` varchar(255) DEFAULT NULL,\n  `captain_player_id` int(11) DEFAULT NULL,\n  PRIMARY KEY (`team_id`),\n  KEY `teams_ibfk_1` (`captain_player_id`),\n  CONSTRAINT `teams_ibfk_1` FOREIGN KEY (`captain_player_id`) REFERENCES `players` (`player_id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `stadiums` (\n  `stadium_id` int(11) NOT NULL AUTO_INCREMENT,\n  `stadium_name` varchar(255) NOT NULL,\n  `capacity` int(11) NOT NULL,\n  `current_condition` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`stadium_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `players` (\n  `player_id` int(11) NOT NULL AUTO_INCREMENT,\n  `player_name` varchar(255) NOT NULL,\n  `age` int(11) NOT NULL,\n  `team_id` int(11) NOT NULL,\n  `team_number` int(11) NOT NULL,\n  `injury_status` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`player_id`),\n  KEY `players_ibfk_1` (`team_id`),\n  CONSTRAINT `players_ibfk_1` FOREIGN KEY (`team_id`) REFERENCES `teams` (`team_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\nCREATE TABLE `matches` (\n  `match_id` int(11) NOT NULL AUTO_INCREMENT,\n  `home_team_id` int(11) NOT NULL,\n  `away_team_id` int(11) NOT NULL,\n  `stadium_id` int(11) NOT NULL,\n  `match_datetime` datetime NOT NULL,\n  `home_team_score` int(11) DEFAULT NULL,\n  `away_team_score` int(11) DEFAULT NULL,\n  `referee_name` varchar(255) DEFAULT NULL,\n  `assistant_referee_1` varchar(255) DEFAULT NULL,\n  `assistant_referee_2` varchar(255) DEFAULT NULL,\n  `man_of_the_match_player_id` int(11) DEFAULT NULL,\n  `home_team_captain_player_id` int(11) DEFAULT NULL,\n  `away_team_captain_player_id` int(11) DEFAULT NULL,\n  PRIMARY KEY (`match_id`),\n  KEY `matches_ibfk_1` (`home_team_id`),\n  KEY `matches_ibfk_2` (`away_team_id`),\n  KEY `matches_ibfk_3` (`stadium_id`),\n  KEY `matches_ibfk_4` (`man_of_the_match_player_id`),\n  KEY `matches_ibfk_5` (`home_team_captain_player_id`),\n  KEY `matches_ibfk_6` (`away_team_captain_player_id`),\n  CONSTRAINT `matches_ibfk_1` FOREIGN KEY (`home_team_id`) REFERENCES `teams` (`team_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `matches_ibfk_2` FOREIGN KEY (`away_team_id`) REFERENCES `teams` (`team_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `matches_ibfk_3` FOREIGN KEY (`stadium_id`) REFERENCES `stadiums` (`stadium_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `matches_ibfk_4` FOREIGN KEY (`man_of_the_match_player_id`) REFERENCES `players` (`player_id`) ON DELETE SET NULL ON UPDATE CASCADE,\n  CONSTRAINT `matches_ibfk_5` FOREIGN KEY (`home_team_captain_player_id`) REFERENCES `players` (`player_id`) ON DELETE SET NULL ON UPDATE CASCADE,\n  CONSTRAINT `matches_ibfk_6` FOREIGN KEY (`away_team_captain_player_id`) REFERENCES `players` (`player_id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
