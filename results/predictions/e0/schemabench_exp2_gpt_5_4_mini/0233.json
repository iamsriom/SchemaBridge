  "question": "1) Background / Context\n   \n   The Rescue Management System is a comprehensive database project aimed at enhancing the management of emergency services. It addresses the critical need for efficient handling of rescue operations, resource allocation, and incident tracking to support emergency response teams.\n\n2) Objectives\n\n   - To streamline the management of rescue operations and emergency responses.\n   - To effectively track rescue personnel, vehicles, and resources.\n   - To maintain accurate records of incidents and their response times.\n   - To provide a centralized and organized database for emergency service management.\n\n3) Stakeholders & Users\n\n   - Emergency Service Managers: Oversee operations and resource allocation.\n   - Rescue Personnel: Conduct rescue operations and require access to incident information.\n   - Administrators: Manage data entry and database maintenance.\n   - Incident Analysts: Analyze response effectiveness and efficiency.\n\n4) Functional Descriptions\n\n   - Incident Management: Record and track details of incidents, including type, location, description, and date.\n   - Personnel Management: Maintain data on rescue personnel, including identification, contact information, designation, and shift details.\n   - Vehicle Management: Monitor vehicle availability, types, and models for rescue operations.\n   - Equipment Management: Track equipment types, quantities, conditions, and descriptions to ensure readiness.\n   - Victim Management: Log victim details, including identification, name, and age.\n   - Task Coordination: Document and monitor task types and their completion status.\n   - Medical Records: Record medical treatments and diagnoses for tracking victim care.\n\n5) Non-Functional Descriptions\n\n   - Scalability: The system should efficiently handle a growing amount of data and users.\n   - Reliability: Ensure data consistency and availability during emergencies.\n   - Usability: Provide a user-friendly interface for quick access and data entry.\n   - Security: Secure sensitive personal and medical information of victims and personnel.",
  "ddl": "-- Schema for database: schemabench_0233\nCREATE TABLE `incidents` (\n  `incident_id` int(11) NOT NULL AUTO_INCREMENT,\n  `incident_type` varchar(100) NOT NULL,\n  `location` varchar(255) NOT NULL,\n  `description` text DEFAULT NULL,\n  `incident_date` datetime NOT NULL,\n  `response_time_minutes` int(11) DEFAULT NULL,\n  PRIMARY KEY (`incident_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `personnel` (\n  `personnel_id` int(11) NOT NULL AUTO_INCREMENT,\n  `full_name` varchar(255) NOT NULL,\n  `contact_number` varchar(20) DEFAULT NULL,\n  `designation` varchar(100) NOT NULL,\n  `shift_details` varchar(100) DEFAULT NULL,\n  `email` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`personnel_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `vehicles` (\n  `vehicle_id` int(11) NOT NULL AUTO_INCREMENT,\n  `vehicle_type` varchar(100) NOT NULL,\n  `model` varchar(100) NOT NULL,\n  `availability_status` varchar(50) NOT NULL,\n  `registration_number` varchar(50) DEFAULT NULL,\n  PRIMARY KEY (`vehicle_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `equipment` (\n  `equipment_id` int(11) NOT NULL AUTO_INCREMENT,\n  `equipment_type` varchar(100) NOT NULL,\n  `quantity` int(11) NOT NULL,\n  `condition_status` varchar(50) NOT NULL,\n  `description` text DEFAULT NULL,\n  PRIMARY KEY (`equipment_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `victims` (\n  `victim_id` int(11) NOT NULL AUTO_INCREMENT,\n  `identification_number` varchar(100) DEFAULT NULL,\n  `full_name` varchar(255) NOT NULL,\n  `age` int(11) DEFAULT NULL,\n  `gender` varchar(20) DEFAULT NULL,\n  `contact_information` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`victim_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `tasks` (\n  `task_id` int(11) NOT NULL AUTO_INCREMENT,\n  `incident_id` int(11) NOT NULL,\n  `task_type` varchar(100) NOT NULL,\n  `task_description` text DEFAULT NULL,\n  `completion_status` varchar(50) NOT NULL,\n  `assigned_personnel_id` int(11) DEFAULT NULL,\n  `assigned_vehicle_id` int(11) DEFAULT NULL,\n  PRIMARY KEY (`task_id`),\n  KEY `incident_id` (`incident_id`),\n  KEY `assigned_personnel_id` (`assigned_personnel_id`),\n  KEY `assigned_vehicle_id` (`assigned_vehicle_id`),\n  CONSTRAINT `tasks_ibfk_1` FOREIGN KEY (`incident_id`) REFERENCES `incidents` (`incident_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `tasks_ibfk_2` FOREIGN KEY (`assigned_personnel_id`) REFERENCES `personnel` (`personnel_id`) ON DELETE SET NULL ON UPDATE CASCADE,\n  CONSTRAINT `tasks_ibfk_3` FOREIGN KEY (`assigned_vehicle_id`) REFERENCES `vehicles` (`vehicle_id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `medical_records` (\n  `medical_record_id` int(11) NOT NULL AUTO_INCREMENT,\n  `victim_id` int(11) NOT NULL,\n  `incident_id` int(11) NOT NULL,\n  `diagnosis` varchar(255) NOT NULL,\n  `treatment` text DEFAULT NULL,\n  `record_date` datetime NOT NULL,\n  PRIMARY KEY (`medical_record_id`),\n  KEY `victim_id` (`victim_id`),\n  KEY `incident_id` (`incident_id`),\n  CONSTRAINT `medical_records_ibfk_1` FOREIGN KEY (`victim_id`) REFERENCES `victims` (`victim_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `medical_records_ibfk_2` FOREIGN KEY (`incident_id`) REFERENCES `incidents` (`incident_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
