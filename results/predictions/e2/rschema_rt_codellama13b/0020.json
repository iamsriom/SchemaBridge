  "ddl": "-- Schema for database: rschema_0020\nCREATE TABLE `Supplier` (\n  `Supplier_ID` int(11) NOT NULL,\n  `Name` varchar(255) NOT NULL,\n  `Contact_Information` varchar(255) DEFAULT NULL,\n  `Address` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`Supplier_ID`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `Ingredient` (\n  `Ingredient_ID` int(11) NOT NULL,\n  `Ingredient_Name` varchar(255) NOT NULL,\n  `Ingredient_Specification` varchar(255) DEFAULT NULL,\n  `Price` decimal(10,2) DEFAULT NULL,\n  PRIMARY KEY (`Ingredient_ID`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `Purchase_Record` (\n  `Purchase_ID` int(11) NOT NULL,\n  `Supplier_ID` int(11) NOT NULL,\n  `Ingredient_ID` int(11) NOT NULL,\n  `Purchase_Date` datetime DEFAULT NULL,\n  `Purchase_Quantity` int(11) NOT NULL,\n  `Purchase_Amount` decimal(10,2) DEFAULT NULL,\n  PRIMARY KEY (`Supplier_ID`, `Ingredient_ID`),\n  CONSTRAINT `purchase_record_ibfk_1` FOREIGN KEY (`Supplier_ID`) REFERENCES `Supplier` (`Supplier_ID`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `purchase_record_ibfk_2` FOREIGN KEY (`Ingredient_ID`) REFERENCES `Ingredient` (`Ingredient_ID`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
