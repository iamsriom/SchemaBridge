  "database": "rschema_0022",
  "nl_text": "This database schema is for a document management system, with five tables: `document`, `document_management_personnel`, `approval_record`, `archiving_record`, and `query_record`. The `document` table contains information about the documents being managed, including their unique ID, name, category, creation time, and status. The `document_management_personnel` table contains information about the personnel involved in the document management process, including their employee ID, name, gender, position, and contact information. The `approval_record` table contains information about the approval process for each document, including the approver's ID, the time of approval, and any comments. The `archiving_record` table contains information about the archiving process for each document, including the archivist's ID, the time of archiving, and the location of the archived document. The `query_record` table contains information about the queries made about each document, including the query personnel's ID, the time of the query, and the result of the query. The tables are linked through foreign keys, with the `approval_record` and `archiving_record` tables referencing the `document` table, and the `query_record` table referencing both the `document` and `document_management_personnel` tables.",
  "gold_question": "A national agency requires management of the document circulation process, including approval, archiving, and querying of documents.\nDocuments have a document ID, name, category, creation time, and status;\nApproval records include document ID, approver, approval time, and approval comments;\nArchiving records include document ID, archivist, archiving time, and archiving location;\nQuery records include document ID, query personnel, query time, and query results;\nThe approval and querying operations of documents can occur multiple times, whereas archiving occurs only once.\nDocument management personnel are responsible for approving, archiving, and querying documents; they have employee ID, name, gender, position, and contact information.",
  "input_json": "/data/RSchema_ExpResults4/Experiment2/schema2text_codellama13b/0022.json",
  "ddl": "-- Schema for database: rschema_0022\nCREATE TABLE `document` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `category` varchar(255) NOT NULL,\n  `creation_time` datetime NOT NULL,\n  `status` varchar(50) NOT NULL,\n  PRIMARY KEY (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `document_management_personnel` (\n  `employee_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `gender` char(1) NOT NULL,\n  `position` varchar(255) NOT NULL,\n  `contact_info` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`employee_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `approval_record` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `document_id` int(11) NOT NULL,\n  `approver_id` int(11) NOT NULL,\n  `approval_time` datetime NOT NULL,\n  `comments` text DEFAULT NULL,\n  PRIMARY KEY (`id`),\n  CONSTRAINT `approval_record_ibfk_1` FOREIGN KEY (`document_id`) REFERENCES `document` (`id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `approval_record_ibfk_2` FOREIGN KEY (`approver_id`) REFERENCES `document_management_personnel` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `archiving_record` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `document_id` int(11) NOT NULL,\n  `archivist_id` int(11) NOT NULL,\n  `archiving_time` datetime NOT NULL,\n  `archive_location` varchar(255) NOT NULL,\n  PRIMARY KEY (`id`),\n  CONSTRAINT `archiving_record_ibfk_1` FOREIGN KEY (`document_id`) REFERENCES `document` (`id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `archiving_record_ibfk_2` FOREIGN KEY (`archivist_id`) REFERENCES `document_management_personnel` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `query_record` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `document_id` int(11) NOT NULL,\n  `query_personnel_id` int(11) NOT NULL,\n  `query_time` datetime NOT NULL,\n  `query_result` text DEFAULT NULL,\n  PRIMARY KEY (`id`),\n  CONSTRAINT `query_record_ibfk_1` FOREIGN KEY (`document_id`) REFERENCES `document` (`id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `query_record_ibfk_2` FOREIGN KEY (`query_personnel_id`) REFERENCES `document_management_personnel` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
