  "ddl": "-- Schema for database: rschema_0056\nCREATE TABLE `Operator` (\n  `Operator_ID` int(11) NOT NULL,\n  `Name` varchar(255) NOT NULL,\n  `Contact_Information` varchar(255) DEFAULT NULL,\n  `Department` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`Operator_ID`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `User` (\n  `User_ID` int(11) NOT NULL,\n  `Name` varchar(255) NOT NULL,\n  `Contact_Information` varchar(255) DEFAULT NULL,\n  `Address` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`User_ID`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `Billing_Record` (\n  `User_ID` int(11) NOT NULL,\n  `Bill_Date` datetime NOT NULL,\n  `Bill_Amount` decimal(10,2) NOT NULL,\n  `Operator_ID` int(11) NOT NULL,\n  PRIMARY KEY (`User_ID`, `Bill_Date`),\n  CONSTRAINT `billing_record_ibfk_1` FOREIGN KEY (`User_ID`) REFERENCES `User` (`User_ID`) ON DELETE RESTRICT ON UPDATE CASCADE,\n  CONSTRAINT `billing_record_ibfk_2` FOREIGN KEY (`Operator_ID`) REFERENCES `Operator` (`Operator_ID`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
