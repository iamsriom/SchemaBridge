  "ddl": "-- Schema for database: rschema_0059\nCREATE TABLE `Handler` (\n  `Handler_ID` int(11) NOT NULL,\n  `Name` varchar(255) NOT NULL,\n  `Contact_Information` varchar(255) DEFAULT NULL,\n  `Department` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`Handler_ID`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `Fault_Handling` (\n  `Fault_ID` int(11) NOT NULL,\n  `Handler_ID` int(11) NOT NULL,\n  `Affected_User_ID` varchar(255) DEFAULT NULL,\n  `Description` text DEFAULT NULL,\n  `Occurrence_Date` datetime DEFAULT NULL,\n  `Resolution_Date` datetime DEFAULT NULL,\n  PRIMARY KEY (`Fault_ID`),\n  CONSTRAINT `Fault_Handling_ibfk_1` FOREIGN KEY (`Handler_ID`) REFERENCES `Handler` (`Handler_ID`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
