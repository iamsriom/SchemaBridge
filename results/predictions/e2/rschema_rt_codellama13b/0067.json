  "ddl": "-- Schema for database: rschema_0067\nCREATE TABLE `customer` (\n  `customer_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `phone` varchar(255) DEFAULT NULL,\n  `credit_score` int(11) DEFAULT NULL,\n  PRIMARY KEY (`customer_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `rental_record` (\n  `record_id` int(11) NOT NULL,\n  `customer_id` int(11) NOT NULL,\n  `rental_fee` decimal(10,2) DEFAULT NULL,\n  `rental_time` datetime DEFAULT NULL,\n  `return_time` datetime DEFAULT NULL,\n  PRIMARY KEY (`record_id`),\n  CONSTRAINT `rental_record_ibfk_1` FOREIGN KEY (`customer_id`) REFERENCES `customer` (`customer_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `credit_change_record` (\n  `record_id` int(11) NOT NULL,\n  `customer_id` int(11) NOT NULL,\n  `change_time` datetime DEFAULT NULL,\n  `change_reason` varchar(255) DEFAULT NULL,\n  `old_credit_value` int(11) DEFAULT NULL,\n  `new_credit_value` int(11) DEFAULT NULL,\n  PRIMARY KEY (`record_id`),\n  CONSTRAINT `credit_change_record_ibfk_1` FOREIGN KEY (`customer_id`) REFERENCES `customer` (`customer_id`) ON DELETE RESTRICT ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
