  "ddl": "-- Schema for database: rschema_0153\nCREATE TABLE `Teacher` (\n  `Teacher_ID` int(11) NOT NULL,\n  `Name` varchar(255) NOT NULL,\n  `Description` text DEFAULT NULL,\n  `Income` decimal(10,2) DEFAULT NULL,\n  PRIMARY KEY (`Teacher_ID`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `Student` (\n  `Student_ID` int(11) NOT NULL,\n  `Name` varchar(255) NOT NULL,\n  `Age` int(11) DEFAULT NULL,\n  `Balance` decimal(10,2) DEFAULT NULL,\n  PRIMARY KEY (`Student_ID`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `Course` (\n  `Course_ID` int(11) NOT NULL,\n  `Name` varchar(255) NOT NULL,\n  `Description` text DEFAULT NULL,\n  `Category` varchar(255) DEFAULT NULL,\n  `Instructor_Teacher_ID` int(11) NOT NULL,\n  PRIMARY KEY (`Course_ID`),\n  CONSTRAINT `course_ibfk_1` FOREIGN KEY (`Instructor_Teacher_ID`) REFERENCES `Teacher` (`Teacher_ID`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `Student_Course_Selection` (\n  `Student_ID` int(11) NOT NULL,\n  `Course_ID` int(11) NOT NULL,\n  `Course_Selection_Time` datetime DEFAULT NULL,\n  PRIMARY KEY (`Student_ID`, `Course_ID`),\n  CONSTRAINT `student_course_selection_ibfk_1` FOREIGN KEY (`Student_ID`) REFERENCES `Student` (`Student_ID`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `student_course_selection_ibfk_2` FOREIGN KEY (`Course_ID`) REFERENCES `Course` (`Course_ID`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
