  "ddl": "-- Schema for database: rschema_0184\nCREATE TABLE `member` (\n  `member_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `phone_number` varchar(20) DEFAULT NULL,\n  `registration_date` datetime NOT NULL,\n  `points_earned` int(11) DEFAULT NULL,\n  PRIMARY KEY (`member_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `room` (\n  `room_number` int(11) NOT NULL,\n  `room_type` varchar(100) NOT NULL,\n  `price` decimal(10,2) NOT NULL,\n  PRIMARY KEY (`room_number`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `booking` (\n  `member_id` int(11) NOT NULL,\n  `booking_date` datetime NOT NULL,\n  `room_number` int(11) NOT NULL,\n  `check_in_date` datetime NOT NULL,\n  `check_out_date` datetime NOT NULL,\n  `booking_status` varchar(50) NOT NULL,\n  `points_change` int(11) DEFAULT NULL,\n  PRIMARY KEY (`member_id`, `booking_date`),\n  UNIQUE KEY `unique_booking` (`member_id`, `booking_date`, `room_number`),\n  CONSTRAINT `booking_ibfk_1` FOREIGN KEY (`member_id`) REFERENCES `member` (`member_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `booking_ibfk_2` FOREIGN KEY (`room_number`) REFERENCES `room` (`room_number`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
