  "ddl": "-- Schema for database: rschema_0242\nCREATE TABLE `Employee` (\n  `Employee_ID` int(11) NOT NULL,\n  `Password` varchar(255) NOT NULL,\n  `Username` varchar(255) NOT NULL,\n  PRIMARY KEY (`Employee_ID`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `Member` (\n  `Member_ID` int(11) NOT NULL,\n  `Password` varchar(255) NOT NULL,\n  `Username` varchar(255) NOT NULL,\n  `Balance` decimal(10,2) DEFAULT NULL,\n  `Birth_Month_and_Year` date DEFAULT NULL,\n  `Gender` char(1) DEFAULT NULL,\n  `Phone_Number` varchar(15) DEFAULT NULL,\n  `Administrator_ID` int(11) DEFAULT NULL,\n  PRIMARY KEY (`Member_ID`),\n  CONSTRAINT `member_ibfk_1` FOREIGN KEY (`Administrator_ID`) REFERENCES `Administrator` (`Administrator_ID`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `Administrator` (\n  `Administrator_ID` int(11) NOT NULL,\n  `Password` varchar(255) NOT NULL,\n  `Username` varchar(255) NOT NULL,\n  PRIMARY KEY (`Administrator_ID`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `Order` (\n  `Order_ID` int(11) NOT NULL,\n  `Order_Time` datetime NOT NULL,\n  `Employee_ID` int(11) NOT NULL,\n  `Member_ID` int(11) NOT NULL,\n  PRIMARY KEY (`Order_ID`),\n  CONSTRAINT `order_ibfk_1` FOREIGN KEY (`Employee_ID`) REFERENCES `Employee` (`Employee_ID`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `order_ibfk_2` FOREIGN KEY (`Member_ID`) REFERENCES `Member` (`Member_ID`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
