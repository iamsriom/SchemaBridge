  "ddl": "-- Schema for database: rschema_0256\nCREATE TABLE `Mall` (\n  `Mall_ID` int(11) NOT NULL,\n  `Mall_name` varchar(255) NOT NULL,\n  `Address` varchar(255) NOT NULL,\n  `Contact_number` varchar(15) DEFAULT NULL,\n  PRIMARY KEY (`Mall_ID`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `Department` (\n  `Department_ID` int(11) NOT NULL,\n  `Department_name` varchar(255) NOT NULL,\n  `Location_distribution` varchar(255) NOT NULL,\n  `Contact_number` varchar(15) DEFAULT NULL,\n  `Mall_ID` int(11) NOT NULL,\n  `Manager_employee_ID` int(11) DEFAULT NULL,\n  PRIMARY KEY (`Department_ID`),\n  CONSTRAINT `department_ibfk_1` FOREIGN KEY (`Mall_ID`) REFERENCES `Mall` (`Mall_ID`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `department_ibfk_2` FOREIGN KEY (`Manager_employee_ID`) REFERENCES `Employee` (`Employee_ID`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `Employee` (\n  `Employee_ID` int(11) NOT NULL,\n  `Department_ID` int(11) NOT NULL,\n  `Name` varchar(255) NOT NULL,\n  `Phone_number` varchar(15) DEFAULT NULL,\n  `Position` varchar(255) NOT NULL,\n  `Salary` decimal(10,2) DEFAULT NULL,\n  PRIMARY KEY (`Employee_ID`, `Department_ID`),\n  CONSTRAINT `employee_ibfk_1` FOREIGN KEY (`Department_ID`) REFERENCES `Department` (`Department_ID`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
