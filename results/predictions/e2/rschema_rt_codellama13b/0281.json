  "ddl": "-- Schema for database: rschema_0281\nCREATE TABLE `exhibition` (\n  `exhibition_id` int(11) NOT NULL AUTO_INCREMENT,\n  `exhibition_name` varchar(255) NOT NULL,\n  `location` varchar(255) NOT NULL,\n  `start_time` datetime NOT NULL,\n  `end_time` datetime NOT NULL,\n  PRIMARY KEY (`exhibition_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `curator` (\n  `curator_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `email` varchar(255) NOT NULL,\n  `phone_number` varchar(20) DEFAULT NULL,\n  PRIMARY KEY (`curator_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `exhibit` (\n  `exhibit_id` int(11) NOT NULL AUTO_INCREMENT,\n  `exhibit_name` varchar(255) NOT NULL,\n  `description` text DEFAULT NULL,\n  `image_path` varchar(255) DEFAULT NULL,\n  `source` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`exhibit_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `exhibition_management` (\n  `curator_id` int(11) NOT NULL,\n  `exhibition_id` int(11) NOT NULL,\n  PRIMARY KEY (`curator_id`, `exhibition_id`),\n  CONSTRAINT `exhibition_management_ibfk_1` FOREIGN KEY (`curator_id`) REFERENCES `curator` (`curator_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `exhibition_management_ibfk_2` FOREIGN KEY (`exhibition_id`) REFERENCES `exhibition` (`exhibition_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `exhibit_association` (\n  `exhibit_id` int(11) NOT NULL,\n  `exhibition_id` int(11) NOT NULL,\n  PRIMARY KEY (`exhibit_id`, `exhibition_id`),\n  CONSTRAINT `exhibit_association_ibfk_1` FOREIGN KEY (`exhibit_id`) REFERENCES `exhibit` (`exhibit_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `exhibit_association_ibfk_2` FOREIGN KEY (`exhibition_id`) REFERENCES `exhibition` (`exhibition_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
