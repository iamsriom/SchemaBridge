  "ddl": "-- Schema for database: rschema_0334\nCREATE TABLE `user` (\n  `user_id` int(11) NOT NULL AUTO_INCREMENT,\n  `first_name` varchar(255) NOT NULL,\n  `last_name` varchar(255) NOT NULL,\n  `email` varchar(255) NOT NULL,\n  `password` varchar(255) NOT NULL,\n  `avatar_path` varchar(255) DEFAULT NULL,\n  `date_of_birth` datetime DEFAULT NULL,\n  PRIMARY KEY (`user_id`),\n  UNIQUE KEY `email` (`email`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `post` (\n  `post_id` int(11) NOT NULL AUTO_INCREMENT,\n  `post_title` varchar(255) NOT NULL,\n  `post_content` text NOT NULL,\n  `poster_user_id` int(11) NOT NULL,\n  PRIMARY KEY (`post_id`),\n  CONSTRAINT `post_ibfk_1` FOREIGN KEY (`poster_user_id`) REFERENCES `user` (`user_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `comment` (\n  `comment_id` int(11) NOT NULL AUTO_INCREMENT,\n  `comment_content` text NOT NULL,\n  `commented_post_id` int(11) NOT NULL,\n  `commenter_user_id` int(11) NOT NULL,\n  PRIMARY KEY (`comment_id`),\n  CONSTRAINT `comment_ibfk_1` FOREIGN KEY (`commented_post_id`) REFERENCES `post` (`post_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `comment_ibfk_2` FOREIGN KEY (`commenter_user_id`) REFERENCES `user` (`user_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
