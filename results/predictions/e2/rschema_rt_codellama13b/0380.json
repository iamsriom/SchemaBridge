  "ddl": "-- Schema for database: rschema_0380\nCREATE TABLE `customer` (\n  `customer_id` int(11) NOT NULL,\n  `email` varchar(255) DEFAULT NULL,\n  `name` varchar(255) DEFAULT NULL,\n  `phone` varchar(20) DEFAULT NULL,\n  PRIMARY KEY (`customer_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `airline` (\n  `airline_id` int(11) NOT NULL,\n  `address` varchar(255) DEFAULT NULL,\n  `name` varchar(255) DEFAULT NULL,\n  `phone` varchar(20) DEFAULT NULL,\n  PRIMARY KEY (`airline_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `flight` (\n  `flight_id` int(11) NOT NULL,\n  `airline_id` int(11) NOT NULL,\n  `arrival_time` datetime DEFAULT NULL,\n  `departure_location` varchar(255) DEFAULT NULL,\n  `departure_time` datetime DEFAULT NULL,\n  `destination` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`flight_id`),\n  CONSTRAINT `flight_ibfk_1` FOREIGN KEY (`airline_id`) REFERENCES `airline` (`airline_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `flight_reservation` (\n  `customer_id` int(11) NOT NULL,\n  `flight_id` int(11) NOT NULL,\n  `number_of_tickets` int(11) DEFAULT NULL,\n  `reservation_time` datetime NOT NULL,\n  PRIMARY KEY (`customer_id`, `flight_id`, `reservation_time`),\n  CONSTRAINT `flight_reservation_ibfk_1` FOREIGN KEY (`customer_id`) REFERENCES `customer` (`customer_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `flight_reservation_ibfk_2` FOREIGN KEY (`flight_id`) REFERENCES `flight` (`flight_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
