  "nl_text": "The database name is rschema_0499 and it contains five tables. The first table is called Class and it has four columns: Class_ID, Class_name, Classroom, and Major. The Class_ID column is the primary key and the other columns are not null. The second table is called Sports_team and it has four columns: Activity_time, Coach, Team_ID, and Team_name. The Team_ID column is the primary key and the other columns are not null. The third table is called Dormitory and it has five columns: Administrator, Building_number, Dormitory_number, Number_of_residents, and PRIMARY KEY (Dormitory_number, Building_number). The fourth table is called Student and it has eight columns: Age, Building_number, Class_ID, Dormitory_number, Gender, Name, Student_ID, and FOREIGN KEY (Building_number) REFERENCES Dormitory(Building_number), FOREIGN KEY (Class_ID) REFERENCES Class(Class_ID), FOREIGN KEY (Dormitory_number) REFERENCES Dormitory(Dormitory_number). The Student_ID column is the primary key and the other columns are not null. The fifth table is called Team_membership and it has three columns: Student_ID, Team_ID, and PRIMARY KEY (Student_ID, Team_ID). The Student_ID and Team_ID columns are not null and the FOREIGN KEY (Student_ID) REFERENCES Student(Student_ID) and FOREIGN KEY (Team_ID) REFERENCES Sports_team(Team_ID) constraints are in place.",
  "gold_question": "This is a student management system. The system manages student information (student ID, name, gender, age, etc.), class information (class name, major, classroom, etc.), sports team information (team name, activity time, coach, etc.), and dormitory information (dormitory number, building number, administrator, number of residents, etc.). The system also maintains the relationships between students and classes, students and sports teams, and students and dormitories.",
  "input_json": "/data/RSchema_ExpResults4/Experiment2/schema2text_codellama13b/0499.json",
  "ddl": "-- Schema for database: rschema_0499\nCREATE TABLE `Class` (\n  `Class_ID` int(11) NOT NULL,\n  `Class_name` varchar(255) NOT NULL,\n  `Classroom` varchar(255) NOT NULL,\n  `Major` varchar(255) NOT NULL,\n  PRIMARY KEY (`Class_ID`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `Sports_team` (\n  `Activity_time` datetime NOT NULL,\n  `Coach` varchar(255) NOT NULL,\n  `Team_ID` int(11) NOT NULL,\n  `Team_name` varchar(255) NOT NULL,\n  PRIMARY KEY (`Team_ID`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `Dormitory` (\n  `Administrator` varchar(255) NOT NULL,\n  `Building_number` int(11) NOT NULL,\n  `Dormitory_number` int(11) NOT NULL,\n  `Number_of_residents` int(11) NOT NULL,\n  PRIMARY KEY (`Dormitory_number`, `Building_number`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `Student` (\n  `Age` int(11) NOT NULL,\n  `Building_number` int(11) NOT NULL,\n  `Class_ID` int(11) NOT NULL,\n  `Dormitory_number` int(11) NOT NULL,\n  `Gender` varchar(10) NOT NULL,\n  `Name` varchar(255) NOT NULL,\n  `Student_ID` int(11) NOT NULL,\n  PRIMARY KEY (`Student_ID`),\n  CONSTRAINT `student_ibfk_1` FOREIGN KEY (`Building_number`) REFERENCES `Dormitory` (`Building_number`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `student_ibfk_2` FOREIGN KEY (`Class_ID`) REFERENCES `Class` (`Class_ID`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `student_ibfk_3` FOREIGN KEY (`Dormitory_number`) REFERENCES `Dormitory` (`Dormitory_number`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `Team_membership` (\n  `Student_ID` int(11) NOT NULL,\n  `Team_ID` int(11) NOT NULL,\n  PRIMARY KEY (`Student_ID`, `Team_ID`),\n  CONSTRAINT `team_membership_ibfk_1` FOREIGN KEY (`Student_ID`) REFERENCES `Student` (`Student_ID`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `team_membership_ibfk_2` FOREIGN KEY (`Team_ID`) REFERENCES `Sports_team` (`Team_ID`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
