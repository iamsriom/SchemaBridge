  "database": "rschema_0060",
  "nl_text": "The database schema named 'rschema_0060' contains four tables: 'project', 'researcher', 'research_result', and 'fund_usage'.\nThe 'project' table represents a project with columns for 'project_id', 'name', 'start_date', 'end_date', 'project_leader', and 'budget'. The 'project_id' column is the primary key.\nThe 'researcher' table represents a researcher with columns for 'employee_number', 'name', 'date_of_birth', 'gender', 'phone_number', 'position', and 'project_id'. The 'employee_number' column is the primary key and the 'project_id' column is a foreign key referencing the 'project' table.\nThe 'research_result' table represents a research result with columns for 'result_id', 'name', 'publication_date', and 'researcher_employee_number'. The 'result_id' column is the primary key and the 'researcher_employee_number' column is a foreign key referencing the 'researcher' table.\nFinally, the 'fund_usage' table represents the usage of funds with columns for 'fund_id', 'project_id', 'purpose', 'amount', and 'usage_date'. The 'fund_id' column is the primary key and the 'project_id' column is a foreign key referencing the 'project' table. The 'fund_usage' table has ON DELETE CASCADE and ON UPDATE CASCADE rules for both foreign keys, meaning that if a project or researcher is deleted or updated, the corresponding entries in the 'fund_usage' table will also be deleted or updated.",
  "gold_question": "Research institutions conduct multiple scientific projects, each involving multiple researchers, with each researcher participating in only one project.\n  Each project has a project ID, name, start date, end date, project leader, and budget. Researchers have an employee number, name, date of birth, gender, phone number, and position.\n  Each project's research results must be recorded with a result ID, name, publication date, and researcher (1 person).\n  The usage of project funds needs to be recorded with a fund ID, project ID, purpose, amount, and usage date.",
  "input_json": "/data/RSchema_ExpResults4/Experiment2/schema2text_deepseek/0060.json",
  "ddl": "-- Schema for database: rschema_0060\nCREATE TABLE `project` (\n  `project_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `start_date` datetime NOT NULL,\n  `end_date` datetime NOT NULL,\n  `project_leader` varchar(255) NOT NULL,\n  `budget` decimal(10,2) NOT NULL,\n  PRIMARY KEY (`project_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `researcher` (\n  `employee_number` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `date_of_birth` date NOT NULL,\n  `gender` char(1) NOT NULL,\n  `phone_number` varchar(15) DEFAULT NULL,\n  `position` varchar(255) NOT NULL,\n  `project_id` int(11) DEFAULT NULL,\n  PRIMARY KEY (`employee_number`),\n  CONSTRAINT `researcher_ibfk_1` FOREIGN KEY (`project_id`) REFERENCES `project` (`project_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `research_result` (\n  `result_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `publication_date` date NOT NULL,\n  `researcher_employee_number` int(11) NOT NULL,\n  PRIMARY KEY (`result_id`),\n  CONSTRAINT `research_result_ibfk_1` FOREIGN KEY (`researcher_employee_number`) REFERENCES `researcher` (`employee_number`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `fund_usage` (\n  `fund_id` int(11) NOT NULL,\n  `project_id` int(11) NOT NULL,\n  `purpose` varchar(255) NOT NULL,\n  `amount` decimal(10,2) NOT NULL,\n  `usage_date` date NOT NULL,\n  PRIMARY KEY (`fund_id`),\n  CONSTRAINT `fund_usage_ibfk_1` FOREIGN KEY (`project_id`) REFERENCES `project` (`project_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
