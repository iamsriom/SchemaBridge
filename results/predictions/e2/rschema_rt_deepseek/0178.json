  "nl_text": "The database schema named 'rschema_0178' contains 7 tables. The 'Customer' table is used for storing customer information, including their address, agreement status, contact information, customer ID, email, name, and password. The 'Medication' table is used for storing medication information, including the dosage, medication ID, medication name, price, and stock quantity. The 'Payment_Method' table is used for storing payment method information, including the customer ID, payment details, payment method ID, and payment type. The 'Prescription' table is used for storing prescription information, including the customer ID, doctor contact information, doctor hospital, doctor name, prescription ID, prescription status, and submission time. The 'Prescription_Medication_Association' table is used for associating medications with prescriptions, including the medication ID and prescription ID, as well as the quantity. The 'Order' table is used for storing order information, including the customer ID, mailing address, order ID, order status, order time, prescription ID, and total price. The 'Verification_Log' table is used for storing verification log information, including the log ID, prescription ID, verification result, and verification time. All tables have primary keys and foreign keys to ensure data integrity and referential integrity.",
  "gold_question": "The database for an online pharmacy system shall be designed and implemented with the following requirements:\n\nThe system shall support customer registration, including filling out customer information, payment methods, and signing an authorization agreement; and login, allowing only registered customers to log in.\n\nThe system shall support prescription entry and submission, including filling out doctor information and medication information; and prescription validation, verifying doctor information and sending confirmation requests. The prescription status shall be set to \"Invalid Doctor Information\", \"Invalid Prescription\", \"Unable to Review\", or \"Approved for Payment\" based on the doctor's response or timeout.\n\nThe system shall support medication purchase, automatically calculating medication prices and mailing to customers who have paid.",
  "input_json": "/data/RSchema_ExpResults4/Experiment2/schema2text_deepseek/0178.json",
  "ddl": "-- Schema for database: rschema_0178\nCREATE TABLE `Customer` (\n  `customer_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `email` varchar(255) NOT NULL,\n  `password` varchar(255) NOT NULL,\n  `address` varchar(255) DEFAULT NULL,\n  `agreement_status` varchar(50) DEFAULT NULL,\n  `contact_information` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`customer_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `Medication` (\n  `medication_id` int(11) NOT NULL AUTO_INCREMENT,\n  `medication_name` varchar(255) NOT NULL,\n  `dosage` varchar(50) DEFAULT NULL,\n  `price` decimal(10,2) NOT NULL,\n  `stock_quantity` int(11) NOT NULL,\n  PRIMARY KEY (`medication_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `Payment_Method` (\n  `payment_method_id` int(11) NOT NULL AUTO_INCREMENT,\n  `customer_id` int(11) NOT NULL,\n  `payment_details` varchar(255) NOT NULL,\n  `payment_type` varchar(50) NOT NULL,\n  PRIMARY KEY (`payment_method_id`),\n  CONSTRAINT `payment_method_ibfk_1` FOREIGN KEY (`customer_id`) REFERENCES `Customer` (`customer_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `Prescription` (\n  `prescription_id` int(11) NOT NULL AUTO_INCREMENT,\n  `customer_id` int(11) NOT NULL,\n  `doctor_name` varchar(255) NOT NULL,\n  `doctor_hospital` varchar(255) DEFAULT NULL,\n  `doctor_contact_information` varchar(255) DEFAULT NULL,\n  `prescription_status` varchar(50) DEFAULT NULL,\n  `submission_time` datetime NOT NULL,\n  PRIMARY KEY (`prescription_id`),\n  CONSTRAINT `prescription_ibfk_1` FOREIGN KEY (`customer_id`) REFERENCES `Customer` (`customer_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `Prescription_Medication_Association` (\n  `association_id` int(11) NOT NULL AUTO_INCREMENT,\n  `prescription_id` int(11) NOT NULL,\n  `medication_id` int(11) NOT NULL,\n  `quantity` int(11) NOT NULL,\n  PRIMARY KEY (`association_id`),\n  CONSTRAINT `prescription_medication_association_ibfk_1` FOREIGN KEY (`prescription_id`) REFERENCES `Prescription` (`prescription_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `prescription_medication_association_ibfk_2` FOREIGN KEY (`medication_id`) REFERENCES `Medication` (`medication_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `Order` (\n  `order_id` int(11) NOT NULL AUTO_INCREMENT,\n  `customer_id` int(11) NOT NULL,\n  `prescription_id` int(11) DEFAULT NULL,\n  `mailing_address` varchar(255) NOT NULL,\n  `order_status` varchar(50) DEFAULT NULL,\n  `order_time` datetime NOT NULL,\n  `total_price` decimal(10,2) NOT NULL,\n  PRIMARY KEY (`order_id`),\n  CONSTRAINT `order_ibfk_1` FOREIGN KEY (`customer_id`) REFERENCES `Customer` (`customer_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `order_ibfk_2` FOREIGN KEY (`prescription_id`) REFERENCES `Prescription` (`prescription_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `Verification_Log` (\n  `log_id` int(11) NOT NULL AUTO_INCREMENT,\n  `prescription_id` int(11) NOT NULL,\n  `verification_result` varchar(50) NOT NULL,\n  `verification_time` datetime NOT NULL,\n  PRIMARY KEY (`log_id`),\n  CONSTRAINT `verification_log_ibfk_1` FOREIGN KEY (`prescription_id`) REFERENCES `Prescription` (`prescription_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
