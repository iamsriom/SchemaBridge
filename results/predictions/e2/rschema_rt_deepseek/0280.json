  "ddl": "-- Schema for database: rschema_0280\nCREATE TABLE `movie_project` (\n  `project_id` int(11) NOT NULL,\n  `project_name` varchar(255) DEFAULT NULL,\n  `project_type` varchar(255) DEFAULT NULL,\n  `budget` float DEFAULT NULL,\n  `filming_time` datetime DEFAULT NULL,\n  PRIMARY KEY (`project_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `director` (\n  `director_id` int(11) NOT NULL,\n  `director_name` varchar(255) DEFAULT NULL,\n  `email` varchar(255) DEFAULT NULL,\n  `phone_number` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`director_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `actor` (\n  `actor_id` int(11) NOT NULL,\n  `actor_name` varchar(255) DEFAULT NULL,\n  `email` varchar(255) DEFAULT NULL,\n  `phone_number` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`actor_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `producer` (\n  `producer_id` int(11) NOT NULL,\n  `producer_name` varchar(255) DEFAULT NULL,\n  `email` varchar(255) DEFAULT NULL,\n  `phone_number` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`producer_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `director_participate_project` (\n  `director_id` int(11) NOT NULL,\n  `project_id` int(11) NOT NULL,\n  PRIMARY KEY (`director_id`, `project_id`),\n  CONSTRAINT `director_participate_project_ibfk_1` FOREIGN KEY (`director_id`) REFERENCES `director` (`director_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `director_participate_project_ibfk_2` FOREIGN KEY (`project_id`) REFERENCES `movie_project` (`project_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `actor_participate_project` (\n  `actor_id` int(11) NOT NULL,\n  `project_id` int(11) NOT NULL,\n  PRIMARY KEY (`actor_id`, `project_id`),\n  CONSTRAINT `actor_participate_project_ibfk_1` FOREIGN KEY (`actor_id`) REFERENCES `actor` (`actor_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `actor_participate_project_ibfk_2` FOREIGN KEY (`project_id`) REFERENCES `movie_project` (`project_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `producer_participate_project` (\n  `producer_id` int(11) NOT NULL,\n  `project_id` int(11) NOT NULL,\n  PRIMARY KEY (`producer_id`, `project_id`),\n  CONSTRAINT `producer_participate_project_ibfk_1` FOREIGN KEY (`producer_id`) REFERENCES `producer` (`producer_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `producer_participate_project_ibfk_2` FOREIGN KEY (`project_id`) REFERENCES `movie_project` (`project_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
