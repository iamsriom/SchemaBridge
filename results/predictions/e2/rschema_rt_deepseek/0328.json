  "database": "rschema_0328",
  "nl_text": "The database schema named 'rschema_0328' contains six tables: Administrator, Survey, Question, Option, Text_answer_record, and Choice_answer_record.\nThe Administrator table is used for storing information about the administrators of the survey system. It includes columns for Account, Administrator_ID, Name, Password, and Phone_number.\nThe Survey table is used for storing information about the surveys. It includes columns for Access_restriction, Access_rule, Anonymous, Background_image_URL, Description, End_time, Start_time, Survey_ID, Survey_logo_URL, Survey_status, and Survey_title.\nThe Question table is used for storing information about the questions in the surveys. It includes columns for Description, Display_order, Display_style, Evaluation_score, For_evaluation, Question_ID, Question_title, Question_type, Required, Survey_ID, and Validation_type. The Survey_ID column is a foreign key referencing the Survey table.\nThe Option table is used for storing information about the options for questions in the surveys. It includes columns for Display_order, Is_correct_answer, Option_ID, Option_content, Question_ID, and a foreign key referencing the Question table.\nThe Text_answer_record table is used for storing information about text answers to questions in the surveys. It includes columns for Answer_ID, Answer_content, Question_ID, Respondent_information, and Submission_time. The Question_ID column is a foreign key referencing the Question table.\nThe Choice_answer_record table is used for storing information about choice answers to questions in the surveys. It includes columns for Answer_ID, Answer_type, Option_ID, Respondent_information, and Submission_time. The Option_ID column is a foreign key referencing the Option table.\nAll tables allow null values except for the Survey_ID in the Question table, Question_ID in the Option table, and Question_ID in the Text_answer_record and Choice_answer_record tables. The primary keys are the unique identifiers for each record in their respective tables. The foreign keys enforce referential integrity by ensuring that the values in the foreign key columns match the values in the primary key columns of the referenced tables.",
  "gold_question": "This is an online survey system. For administrator management, the system maintains administrator information including name, phone number, account, and password. Administrators can register, log in to the system, create, edit, delete surveys, and view survey statistics. For survey management, the system supports creating surveys, setting survey title, description, access restrictions, start and end times, access rules (public or password-protected), survey status (created, in progress, ended), survey logo URL and background image URL, anonymity settings, etc. Surveys can be associated with multiple questions. For question management, the system supports creating different types of questions (single choice, multiple choice, text, text area), setting question title, description, required status, validation type, display order, display style, evaluation status, evaluation score, etc. Questions can be associated with multiple options. For option management, the system supports creating options for questions, setting option content, display order, correct answer status, etc. Options can be single or multiple choice type. For answer recording, the system records users' answers to single or multiple choice questions, including option ID, answer type, submission time, respondent information, and also records users' answers to text questions, including question ID, answer content, submission time, and respondent information.",
  "input_json": "/data/RSchema_ExpResults4/Experiment2/schema2text_deepseek/0328.json",
  "ddl": "-- Schema for database: rschema_0328\nCREATE TABLE `administrator` (\n  `administrator_id` int(11) NOT NULL,\n  `account` varchar(255) DEFAULT NULL,\n  `name` varchar(255) DEFAULT NULL,\n  `password` varchar(255) DEFAULT NULL,\n  `phone_number` varchar(20) DEFAULT NULL,\n  PRIMARY KEY (`administrator_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `survey` (\n  `survey_id` int(11) NOT NULL,\n  `survey_title` varchar(255) DEFAULT NULL,\n  `description` text DEFAULT NULL,\n  `background_image_url` varchar(255) DEFAULT NULL,\n  `survey_logo_url` varchar(255) DEFAULT NULL,\n  `start_time` datetime DEFAULT NULL,\n  `end_time` datetime DEFAULT NULL,\n  `survey_status` varchar(50) DEFAULT NULL,\n  `access_restriction` varchar(50) DEFAULT NULL,\n  `access_rule` varchar(50) DEFAULT NULL,\n  `anonymous` tinyint(1) DEFAULT NULL,\n  PRIMARY KEY (`survey_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `question` (\n  `question_id` int(11) NOT NULL,\n  `question_title` varchar(255) DEFAULT NULL,\n  `description` text DEFAULT NULL,\n  `display_order` int(11) DEFAULT NULL,\n  `display_style` varchar(50) DEFAULT NULL,\n  `evaluation_score` int(11) DEFAULT NULL,\n  `for_evaluation` tinyint(1) DEFAULT NULL,\n  `required` tinyint(1) DEFAULT NULL,\n  `question_type` varchar(50) DEFAULT NULL,\n  `validation_type` varchar(50) DEFAULT NULL,\n  `survey_id` int(11) NOT NULL,\n  PRIMARY KEY (`question_id`),\n  CONSTRAINT `question_ibfk_1` FOREIGN KEY (`survey_id`) REFERENCES `survey` (`survey_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `option` (\n  `option_id` int(11) NOT NULL,\n  `option_content` text DEFAULT NULL,\n  `display_order` int(11) DEFAULT NULL,\n  `is_correct_answer` tinyint(1) DEFAULT NULL,\n  `question_id` int(11) NOT NULL,\n  PRIMARY KEY (`option_id`),\n  CONSTRAINT `option_ibfk_1` FOREIGN KEY (`question_id`) REFERENCES `question` (`question_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `text_answer_record` (\n  `answer_id` int(11) NOT NULL,\n  `answer_content` text DEFAULT NULL,\n  `question_id` int(11) NOT NULL,\n  `respondent_information` varchar(255) DEFAULT NULL,\n  `submission_time` datetime DEFAULT NULL,\n  PRIMARY KEY (`answer_id`),\n  CONSTRAINT `text_answer_record_ibfk_1` FOREIGN KEY (`question_id`) REFERENCES `question` (`question_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `choice_answer_record` (\n  `answer_id` int(11) NOT NULL,\n  `answer_type` varchar(50) DEFAULT NULL,\n  `option_id` int(11) NOT NULL,\n  `respondent_information` varchar(255) DEFAULT NULL,\n  `submission_time` datetime DEFAULT NULL,\n  PRIMARY KEY (`answer_id`),\n  CONSTRAINT `choice_answer_record_ibfk_1` FOREIGN KEY (`option_id`) REFERENCES `option` (`option_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
