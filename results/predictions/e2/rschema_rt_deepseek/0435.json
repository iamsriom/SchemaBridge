  "database": "rschema_0435",
  "nl_text": "The database schema named 'rschema_0435' contains six tables. The main purpose of this schema is to manage and organize data related to various scientific instruments, celestial bodies, probe configurations, observation records, and exploration missions.\nThe 'Probe' table represents the scientific instruments used for exploration missions. It contains columns for the launch date, name, operational status, probe ID, remaining fuel, service life, and weight.\nThe 'Scientific_instrument' table holds information about scientific instruments. It includes accuracy, calibration data, instrument ID, name, operating parameters, power consumption, and weight.\nThe 'Celestial_body' table contains data about celestial bodies. It includes celestial ID, name, orbital parameters, physical characteristics, research value, and type.\nThe 'Probe_instrument_configuration' table establishes the relationship between probes and scientific instruments. It contains foreign keys referencing the 'Probe' and 'Scientific_instrument' tables.\nThe 'Observation_record' table records observations made on celestial bodies. It includes foreign key referencing the 'Celestial_body' table and contains columns for observation accuracy, observation data, observation results, observation time, and record ID.\nFinally, the 'Exploration_mission' table details the exploration missions. It contains foreign keys referencing the 'Celestial_body' and 'Probe' tables. It also includes columns for execution status, mission priority, mission resource allocation, probe flight trajectory, and scientific data acquisition status.\nThis schema ensures data integrity by enforcing primary and foreign key constraints, and it allows for referential integrity by maintaining the relationships between tables.",
  "gold_question": "This is a space exploration mission management system. For probe management, the system records basic probe information including probe ID, name, weight, launch date, and service life, maintains the scientific instrument configuration carried by the probe, and tracks the probe's operational status and remaining fuel.\n\nFor celestial target management, the system records basic information about observed celestial bodies, including celestial body ID, name, type (planet/asteroid/comet etc.), maintains orbital parameters and physical characteristics, while recording existing observational data (observation time, observation data, observation results, observation accuracy, etc.) and research value.\n\nFor scientific instrument management, the system records basic instrument information including instrument ID, name, weight, power consumption, accuracy, etc., and maintains instrument operating parameters and calibration data.\n\nFor exploration mission management, the system records the probe's flight trajectory and target celestial bodies, records mission execution status and scientific data acquisition status, while maintaining mission priority and resource allocation.",
  "input_json": "/data/RSchema_ExpResults4/Experiment2/schema2text_deepseek/0435.json",
  "ddl": "-- Schema for database: rschema_0435\nCREATE TABLE `Probe` (\n  `probe_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `launch_date` datetime NOT NULL,\n  `operational_status` varchar(50) NOT NULL,\n  `remaining_fuel` float DEFAULT NULL,\n  `service_life` int(11) DEFAULT NULL,\n  `weight` float DEFAULT NULL,\n  PRIMARY KEY (`probe_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `Scientific_instrument` (\n  `instrument_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `accuracy` float DEFAULT NULL,\n  `calibration_data` varchar(255) DEFAULT NULL,\n  `operating_parameters` varchar(255) DEFAULT NULL,\n  `power_consumption` float DEFAULT NULL,\n  `weight` float DEFAULT NULL,\n  PRIMARY KEY (`instrument_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `Celestial_body` (\n  `celestial_id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `orbital_parameters` varchar(255) DEFAULT NULL,\n  `physical_characteristics` varchar(255) DEFAULT NULL,\n  `research_value` float DEFAULT NULL,\n  `type` varchar(50) DEFAULT NULL,\n  PRIMARY KEY (`celestial_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `Probe_instrument_configuration` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `probe_id` int(11) NOT NULL,\n  `instrument_id` int(11) NOT NULL,\n  PRIMARY KEY (`id`),\n  CONSTRAINT `probe_instrument_configuration_ibfk_1` FOREIGN KEY (`probe_id`) REFERENCES `Probe` (`probe_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `probe_instrument_configuration_ibfk_2` FOREIGN KEY (`instrument_id`) REFERENCES `Scientific_instrument` (`instrument_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `Observation_record` (\n  `record_id` int(11) NOT NULL AUTO_INCREMENT,\n  `celestial_id` int(11) NOT NULL,\n  `observation_accuracy` float DEFAULT NULL,\n  `observation_data` text DEFAULT NULL,\n  `observation_results` text DEFAULT NULL,\n  `observation_time` datetime NOT NULL,\n  PRIMARY KEY (`record_id`),\n  CONSTRAINT `observation_record_ibfk_1` FOREIGN KEY (`celestial_id`) REFERENCES `Celestial_body` (`celestial_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `Exploration_mission` (\n  `mission_id` int(11) NOT NULL AUTO_INCREMENT,\n  `celestial_id` int(11) NOT NULL,\n  `probe_id` int(11) NOT NULL,\n  `execution_status` varchar(50) DEFAULT NULL,\n  `mission_priority` int(11) DEFAULT NULL,\n  `mission_resource_allocation` float DEFAULT NULL,\n  `probe_flight_trajectory` varchar(255) DEFAULT NULL,\n  `scientific_data_acquisition_status` varchar(50) DEFAULT NULL,\n  PRIMARY KEY (`mission_id`),\n  CONSTRAINT `exploration_mission_ibfk_1` FOREIGN KEY (`celestial_id`) REFERENCES `Celestial_body` (`celestial_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `exploration_mission_ibfk_2` FOREIGN KEY (`probe_id`) REFERENCES `Probe` (`probe_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
