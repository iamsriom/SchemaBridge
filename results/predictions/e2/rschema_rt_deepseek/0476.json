  "nl_text": "The database schema named \"rschema_0476\" contains 11 tables.\nThe 'Customer' table is used to store customer information. It includes columns for 'Address', 'Contact_Number', 'Customer_ID', and 'Name'. 'Customer_ID' is the primary key.\nThe 'Raw_Material' table is used to store raw material information. It includes columns for 'Raw_Material_ID', 'Raw_Material_Name', and 'Specification'. 'Raw_Material_ID' is the primary key.\nThe 'Financial_Record' table is used to store financial transaction information. It includes columns for 'Amount', 'Date', 'Status', 'Transaction_ID', and 'Transaction_Type'. 'Transaction_ID' is the primary key.\nThe 'Supplier' table is used to store supplier information. It includes columns for 'Contact_Information', 'Supplier_ID', and 'Supplier_Name'. 'Supplier_ID' is the primary key.\nThe 'Pizza_Recipe' table is used to store pizza recipe information. It includes columns for 'Raw_Material_ID', 'Recipe_ID', and 'Usage_Amount'. 'Recipe_ID' and 'Raw_Material_ID' are primary keys.\nThe 'Sales_Order' table is used to store sales order information. It includes columns for 'Customer_ID', 'Expected_Delivery_Date', 'Order_ID', and 'Order_Status'. 'Order_ID' is the primary key and 'Customer_ID' is a foreign key referencing the 'Customer' table.\nThe 'Purchase_Order' table is used to store purchase order information. It includes columns for 'Order_Quantity', 'Order_Status', 'Purchase_Order_ID', 'Raw_Material_ID', 'Supplied_Quantity', and 'Supplier_ID'. 'Purchase_Order_ID' is the primary key and 'Raw_Material_ID' and 'Supplier_ID' are foreign keys referencing the 'Raw_Material' and 'Supplier' tables respectively.\nThe 'Product' table is used to store product information. It includes columns for 'Product_ID', 'Product_Name', and 'Recipe_ID'. 'Product_ID' is the primary key and 'Recipe_ID' is a foreign key referencing the 'Pizza_Recipe' table.\nThe 'Production_Plan' table is used to store production plan information. It includes columns for 'Order_ID', 'Production_Plan_ID', and 'Production_Status'. 'Production_Plan_ID' is the primary key and 'Order_ID' is a foreign key referencing the 'Sales_Order' table.\nThe 'Delivery_Record' table is used to store delivery record information. It includes columns for 'Delivery_Location', 'Delivery_Record_ID', 'Delivery_Time', 'Order_ID', and 'Status'. 'Delivery_Record_ID' is the primary key and 'Order_ID' is a foreign key referencing the 'Sales_Order' table.\nFinally, the 'Inventory_Management' table is used to store inventory management information. It includes columns for 'Inventory_ID', 'Product_ID', 'Quantity', and 'Status'. 'Inventory_ID' is the primary key and 'Product_ID' is a foreign key referencing the 'Product' table.",
  "gold_question": "The design of the information management system for a pizza shop is as follows:\nThe system includes Customer Management, Sales Order Processing, Production Planning, Raw Material Procurement, Product Inventory Management, Order Delivery, and Financial Records.\nCustomer information comprises Customer ID, Name, Contact Number, and Address.\nSales Order records the customer's order details, including Order ID, Customer ID, Expected Delivery Date, and Order Status.\nProduction Planning determines the production sequence and quantity based on Sales Orders and inventory status, and records the production status.  \nInventory Management tracks the quantity and status of pizzas and raw materials.\nPurchase Orders are used to order raw materials from suppliers, documenting Supplier ID, Raw Material ID, Order Quantity, Supply Quantity, and Order Status.\nDelivery Records track the delivery details of orders, including Delivery Time, Location, and Status.\nFinancial Records manage income and expenses, recording Transaction Type, Amount, Date, and Status.\nAdditionally, the system includes Supplier Information, Pizza Recipes, and Raw Material Details to ensure the smooth progression of production processes.",
  "input_json": "/data/RSchema_ExpResults4/Experiment2/schema2text_deepseek/0476.json",
  "ddl": "-- Schema for database: rschema_0476\nCREATE TABLE `Customer` (\n  `Customer_ID` int(11) NOT NULL,\n  `Name` varchar(255) NOT NULL,\n  `Address` varchar(255) DEFAULT NULL,\n  `Contact_Number` varchar(15) DEFAULT NULL,\n  PRIMARY KEY (`Customer_ID`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `Raw_Material` (\n  `Raw_Material_ID` int(11) NOT NULL,\n  `Raw_Material_Name` varchar(255) NOT NULL,\n  `Specification` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`Raw_Material_ID`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `Financial_Record` (\n  `Transaction_ID` int(11) NOT NULL,\n  `Amount` decimal(10,2) NOT NULL,\n  `Date` datetime NOT NULL,\n  `Status` varchar(50) DEFAULT NULL,\n  `Transaction_Type` varchar(50) DEFAULT NULL,\n  PRIMARY KEY (`Transaction_ID`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `Supplier` (\n  `Supplier_ID` int(11) NOT NULL,\n  `Supplier_Name` varchar(255) NOT NULL,\n  `Contact_Information` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`Supplier_ID`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `Pizza_Recipe` (\n  `Recipe_ID` int(11) NOT NULL,\n  `Raw_Material_ID` int(11) NOT NULL,\n  `Usage_Amount` decimal(10,2) NOT NULL,\n  PRIMARY KEY (`Recipe_ID`, `Raw_Material_ID`),\n  CONSTRAINT `pizza_recipe_ibfk_1` FOREIGN KEY (`Raw_Material_ID`) REFERENCES `Raw_Material` (`Raw_Material_ID`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `Sales_Order` (\n  `Order_ID` int(11) NOT NULL,\n  `Customer_ID` int(11) NOT NULL,\n  `Expected_Delivery_Date` datetime DEFAULT NULL,\n  `Order_Status` varchar(50) DEFAULT NULL,\n  PRIMARY KEY (`Order_ID`),\n  CONSTRAINT `sales_order_ibfk_1` FOREIGN KEY (`Customer_ID`) REFERENCES `Customer` (`Customer_ID`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `Purchase_Order` (\n  `Purchase_Order_ID` int(11) NOT NULL,\n  `Order_Quantity` int(11) NOT NULL,\n  `Supplied_Quantity` int(11) DEFAULT NULL,\n  `Order_Status` varchar(50) DEFAULT NULL,\n  `Raw_Material_ID` int(11) NOT NULL,\n  `Supplier_ID` int(11) NOT NULL,\n  PRIMARY KEY (`Purchase_Order_ID`),\n  CONSTRAINT `purchase_order_ibfk_1` FOREIGN KEY (`Raw_Material_ID`) REFERENCES `Raw_Material` (`Raw_Material_ID`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `purchase_order_ibfk_2` FOREIGN KEY (`Supplier_ID`) REFERENCES `Supplier` (`Supplier_ID`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `Product` (\n  `Product_ID` int(11) NOT NULL,\n  `Product_Name` varchar(255) NOT NULL,\n  `Recipe_ID` int(11) NOT NULL,\n  PRIMARY KEY (`Product_ID`),\n  CONSTRAINT `product_ibfk_1` FOREIGN KEY (`Recipe_ID`) REFERENCES `Pizza_Recipe` (`Recipe_ID`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `Production_Plan` (\n  `Production_Plan_ID` int(11) NOT NULL,\n  `Order_ID` int(11) NOT NULL,\n  `Production_Status` varchar(50) DEFAULT NULL,\n  PRIMARY KEY (`Production_Plan_ID`),\n  CONSTRAINT `production_plan_ibfk_1` FOREIGN KEY (`Order_ID`) REFERENCES `Sales_Order` (`Order_ID`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `Delivery_Record` (\n  `Delivery_Record_ID` int(11) NOT NULL,\n  `Order_ID` int(11) NOT NULL,\n  `Delivery_Location` varchar(255) DEFAULT NULL,\n  `Delivery_Time` datetime DEFAULT NULL,\n  `Status` varchar(50) DEFAULT NULL,\n  PRIMARY KEY (`Delivery_Record_ID`),\n  CONSTRAINT `delivery_record_ibfk_1` FOREIGN KEY (`Order_ID`) REFERENCES `Sales_Order` (`Order_ID`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `Inventory_Management` (\n  `Inventory_ID` int(11) NOT NULL,\n  `Product_ID` int(11) NOT NULL,\n  `Quantity` int(11) NOT NULL,\n  `Status` varchar(50) DEFAULT NULL,\n  PRIMARY KEY (`Inventory_ID`),\n  CONSTRAINT `inventory_management_ibfk_1` FOREIGN KEY (`Product_ID`) REFERENCES `Product` (`Product_ID`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
