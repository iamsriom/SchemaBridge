  "database": "rschema_0023",
  "nl_text": "The rschema_0023 database is designed to manage information about donors, recipients, donated items, and donation records. The database contains five tables: donor, recipient, donated_item, donation_record, and donation_record_details. The donor table stores information about individuals who donate items, including their donor number, name, gender, date of birth, and contact information, with a primary key of donor number. The recipient table stores information about individuals who receive donations, with the same structure as the donor table. The donated_item table stores information about the items being donated, including the item number, name, quantity, and description, with a primary key of item number. The donation_record table stores information about each donation, including a unique donation record ID, the recipient number, the time of donation, and the item number, with a primary key of donation record ID and foreign keys referencing the donor and recipient tables with cascade delete and update rules. The donation_record_details table stores additional details about each donation, including the donation record ID and item number, with a composite primary key of donation record ID and item number, and foreign keys referencing the donation_record and donated_item tables with cascade delete and update rules.",
  "gold_question": "A mass organization needs to manage donation affairs, including donors, recipients, donation records and donated items.\nDonors have donor number, name, gender, date of birth and contact information;\nRecipients have recipient number, name, gender, date of birth and contact information;\nDonation records include donor number, recipient number, donation time and donated items;\nDonated items have item number, name, quantity and description. The system also needs to be able to count the number of donations made by each donor.",
  "input_json": "/data/RSchema_ExpResults4/Experiment2/schema2text_llama31/0023.json",
  "ddl": "-- Schema for database: rschema_0023\nCREATE TABLE `donor` (\n  `donor_number` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `gender` char(1) NOT NULL,\n  `date_of_birth` date NOT NULL,\n  `contact_information` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`donor_number`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `recipient` (\n  `recipient_number` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `gender` char(1) NOT NULL,\n  `date_of_birth` date NOT NULL,\n  `contact_information` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`recipient_number`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `donated_item` (\n  `item_number` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `quantity` int(11) NOT NULL,\n  `description` text DEFAULT NULL,\n  PRIMARY KEY (`item_number`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `donation_record` (\n  `donation_record_id` int(11) NOT NULL,\n  `recipient_number` int(11) NOT NULL,\n  `donor_number` int(11) NOT NULL,\n  `time_of_donation` datetime NOT NULL,\n  `item_number` int(11) NOT NULL,\n  PRIMARY KEY (`donation_record_id`),\n  CONSTRAINT `donation_record_ibfk_1` FOREIGN KEY (`donor_number`) REFERENCES `donor` (`donor_number`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `donation_record_ibfk_2` FOREIGN KEY (`recipient_number`) REFERENCES `recipient` (`recipient_number`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `donation_record_details` (\n  `donation_record_id` int(11) NOT NULL,\n  `item_number` int(11) NOT NULL,\n  PRIMARY KEY (`donation_record_id`, `item_number`),\n  CONSTRAINT `donation_record_details_ibfk_1` FOREIGN KEY (`donation_record_id`) REFERENCES `donation_record` (`donation_record_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `donation_record_details_ibfk_2` FOREIGN KEY (`item_number`) REFERENCES `donated_item` (`item_number`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
