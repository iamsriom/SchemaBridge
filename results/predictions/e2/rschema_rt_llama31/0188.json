  "database": "rschema_0188",
  "nl_text": "The rschema_0188 database is designed to manage the operations of a company, encompassing various aspects such as product management, employee information, production records, inventory tracking, sales transactions, and performance evaluations. The database consists of seven tables: product, department, employee, production_record, inventory_record, sales_record, and performance_evaluation. The product table stores information about each product, including its unique identifier, name, type, production date, and price. The department table contains details about each department, including its identifier, name, manager's employee ID, and contact information, with the manager's employee ID referencing the employee table for cascading updates and deletions. The employee table holds information about each employee, including their unique identifier, name, gender, phone number, job position, and department ID, with the department ID referencing the department table for cascading updates and deletions. The production_record table tracks the production of products, including the product ID, producer's employee ID, production time, and quantity, with the producer's employee ID referencing the employee table for cascading updates and deletions. The inventory_record table keeps track of the stock levels, including the product ID, stock-in time, and quantity, with the product ID referencing the product table for cascading updates and deletions. The sales_record table records sales transactions, including the salesperson's employee ID, customer, sales time, product ID, and sales quantity, with the salesperson's employee ID and product ID referencing the employee and product tables, respectively, for cascading updates and deletions. The performance_evaluation table evaluates the performance of departments, including the department ID, evaluation time, and evaluation score, with the department ID referencing the department table for cascading updates and deletions.",
  "gold_question": "Business Requirements Description for Leather Manufacturing Management System:\n\nA leather goods and footwear manufacturing company needs to manage the production, inventory, and sales of leather products and shoes. Each product has Attributes such as Product ID, Product Name, Product Type, Production Date, and Price. The company has multiple departments collaborating, and each department has a Department ID, Department Name, Manager, and Contact Information. Employee management includes Employee ID, Employee Name, Employee Gender, Employee Phone, Department ID, and Job Position. During production, the system records the products produced (one or more), Production Quantity, Producer, and Production Time. For inventory management, the system records the Product ID, Stock Quantity, and Stock In Time. For sales, the system records the Product ID, Sales Quantity, Salesperson, Customer, and Sales Time. The system also supports performance evaluation for each department.",
  "input_json": "/data/RSchema_ExpResults4/Experiment2/schema2text_llama31/0188.json",
  "ddl": "-- Schema for database: rschema_0188\nCREATE TABLE `product` (\n  `product_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `type` varchar(100) NOT NULL,\n  `production_date` datetime NOT NULL,\n  `price` decimal(10,2) NOT NULL,\n  PRIMARY KEY (`product_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `department` (\n  `department_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `manager_employee_id` int(11) NOT NULL,\n  `contact_info` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`department_id`),\n  CONSTRAINT `department_ibfk_1` FOREIGN KEY (`manager_employee_id`) REFERENCES `employee` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `employee` (\n  `employee_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `gender` char(1) NOT NULL,\n  `phone_number` varchar(15) DEFAULT NULL,\n  `job_position` varchar(100) NOT NULL,\n  `department_id` int(11) NOT NULL,\n  PRIMARY KEY (`employee_id`),\n  CONSTRAINT `employee_ibfk_1` FOREIGN KEY (`department_id`) REFERENCES `department` (`department_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `production_record` (\n  `record_id` int(11) NOT NULL,\n  `product_id` int(11) NOT NULL,\n  `producer_employee_id` int(11) NOT NULL,\n  `production_time` datetime NOT NULL,\n  `quantity` int(11) NOT NULL,\n  PRIMARY KEY (`record_id`),\n  CONSTRAINT `production_record_ibfk_1` FOREIGN KEY (`product_id`) REFERENCES `product` (`product_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `production_record_ibfk_2` FOREIGN KEY (`producer_employee_id`) REFERENCES `employee` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `inventory_record` (\n  `inventory_id` int(11) NOT NULL,\n  `product_id` int(11) NOT NULL,\n  `stock_in_time` datetime NOT NULL,\n  `quantity` int(11) NOT NULL,\n  PRIMARY KEY (`inventory_id`),\n  CONSTRAINT `inventory_record_ibfk_1` FOREIGN KEY (`product_id`) REFERENCES `product` (`product_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `sales_record` (\n  `sales_id` int(11) NOT NULL,\n  `salesperson_employee_id` int(11) NOT NULL,\n  `customer` varchar(255) NOT NULL,\n  `sales_time` datetime NOT NULL,\n  `product_id` int(11) NOT NULL,\n  `sales_quantity` int(11) NOT NULL,\n  PRIMARY KEY (`sales_id`),\n  CONSTRAINT `sales_record_ibfk_1` FOREIGN KEY (`salesperson_employee_id`) REFERENCES `employee` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `sales_record_ibfk_2` FOREIGN KEY (`product_id`) REFERENCES `product` (`product_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `performance_evaluation` (\n  `evaluation_id` int(11) NOT NULL,\n  `department_id` int(11) NOT NULL,\n  `evaluation_time` datetime NOT NULL,\n  `evaluation_score` decimal(5,2) NOT NULL,\n  PRIMARY KEY (`evaluation_id`),\n  CONSTRAINT `performance_evaluation_ibfk_1` FOREIGN KEY (`department_id`) REFERENCES `department` (`department_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
