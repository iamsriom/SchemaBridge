  "database": "rschema_0350",
  "nl_text": "The rschema_0350 database is designed to manage information about events, tickets, and participants. The Ticket_Type table stores details about different types of tickets, including a unique identifier, description, whether it includes a workshop, name, price, and a primary key to uniquely identify each ticket type. The Discount_Code table contains information about discount codes, with a unique identifier, name, type, and the amount of the discount. The Meeting table holds details about meetings, including the date, description, start and end times, room, and a unique identifier. The Workshop table stores information about workshops, including capacity, date, description, start and end times, location, requirements, and a unique identifier. The Speaker table contains details about speakers, including their bio, company, name, and a unique identifier. The Participant table links participants to their tickets and discount codes, with columns for company, email, name, and a unique identifier, as well as foreign keys referencing the Discount_Code and Ticket_Type tables to ensure data consistency. The Meeting_Speaker table connects meetings to their speakers, with a composite primary key consisting of the meeting and speaker IDs, and foreign keys referencing the Meeting and Speaker tables to maintain referential integrity. The Workshop_Speaker table does the same for workshops and speakers, with a composite primary key and foreign keys referencing the Workshop and Speaker tables.",
  "gold_question": "The design of a technology conference management system is as follows:\nThe conference has participants, whose information includes Participant ID, Name, Company, and Email.\nThe conference offers various types of tickets, with ticket information including Ticket ID, Name, Description, Price, and whether it includes workshops, with each participant limited to purchasing one ticket.\nParticipants can use discount codes to purchase tickets, with discount code information including Code, Name, Type, and Amount.\nAfter purchasing tickets, participant ticket records are generated, containing Participant ID, Ticket ID, Discount Code ID, and Net Price.\nThe conference schedules multiple meetings, with meeting information including Name, Description, Date, Start Time, End Time, and Room.\nFurthermore, the conference also offers workshops, with workshop information including Name, Description, Requirements, Location, Date, Start Time, End Time, and Capacity.\nEach meeting or workshop can have multiple speakers, with speaker information including Name, Company, and Description.",
  "input_json": "/data/RSchema_ExpResults4/Experiment2/schema2text_llama31/0350.json",
  "ddl": "-- Schema for database: rschema_0350\nCREATE TABLE `ticket_type` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `description` varchar(255) DEFAULT NULL,\n  `includes_workshop` tinyint(1) DEFAULT NULL,\n  `name` varchar(255) NOT NULL,\n  `price` decimal(10,2) NOT NULL,\n  PRIMARY KEY (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `discount_code` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `type` varchar(50) NOT NULL,\n  `amount` decimal(10,2) NOT NULL,\n  PRIMARY KEY (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `meeting` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `date` date NOT NULL,\n  `description` varchar(255) DEFAULT NULL,\n  `start_time` datetime NOT NULL,\n  `end_time` datetime NOT NULL,\n  `room` varchar(100) DEFAULT NULL,\n  PRIMARY KEY (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `workshop` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `capacity` int(11) NOT NULL,\n  `date` date NOT NULL,\n  `description` varchar(255) DEFAULT NULL,\n  `start_time` datetime NOT NULL,\n  `end_time` datetime NOT NULL,\n  `location` varchar(255) DEFAULT NULL,\n  `requirements` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `speaker` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `bio` text DEFAULT NULL,\n  `company` varchar(255) DEFAULT NULL,\n  `name` varchar(255) NOT NULL,\n  PRIMARY KEY (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `participant` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `company` varchar(255) DEFAULT NULL,\n  `email` varchar(255) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `discount_code_id` int(11) DEFAULT NULL,\n  `ticket_type_id` int(11) DEFAULT NULL,\n  PRIMARY KEY (`id`),\n  CONSTRAINT `participant_ibfk_1` FOREIGN KEY (`discount_code_id`) REFERENCES `discount_code` (`id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `participant_ibfk_2` FOREIGN KEY (`ticket_type_id`) REFERENCES `ticket_type` (`id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `meeting_speaker` (\n  `meeting_id` int(11) NOT NULL,\n  `speaker_id` int(11) NOT NULL,\n  PRIMARY KEY (`meeting_id`, `speaker_id`),\n  CONSTRAINT `meeting_speaker_ibfk_1` FOREIGN KEY (`meeting_id`) REFERENCES `meeting` (`id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `meeting_speaker_ibfk_2` FOREIGN KEY (`speaker_id`) REFERENCES `speaker` (`id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `workshop_speaker` (\n  `workshop_id` int(11) NOT NULL,\n  `speaker_id` int(11) NOT NULL,\n  PRIMARY KEY (`workshop_id`, `speaker_id`),\n  CONSTRAINT `workshop_speaker_ibfk_1` FOREIGN KEY (`workshop_id`) REFERENCES `workshop` (`id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `workshop_speaker_ibfk_2` FOREIGN KEY (`speaker_id`) REFERENCES `speaker` (`id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
