  "database": "rschema_0388",
  "nl_text": "The rschema_0388 database is designed to manage information about suppliers, projects, salaries, employees, and their attendance records. The database contains seven tables: Supplier_Table, Project_Table, Salary_Table, Supplier_Supply_Project, Employee_Table, Attendance_Record_Table, and Employee_Project_Allocation. The Supplier_Table stores information about each supplier, including their creation and update times, supplier ID, supplier information, and supplier relationship management. The Project_Table holds details about each project, such as creation and update times, project ID, project information, and project progress management. The Salary_Table contains information about salary calculations, distribution, and ID. The Supplier_Supply_Project table links suppliers to projects, with each supplier ID and project ID forming a composite primary key, and both referencing the Supplier_Table and Project_Table respectively. The Employee_Table stores employee details, including creation and update times, employee ID, employee information, performance evaluation, position allocation, and a foreign key referencing the Salary_Table for each employee's salary. The Attendance_Record_Table tracks attendance records for each employee, with a unique attendance ID, attendance record, creation time, employee ID, and employee punch-in time, referencing the Employee_Table for each employee. The Employee_Project_Allocation table assigns employees to projects, with a composite primary key of employee ID and project ID, referencing the Employee_Table and Project_Table respectively.",
  "gold_question": "The requirements analysis of a certain enterprise management system is as follows:\n1. Employee management: including employee information, job assignment, performance appraisal, salary number, creation time, update time, etc. An employee can participate in multiple projects.\n2. Supplier management: including supplier information, supplier relationship management, creation time, update time, etc. A supplier can supply multiple projects.\n3. Project management: including project information, project progress management, creation time, update time, etc. A project contains multiple employees and can have multiple suppliers.\n4. Attendance management: including employee number, employee clock-in, attendance record, creation time, update time, etc.\n5. Salary management: including salary payment, salary calculation, creation time, update time, etc.",
  "input_json": "/data/RSchema_ExpResults4/Experiment2/schema2text_llama31/0388.json",
  "ddl": "-- Schema for database: rschema_0388\nCREATE TABLE `supplier_table` (\n  `supplier_id` int(11) NOT NULL,\n  `supplier_info` varchar(255) DEFAULT NULL,\n  `created_at` datetime NOT NULL,\n  `updated_at` datetime NOT NULL,\n  `supplier_relationship_management` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`supplier_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `project_table` (\n  `project_id` int(11) NOT NULL,\n  `project_info` varchar(255) DEFAULT NULL,\n  `created_at` datetime NOT NULL,\n  `updated_at` datetime NOT NULL,\n  `project_progress_management` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`project_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `salary_table` (\n  `salary_id` int(11) NOT NULL,\n  `salary_info` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`salary_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `supplier_supply_project` (\n  `supplier_id` int(11) NOT NULL,\n  `project_id` int(11) NOT NULL,\n  PRIMARY KEY (`supplier_id`, `project_id`),\n  CONSTRAINT `supplier_supply_project_ibfk_1` FOREIGN KEY (`supplier_id`) REFERENCES `supplier_table` (`supplier_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `supplier_supply_project_ibfk_2` FOREIGN KEY (`project_id`) REFERENCES `project_table` (`project_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `employee_table` (\n  `employee_id` int(11) NOT NULL,\n  `employee_info` varchar(255) DEFAULT NULL,\n  `performance_evaluation` varchar(255) DEFAULT NULL,\n  `position_allocation` varchar(255) DEFAULT NULL,\n  `created_at` datetime NOT NULL,\n  `updated_at` datetime NOT NULL,\n  `salary_id` int(11) NOT NULL,\n  PRIMARY KEY (`employee_id`),\n  CONSTRAINT `employee_table_ibfk_1` FOREIGN KEY (`salary_id`) REFERENCES `salary_table` (`salary_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `attendance_record_table` (\n  `attendance_id` int(11) NOT NULL,\n  `attendance_record` varchar(255) DEFAULT NULL,\n  `created_at` datetime NOT NULL,\n  `employee_id` int(11) NOT NULL,\n  `punch_in_time` datetime NOT NULL,\n  PRIMARY KEY (`attendance_id`),\n  CONSTRAINT `attendance_record_table_ibfk_1` FOREIGN KEY (`employee_id`) REFERENCES `employee_table` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `employee_project_allocation` (\n  `employee_id` int(11) NOT NULL,\n  `project_id` int(11) NOT NULL,\n  PRIMARY KEY (`employee_id`, `project_id`),\n  CONSTRAINT `employee_project_allocation_ibfk_1` FOREIGN KEY (`employee_id`) REFERENCES `employee_table` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `employee_project_allocation_ibfk_2` FOREIGN KEY (`project_id`) REFERENCES `project_table` (`project_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
