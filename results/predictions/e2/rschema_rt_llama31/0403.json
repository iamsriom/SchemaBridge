  "database": "rschema_0403",
  "nl_text": "The rschema_0403 database is designed to manage the borrowing and auditing of books by students and administrators. The Student table stores information about each student, including their contact number, email, grade, major, name, student ID, and student number, with the student ID serving as the primary key. The Administrator table contains details about each administrator, such as their contact number, email, job number, name, and position, with the administrator ID as the primary key. The Book table holds information about each book, including its author, title, publication date, publisher, category, stock quantity, and borrowed quantity, with the book ID as the primary key. The Student_Borrow_Book table tracks the borrowing history of each student, including the borrowed book ID, borrow date, return date, and review status, with a composite primary key of student ID and borrowed book ID, referencing the Student and Book tables, and enforcing that a student cannot borrow a book without a valid student ID and that a book cannot be borrowed without a valid book ID. The Student_Return_Book table is similar to the Student_Borrow_Book table but for returned books, with a composite primary key of student ID and returned book ID, referencing the Student and Book tables, and enforcing the same constraints as the Student_Borrow_Book table. The Administrator_Audit table records the auditing history of administrators, including the administrator ID, audit date, audit result, book ID, and borrowing status, with a composite primary key of administrator ID and book ID, referencing the Administrator and Book tables, and ensuring that an administrator can only audit a book with a valid administrator ID and book ID.",
  "gold_question": "Business Requirement Description:\nThe following describes a Library Management System. The system’s main features might include:\n1.Student Management: Includes adding, modifying, deleting, and querying student information. Each student has a Student ID, Name, Student Number, Grade, Major, Contact Number, and Email.\n2.Administrator Management: Includes adding, modifying, deleting, and querying administrator information. The administrator details include Administrator ID, Name, Job Number, Contact Number, Email, and Position.\n3.Book Management: Includes adding, modifying, deleting, and querying book information. Book details include Book ID, Title, Author, Publisher, Publication Date, Category, Stock Quantity, and Borrowed Quantity.\n4.Book Borrowing Management: Includes adding, modifying, deleting, and querying student borrowing records. The records include Student ID, Borrowed Book ID, Borrow Date, Return Date, and Review Status.\n5.Book Returning Management: Includes adding, modifying, deleting, and querying student returning records. The records include Student ID, Borrowed Book ID, Return Date, and Review Status.\n6.Audit Management: Administrators review book borrowing and returning actions. The audit includes Administrator ID, Book ID, Borrowing Status, Audit Date, and Audit Result.",
  "input_json": "/data/RSchema_ExpResults4/Experiment2/schema2text_llama31/0403.json",
  "ddl": "-- Schema for database: rschema_0403\nCREATE TABLE `student` (\n  `student_id` int(11) NOT NULL,\n  `student_number` varchar(50) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `email` varchar(255) NOT NULL,\n  `contact_number` varchar(15) DEFAULT NULL,\n  `grade` varchar(10) DEFAULT NULL,\n  `major` varchar(100) DEFAULT NULL,\n  PRIMARY KEY (`student_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `administrator` (\n  `administrator_id` int(11) NOT NULL,\n  `name` varchar(255) NOT NULL,\n  `email` varchar(255) NOT NULL,\n  `contact_number` varchar(15) DEFAULT NULL,\n  `job_number` varchar(50) NOT NULL,\n  `position` varchar(100) DEFAULT NULL,\n  PRIMARY KEY (`administrator_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `book` (\n  `book_id` int(11) NOT NULL,\n  `title` varchar(255) NOT NULL,\n  `author` varchar(255) NOT NULL,\n  `publisher` varchar(255) DEFAULT NULL,\n  `publication_date` date DEFAULT NULL,\n  `category` varchar(100) DEFAULT NULL,\n  `stock_quantity` int(11) NOT NULL,\n  `borrowed_quantity` int(11) NOT NULL DEFAULT 0,\n  PRIMARY KEY (`book_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `student_borrow_book` (\n  `student_id` int(11) NOT NULL,\n  `borrowed_book_id` int(11) NOT NULL,\n  `borrow_date` datetime NOT NULL,\n  `return_date` datetime DEFAULT NULL,\n  `review_status` varchar(50) DEFAULT NULL,\n  PRIMARY KEY (`student_id`, `borrowed_book_id`),\n  CONSTRAINT `student_borrow_book_ibfk_1` FOREIGN KEY (`student_id`) REFERENCES `student` (`student_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `student_borrow_book_ibfk_2` FOREIGN KEY (`borrowed_book_id`) REFERENCES `book` (`book_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `student_return_book` (\n  `student_id` int(11) NOT NULL,\n  `returned_book_id` int(11) NOT NULL,\n  `return_date` datetime NOT NULL,\n  PRIMARY KEY (`student_id`, `returned_book_id`),\n  CONSTRAINT `student_return_book_ibfk_1` FOREIGN KEY (`student_id`) REFERENCES `student` (`student_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `student_return_book_ibfk_2` FOREIGN KEY (`returned_book_id`) REFERENCES `book` (`book_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `administrator_audit` (\n  `administrator_id` int(11) NOT NULL,\n  `audit_date` datetime NOT NULL,\n  `audit_result` varchar(255) NOT NULL,\n  `book_id` int(11) NOT NULL,\n  `borrowing_status` varchar(50) DEFAULT NULL,\n  PRIMARY KEY (`administrator_id`, `book_id`),\n  CONSTRAINT `administrator_audit_ibfk_1` FOREIGN KEY (`administrator_id`) REFERENCES `administrator` (`administrator_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `administrator_audit_ibfk_2` FOREIGN KEY (`book_id`) REFERENCES `book` (`book_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
