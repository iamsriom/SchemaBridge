  "database": "rschema_0416",
  "nl_text": "The rschema_0416 database is designed to manage user interactions and job information. The User table stores information about each user, including their avatar, email, nickname, password, registration time, role, and username, with a unique identifier for each user. The Company table contains details about each company, such as their address, name, profile, and contact information, with a unique identifier for each company. The Conversation table represents a conversation between two users, storing the conversation ID, message content, send time, and the IDs of the sender and receiver, with foreign keys referencing the User table to establish relationships between users. The Message_Board table stores messages posted by users, including the message content, send time, and the user who posted it, with a foreign key referencing the User table. The Job_Info table contains information about job openings, including the company ID, job category, education level, requirements, salary, title, and work location, with a unique identifier for each job. The User_and_Conversation table is a composite key that represents a conversation between two users, with foreign keys referencing the Conversation and User tables to establish relationships between users and conversations. The User_and_Message table stores messages posted by users, with a composite key referencing the Message_Board and User tables to establish relationships between users and messages. The Resume_Submission and Resume_Save tables store information about users who have submitted or saved job applications, with foreign keys referencing the Job_Info and User tables to establish relationships between users and job openings. The Company_and_Job_Info table contains duplicate information about job openings, with a composite key referencing the Job_Info and Company tables to establish relationships between companies and job openings.",
  "gold_question": "Business Requirement Description:\nThe online job recruitment system mainly serves three types of users: job seekers, companies, and administrators. The system provides the following functionalities:\n1.User Information Management: Each registered user has a unique user ID, username, password, email, avatar, nickname, registration time, and role.\n2.Company Information Management: Each company includes basic information such as company ID, company name, company address, company profile, and contact information.\n3.Job Information Management: Companies can post job openings or save matching resumes from users. Users can view detailed job information and submit resumes to the company. Job information includes job ID, title, content, requirements, job category, salary, education level, and work location.\n4.Conversation Management: Users can communicate via conversations. Conversation details include conversation ID, message content, and send time.\n5.Message Board Management: Users can update the message board with new content. The message board includes message ID, message content, and message time.",
  "input_json": "/data/RSchema_ExpResults4/Experiment2/schema2text_llama31/0416.json",
  "ddl": "-- Schema for database: rschema_0416\nCREATE TABLE `user` (\n  `user_id` int(11) NOT NULL AUTO_INCREMENT,\n  `avatar` varchar(255) DEFAULT NULL,\n  `email` varchar(255) NOT NULL,\n  `nickname` varchar(255) DEFAULT NULL,\n  `password` varchar(255) NOT NULL,\n  `registration_time` datetime NOT NULL,\n  `role` varchar(50) NOT NULL,\n  `username` varchar(255) NOT NULL,\n  PRIMARY KEY (`user_id`),\n  UNIQUE KEY `email` (`email`),\n  UNIQUE KEY `username` (`username`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `company` (\n  `company_id` int(11) NOT NULL AUTO_INCREMENT,\n  `address` varchar(255) DEFAULT NULL,\n  `name` varchar(255) NOT NULL,\n  `profile` text DEFAULT NULL,\n  `contact_info` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`company_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `conversation` (\n  `conversation_id` int(11) NOT NULL AUTO_INCREMENT,\n  `message_content` text NOT NULL,\n  `send_time` datetime NOT NULL,\n  `sender_id` int(11) NOT NULL,\n  `receiver_id` int(11) NOT NULL,\n  PRIMARY KEY (`conversation_id`),\n  CONSTRAINT `conversation_ibfk_1` FOREIGN KEY (`sender_id`) REFERENCES `user` (`user_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `conversation_ibfk_2` FOREIGN KEY (`receiver_id`) REFERENCES `user` (`user_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `message_board` (\n  `message_id` int(11) NOT NULL AUTO_INCREMENT,\n  `message_content` text NOT NULL,\n  `send_time` datetime NOT NULL,\n  `user_id` int(11) NOT NULL,\n  PRIMARY KEY (`message_id`),\n  CONSTRAINT `message_board_ibfk_1` FOREIGN KEY (`user_id`) REFERENCES `user` (`user_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `job_info` (\n  `job_id` int(11) NOT NULL AUTO_INCREMENT,\n  `company_id` int(11) NOT NULL,\n  `job_category` varchar(255) NOT NULL,\n  `education_level` varchar(255) NOT NULL,\n  `requirements` text NOT NULL,\n  `salary` decimal(10,2) NOT NULL,\n  `title` varchar(255) NOT NULL,\n  `work_location` varchar(255) NOT NULL,\n  PRIMARY KEY (`job_id`),\n  CONSTRAINT `job_info_ibfk_1` FOREIGN KEY (`company_id`) REFERENCES `company` (`company_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `user_and_conversation` (\n  `user_id` int(11) NOT NULL,\n  `conversation_id` int(11) NOT NULL,\n  PRIMARY KEY (`user_id`, `conversation_id`),\n  CONSTRAINT `user_and_conversation_ibfk_1` FOREIGN KEY (`user_id`) REFERENCES `user` (`user_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `user_and_conversation_ibfk_2` FOREIGN KEY (`conversation_id`) REFERENCES `conversation` (`conversation_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `user_and_message` (\n  `user_id` int(11) NOT NULL,\n  `message_id` int(11) NOT NULL,\n  PRIMARY KEY (`user_id`, `message_id`),\n  CONSTRAINT `user_and_message_ibfk_1` FOREIGN KEY (`user_id`) REFERENCES `user` (`user_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `user_and_message_ibfk_2` FOREIGN KEY (`message_id`) REFERENCES `message_board` (`message_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `resume_submission` (\n  `submission_id` int(11) NOT NULL AUTO_INCREMENT,\n  `job_id` int(11) NOT NULL,\n  `user_id` int(11) NOT NULL,\n  PRIMARY KEY (`submission_id`),\n  CONSTRAINT `resume_submission_ibfk_1` FOREIGN KEY (`job_id`) REFERENCES `job_info` (`job_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `resume_submission_ibfk_2` FOREIGN KEY (`user_id`) REFERENCES `user` (`user_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `resume_save` (\n  `save_id` int(11) NOT NULL AUTO_INCREMENT,\n  `job_id` int(11) NOT NULL,\n  `user_id` int(11) NOT NULL,\n  PRIMARY KEY (`save_id`),\n  CONSTRAINT `resume_save_ibfk_1` FOREIGN KEY (`job_id`) REFERENCES `job_info` (`job_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `resume_save_ibfk_2` FOREIGN KEY (`user_id`) REFERENCES `user` (`user_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `company_and_job_info` (\n  `company_id` int(11) NOT NULL,\n  `job_id` int(11) NOT NULL,\n  PRIMARY KEY (`company_id`, `job_id`),\n  CONSTRAINT `company_and_job_info_ibfk_1` FOREIGN KEY (`company_id`) REFERENCES `company` (`company_id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `company_and_job_info_ibfk_2` FOREIGN KEY (`job_id`) REFERENCES `job_info` (`job_id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
