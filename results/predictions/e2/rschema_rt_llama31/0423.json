  "database": "rschema_0423",
  "nl_text": "The rschema_0423 database is designed to manage an online learning platform, where users can enroll in courses, view chapters, and interact with instructors. The Course table stores information about each course, including its ID, category, description, name, difficulty level, number of lessons, whether it's recommended, target audience, and total duration. The Chapter table represents individual chapters within a course, with each chapter having a unique ID, description, name, duration, and references to the next, parent, and previous chapters. The Instructor table contains details about each instructor, such as their ID, name, personal profile, professional field, and teaching experience. The Student table stores information about each registered user, including their ID, account status, age, contact information, gender, membership level, points earned, registration time, and avatar. The Course_material table links courses to their respective materials, which are stored in the database with their IDs, names, and URLs. The Instructor_teaching table tracks the courses taught by each instructor, along with their ratings and student feedback. Finally, the Viewing_record table records each student's viewing history, including the chapter ID, completion status, student ID, view count, and viewing duration, with foreign keys referencing the Chapter and Student tables to establish relationships between these entities.",
  "gold_question": "This is an online education platform's course management system. For course management, the system supports maintaining basic course information (course ID, course name, course description, etc.), records detailed course information (number of lessons, total duration, difficulty level, etc.), and manages course classification information (course category, target audience, recommendation status, etc.). For chapter management, the system maintains basic chapter information (chapter ID, chapter name, chapter description, etc.), records detailed chapter information (video URL, course materials, duration, etc.), and manages chapter sequence (previous/next chapters, chapter hierarchy, etc.). For instructor management, the system maintains basic instructor information (instructor ID, name, avatar, etc.), records detailed instructor information (teaching experience, professional field, personal profile, etc.), and manages instructor courses (teaching list, ratings, student feedback, etc.). For student management, the system maintains basic student information, including basic data (student ID, name, avatar, gender, age, contact information) and account information (registration time, account status, membership level, points), while tracking learning progress, including course progress (selected courses, current learning chapter, last learning time), viewing records (viewing duration per lesson, number of views, completion status) and learning statistics (total learning duration, course completion rate).",
  "input_json": "/data/RSchema_ExpResults4/Experiment2/schema2text_llama31/0423.json",
  "ddl": "-- Schema for database: rschema_0423\nCREATE TABLE `course` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `category` varchar(255) DEFAULT NULL,\n  `description` text DEFAULT NULL,\n  `name` varchar(255) NOT NULL,\n  `difficulty_level` varchar(50) DEFAULT NULL,\n  `number_of_lessons` int(11) DEFAULT NULL,\n  `is_recommended` tinyint(1) DEFAULT NULL,\n  `target_audience` varchar(255) DEFAULT NULL,\n  `total_duration` int(11) DEFAULT NULL,\n  PRIMARY KEY (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `chapter` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `description` text DEFAULT NULL,\n  `name` varchar(255) NOT NULL,\n  `duration` int(11) DEFAULT NULL,\n  `next_chapter_id` int(11) DEFAULT NULL,\n  `parent_chapter_id` int(11) DEFAULT NULL,\n  `previous_chapter_id` int(11) DEFAULT NULL,\n  PRIMARY KEY (`id`),\n  CONSTRAINT `chapter_ibfk_1` FOREIGN KEY (`next_chapter_id`) REFERENCES `chapter` (`id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `chapter_ibfk_2` FOREIGN KEY (`parent_chapter_id`) REFERENCES `chapter` (`id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `chapter_ibfk_3` FOREIGN KEY (`previous_chapter_id`) REFERENCES `chapter` (`id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `instructor` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `personal_profile` text DEFAULT NULL,\n  `professional_field` varchar(255) DEFAULT NULL,\n  `teaching_experience` int(11) DEFAULT NULL,\n  PRIMARY KEY (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `student` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `account_status` varchar(50) DEFAULT NULL,\n  `age` int(11) DEFAULT NULL,\n  `contact_information` varchar(255) DEFAULT NULL,\n  `gender` varchar(10) DEFAULT NULL,\n  `membership_level` varchar(50) DEFAULT NULL,\n  `points_earned` int(11) DEFAULT NULL,\n  `registration_time` datetime DEFAULT NULL,\n  `avatar` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `course_material` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(255) NOT NULL,\n  `url` varchar(255) NOT NULL,\n  PRIMARY KEY (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `instructor_teaching` (\n  `instructor_id` int(11) NOT NULL,\n  `course_id` int(11) NOT NULL,\n  `rating` float DEFAULT NULL,\n  `student_feedback` text DEFAULT NULL,\n  PRIMARY KEY (`instructor_id`, `course_id`),\n  CONSTRAINT `instructor_teaching_ibfk_1` FOREIGN KEY (`instructor_id`) REFERENCES `instructor` (`id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `instructor_teaching_ibfk_2` FOREIGN KEY (`course_id`) REFERENCES `course` (`id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `viewing_record` (\n  `chapter_id` int(11) NOT NULL,\n  `completion_status` tinyint(1) DEFAULT NULL,\n  `student_id` int(11) NOT NULL,\n  `view_count` int(11) DEFAULT NULL,\n  `viewing_duration` int(11) DEFAULT NULL,\n  PRIMARY KEY (`chapter_id`, `student_id`),\n  CONSTRAINT `viewing_record_ibfk_1` FOREIGN KEY (`chapter_id`) REFERENCES `chapter` (`id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `viewing_record_ibfk_2` FOREIGN KEY (`student_id`) REFERENCES `student` (`id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
