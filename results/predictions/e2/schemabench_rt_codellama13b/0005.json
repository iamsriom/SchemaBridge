  "database": "schemabench_0005",
  "nl_text": "The schemabench_0005 database is used to store information about users, subscriptions, subscription items, receipts, and tax rates. The users table contains information about each user, including their ID, Stripe ID, payment method type, payment method last four digits, payment method expiration, extra billing information, trial end date, billing address, billing address line 2, billing city, billing state, billing postal code, billing country, VAT ID, and receipt emails. The subscriptions table contains information about each subscription, including their ID, user ID, name, Stripe ID, Stripe status, Stripe price, quantity, trial end date, end date, updated at, and created at. The subscription items table contains information about each subscription item, including their ID, subscription ID, Stripe ID, Stripe product, Stripe price, quantity, updated at, and created at. The receipts table contains information about each receipt, including their ID, user ID, provider ID, amount, tax, paid at, updated at, and created at. The tax rates table contains information about each tax rate, including their ID, Stripe ID, percentage, updated at, and created at. The foreign keys in the tables reference the primary keys in the users, subscriptions, and tax rates tables, and the update and delete rules are set to CASCADE and RESTRICT, respectively.",
  "gold_question": "Background / Context\n\nThe project involves developing a payment subscription management system utilizing Laravel Cashier for interaction with Stripe's billing services. Cashier is part of the Laravel ecosystem, providing a seamless, fluent API that simplifies integrating subscription billing services into Laravel applications. It encapsulates the complex boilerplate code associated with managing customer subscriptions, including functionalities beyond basic subscription handling.\n\nObjectives\n\nThe main objectives are:\n- To integrate an intuitive interface for managing Stripe subscriptions within Laravel applications.\n- To seamlessly handle subscription management tasks including coupon application, subscription swaps, and adjustment of subscription quantities.\n- To support additional features like cancellation grace periods and invoice PDF generation.\n\nStakeholders & Users\n\n- Developers: Use Cashier to integrate Stripe payment solutions seamlessly within Laravel apps.\n- End Users/Customers: Manage their subscriptions and billing details directly on the platform.\n- Administrators: Oversee subscription statuses, manage invoices, and monitor financial transactions.\n\nFunctional Descriptions\n\n1. Subscription Management: \n   - Create, update, and cancel customer subscriptions.\n   - Manage subscription quantities and apply coupons.\n   - Handle grace periods for cancellations.\n\n2. Invoicing:\n   - Generate and deliver invoice PDFs for customer billing.\n   - Maintain records of transactions and payments.\n\n3. Billing Information Management:\n   - Update and store billing addresses and payment methods.\n   - Handle tax calculation through tax rate management.\n\n4. User Management:\n   - Store customer details and subscription preferences.\n   - Track usage metrics and customer interactions with subscriptions.\n\n5. Database Integration:\n   - Store subscription details in the database with tables for subscriptions, users, subscription items, receipts, and tax rates.\n\nNon-Functional Descriptions\n\n- Security: Ensure secure handling of payment data through Stripe's API, with encryption and compliance with industry standards.\n- Performance: Support scalable operations, accommodating a growing base of customers and subscription activities.\n- Usability: Provide a developer-friendly interface that simplifies integration and reduces code complexity within the application.\n- Reliability: Ensure high uptime and integrity of billing operations, minimizing the risks of transaction failures or data inaccuracies.",
  "input_json": "/data/SchemaBench/Experiment/schema2text_codellama13b/0005.json",
  "ddl": "-- Schema for database: schemabench_0005\nCREATE TABLE `users` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `stripe_id` varchar(255) DEFAULT NULL,\n  `payment_method_type` varchar(50) DEFAULT NULL,\n  `payment_method_last4` char(4) DEFAULT NULL,\n  `payment_method_expiration` datetime DEFAULT NULL,\n  `extra_billing_info` text DEFAULT NULL,\n  `trial_end_date` datetime DEFAULT NULL,\n  `billing_address` varchar(255) DEFAULT NULL,\n  `billing_address_line_2` varchar(255) DEFAULT NULL,\n  `billing_city` varchar(100) DEFAULT NULL,\n  `billing_state` varchar(100) DEFAULT NULL,\n  `billing_postal_code` varchar(20) DEFAULT NULL,\n  `billing_country` varchar(100) DEFAULT NULL,\n  `vat_id` varchar(100) DEFAULT NULL,\n  `receipt_emails` text DEFAULT NULL,\n  PRIMARY KEY (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `subscriptions` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `user_id` int(11) NOT NULL,\n  `name` varchar(255) DEFAULT NULL,\n  `stripe_id` varchar(255) DEFAULT NULL,\n  `stripe_status` varchar(50) DEFAULT NULL,\n  `stripe_price` decimal(10,2) DEFAULT NULL,\n  `quantity` int(11) DEFAULT NULL,\n  `trial_end_date` datetime DEFAULT NULL,\n  `end_date` datetime DEFAULT NULL,\n  `updated_at` datetime DEFAULT NULL,\n  `created_at` datetime DEFAULT NULL,\n  PRIMARY KEY (`id`),\n  CONSTRAINT `subscriptions_ibfk_1` FOREIGN KEY (`user_id`) REFERENCES `users` (`id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `subscription_items` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `subscription_id` int(11) NOT NULL,\n  `stripe_id` varchar(255) DEFAULT NULL,\n  `stripe_product` varchar(255) DEFAULT NULL,\n  `stripe_price` decimal(10,2) DEFAULT NULL,\n  `quantity` int(11) DEFAULT NULL,\n  `updated_at` datetime DEFAULT NULL,\n  `created_at` datetime DEFAULT NULL,\n  PRIMARY KEY (`id`),\n  CONSTRAINT `subscription_items_ibfk_1` FOREIGN KEY (`subscription_id`) REFERENCES `subscriptions` (`id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `receipts` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `user_id` int(11) NOT NULL,\n  `provider_id` int(11) DEFAULT NULL,\n  `amount` decimal(10,2) DEFAULT NULL,\n  `tax` decimal(10,2) DEFAULT NULL,\n  `paid_at` datetime DEFAULT NULL,\n  `updated_at` datetime DEFAULT NULL,\n  `created_at` datetime DEFAULT NULL,\n  PRIMARY KEY (`id`),\n  CONSTRAINT `receipts_ibfk_1` FOREIGN KEY (`user_id`) REFERENCES `users` (`id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;\n\nCREATE TABLE `tax_rates` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `stripe_id` varchar(255) DEFAULT NULL,\n  `percentage` decimal(5,2) DEFAULT NULL,\n  `updated_at` datetime DEFAULT NULL,\n  `created_at` datetime DEFAULT NULL,\n  PRIMARY KEY (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;",
